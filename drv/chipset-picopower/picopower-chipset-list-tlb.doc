<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="generator" content="Metropoli-Retro-Viewer">
    <title>Metropoli BBS - chipset.doc</title>
    <link href="https://fonts.cdnfonts.com/css/perfect-dos-vga-437" rel="stylesheet">
    <style>
        :root {
            --bg-color: #000000;
            --crt-bg: #080808;      
            --dos-white: #DDDDDD;       
            --dos-grey: #999999;        
            --dos-yellow: #DDDD44;      
            --dos-cyan: #44DDDD;        
            --dos-green: #44DD44;       
            --dos-red-bg: #AA0000;      
            --action-color: #00AAAA;    
            --hover-white: #FFFFFF;
        }

        body {
            background-color: var(--bg-color);
            color: var(--dos-white);
            font-family: 'Perfect DOS VGA 437 Win', monospace;
            //font-family: 'Modern DOS', monospace;
            font-size: 18px;
            line-height: 20px; 
            margin: 0;
            padding: 20px;
            min-height: 100vh;
            
            /* GRID LAYOUT: 3 Columns.
               1fr / max-content / 1fr creates true centering for the middle column.
               The logo sits in column 1. */
            display: grid;
            grid-template-columns: 1fr max-content 1fr;
            align-items: start;
        }

        /* RESPONSIVE BREAKPOINT: HIDE LOGO */
        @media (max-width: 1120px) {
            body {
                display: flex;
                justify-content: center;
            }
            .logo-wrapper { display: none !important; }
            .grid-spacer { display: none; }
        }

        /* LOGO ITEM */
        .logo-wrapper {
            grid-column: 1;
            justify-self: end; 
            width: 160px;
            height: 160px;
            position: sticky;
            top: 20px;
            margin-right: 20px;
            z-index: 10;
        }
        
        .logo-img {
            width: 100%;
            height: auto;
            opacity: 0.9;
        }

        /* VIEWER ITEM */
        .crt-frame {
            grid-column: 2;
            background-color: var(--crt-bg);
            display: block;
            width: 80ch;
            min-width: min-content; 
            padding: 20px;
            border: 1px solid #333;
            box-sizing: border-box;
        }

        .bbs-header {
            border-bottom: 2px solid var(--dos-grey);
            margin-bottom: 15px;
            padding-bottom: 5px;
            color: var(--dos-yellow);
        }

        a { text-decoration: none; color: var(--action-color); }
        a:hover { color: var(--hover-white); background-color: var(--action-color); }

        /* Prevent internal scrolling */
        pre { margin: 0; white-space: pre; overflow: visible; font-family: inherit; }
        
        .hex-content { color: var(--dos-cyan); } 
        .text-content { color: var(--dos-white); }
        .o { color: var(--dos-yellow); } 
        .h { color: var(--dos-white); } 
        .b { color: var(--dos-grey); }   
        .s { color: var(--hover-white); } 
        //.s { color: var(--hover-white); font-weight: bold; } 

    </style>
</head>
