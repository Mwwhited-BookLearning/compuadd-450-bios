   740 0000154B E8FF25                          db 0xE8, 0xFF, 0x25                      ; 154B  call setup_draw_time_date
   741 0000154E EBEC                            jmp short loc_153C                       ; 154E
   742                                  
   743                                  loc_1550:
   744 00001550 E460                            in al, 0x60                              ; 1550  port 60h: KBC data
   745 00001552 3CE0                            cmp al, 0xe0                             ; 1552
   746 00001554 7510                            jne short loc_1566                       ; 1554
   747 00001556 50                              push ax                                  ; 1556
   748 00001557 1E                              push ds                                  ; 1557
   749 00001558 B84000                          mov ax, 0x40                             ; 1558
   750 0000155B 8ED8                            mov ds, ax                               ; 155B
   751 0000155D 800EB60080                      or byte [bda.phoenix_flags2], 0x80       ; 155D  bda.phoenix_flags2
