   726                                  ; Pop-up keyboard reader: polls 64h/60h directly (redrawing the clock while idle), treats E0h as a prefix (40:B6 bit 7), maps extended scancodes (setup_extended_scancodes) to AL=0/AH=scancode, digit keys 02h-0Bh to '1'..'0', Backspace to 08h; unknown keys beep (setup_key_default).
   727                                  popup_read_key:
   728 00001539 51                              push cx                                  ; 1539
   729 0000153A 57                              push di                                  ; 153A
   730 0000153B 06                              push es                                  ; 153B
   731                                  
   732                                  loc_153C:
   733 0000153C E464                            in al, 0x64                              ; 153C  port 64h: KBC command/status
   734 0000153E A801                            test al, 1                               ; 153E
   735 00001540 750E                            jne short loc_1550                       ; 1540
   736 00001542 B00C                            mov al, 0xc                              ; 1542
   737 00001544 E8C825                          db 0xE8, 0xC8, 0x25                      ; 1544  call cmos_hw_read
   738 00001547 A810                            test al, 0x10                            ; 1547
