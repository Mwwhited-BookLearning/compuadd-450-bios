   143 000002EC 75D2                <2> 	jnz		SHORT DisplayFormatCompressed_Format_2_u
   144 000002EE BE[D200]            <2> 	mov		si, g_szDashForZero			; if parameter equals zero, emit dash string instead
   145 000002F1 BB                  <2> 	SKIP2B	bx							; Fall through to DisplayFormat_ParseCharacters
