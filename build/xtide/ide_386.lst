   262                              <2> ; Keyboard_RemoveAllKeystrokesFromBuffer
   263                              <2> ;	Parameters:
   264                              <2> ;		Nothing
   265                              <2> ;	Returns:
   266                              <2> ;		Nothing
   267                              <2> ;	Corrupts registers:
   268                              <2> ;		AX
   269                              <2> ;--------------------------------------------------------------------
   270                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS				; Only used when debugging
   271                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   272                              <2> Keyboard_RemoveAllKeystrokesFromBuffer:
   273                              <2> 	call	Keyboard_GetKeystrokeToAX
   274                              <2> 	jnz		SHORT Keyboard_RemoveAllKeystrokesFromBuffer
   275                              <2> 	ret
   276                              <2> %endif
