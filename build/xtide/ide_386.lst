    24                              <1> ; DetectPrint_InitializeDisplayContext
    25                              <1> ;	Parameters:
    26                              <1> ;		Nothing
    27                              <1> ;	Returns:
    28                              <1> ;		Nothing
    29                              <1> ;	Corrupts registers:
    30                              <1> ;		AX, DI
    31                              <1> ;--------------------------------------------------------------------
    32                              <1> DetectPrint_InitializeDisplayContext:
