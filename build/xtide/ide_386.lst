    10                              <1> ; it under the terms of the GNU General Public License as published by
    11                              <1> ; the Free Software Foundation; either version 2 of the License, or
    12                              <1> ; (at your option) any later version.
    13                              <1> ;
    14                              <1> ; This program is distributed in the hope that it will be useful,
    15                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                              <1> ; GNU General Public License for more details.
    18                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    19                              <1> ;
    20                              <1> 
    21                              <1> %ifndef ROMVARS_INC
    22                              <1> %define ROMVARS_INC
    23                              <1> 
    24                              <1> 
    25                              <1> ; Master/Slave drive specific parameters
    26                              <1> struc DRVPARAMS
    27 00000000 ????                <1> 	.wFlags			resb	2	; Drive flags
    28                              <1> 	.dwMaximumLBA:				; User specified maximum number of sectors
    29 00000002 ????                <1> 	.wCylinders		resb	2	; User specified cylinders (1...16383)
    30                              <1> 	.wHeadsAndSectors:
    31 00000004 ??                  <1> 	.bHeads			resb	1	; User specified Heads (1...16)
    32 00000005 ??                  <1> 	.bSect			resb	1	; User specified Sectors per track (1...63)
    33                              <1> endstruc
    34                              <1> 
    35                              <1> ; Bit defines for DRVPARAMS.wFlags - these flags are accessed as bytes so changes here might require changes elsewhere
    36                              <1> MASK_DRVPARAMS_WRITECACHE		EQU	(3<<0)	; Bits 0...1, Drive internal write cache settings (must start at bit 0)
    37                              <1> 	DEFAULT_WRITE_CACHE				EQU	0	; Must be 0
    38                              <1> 	DISABLE_WRITE_CACHE				EQU	1
    39                              <1> 	ENABLE_WRITE_CACHE				EQU	2
    40                              <1> MASK_DRVPARAMS_TRANSLATEMODE	EQU	(3<<TRANSLATEMODE_FIELD_POSITION)	; Bits 2...3, Position shared with DPT
    41                              <1> 	TRANSLATEMODE_FIELD_POSITION	EQU	2
    42                              <1> 	TRANSLATEMODE_NORMAL			EQU	0	; Must be zero
    43                              <1> 	TRANSLATEMODE_LARGE				EQU	1
    44                              <1> 	TRANSLATEMODE_ASSISTED_LBA		EQU	2	; 28-bit or 48-bit LBA
    45                              <1> 	TRANSLATEMODE_AUTO				EQU	3	; Only available in ROMVARS, not in DPTs
    46                              <1> FLG_DRVPARAMS_BLOCKMODE			EQU	(1<<4)	; Enable Block mode transfers
    47                              <1> FLG_DRVPARAMS_USERCHS			EQU	(1<<5)	; User specified P-CHS values
    48                              <1> FLG_DRVPARAMS_USERLBA			EQU	(1<<6)	; User specified LBA value
    49                              <1> FLG_DRVPARAMS_DO_NOT_DETECT		EQU	(1<<7)	; Disable detection of drive
    50                              <1> 
    51                              <1> 
    52                              <1> ; Controller specific variables
    53                              <1> struc IDEVARS
    54                              <1> ;;; Word 0
    55                              <1> 	.wSerialPortAndBaud:					; Serial connection port (low, divided by 4) and baud rate divisor (high)
    56                              <1> 	.wBasePort:								; IDE Base Port for Command Block (usual) Registers
    57 00000000 ??                  <1> 	.bSerialPort				resb	1
    58 00000001 ??                  <1> 	.bSerialBaud				resb	1
    59                              <1> 
    60                              <1> ;;; Word 1
    61                              <1> 	.wControlBlockPort:
    62 00000002 ??                  <1> 	.bSerialUnused				resb	1	; IDE Base Port for Control Block Registers
    63                              <1> 
    64                              <1> 	.wSerialCOMPortCharAndDevice:			; In DetectPrint, we grab the COM Port char and Device at the same time
    65 00000003 ??                  <1> 	.bSerialCOMPortChar			resb	1	; Serial connection COM port number/letter
    66                              <1> 
    67                              <1> ;;; Word 2
    68 00000004 ??                  <1> 	.bDevice					resb	1	; Device type
    69 00000005 ??                  <1> 	.bIRQ						resb	1	; Interrupt Request Number
    70                              <1> 
    71                              <1> ;;; And more...
    72 00000006 ????????????        <1> 	.drvParamsMaster			resb	DRVPARAMS_size
    73 0000000C ????????????        <1> 	.drvParamsSlave				resb	DRVPARAMS_size
    74                              <1> endstruc
    75                              <1> 
    76                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    77                              <1> 	%if IDEVARS.bSerialCOMPortChar+1 != IDEVARS.bDevice
    78                              <1> 		%error "IDEVARS.bSerialCOMPortChar needs to come immediately before IDEVARS.bDevice so that both bytes can be fetched at the same time inside DetectPrint.asm"
    79                              <1> 	%endif
    80                              <1> %endif
    81                              <1> 
    82                              <1> STANDARD_CONTROL_BLOCK_OFFSET			EQU		200h
    83                              <1> XTIDE_CONTROL_BLOCK_OFFSET				EQU		8h		; For XTIDE, A3 is used to control selected register (CS0 vs CS1)...
    84                              <1> XTCF_CONTROL_BLOCK_OFFSET				EQU		10h		; ...and for XT-CF (all variants), it's A4
    85                              <1> ADP50L_CONTROL_BLOCK_OFFSET				EQU		10h
    86                              <1> 
    87                              <1> ; Default values for Port and PortCtrl, shared with the configurator
    88                              <1> ;
    89                              <1> DEVICE_XTIDE_DEFAULT_PORT				EQU		300h	; Also the default port for XT-CF
    90                              <1> DEVICE_XTIDE_DEFAULT_PORTCTRL			EQU		(DEVICE_XTIDE_DEFAULT_PORT + XTIDE_CONTROL_BLOCK_OFFSET)
    91                              <1> ; Note XT-CF control port is SHL 1 relative to XTIDE, and coded that way hence no need for specific definition like...
    92                              <1> ; DEVICE_XTCF_DEFAULT_PORTCTRL			EQU		(DEVICE_XTIDE_DEFAULT_PORT + XTCF_CONTROL_BLOCK_OFFSET)
    93                              <1> 
    94                              <1> DEVICE_ATA_PRIMARY_PORT					EQU		1F0h
    95                              <1> DEVICE_ATA_PRIMARY_PORTCTRL				EQU		(DEVICE_ATA_PRIMARY_PORT + STANDARD_CONTROL_BLOCK_OFFSET)
    96                              <1> 
    97                              <1> DEVICE_ATA_SECONDARY_PORT				EQU		170h
    98                              <1> DEVICE_ATA_SECONDARY_PORTCTRL			EQU		(DEVICE_ATA_SECONDARY_PORT + STANDARD_CONTROL_BLOCK_OFFSET)
    99                              <1> 
   100                              <1> DEVICE_ATA_TERTIARY_PORT				EQU		1E8h
   101                              <1> DEVICE_ATA_TERTIARY_PORTCTRL			EQU		(DEVICE_ATA_TERTIARY_PORT + STANDARD_CONTROL_BLOCK_OFFSET)
   102                              <1> 
   103                              <1> DEVICE_ATA_QUATERNARY_PORT				EQU		168h
   104                              <1> DEVICE_ATA_QUATERNARY_PORTCTRL			EQU		(DEVICE_ATA_QUATERNARY_PORT + STANDARD_CONTROL_BLOCK_OFFSET)
   105                              <1> 
   106                              <1> 
   107                              <1> ; Device types for IDEVARS.bDevice
   108                              <1> ; IDE Devices are grouped so device numbers cannot be changed without modifying code elsewhere!
   109                              <1> COUNT_OF_STANDARD_IDE_DEVICES			EQU	2	; 16- and 32-bit controllers
   110                              <1> COUNT_OF_8BIT_IDE_DEVICES				EQU	11
   111                              <1> COUNT_OF_ALL_IDE_DEVICES				EQU	(COUNT_OF_8BIT_IDE_DEVICES + COUNT_OF_STANDARD_IDE_DEVICES)
   112                              <1> ; Standard port mapped I/O
   113                              <1> DEVICE_16BIT_ATA						EQU	(0<<1)
   114                              <1> DEVICE_32BIT_ATA						EQU	(1<<1)
   115                              <1> DEVICE_8BIT_ATA							EQU	((COUNT_OF_STANDARD_IDE_DEVICES+0)<<1)	; 16- or 32-bit controller in 8-bit mode
   116                              <1> DEVICE_8BIT_JUKO_D16X					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+1)<<1)
   117                              <1> DEVICE_8BIT_XTIDE_REV1					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+2)<<1)
   118                              <1> ; Address lines A0 and A3 are swapped
   119                              <1> DEVICE_8BIT_XTIDE_REV2					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+3)<<1)	; Or rev 1 with swapped A0 and A3...
   120                              <1> DEVICE_8BIT_XTIDE_REV2_OLIVETTI			EQU	((COUNT_OF_STANDARD_IDE_DEVICES+4)<<1)	; ...in Olivetti M24 and derivatives
   121                              <1> ; IDE Register offsets are SHL 1
   122                              <1> DEVICE_8BIT_XTCF_PIO8					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+5)<<1)	; XT-CF using 8-bit PIO mode
   123                              <1> DEVICE_8BIT_XTCF_PIO8_WITH_BIU_OFFLOAD	EQU	((COUNT_OF_STANDARD_IDE_DEVICES+6)<<1)	; XT-CF using 8-bit PIO mode, but with 16-bit instructions
   124                              <1> DEVICE_8BIT_XTCF_PIO16_WITH_BIU_OFFLOAD	EQU	((COUNT_OF_STANDARD_IDE_DEVICES+7)<<1)	; Lo-tech 8-bit IDE Adapter
   125                              <1> DEVICE_8BIT_XTCF_DMA					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+8)<<1)	; XT-CFv3 using DMA
   126                              <1> ; Memory Mapped I/O
   127                              <1> DEVICE_8BIT_JRIDE_ISA					EQU	((COUNT_OF_STANDARD_IDE_DEVICES+9)<<1)	; JR-IDE/ISA (Memory Mapped I/O)
   128                              <1> DEVICE_8BIT_ADP50L						EQU	((COUNT_OF_STANDARD_IDE_DEVICES+10)<<1)	; SVC ADP50L (Memory Mapped I/O)
   129                              <1> ; Virtual devices
   130                              <1> DEVICE_SERIAL_PORT						EQU	(COUNT_OF_ALL_IDE_DEVICES<<1)
   131                              <1> 
   132                              <1> FIRST_XTCF_DEVICE						EQU	DEVICE_8BIT_XTCF_PIO8
   133                              <1> LAST_XTCF_DEVICE						EQU	DEVICE_8BIT_XTCF_DMA
   134                              <1> XTCF_DEVICE_OFFSET						EQU	FIRST_XTCF_DEVICE						; Used for XT-CF device <--> mode conversion
   135                              <1> 
   136                              <1> ; Segment when RAMVARS is stored to top of interrupt vectors.
   137                              <1> LITE_MODE_RAMVARS_SEGMENT				EQU	30h
   138                              <1> 
   139                              <1> ; ROM Variables. Written to the ROM image before flashing.
   140                              <1> ; The ROMVARS version in Version.inc must be incremented whenever this struc changes.
   141                              <1> struc ROMVARS
   142 00000000 ????                <1> 	.wRomSign			resb	2	; ROM Signature (AA55h)
   143 00000002 ??                  <1> 	.bRomSize			resb	1	; ROM size in 512 byte blocks
   144 00000003 ??????              <1> 	.rgbJump			resb	3	; First instruction to ROM init (jmp)
   145                              <1> 
   146 00000006 ????????????        <1> 	.rgbSign			resb	6	; Signature for XTIDE Configurator Program (must be even length)
   147 0000000C <res 20h>           <1> 	.szTitle			resb	32	; BIOS title string
   148 0000002C <res 12h>           <1> 	.szVersion			resb	18	; BIOS version string (supports up to r999)
   149                              <1> 
   150 0000003E ????                <1> 	.pColorTheme		resb	2	; Ptr to the color attribute struc used by the boot menu and hotkey bar
   151 00000040 ????                <1> 	.wFlags				resb	2	; Word for ROM flags
   152                              <1> 	; Note! Any additional ROMVARS must be added below if they are supposed to be copied
   153                              <1> 	; over when doing "Load old settings from EEPROM" to a new BIOS loaded from file.
   154 00000042 ????                <1> 	.wRamVars			resb	2	; Segment address for RamVars
   155 00000044 ????                <1> 	.wDisplayMode		resb	2	; Display mode for boot menu
   156 00000046 ????                <1> 	.wBootTimeout		resb	2	; Boot Menu selection timeout in system timer ticks
   157 00000048 ??                  <1> 	.bIdeCnt			resb	1	; Number of available IDE controllers
   158 00000049 ??                  <1> 	.bBootDrv			resb	1	; Default drive to boot from
   159 0000004A ??                  <1> 	.bMinFddCnt			resb	1	; Minimum number of Floppy Drives
   160 0000004B ??                  <1> 	.bStealSize			resb	1	; Number of 1kB blocks stolen from 640kB base RAM
   161 0000004C ??                  <1> 	.bIdleTimeout		resb	1	; Standby timer value
   162                              <1> 
   163 0000004D ??                  <1> 						alignb	2	; WORD align the IDEVARS structures
   164                              <1> 	.ideVarsBegin:
   165 0000004E <res 12h>           <1> 	.ideVars0			resb	IDEVARS_size
   166 00000060 <res 12h>           <1> 	.ideVars1			resb	IDEVARS_size
   167 00000072 <res 12h>           <1> 	.ideVars2			resb	IDEVARS_size
   168 00000084 <res 12h>           <1> 	.ideVars3			resb	IDEVARS_size
   169                              <1> 
   170                              <1> %ifdef MODULE_SERIAL
   171 00000096 <res 12h>           <1> 	.ideVarsSerialAuto	resb	IDEVARS_size
   172                              <1> %endif
   173                              <1> 
   174                              <1> 	.ideVarsEnd:
   175                              <1> endstruc
   176                              <1> 
   177                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   178                              <1> 	%if ROMVARS.ideVarsEnd & 0xff00 <> 0
   179                              <1> 		%error ".ideVars structures must fit within the first 256 bytes of the ROM image"
   180                              <1> 	%endif
   181                              <1> 	%if (ROMVARS.ideVarsEnd - ROMVARS.ideVarsBegin) = 0
   182                              <1> 		%error "there must be at least one .ideVars structure, it would be bizarre if this were not true, but it is assumed in the ah0h reset code."
   183                              <1> 	%endif
   184                              <1> %endif
   185                              <1> 
   186                              <1> NUMBER_OF_IDEVARS					EQU	((ROMVARS.ideVarsEnd - ROMVARS.ideVarsBegin) / IDEVARS_size)
   187                              <1> 
   188                              <1> ; Bit defines for ROMVARS.wFlags
   189                              <1> FLG_ROMVARS_FULLMODE					EQU	(1<<0)	; Full operating mode (steals base RAM, supports EBIOS etc.)
   190                              <1> FLG_ROMVARS_CLEAR_BDA_HD_COUNT			EQU	(1<<1)	; This flag has two purposes; * Removes the system BIOS "dummy" drive
   191                              <1> 													; so that Windows 9x protected mode drivers can be used with XUB drives.
   192                              <1> 													; * Some computers (Zenith Z-171 and Z-161) do not clear the BDA hard
   193                              <1> 													; drive count which causes it to increment on each warm boot.
   194                              <1> FLG_ROMVARS_SERIAL_SCANDETECT 			EQU	(1<<3)	; Scan COM ports at the end of drive detection.  Can also be invoked
   195                              <1> 													; by holding down the ALT key at the end of drive detection.
   196                              <1> 													; (Conveniently, this is 8, a fact we exploit when testing the bit)
   197                              <1> 
   198                              <1> ; Here in case the configuration needs to know functionality is present. Note! Changing the order/location of these flags
   199                              <1> ; also requires changes elsewhere as they are usually tested using byte-accesses for efficiency.
   200                              <1> FLG_ROMVARS_MODULE_MFM_COMPATIBILITY	EQU	(1<<4)
   201                              <1> FLG_ROMVARS_MODULE_POWER_MANAGEMENT		EQU	(1<<5)
   202                              <1> FLG_ROMVARS_MODULE_8BIT_IDE				EQU	(1<<6)
   203                              <1> FLG_ROMVARS_MODULE_8BIT_IDE_ADVANCED	EQU (1<<7)
   204                              <1> FLG_ROMVARS_MODULE_ADVANCED_ATA			EQU	(1<<8)
   205                              <1> FLG_ROMVARS_MODULE_BOOT_MENU			EQU	(1<<9)
   206                              <1> FLG_ROMVARS_MODULE_EBIOS				EQU	(1<<10)	; Currently unused
   207                              <1> FLG_ROMVARS_MODULE_HOTKEYS				EQU	(1<<11)
   208                              <1> FLG_ROMVARS_MODULE_IRQ					EQU	(1<<12)
   209                              <1> FLG_ROMVARS_MODULE_SERIAL				EQU (1<<13)
   210                              <1> FLG_ROMVARS_MODULE_SERIAL_FLOPPY		EQU (1<<14)	; Currently unused
   211                              <1> FLG_ROMVARS_MODULE_STRINGS_COMPRESSED	EQU (1<<15)	; Currently unused
   212                              <1> 
   213                              <1> 
   214                              <1> ; Boot Menu Display Modes (see Assembly Library Display.inc for standard modes)
   215                              <1> DEFAULT_TEXT_MODE		EQU	4
   216                              <1> 
   217                              <1> 
   218                              <1> %endif ; ROMVARS_INC
    56                                  	%include "RamVars.inc"			; For RAMVARS struct
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	RAMVARS struct containing BIOS variables stored in RAM.
