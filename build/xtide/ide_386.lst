    21                              <1> ; Section containing code
    22                              <1> SECTION .text
    23                              <1> 
    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Checks is floppy drive handler installed to interrupt vector 40h.
    26                              <1> ;
    27                              <1> ; FloppyDrive_IsInt40hInstalled
    28                              <1> ;	Parameters:
    29                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
    30                              <1> ;	Returns:
    31                              <1> ;		CF:		Set if INT 40h is installed
    32                              <1> ;				Cleared if INT 40h is not installed
    33                              <1> ;	Corrupts registers:
    34                              <1> ;		BX, CX, DI
    35                              <1> ;--------------------------------------------------------------------
    36                              <1> FloppyDrive_IsInt40hInstalled:
    37                              <1> %ifdef USE_AT
    38 00000569 06                  <1> 	push	es
    39 0000056A 52                  <1> 	push	dx
    40 0000056B 50                  <1> 	push	ax
    41                              <1> 
    42 0000056C E81D00              <1> 	call	LoadInt40hVerifyParameters
    43 0000056F CD13                <1> 	int		BIOS_DISK_INTERRUPT_13h
    44 00000571 7214                <1> 	jc		SHORT .Int40hIsInstalled	; Maybe there are not any floppy drives at all
    45 00000573 06                  <1> 	push	es							; Drive Parameter Table segment
    46 00000574 57                  <1> 	push	di							; Drive Parameter Table offset
    47                              <1> 
    48 00000575 E81400              <1> 	call	LoadInt40hVerifyParameters
    49 00000578 CD40                <1> 	int		BIOS_DISKETTE_INTERRUPT_40h
    50                              <1> 
    51 0000057A 5A                  <1> 	pop		dx
    52 0000057B 59                  <1> 	pop		cx
    53 0000057C 39FA                <1> 	cmp		dx, di						; Difference in offsets?
    54 0000057E 7506                <1> 	jne		SHORT .Int40hNotInstalled
    55 00000580 8CC2                <1> 	mov		dx, es
    56 00000582 39D1                <1> 	cmp		cx, dx						; Difference in segments?
    57 00000584 7401                <1> 	je		SHORT .Int40hIsInstalled
    58                              <1> .Int40hNotInstalled:
    59 00000586 F9                  <1> 	stc
    60                              <1> .Int40hIsInstalled:
    61 00000587 58                  <1> 	pop		ax
    62 00000588 5A                  <1> 	pop		dx
    63 00000589 07                  <1> 	pop		es
    64                              <1> 
    65                              <1> %else ; if XT build
    66                              <1> 	cmp		BYTE [es:BIOS_DISKETTE_INTERRUPT_40h*4+3], 0C0h	; Any ROM segment? (set CF if not)
    67                              <1> %endif ; USE_AT
    68 0000058A F5                  <1> 	cmc
    69 0000058B C3                  <1> 	ret
    70                              <1> 
    71                              <1> ;--------------------------------------------------------------------
    72                              <1> ; LoadInt40hVerifyParameters
    73                              <1> ;	Parameters:
    74                              <1> ;		Nothing
    75                              <1> ;	Returns:
    76                              <1> ;		AH:		08h (Get Drive Parameters)
    77                              <1> ;		DL:		00h (floppy drive)
    78                              <1> ;		ES:DI:	0:0h (to guard against BIOS bugs)
    79                              <1> ;	Corrupts registers:
    80                              <1> ;		DH
    81                              <1> ;--------------------------------------------------------------------
    82                              <1> %ifdef USE_AT
    83                              <1> LoadInt40hVerifyParameters:
    84 0000058C B408                <1> 	mov		ah, GET_DRIVE_PARAMETERS
    85 0000058E 99                  <1> 	cwd						; Floppy drive 0
    86 0000058F 89D7                <1> 	mov		di, dx
    87 00000591 8EC2                <1> 	mov		es, dx			; ES:DI = 0000:0000h to guard against BIOS bugs
    88 00000593 C3                  <1> 	ret
    89                              <1> %endif
    90                              <1> 
    91                              <1> 
    92                              <1> ;--------------------------------------------------------------------
    93                              <1> ; Returns floppy drive type.
    94                              <1> ; PC/XT system do not support AH=08h but FLOPPY_TYPE_525_OR_35_DD
    95                              <1> ; is still returned for them.
    96                              <1> ;
    97                              <1> ; FloppyDrive_GetType
    98                              <1> ;	Parameters:
    99                              <1> ;		DL:		Floppy Drive number
   100                              <1> ;	Returns:
   101                              <1> ;		BX:		Floppy Drive Type:
   102                              <1> ;					FLOPPY_TYPE_525_OR_35_DD
   103                              <1> ;					FLOPPY_TYPE_525_DD
   104                              <1> ;					FLOPPY_TYPE_525_HD
   105                              <1> ;					FLOPPY_TYPE_35_DD
   106                              <1> ;					FLOPPY_TYPE_35_HD
   107                              <1> ;					FLOPPY_TYPE_35_ED
   108                              <1> ;		CF:		Set if AH=08h not supported (XT systems) or error
   109                              <1> ;				Cleared if type read correctly (AT systems)
   110                              <1> ;	Corrupts registers:
   111                              <1> ;		AX, CX, DX, DI, ES
   112                              <1> ;--------------------------------------------------------------------
   113                              <1> %ifdef MODULE_BOOT_MENU
   114                              <1> FloppyDrive_GetType:
   115                              <1> 	mov		ah, GET_DRIVE_PARAMETERS
   116                              <1> 	xor		bx, bx			; FLOPPY_TYPE_525_OR_35_DD when function not supported
   117                              <1> 	int		BIOS_DISKETTE_INTERRUPT_40h
   118                              <1> 	ret
   119                              <1> %endif
   120                              <1> 
   121                              <1> 
   122                              <1> ;--------------------------------------------------------------------
   123                              <1> ; Returns number of Floppy Drives in system.
   124                              <1> ;
   125                              <1> ; FloppyDrive_GetCountToAX
   126                              <1> ;	Parameters:
   127                              <1> ;		DS:		RAMVARS Segment
   128                              <1> ;	Returns:
   129                              <1> ;		AX:		Number of Floppy Drives
   130                              <1> ;--------------------------------------------------------------------
   131                              <1> FloppyDrive_GetCountToAX:
   132                              <1> %ifdef MODULE_SERIAL_FLOPPY
   133 00000594 E899FF              <1> 	call	RamVars_UnpackFlopCntAndFirstToAL
   134 00000597 7804                <1> 	js		.UseBIOSorBDA				; We didn't add in any drives, counts here are not valid
   135                              <1> 
   136 00000599 1401                <1> 	adc		al, 1						; adds in the drive count bit, and adds 1 for count vs. 0-index,
   137 0000059B EB03                <1> 	jmp		.FinishCalc					; need to clear AH on the way out, and add in minimum drive numbers
   138                              <1> 
   139                              <1> .UseBIOSorBDA:
   140                              <1> %endif
   141 0000059D E80D00              <1> 	call	FloppyDrive_GetCountFromBIOS_or_BDA
   142                              <1> 
   143                              <1> .FinishCalc:
   144 000005A0 2E8A264A00          <1> 	mov		ah, [cs:ROMVARS.bMinFddCnt]
   145                              <1> 	MAX_U	al, ah
    48 000005A5 38E0                <2>  cmp %1, %2
    49 000005A7 7702                <2>  ja %%Return
    50 000005A9 88E0                <2>  mov %1, %2
    51                              <2> %%Return:
   146 000005AB 98                  <1> 	cbw
   147                              <1> 
   148 000005AC C3                  <1> 	ret
   149                              <1> 
   150                              <1> 
   151                              <1> ;--------------------------------------------------------------------
   152                              <1> ; FloppyDrive_GetCountFromBIOS_or_BDA
   153                              <1> ;	Parameters:
   154                              <1> ;		Nothing
   155                              <1> ;	Returns:
   156                              <1> ;		AL:		Number of Floppy Drives
   157                              <1> ;		CF:		Cleared if successful
   158                              <1> ;				Set if BIOS function not supported
   159                              <1> ;	Corrupts registers:
   160                              <1> ;		AH
   161                              <1> ;--------------------------------------------------------------------
   162                              <1> FloppyDrive_GetCountFromBIOS_or_BDA:
   163                              <1> %ifdef USE_AT
   164                              <1> ; Reads Floppy Drive Count from BIOS.
   165                              <1> ; Does not work on most XT systems. Call .GetCountFromBDA
   166                              <1> ; if this function fails.
   167                              <1> 
   168 000005AD 06                  <1> 	push	es
   169 000005AE 57                  <1> 	push	di
   170 000005AF 53                  <1> 	push	bx
   171 000005B0 51                  <1> 	push	cx
   172 000005B1 52                  <1> 	push	dx
   173                              <1> 
   174 000005B2 B408                <1> 	mov		ah, GET_DRIVE_PARAMETERS
   175 000005B4 99                  <1> 	cwd								; Floppy Drive 00h
   176 000005B5 CD40                <1> 	int		BIOS_DISKETTE_INTERRUPT_40h
   177 000005B7 92                  <1> 	xchg	ax, dx					; Number of Floppy Drives to AL
   178                              <1> 
   179 000005B8 5A                  <1> 	pop		dx
   180 000005B9 59                  <1> 	pop		cx
   181 000005BA 5B                  <1> 	pop		bx
   182 000005BB 5F                  <1> 	pop		di
   183 000005BC 07                  <1> 	pop		es
   184                              <1> 
   185                              <1> %else ; ifndef USE_AT
   186                              <1> ; Reads Floppy Drive Count (0...4) from BIOS Data Area.
   187                              <1> ; This function should be used only if .GetCountFromBIOS fails.
   188                              <1> 
   189                              <1> 	push	ds
   190                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax
   191                              <1> 	mov		al, [BDA.wEquipment]	; Load Equipment WORD low byte
   192                              <1> 	and		al, 0C1h				; Leave bits 7..6 and 0
   193                              <1> 	eAAM	64
   194                              <1> 	add		al, ah					; AL = Floppy Drive count
   195                              <1> 	pop		ds
   196                              <1> %endif ; USE_AT
   197                              <1> 
   198 000005BD C3                  <1> 	ret
   247                                  	%include "CreateDPT.asm"		; For creating DPTs
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Functions for creating Disk Parameter Table.
