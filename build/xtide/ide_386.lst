    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Detects all IDE hard disks to be controlled by this BIOS.
    25                              <1> ;
    26                              <1> ; DetectDrives_FromAllIDEControllers
    27                              <1> ;	Parameters:
    28                              <1> ;		DS:		RAMVARS segment
    29                              <1> ;		ES:		BDA segment (zero)
    30                              <1> ;	Returns:
    31                              <1> ;		Nothing
    32                              <1> ;	Corrupts registers:
    33                              <1> ;		All (not segments)
    34                              <1> ;--------------------------------------------------------------------
    35                              <1> DetectDrives_FromAllIDEControllers:
    36 000008A0 E895FC              <1> 	call	RamVars_GetIdeControllerCountToCX
    37 000008A3 BD4E00              <1> 	mov		bp, ROMVARS.ideVars0			; CS:BP now points to first IDEVARS
    38                              <1> 
    39                              <1> .DriveDetectLoop:							; Loop through IDEVARS
    40 000008A6 51                  <1> 	push	cx
    41                              <1> 
    42 000008A7 B9[A800]            <1> 	mov		cx, g_szDetectMaster
    43 000008AA B7A0                <1> 	mov		bh, MASK_DRVNHEAD_SET								; Select Master drive
    44 000008AC E8B500              <1> 	call	StartDetectionWithDriveSelectByteInBHandStringInCX	; Detect and create DPT + BOOTNFO
    45                              <1> 
    46 000008AF 2EF6460C80          <1> 	test	BYTE [cs:bp+IDEVARS.drvParamsSlave+DRVPARAMS.wFlags], FLG_DRVPARAMS_DO_NOT_DETECT
    47 000008B4 7508                <1> 	jnz		SHORT .SkipSlaveDetection
    48 000008B6 B9[AE00]            <1> 	mov		cx, g_szDetectSlave
    49 000008B9 B7B0                <1> 	mov		bh, MASK_DRVNHEAD_SET | FLG_DRVNHEAD_DRV
    50 000008BB E8A600              <1> 	call	StartDetectionWithDriveSelectByteInBHandStringInCX
    51                              <1> .SkipSlaveDetection:
    52                              <1> 
    53                              <1> %ifdef MODULE_HOTKEYS
    54                              <1> %ifdef MODULE_SERIAL
    55                              <1> 	; This is only needed for hotkey F6 (ComDtct) to work
    56 000008BE E85E03              <1> 	call	ScanHotkeysFromKeyBufferAndStoreToBootvars			; Done here while CX is still protected
    57                              <1> %endif
    58                              <1> %endif
    59                              <1> 
    60 000008C1 59                  <1> 	pop		cx
    61                              <1> 
    62 000008C2 83C512              <1> 	add		bp, BYTE IDEVARS_size			; Point to next IDEVARS
    63                              <1> 
    64                              <1> %ifdef MODULE_SERIAL
    65 000008C5 E31B                <1> 	jcxz	.AddHardDisks					; Set to zero on .ideVarsSerialAuto iteration (if any)
    66                              <1> %endif
    67 000008C7 E2DD                <1> 	loop	.DriveDetectLoop
    68                              <1> 
    69                              <1> %ifdef MODULE_SERIAL
    70                              <1> ;----------------------------------------------------------------------
    71                              <1> ;
    72                              <1> ; if serial drive detected, do not scan (avoids duplicate drives and isn't needed - we already have a connection)
    73                              <1> ;
    74 000008C9 E8F0FD              <1> 	call	FindDPT_ToDSDIforSerialDevice	; Does not modify AX
    75 000008CC 7314                <1> 	jnc		SHORT .AddHardDisks
    76                              <1> 
    77 000008CE BD9600              <1> 	mov		bp, ROMVARS.ideVarsSerialAuto	; Point to our special IDEVARS structure, just for serial scans
    78                              <1> 
    79                              <1> %ifdef MODULE_HOTKEYS
    80 000008D1 3C40                <1> 	cmp		al, COM_DETECT_HOTKEY_SCANCODE	; Set by last call to ScanHotkeysFromKeyBufferAndStoreToBootvars above
    81 000008D3 74D1                <1> 	je		SHORT .DriveDetectLoop
    82                              <1> %endif
    83                              <1> 
    84 000008D5 2EA04000            <1> 	mov		al, [cs:ROMVARS.wFlags]			; Configurator set to always scan?
    85 000008D9 260A061704          <1> 	or		al, [es:BDA.bKBFlgs1]			; Or, did the user hold down the ALT key?
    86 000008DE 2408                <1> 	and		al, 8							; 8 = alt key depressed, same as FLG_ROMVARS_SERIAL_SCANDETECT
    87 000008E0 75C4                <1> 	jnz		SHORT .DriveDetectLoop
    88                              <1> %endif ; MODULE_SERIAL
    89                              <1> 
    90                              <1> .AddHardDisks:
    91                              <1> ;----------------------------------------------------------------------
    92                              <1> ;
    93                              <1> ; Add in hard disks to BDA, finalize our Count and First variables
    94                              <1> ;
    95                              <1> ; Note that we perform the add to bHDCount and store bFirstDrv even if the count is zero.
    96                              <1> ; This is done because we use the value of .bFirstDrv to know how many drives were in the system
    97                              <1> ; at the time of boot, and to return that number on int13h/8h calls.  Because the count is zero,
    98                              <1> ; FindDPT_ForDriveNumber will not find any drives that are ours.
    99                              <1> ;
   100                              <1> 
   101                              <1> ; This is a hack to get Windows 9x to load its built-in protected mode IDE driver.
   102                              <1> ;
   103                              <1> ; The Windows hack has two parts. First part is to try to alter CMOS address 12h as that
   104                              <1> ; is what Windows 9x driver reads to detect IDE drives. Altering is not possible on all
   105                              <1> ; systems since CMOS has a checksum but its location is not standardized. We will first
   106                              <1> ; try to detect valid checksum. If it succeeds, then it is safe to assume this system
   107                              <1> ; has compatible CMOS and we can alter it.
   108                              <1> ; If verify fails, we do the more dirty hack to zero BDA drive count. Then Windows 9x works
   109                              <1> ; as long as user has configured at least one drive in the BIOS setup.
   110                              <1> %ifdef MODULE_WIN9X_CMOS_HACK
   111 000008E2 B212                <1> 	mov		dl, HARD_DISK_TYPES
   112 000008E4 E8B9FA              <1> 	call	CMOS_ReadFromIndexInDLtoAL
   113 000008E7 A8F0                <1> 	test	al, 0F0h
   114 000008E9 7528                <1> 	jnz		SHORT .ClearBdaDriveCount		; CMOS byte 12h is ready for Windows 9x
   115 000008EB E8C1FA              <1> 	call	CMOS_Verify10hTo2Dh				; Can we modify CMOS?
   116 000008EE 7523                <1> 	jnz		SHORT .ClearBdaDriveCount		; Unsupported BIOS, use plan B
   117                              <1> 
   118                              <1> 	; Now we can alter CMOS location 12h. Award BIOS locks if we set drive 0 type to Fh
   119                              <1> 	; (but accept changes to drive type 1). Windows 9x requires that the drive 0 type is
   120                              <1> 	; non zero and ignores drive 1 type. So if we only set drive 1, then Award BIOS
   121                              <1> 	; won't give problems but Windows 9x stays in MS-DOS compatibility mode.
   122                              <1> 	;
   123                              <1> 	; For Award BIOSes we could set the Drive 0 type to 1 and then clear the BDA drive count.
   124                              <1> 	; So essentially we could automatically do what user needs to do manually to get Windows 9x
   125                              <1> 	; working on Award BIOSes. However, I think that should be left to do manually since
   126                              <1> 	; there may be SCSI drives on the system or FLG_ROMVARS_CLEAR_BDA_HD_COUNT could
   127                              <1> 	; be intentionally cleared and forcing the dummy drive might cause only trouble.
   128                              <1> 
   129                              <1> 	; Try to detect Award BIOS (Seems to work on a tested 128k BIOS so hopefully
   130                              <1> 	; there will be no need to scan E000h segment)
   131 000008F0 B9FCFF              <1> 	mov		cx, 65536 - 4
   132 000008F3 66B841776172        <1> 	mov		eax, 'Awar'						; Four characters should be enough
   133 000008F9 BF00F0              <1> 	mov		di, 0F000h						; Scan 64k starting from segment F000h
   134 000008FC 8EE7                <1> 	mov		fs, di							; No need to preserve FS since we set it to zero soon when we boot
   135 000008FE 31FF                <1> 	xor		di, di
   136                              <1> .ScanNextCharacters:
   137 00000900 64663905            <1> 	cmp		[fs:di], eax
   138 00000904 740D                <1> 	je		SHORT .ClearBdaDriveCount		; Award detected, cannot modify CMOS
   139 00000906 47                  <1> 	inc		di								; Increment offset by one character (not four)
   140 00000907 E2F7                <1> 	loop	.ScanNextCharacters
   141                              <1> 
   142                              <1> 	; Now it should be safe to write
   143 00000909 B212                <1> 	mov		dl, HARD_DISK_TYPES
   144 0000090B B0F0                <1> 	mov		al, 0F0h						; Drive 0 type 16...47 (supposed to be defined elsewhere in the CMOS)
   145 0000090D E887FA              <1> 	call	CMOS_WriteALtoIndexInDL
   146 00000910 E8AFFA              <1> 	call	CMOS_StoreNewChecksumFor10hto2Dh
   147                              <1> .ClearBdaDriveCount:
   148                              <1> %endif ; MODULE_WIN9X_CMOS_HACK
   149                              <1> 
   150 00000913 8B0E0B00            <1> 	mov		cx, [RAMVARS.wDrvCntAndFlopCnt]	; Our count of hard disks
   151 00000917 26A07504            <1> 	mov		al, [es:BDA.bHDCount]
   152                              <1> %ifndef MODULE_MFM_COMPATIBILITY
   153                              <1> 	; This is excluded when MODULE_MFM_COMPATIBILITY is included because it doesn't make sense to use both at the same time.
   154 0000091B 2EF606400002        <1> 	test	BYTE [cs:ROMVARS.wFlags], FLG_ROMVARS_CLEAR_BDA_HD_COUNT	; Clears CF
   155 00000921 7401                <1> 	jz		SHORT .ContinueInitialization
   156                              <1> %ifdef USE_UNDOC_INTEL
   157 00000923 D6                  <1> 	salc
   158                              <1> %else
   159                              <1> 	xor		al, al
   160                              <1> %endif
   161                              <1> .ContinueInitialization:
   162                              <1> %endif ; MODULE_MFM_COMPATIBILITY
   163 00000924 00C1                <1> 	add		cl, al
   164 00000926 26880E7504          <1> 	mov		[es:BDA.bHDCount], cl			; Update the system count
   165 0000092B 0C80                <1> 	or		al, 80h							; Or in hard disk flag
   166 0000092D A20A00              <1> 	mov		[RAMVARS.bFirstDrv], al			; Store first drive number
   167                              <1> 
   168                              <1> .AddFloppies:
   169                              <1> %ifdef MODULE_SERIAL_FLOPPY
   170                              <1> ;----------------------------------------------------------------------
   171                              <1> ;
   172                              <1> ; Add in any emulated serial floppy drives, finalize our packed Count and First variables
   173                              <1> ;
   174 00000930 FECD                <1> 	dec		ch
   175 00000932 88E8                <1> 	mov		al, ch
   176 00000934 782A                <1> 	js		SHORT .NoFloppies				; If no drives are present, we store 0FFh
   177                              <1> 
   178 00000936 E874FC              <1> 	call	FloppyDrive_GetCountFromBIOS_or_BDA
   179                              <1> 
   180 00000939 50                  <1> 	push	ax
   181                              <1> 
   182 0000093A 00E8                <1> 	add		al, ch							; Add our drives to existing drive count
   183 0000093C 3C03                <1> 	cmp		al, 3							; For BDA, max out at 4 drives (ours is zero based)
   184 0000093E 7202                <1> 	jb		SHORT .MaxBDAFloppiesExceeded
   185 00000940 B003                <1> 	mov		al, 3
   186                              <1> .MaxBDAFloppiesExceeded:
   187                              <1> 	eROR_IM	al, 2							; move to bits 6-7
   680                              <2>  eSHIFT_IM %1, %2, ror
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 00000942 C0C802              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   188 00000945 40                  <1> 	inc		ax								; low order bit, indicating floppy drive exists
   189                              <1> 
   190 00000946 B43E                <1> 	mov		ah, 3Eh							; AND mask to AH (all bits set except floppy drive count/present)
   191 00000948 2622261004          <1> 	and		ah, [es:BDA.wEquipment]			; Load Equipment WORD low byte and mask off drive number and drives present bit
   192 0000094D 08E0                <1> 	or		al, ah							; Or in new values
   193 0000094F 26A21004            <1> 	mov		[es:BDA.wEquipment], al			; and store
   194                              <1> 
   195 00000953 B01E                <1> 	mov		al, 1Eh							; BDA pointer to Floppy DPT
   196 00000955 BE[2F1A]            <1> 	mov		si, AH8h_FloppyDPT
   197 00000958 E845FB              <1> 	call	Interrupts_InstallHandlerToVectorInALFromCSSI
   198                              <1> 
   199 0000095B 58                  <1> 	pop		ax
   200                              <1> 
   201 0000095C D0ED                <1> 	shr		ch, 1							; number of drives, 1 or 2 only, to CF flag (clear=1, set=2)
   202                              <1> 	eRCL_IM	al, 1							; starting drive number in upper 7 bits, number of drives in low bit
   692                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   693                              <2> %ifdef USE_386
   694                              <2>  %if %2 = 1
   695                              <2>  FSIS ], %1
   696                              <2>  %if strpos
   697                              <2>  eSHIFT_IM %1, %2, rcl
   698                              <2>  %else
   699 0000095E 10C0                <2>  adc %1, %1
   700                              <2>  %endif
   701                              <2>  %else
   702                              <2>  eSHIFT_IM %1, %2, rcl
   703                              <2>  %endif
   704                              <2> %else
   705                              <2>  eSHIFT_IM %1, %2, rcl
   706                              <2> %endif
   707                              <2> %endif
   203                              <1> .NoFloppies:
   204 00000960 A20C00              <1> 	mov		[RAMVARS.xlateVars+XLATEVARS.bFlopCntAndFirst], al
   205                              <1> %endif
   206 00000963 C3                  <1> 	ret
   207                              <1> 
   208                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   209                              <1> 	%if FLG_ROMVARS_SERIAL_SCANDETECT != 8
   210                              <1> 		%error "DetectDrives is currently coded to assume that FLG_ROMVARS_SERIAL_SCANDETECT is the same bit as the ALT key code in the BDA.  Changes in the code will be needed if these values are no longer the same."
   211                              <1> 	%endif
   212                              <1> %endif
