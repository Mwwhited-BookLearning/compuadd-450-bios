   178                              <2>  %ifnidni %1, dl
   179 000011FC B203                <2>  mov dl, %1
   180                              <2>  %endif
   181                              <2>  %endif
   182 000011FE E85903              <2>  call IdeIO_InputToALfromIdeRegisterInDL
   183                              <2> 
   184                              <2> %endif
   330 00001201 C3                  <1> 	ret
   331                              <1> %else
