   162                              <1> ; RamVars_GetCountOfKnownDrivesToAX
   163                              <1> ;	Parameters:
   164                              <1> ;		DS:		RAMVARS segment
   165                              <1> ;	Returns:
   166                              <1> ;		AX:		Total hard disk count
   167                              <1> ;	Corrupts registers:
   168                              <1> ;		None
   169                              <1> ;--------------------------------------------------------------------
   170 0000053F 90                  <1> ALIGN JUMP_ALIGN
   171                              <1> RamVars_GetCountOfKnownDrivesToAX:
   172 00000540 A10A00              <1> 	mov		ax, [RAMVARS.wFirstDrvAndCount]
   173 00000543 00E0                <1> 	add		al, ah
   174 00000545 83E07F              <1> 	and		ax, BYTE 7Fh
   175 00000548 C3                  <1> 	ret
