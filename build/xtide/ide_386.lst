   142                              <1> ;--------------------------------------------------------------------
   143                              <1> ; 8-bit PIO from a single data port.
   144                              <1> ;
   145                              <1> ; IdePioBlock_ReadFrom8bitDataPort
   146                              <1> ;	Parameters:
   147                              <1> ;		CX:		Block size in 512 byte sectors
   148                              <1> ;		DX:		IDE Data port address
   149                              <1> ;		ES:DI:	Normalized ptr to buffer to receive data
   150                              <1> ;	Returns:
   151                              <1> ;		Nothing
   152                              <1> ;	Corrupts registers:
   153                              <1> ;		AX, CX
   154                              <1> ;--------------------------------------------------------------------
