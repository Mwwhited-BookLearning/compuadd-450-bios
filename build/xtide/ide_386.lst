    26                              <1> ; CompatibleDPT_CreateToAXSIforDriveDL
    27                              <1> ;	Parameters:
    28                              <1> ;		DL:		Drive number (80h or 81h)
    29                              <1> ;		DS:DI:	Ptr to DPT
    30                              <1> ;	Returns:
    31                              <1> ;		AX:SI	Ptr to destination buffer
    32                              <1> ;	Corrupts registers:
    33                              <1> ;		CX, DX
    34                              <1> ;--------------------------------------------------------------------
    35                              <1> CompatibleDPT_CreateToAXSIforDriveDL:
    36 00000A16 06                  <1> 	push	es
    37                              <1> 
    38 00000A17 E8D6FC              <1> 	call	AccessDPT_GetDeviceControlByteToAL
    39 00000A1A 91                  <1> 	xchg	cx, ax							; Device control byte to CL
    40 00000A1B 89FE                <1> 	mov		si, di							; DPT now in DS:SI
    41 00000A1D E81700              <1> 	call	GetBufferForDrive80hToESDI
    42 00000A20 D1EA                <1> 	shr		dx, 1
    43 00000A22 7303                <1> 	jnc		SHORT .BufferLoadedToESDI
    44 00000A24 83C710              <1> 	add		di, BYTE TRANSLATED_DPT_size	; For drive 81h
    45                              <1> .BufferLoadedToESDI:
    46                              <1> 
    47 00000A27 E81A00              <1> 	call	FillToESDIusingDPTfromDSSI
    48 00000A2A 87F7                <1> 	xchg	di, si
    49 00000A2C 8CC0                <1> 	mov		ax, es
    50                              <1> 
    51 00000A2E 07                  <1> 	pop		es
    52 00000A2F C3                  <1> 	ret
    53                              <1> 
