   123                              <2> ;--------------------------------------------------------------------
   124                              <2> ; Memory_ReserveCLbytesFromStackToDSSI
   125                              <2> ; Memory_ReserveCXbytesFromStackToDSSI
   126                              <2> ;	Parameters
   127                              <2> ;		CL/CX:	Number of bytes to reserve
   128                              <2> ;	Returns:
   129                              <2> ;		DS:SI:	Ptr to reserved buffer
   130                              <2> ;	Corrupts registers:
   131                              <2> ;		AX
   132                              <2> ;--------------------------------------------------------------------
   133                              <2> %ifndef EXCLUDE_FROM_XUB
   134                              <2> ALIGN JUMP_ALIGN
   135                              <2> Memory_ReserveCLbytesFromStackToDSSI:
   136                              <2> 	xor		ch, ch
   137                              <2> Memory_ReserveCXbytesFromStackToDSSI:
   138                              <2> 	pop		ax
   139                              <2> 	push	ss
   140                              <2> 	pop		ds
   141                              <2> 	sub		sp, cx
   142                              <2> 	mov		si, sp
   143                              <2> 	jmp		ax
   144                              <2> %endif
   145                              <2> 
   146                              <2> 
   147                              <2> ;--------------------------------------------------------------------
   148                              <2> ; Memory_SumCXbytesFromESSItoAL
   149                              <2> ;	Parameters
   150                              <2> ;		CX:		Number of bytes to sum (0=65536)
   151                              <2> ;		ES:SI:	Ptr to buffer containing the bytes to sum
   152                              <2> ;	Returns:
   153                              <2> ;		AL:		Sum of bytes
   154                              <2> ;		ZF:		Set if result is zero
   155                              <2> ;				Cleared if result is non-zero
   156                              <2> ;	Corrupts registers:
   157                              <2> ;		CX
   158                              <2> ;--------------------------------------------------------------------
   159                              <2> %ifndef EXCLUDE_FROM_XTIDECFG OR NO_ATAID_VALIDATION
   160                              <2> ALIGN JUMP_ALIGN
   161                              <2> Memory_SumCXbytesFromESSItoAL:
   162                              <2> 	add		si, cx
   163                              <2> 	xor		al, al
   164                              <2> ALIGN JUMP_ALIGN
   165                              <2> .AddNextByteToAL:
   166                              <2> 	dec		si
   167                              <2> 	add		al, [es:si]
   168                              <2> 	loop	.AddNextByteToAL
   169                              <2> 	ret
   170                              <2> %endif
