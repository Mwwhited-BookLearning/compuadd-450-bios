    24                              <1> ; Int 13h function AH=47h, Extended Seek.
    25                              <1> ;
    26                              <1> ; AH47h_HandlerForExtendedSeek
    27                              <1> ;	Parameters:
    28                              <1> ;		SI:		Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		DS:SI:	Ptr to Disk Address Packet
    34                              <1> ;	Returns with INTPACK:
    35                              <1> ;		AH:		Int 13h return status
    36                              <1> ;		CF:		0 if successful, 1 if error
    37                              <1> ;--------------------------------------------------------------------
    38 00001CC2 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    39                              <1> AH47h_HandlerForExtendedSeek:
    40                              <1> 	; Note that there is no Seek command for LBA48 addressing!
    41 00001CC4 8E460E              <1> 	mov		es, [bp+IDEPACK.intpack+INTPACK.ds]	; ES:SI to point Disk Address Packet
    42 00001CC7 26803C10            <1> 	cmp		BYTE [es:si+DAP.bSize], MINIMUM_DAP_SIZE
    43 00001CCB 7290                <1> 	jb		SHORT Prepare_ReturnFromInt13hWithInvalidFunctionError
    44                              <1> 
    45 00001CCD B470                <1> 	mov		ah, COMMAND_SEEK
    46 00001CCF BB40FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRDY)
    47                              <1> %ifdef USE_186
    48 00001CD2 68[8018]            <1> 	push	Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    49 00001CD5 E914F1              <1> 	jmp		Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    50                              <1> %else
    51                              <1> 	call	Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    52                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    53                              <1> %endif
   345                                  	%include "AH48h_GetExtendedDriveParameters.asm"
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Int 13h function AH=48h, Get Extended Drive Parameters.
     3                              <1> 
     4                              <1> ;
     5                              <1> ; XTIDE Universal BIOS and Associated Tools
     6                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2025 by XTIDE Universal BIOS Team.
     7                              <1> ;
     8                              <1> ; This program is free software; you can redistribute it and/or modify
     9                              <1> ; it under the terms of the GNU General Public License as published by
    10                              <1> ; the Free Software Foundation; either version 2 of the License, or
    11                              <1> ; (at your option) any later version.
    12                              <1> ;
    13                              <1> ; This program is distributed in the hope that it will be useful,
    14                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                              <1> ; GNU General Public License for more details.
    17                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    18                              <1> ;
    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=48h, Get Extended Drive Parameters.
    25                              <1> ;
    26                              <1> ; It is not completely clear what this function should return as total sector count in some cases.
    27                              <1> ; What is certain is that:
    28                              <1> ; A) Phoenix Enhanced Disk Drive Specification v3.0 says that P-CHS values
    29                              <1> ;    are never returned for drives with more than 15,482,880 sectors (16384*15*63).
    30                              <1> ;    For those drives we can simply return total sector count from
    31                              <1> ;    ATA ID WORDs 60 and 61 (LBA28) or WORDs 100-103 (LBA48).
    32                              <1> ; B) IBM PC DOS 7.1 fdisk32 displays warning message if P-CHS values multiplied
    33                              <1> ;    together are different than total sector count. Therefore for drives with less
    34                              <1> ;    than or equal 15,482,880 sectors we MUST NOT return total sector count from
    35                              <1> ;    ATA ID WORDs 60 and 61.
    36                              <1> ;
    37                              <1> ;    Lets take an example. 6 GB Hitachi microdrive reports following values in ATA ID:
    38                              <1> ;    Sector count from WORDs 60 and 61	: 12,000,556
    39                              <1> ;    Cylinders							: 11905
    40                              <1> ;    Heads								:    16
    41                              <1> ;    Sectors per track					:    63
    42                              <1> ;
    43                              <1> ;    When multiplying C*H*S we get		: 12,000,240
    44                              <1> ;    So the CHS size is a little bit less than LBA size. But we must use
    45                              <1> ;    the smaller value since C*H*S must equal total sector count!
    46                              <1> ;
    47                              <1> ; Now we get to the uncertain area where I could not find any information.
    48                              <1> ; Award BIOS from 1997 Pentium motherboard returns following values:
    49                              <1> ;    AH=08h L-CHS:   745, 255, 63 (exactly the same as what we return)
    50                              <1> ;    => Total Sector Count:		  745*255*63 = 11,968,425
    51                              <1> ;    AH=48h P-CHS: 11873,  16, 63
    52                              <1> ;    AH=48h Total Sector Count: 11873* 16*63 = 11,967,984
    53                              <1> ;
    54                              <1> ; Notice how AH=48h returns lesser total sector count than AH=08h! The only
    55                              <1> ; way I could think of to get 11873 cylinders is to divide AH=08h sector
    56                              <1> ; count with P-CHS heads and sectors: (745*255*63) / (16*63) = 11873
    57                              <1> ;
    58                              <1> ; The only reason I can think of is that the Award BIOS has a bug and
    59                              <1> ; uses L-CHS when it should use P-CHS values in the calculation.
    60                              <1> ;
    61                              <1> ;
    62                              <1> ; AH48h_GetExtendedDriveParameters
    63                              <1> ;	Parameters:
    64                              <1> ;		SI:		Same as in INTPACK
    65                              <1> ;		DL:		Translated Drive number
    66                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    67                              <1> ;		SS:BP:	Ptr to IDEPACK
    68                              <1> ;	Parameters on INTPACK:
    69                              <1> ;		DS:SI:	Ptr to Extended Drive Information Table to fill
    70                              <1> ;	Returns with INTPACK:
    71                              <1> ;		AH:		Int 13h return status
    72                              <1> ;		DS:SI:	Ptr to Extended Drive Information Table
    73                              <1> ;		CF:		0 if successful, 1 if error
    74                              <1> ;--------------------------------------------------------------------
    75                              <1> AH48h_HandlerForGetExtendedDriveParameters:
    76 00001CD8 1E                  <1> 	push	ds
    77 00001CD9 07                  <1> 	pop		es		; ES = RAMVARS segment
    78 00001CDA 89FE                <1> 	mov		si, di
    79 00001CDC 31DB                <1> 	xor		bx, bx
    80 00001CDE 4B                  <1> 	dec		bx		; Set to FFFFh to assume we do not return DPTE
    81                              <1> 
    82                              <1> 	; Create DPTE (hardware information for device drivers)
    83                              <1> %ifdef MODULE_COMPATIBLE_TABLES
    84 00001CDF E89F00              <1> 	call	AH41h_GetSupportBitsToCX
    85 00001CE2 F6C104              <1> 	test	cl, ENHANCED_DISK_DRIVE_SUPPORT
    86 00001CE5 7403                <1> 	jz		SHORT .DoNotCreateDPTE
    87 00001CE7 E8B3ED              <1> 	call	CompatibleDPT_CreateDeviceParameterTableExtensionToESBXfromDPTinDSSI
    88                              <1> .DoNotCreateDPTE:
    89                              <1> %endif ; MODULE_COMPATIBLE_TABLES
    90                              <1> 
    91                              <1> 	; Point DS:DI to Extended Drive Information Table to fill
    92 00001CEA 8B7E12              <1> 	mov		di, [bp+IDEPACK.intpack+INTPACK.si]
    93 00001CED 8E5E0E              <1> 	mov		ds, [bp+IDEPACK.intpack+INTPACK.ds]
    94                              <1> 
    95                              <1> 	; Check and adjust Extended Drive Information Table size
    96                              <1> 	; to MINIMUM_EDRIVEINFO_SIZE or EDRIVEINFO_SIZE_WITH_DPTE
    97 00001CF0 B81A00              <1> 	mov		ax, MINIMUM_EDRIVEINFO_SIZE
    98 00001CF3 8B0D                <1> 	mov		cx, [di+EDRIVE_INFO.wSize]
    99 00001CF5 39C1                <1> 	cmp		cx, ax
   100 00001CF7 0F8262FF            <1> 	jb		Prepare_ReturnFromInt13hWithInvalidFunctionError
   101 00001CFB 8905                <1> 	mov		[di+EDRIVE_INFO.wSize], ax
   102 00001CFD B01E                <1> 	mov		al, EDRIVEINFO_SIZE_WITH_DPTE
   103 00001CFF 39C1                <1> 	cmp		cx, ax
   104 00001D01 720F                <1> 	jb		SHORT .SkipEddConfigurationParameters
   105 00001D03 8805                <1> 	mov		[di+EDRIVE_INFO.wSize], al
   106                              <1> 
   107                              <1> 	; Store DPTE for standard controllers only,
   108                              <1> 	; FFFF:FFFF for non standard controllers
   109                              <1> %ifdef MODULE_COMPATIBLE_TABLES
   110 00001D05 895D1A              <1> 	mov		[di+EDRIVE_INFO.fpDPTE], bx
   111 00001D08 8C451C              <1> 	mov		[di+EDRIVE_INFO.fpDPTE+2], es
   112 00001D0B 43                  <1> 	inc		bx
   113 00001D0C 7504                <1> 	jnz		SHORT .SkipEddConfigurationParameters	; Already stored
   114 00001D0E 4B                  <1> 	dec		bx
   115 00001D0F 895D1C              <1> 	mov		[di+EDRIVE_INFO.fpDPTE+2], bx	; Segment = FFFFh
   116                              <1> %else
   117                              <1> 	mov		[di+EDRIVE_INFO.fpDPTE], bx
   118                              <1> 	mov		[di+EDRIVE_INFO.fpDPTE+2], bx
   119                              <1> %endif ; MODULE_COMPATIBLE_TABLES
   120                              <1> 
   121                              <1> 	; Fill Extended Drive Information Table in DS:DI from DPT in ES:SI
   122                              <1> .SkipEddConfigurationParameters:
   123 00001D12 C745020100          <1> 	mov		WORD [di+EDRIVE_INFO.wFlags], FLG_DMA_BOUNDARY_ERRORS_HANDLED_BY_BIOS
   124                              <1> 
   125                              <1> 	; Store total sector count
   126 00001D17 E842E6              <1> 	call	Registers_ExchangeDSSIwithESDI
   127 00001D1A E8E3E9              <1> 	call	AccessDPT_GetLbaSectorCountToBXDXAX
   128 00001D1D E83CE6              <1> 	call	Registers_ExchangeDSSIwithESDI
   129 00001D20 894510              <1> 	mov		[di+EDRIVE_INFO.qwTotalSectors], ax
   130 00001D23 895512              <1> 	mov		[di+EDRIVE_INFO.qwTotalSectors+2], dx
   131 00001D26 895D14              <1> 	mov		[di+EDRIVE_INFO.qwTotalSectors+4], bx
   132 00001D29 31C9                <1> 	xor		cx, cx
   133 00001D2B 894D16              <1> 	mov		[di+EDRIVE_INFO.qwTotalSectors+6], cx	; Always zero
   134 00001D2E C745180002          <1> 	mov		WORD [di+EDRIVE_INFO.wSectorSize], 512
   135                              <1> 
   136                              <1> 	; Store P-CHS. Based on phoenix specification this is returned only if
   137                              <1> 	; total sector count is 15,482,880 or less.
   138 00001D33 2D0140              <1> 	sub		ax, (MAX_SECTOR_COUNT_TO_RETURN_PCHS+1) & 0FFFFh
   139 00001D36 81DAEC00            <1> 	sbb		dx, (MAX_SECTOR_COUNT_TO_RETURN_PCHS+1) >> 16
   140 00001D3A 19CB                <1> 	sbb		bx, cx		; Zero
   141 00001D3C 7304                <1> 	jnc		SHORT .DoNotSetChsFlag
   142 00001D3E 804D0202            <1> 	or		BYTE [di+EDRIVE_INFO.wFlags], FLG_CHS_INFORMATION_IS_VALID
   143                              <1> 
   144                              <1> 	; We store something to P-CHS anyway since some HW detection programs
   145                              <1> 	; ignore the CHS flag. And we should at least clear the variables anyway
   146                              <1> 	; since the same buffer is used for all drives so it contains parameters
   147                              <1> 	; from previously scanned drive.
   148                              <1> .DoNotSetChsFlag:
   149                              <1> %ifdef USE_386
   150 00001D42 6650                <1> 	push	eax			; Save the high WORD of EAX
   151                              <1> 
   152 00001D44 26660FB6440A        <1> 	movzx	eax, BYTE [es:si+DPT.bPchsHeads]
   153 00001D4A 66894508            <1> 	mov		[di+EDRIVE_INFO.dwHeads], eax
   154                              <1> 
   155 00001D4E 268A440B            <1> 	mov		al, [es:si+DPT.bPchsSectorsPerTrack]
   156 00001D52 6689450C            <1> 	mov		[di+EDRIVE_INFO.dwSectorsPerTrack], eax
   157                              <1> 
   158 00001D56 268B440C            <1> 	mov		ax, [es:si+DPT.wPchsCylinders]
   159 00001D5A 66894504            <1> 	mov		[di+EDRIVE_INFO.dwCylinders], eax
   160                              <1> 
   161 00001D5E 6658                <1> 	pop		eax			; Restore the high WORD of EAX
   162                              <1> %else
   163                              <1> 	eMOVZX	dx, BYTE [es:si+DPT.bPchsHeads]
   164                              <1> 	mov		[di+EDRIVE_INFO.dwHeads], dx
   165                              <1> 	mov		[di+EDRIVE_INFO.dwHeads+2], cx
   166                              <1> 
   167                              <1> 	mov		dl, [es:si+DPT.bPchsSectorsPerTrack]
   168                              <1> 	mov		[di+EDRIVE_INFO.dwSectorsPerTrack], dx
   169                              <1> 	mov		[di+EDRIVE_INFO.dwSectorsPerTrack+2], cx
   170                              <1> 
   171                              <1> 	mov		dx, [es:si+DPT.wPchsCylinders]
   172                              <1> 	mov		[di+EDRIVE_INFO.dwCylinders], dx
   173                              <1> 	mov		[di+EDRIVE_INFO.dwCylinders+2], cx
   174                              <1> %endif
   175 00001D60 91                  <1> 	xchg	ax, cx		; Success
   176 00001D61 E91CFB              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
   346                                  	%include "AH41h_CheckIfExtensionsPresent.asm"
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Int 13h function AH=41h, Check if Extensions Present.
     3                              <1> 
     4                              <1> ;
     5                              <1> ; XTIDE Universal BIOS and Associated Tools
     6                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
