    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Vision_DetectAndReturnIDinAXandPortInDXifControllerPresent
    26                              <1> ;	Parameters:
    27                              <1> ;		Nothing
    28                              <1> ;	Returns:
    29                              <1> ;		AX:		ID WORD specific for QDI Vision Controllers
    30                              <1> ;				(AL = QD65xx Config Register contents)
    31                              <1> ;				(AH = QDI Vision Controller ID)
    32                              <1> ;		DX:		Controller port (not IDE port)
    33                              <1> ;		ZF:		Set if controller found
    34                              <1> ;				Cleared if supported controller not found (AX,DX = undefined)
    35                              <1> ;	Corrupts registers:
    36                              <1> ;		Nothing
    37                              <1> ;--------------------------------------------------------------------
    38                              <1> Vision_DetectAndReturnIDinAXandPortInDXifControllerPresent:
    39                              <1> 	; Check QD65xx base port
    40 00000F69 BA3000              <1> 	mov		dx, QD65XX_BASE_PORT
    41 00000F6C E431                <1> 	in		al, QD65XX_BASE_PORT + QD65XX_CONFIG_REGISTER_in
    42                              <1> 
    43 00000F6E E80600              <1> 	call	IsConfigRegisterWithIDinAL
    44 00000F71 7414                <1> 	je		SHORT VisionControllerDetected.Return
    45                              <1> 
    46                              <1> 	; Check QD65xx alternative base port
    47 00000F73 B2B0                <1> 	mov		dl, QD65XX_ALTERNATIVE_BASE_PORT
    48 00000F75 E4B1                <1> 	in		al, QD65XX_ALTERNATIVE_BASE_PORT + QD65XX_CONFIG_REGISTER_in
    49                              <1> 	; Fall to IsConfigRegisterWithIDinAL
    50                              <1> 
    51                              <1> ;--------------------------------------------------------------------
    52                              <1> ; IsConfigRegisterWithIDinAL
    53                              <1> ;	Parameters:
    54                              <1> ;		AL:		Possible QD65xx Config Register contents
    55                              <1> ;	Returns:
    56                              <1> ;		AH		QDI Vision Controller ID or undefined
    57                              <1> ;		ZF:		Set if controller found
    58                              <1> ;				Cleared if supported controller not found (AH = undefined)
    59                              <1> ;	Corrupts registers:
    60                              <1> ;		Nothing
    61                              <1> ;--------------------------------------------------------------------
    62                              <1> IsConfigRegisterWithIDinAL:
    63 00000F77 88C4                <1> 	mov		ah, al
    64 00000F79 24F0                <1> 	and		al, MASK_QDCONFIG_CONTROLLER_ID
    65 00000F7B 3CC0                <1> 	cmp		al, ID_QD6500
    66 00000F7D 7406                <1> 	je		SHORT VisionControllerDetected
    67 00000F7F 3CA0                <1> 	cmp		al, ID_QD6580
    68 00000F81 7402                <1> 	je		SHORT VisionControllerDetected
    69 00000F83 3C50                <1> 	cmp		al, ID_QD6580_ALTERNATE
    70                              <1> VisionControllerDetected:
    71 00000F85 86C4                <1> 	xchg	ah, al
    72                              <1> .Return:
    73 00000F87 C3                  <1> 	ret
    74                              <1> 
    75                              <1> 
    76                              <1> ;--------------------------------------------------------------------
    77                              <1> ; Vision_DoesIdePortInBXbelongToControllerWithIDinAX
    78                              <1> ;	Parameters:
    79                              <1> ;		AL:		QD65xx Config Register contents
    80                              <1> ;		AH:		QDI Vision Controller ID
    81                              <1> ;		BX:		IDE Base port to check
    82                              <1> ;		DX:		Vision Controller port
    83                              <1> ;	Returns:
    84                              <1> ;		ZF:		Set if port belongs to controller
    85                              <1> ;				Cleared if port belongs to another controller
    86                              <1> ;	Corrupts registers:
    87                              <1> ;		Nothing
    88                              <1> ;--------------------------------------------------------------------
    89                              <1> Vision_DoesIdePortInBXbelongToControllerWithIDinAX:
    90 00000F88 80FCC0              <1> 	cmp		ah, ID_QD6500
    91 00000F8B 7413                <1> 	je		SHORT .DoesIdePortInDXbelongToQD6500
    92                              <1> 
    93                              <1> 	; QD6580 always have Primary IDE at 1F0h
    94                              <1> 	; Secondary IDE at 170h can be enabled or disabled
    95 00000F8D 81FBF001            <1> 	cmp		bx, DEVICE_ATA_PRIMARY_PORT
    96 00000F91 741A                <1> 	je		SHORT .ReturnResultInZF
    97                              <1> 
    98                              <1> 	; Check if Secondary IDE channel is enabled
    99 00000F93 50                  <1> 	push	ax
   100 00000F94 52                  <1> 	push	dx
   101 00000F95 83C203              <1> 	add		dx, BYTE QD6580_CONTROL_REGISTER
   102 00000F98 EC                  <1> 	in		al, dx
   103 00000F99 A801                <1> 	test	al, FLG_QDCONTROL_SECONDARY_DISABLED_in
   104 00000F9B 5A                  <1> 	pop		dx
   105 00000F9C 58                  <1> 	pop		ax
   106 00000F9D 740A                <1> 	jz		SHORT .CompareBXtoSecondaryIDE
   107 00000F9F C3                  <1> 	ret
   108                              <1> 
   109                              <1> 	; QD6500 has only one IDE channel that can be at 1F0h or 170h
   110                              <1> .DoesIdePortInDXbelongToQD6500:
   111 00000FA0 A801                <1> 	test	al, FLG_QDCONFIG_PRIMARY_IDE
   112 00000FA2 7405                <1> 	jz		SHORT .CompareBXtoSecondaryIDE
   113 00000FA4 81FBF001            <1> 	cmp		bx, DEVICE_ATA_PRIMARY_PORT
   114 00000FA8 C3                  <1> 	ret
   115                              <1> 
   116                              <1> .CompareBXtoSecondaryIDE:
   117 00000FA9 81FB7001            <1> 	cmp		bx, DEVICE_ATA_SECONDARY_PORT
   118                              <1> .ReturnResultInZF:
   119 00000FAD C3                  <1> 	ret
   120                              <1> 
   121                              <1> 
   122                              <1> ;--------------------------------------------------------------------
   123                              <1> ; Vision_GetMaxPioModeToALandMinCycleTimeToBX
   124                              <1> ;	Parameters:
   125                              <1> ;		AL:		QD65xx Config Register contents
   126                              <1> ;		AH:		QDI Vision Controller ID
   127                              <1> ;	Returns:
   128                              <1> ;		AL:		Max supported PIO mode (only if ZF set)
   129                              <1> ;		AH:		~FLGH_DPT_IORDY if IORDY not supported, -1 otherwise (only if ZF set)
   130                              <1> ;		BX:		Min PIO Cycle Time (only if ZF set)
   131                              <1> ;		ZF:		Set if PIO limit necessary
   132                              <1> ;				Cleared if no need to limit timings
   133                              <1> ;	Corrupts registers:
   134                              <1> ;		Nothing
   135                              <1> ;--------------------------------------------------------------------
   136                              <1> Vision_GetMaxPioModeToALandMinCycleTimeToBX:
   137 00000FAE 80FCC0              <1> 	cmp		ah, ID_QD6500
   138 00000FB1 7506                <1> 	jne		SHORT .NoNeedToLimitForQD6580
   139 00000FB3 B8027F              <1> 	mov		ax, (~FLGH_DPT_IORDY & 0FFh) << 8 | 2	; Limit to PIO 2 because QD6500 does not support IORDY
   140 00000FB6 BBF000              <1> 	mov		bx, PIO_2_MIN_CYCLE_TIME_NS
   141                              <1> .NoNeedToLimitForQD6580:
   142 00000FB9 C3                  <1> 	ret
   143                              <1> 
   144                              <1> 
   145                              <1> ;--------------------------------------------------------------------
   146                              <1> ; Vision_InitializeWithIDinAH
   147                              <1> ;	Parameters:
   148                              <1> ;		AH:		QDI Vision Controller ID
   149                              <1> ;		DS:DI:	Ptr to DPT for Single or Slave Drive
   150                              <1> ;		SI:		Offset to Master DPT if Slave Drive present
   151                              <1> ;				Zero if Slave Drive not present
   152                              <1> ;	Returns:
   153                              <1> ;		CF:		Cleared if success
   154                              <1> ;				Set if error
   155                              <1> ;	Corrupts registers:
   156                              <1> ;		AX, BX, CX, DX, BP
   157                              <1> ;--------------------------------------------------------------------
   158                              <1> Vision_InitializeWithIDinAH:
   159                              <1> 	; QD6580 has a Control Register that needs to be programmed
   160 00000FBA 80FCC0              <1> 	cmp		ah, ID_QD6500
   161 00000FBD 8B5518              <1> 	mov		dx, [di+DPT_ADVANCED_ATA.wControllerBasePort]
   162 00000FC0 BD0801              <1> 	mov		bp, QD6500_MAX_ACTIVE_TIME_CLOCKS | (QD6500_MIN_ACTIVE_TIME_CLOCKS << 8)	; Assume QD6500
   163 00000FC3 7419                <1> 	je		SHORT .CalculateTimingsForQD65xx
   164 00000FC5 BD1102              <1> 	mov		bp, QD6580_MAX_ACTIVE_TIME_CLOCKS | (QD6580_MIN_ACTIVE_TIME_CLOCKS << 8)	; It's a QD6580
   165                              <1> 
   166                              <1> 	; Program QD6580 Control Register (not available on QD6500) to
   167                              <1> 	; Enable or Disable Read-Ahead and Post-Write Buffer to match
   168                              <1> 	; jumper setting on the multi I/O card.
   169 00000FC8 83C203              <1> 	add		dx, BYTE QD6580_CONTROL_REGISTER
   170 00000FCB EC                  <1> 	in		al, dx						; Read to get ATAPI jumper status
   171 00000FCC A802                <1> 	test	al, FLG_QDCONTROL_HDONLY_in
   172 00000FCE B05F                <1> 	mov		al, MASK_QDCONTROL_FLAGS_TO_SET
   173                              <1> 	eCMOVNZ	al, FLG_QDCONTROL_NONATAPI | MASK_QDCONTROL_FLAGS_TO_SET	; Enable Read-Ahead and Post-Write Buffers
   338 00000FD0 7402                <2>  jz SHORT %%Return
   339 00000FD2 B0DF                <2>  mov %1, %2
   340                              <2> %%Return:
   174 00000FD4 EE                  <1> 	out		dx, al
   175 00000FD5 4A                  <1> 	dec		dx							; Secondary Channel IDE Timing Register
   176                              <1> 
   177                              <1> 	; Now we need to determine is the drive connected to the Primary or Secondary channel.
   178                              <1> 	; QD6500 has only one channel that can be Primary at 1F0h or Secondary at 170h.
   179                              <1> 	; QD6580 always has Primary channel at 1F0h. Secondary channel at 170h can be Enabled or Disabled.
   180 00000FD6 807D0470            <1> 	cmp		BYTE [di+DPT.wBasePort], DEVICE_ATA_SECONDARY_PORT & 0FFh
   181 00000FDA 7402                <1> 	je		SHORT .CalculateTimingsForQD65xx		; Secondary Channel so no need to modify DX
   182 00000FDC 4A                  <1> 	dec		dx
   183 00000FDD 4A                  <1> 	dec		dx							; Primary Channel IDE Timing Register
   184                              <1> 
   185                              <1> 	; We need the PIO Cycle Time in CX to calculate Active and Recovery Times.
   186                              <1> .CalculateTimingsForQD65xx:
   187 00000FDE E86AFF              <1> 	call	AdvAtaInit_SelectSlowestCommonPioTimingsToBXandCXfromDSSIandDSDI
   188                              <1> 
   189                              <1> 	; Calculate Active Time value for QD65xx IDE Timing Register
   190 00000FE1 E8AEF8              <1> 	call	AtaID_GetActiveTimeToAXfromPioModeInBX
   191 00000FE4 E81F00              <1> 	call	ConvertNanosecsFromAXwithLimitsInBPtoRegisterValue
   192 00000FE7 95                  <1> 	xchg	bp, ax
   193                              <1> 
   194                              <1> 	; Calculate Recovery Time value for QD65xx IDE Timing Register
   195 00000FE8 91                  <1> 	xchg	ax, cx
   196 00000FE9 2E8A9F[FF0F]        <1> 	mov		bl, [cs:bx+.rgbToSubtractFromCycleTimeBasedOnPIOmode]
   197 00000FEE 29D8                <1> 	sub		ax, bx
   198 00000FF0 89EB                <1> 	mov		bx, bp						; Active Time value now in BL
   199 00000FF2 BD0F02              <1> 	mov		bp, QD65xx_MAX_RECOVERY_TIME_CLOCKS | (QD65xx_MIN_RECOVERY_TIME_CLOCKS << 8)
   200 00000FF5 E80E00              <1> 	call	ConvertNanosecsFromAXwithLimitsInBPtoRegisterValue
   201                              <1> 
   202                              <1> 	; Merge the values to a single byte to output
   203                              <1> 	eSHL_IM	al, POSITION_QD65XXIDE_RECOVERY_TIME
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668                              <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 00000FF8 C0E004              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   204 00000FFB 08D8                <1> 	or		al, bl
   205 00000FFD EE                  <1> 	out		dx, al
   206 00000FFE C3                  <1> 	ret									; Return with CF cleared
   207                              <1> 
   208                              <1> .rgbToSubtractFromCycleTimeBasedOnPIOmode:
   209                              <1> 	; For PIO 0 to 2 this method (t0 - (t1+t8+t9)) seems to give closest (little less) values to the fixed preset
   210                              <1> 	; values used by QDI6580 DOS driver v3.7
   211 00000FFF 96                  <1> 	db		(PIO_0_MIN_ADDRESS_VALID_NS + PIO_0_MAX_ADDR_VALID_TO_IOCS16_RELEASED + PIO_0_DIORW_TO_ADDR_VALID_HOLD)
   212 00001000 6E                  <1> 	db		(PIO_1_MIN_ADDRESS_VALID_NS + PIO_1_MAX_ADDR_VALID_TO_IOCS16_RELEASED + PIO_1_DIORW_TO_ADDR_VALID_HOLD)
   213 00001001 46                  <1> 	db		(PIO_2_MIN_ADDRESS_VALID_NS + PIO_2_MAX_ADDR_VALID_TO_IOCS16_RELEASED + PIO_2_DIORW_TO_ADDR_VALID_HOLD)
   214 00001002 66                  <1> 	db		102		; QDI6580 DOS driver v3.7 uses fixed values for PIO 3...
   215 00001003 3D                  <1> 	db		61		; ...and PIO 4. No idea where these values come from.
   216 00001004 32                  <1> 	db		(PIO_5_MIN_CYCLE_TIME_NS / 2) ; PIO 5 and 6 were not available when QD6580 was released. Use values...
   217 00001005 28                  <1> 	db		(PIO_6_MIN_CYCLE_TIME_NS / 2) ; ...that resembles those used for PIO 4
   218                              <1> 
   219                              <1> 
   220                              <1> ;--------------------------------------------------------------------
   221                              <1> ; ConvertNanosecsFromAXwithLimitsInBPtoRegisterValue
   222                              <1> ;	Parameters:
   223                              <1> ;		AX:		Nanosecs to convert
   224                              <1> ;		BP:		Low Byte:	Maximum allowed ticks
   225                              <1> ;				High Byte:	Minimum allowed ticks
   226                              <1> ;		DS:DI:	Ptr to DPT for Single or Slave Drive
   227                              <1> ;	Returns:
   228                              <1> ;		AL:		Timing value for QD65xx register
   229                              <1> ;	Corrupts registers:
   230                              <1> ;		Nothing
   231                              <1> ;--------------------------------------------------------------------
   232                              <1> ConvertNanosecsFromAXwithLimitsInBPtoRegisterValue:
   233 00001006 51                  <1> 	push	cx
   234                              <1> 
   235                              <1> 	; Get VLB Cycle Time in nanosecs
   236 00001007 B11E                <1> 	mov		cl, VLB_33MHZ_CYCLE_TIME	; Assume 33 MHz or slower VLB bus (30 ns)
   237 00001009 F6451604            <1> 	test	BYTE [di+DPT_ADVANCED_ATA.wControllerID], FLG_QDCONFIG_ID3
   238                              <1> 	eCMOVZ	cl, VLB_40MHZ_CYCLE_TIME	; (25 ns)
   332 0000100D 7502                <2>  jnz SHORT %%Return
   333 0000100F B119                <2>  mov %1, %2
   334                              <2> %%Return:
   239                              <1> 
   240                              <1> 	; Convert value in AX to VLB ticks
   241 00001011 F6F1                <1> 	div		cl							; AL = VLB ticks
   242 00001013 40                  <1> 	inc		ax							; Round up
   243                              <1> 
   244                              <1> 	; Limit value to QD65xx limits
   245 00001014 89E9                <1> 	mov		cx, bp
   246                              <1> 	MAX_U	al, ch						; Make sure not below minimum
    48 00001016 38E8                <2>  cmp %1, %2
    49 00001018 7702                <2>  ja %%Return
    50 0000101A 88E8                <2>  mov %1, %2
    51                              <2> %%Return:
   247                              <1> 	MIN_U	al, cl						; Make sure not above maximum
    22 0000101C 38C8                <2>  cmp %1, %2
    23 0000101E 7202                <2>  jb %%Return
    24 00001020 88C8                <2>  mov %1, %2
    25                              <2> %%Return:
   248                              <1> 
   249                              <1> 	; Not done yet, we need to invert the ticks since 0 is the slowest
   250                              <1> 	; value on the timing register
   251 00001022 28C1                <1> 	sub		cl, al
   252 00001024 91                  <1> 	xchg	ax, cx						; Return in AL
   253                              <1> 
   254 00001025 59                  <1> 	pop		cx
   255 00001026 C3                  <1> 	ret
