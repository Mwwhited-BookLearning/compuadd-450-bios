    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; IdeWait_IRQorDRQ
    25                              <1> ;	Parameters:
    26                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    27                              <1> ;		SS:BP:	Ptr to IDEPACK, PIOVARS or MEMPIOVARS
    28                              <1> ;	Returns:
    29                              <1> ;		AH:		INT 13h Error Code
    30                              <1> ;		CF:		Cleared if success, Set if error
    31                              <1> ;	Corrupts registers:
    32                              <1> ;		AL, BX, CX, DX
    33                              <1> ;--------------------------------------------------------------------
    34                              <1> IdeWait_IRQorDRQ:
    35 0000147B BB08FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRQ)
    36                              <1> 
    37                              <1> %ifdef MODULE_IRQ
    38 0000147E F6460702            <1> 	test	BYTE [bp+IDEPACK.bDeviceControl], FLG_DEVCONTROL_nIEN
    39 00001482 7503                <1> 	jnz		SHORT IdeWait_PollStatusFlagInBLwithTimeoutInBH	; Interrupt disabled
    40                              <1> %endif
    41                              <1> 	; Fall to IdeWait_IRQorStatusFlagInBLwithTimeoutInBH
    42                              <1> 
    43                              <1> 
    44                              <1> ;--------------------------------------------------------------------
