   298                              <1> ;--------------------------------------------------------------------
   299                              <1> ; CreateBiosTablesForHardDisk
   300                              <1> ;	Parameters:
   301                              <1> ;		BH:		Drive Select byte for Drive and Head Register
   302                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
   303                              <1> ;		CS:BP:	Ptr to IDEVARS for the drive
   304                              <1> ;		ES:SI	Ptr to ATA information for the drive
   305                              <1> ;		DS:		RAMVARS segment
   306                              <1> ;		ES:		BDA segment
   307                              <1> ;	Returns:
   308                              <1> ;		Nothing
   309                              <1> ;	Corrupts registers:
   310                              <1> ;		AX, BX, CX, DX, SI, DI
