    20                              <1> %ifndef RAMVARS_INC
    21                              <1> %define RAMVARS_INC
    22                              <1> 
    23                              <1> 
    24                              <1> %ifdef MODULE_SERIAL_FLOPPY OR MODULE_DRIVEXLATE
    25                              <1> 	%define NEED_XLATEVARS
    26                              <1> %endif
    27                              <1> 
    28                              <1> 
    29                              <1> %ifdef NEED_XLATEVARS
    30                              <1> ; Variables for translating drive numbers.
    31                              <1> 	struc XLATEVARS
    32                              <1> 	%ifdef MODULE_SERIAL_FLOPPY
    33                              <1> 		.bFlopCreateCnt:
    34 00000000 ??                  <1> 		.bFlopCntAndFirst	resb	1	; Normally, packed starting floppy drive number (high order 7 bits)
    35                              <1> 										; and number of drives (low order bit, max 2 drives supported).
    36                              <1> 										; During initialization, until the end of DetectDrives_FromAllIDEControllers,
    37                              <1> 										; this byte contains the raw number of floppy drives seen
    38                              <1> 										; (using .bFlopCreateCnt)
    39                              <1> 	%else
    40                              <1> 							resb	1	; alignment
    41                              <1> 	%endif
    42                              <1> 
    43                              <1> 	%ifdef MODULE_DRIVEXLATE
    44 00000001 ??                  <1> 		.bXlatedDrv			resb	1	; Drive number after translation
    45                              <1> 		.wFDandHDswap:
    46 00000002 ??                  <1> 		.bFDSwap			resb	1	; Floppy Drive to swap to 00h and vice versa
    47 00000003 ??                  <1> 		.bHDSwap			resb	1	; Hard Drive to swap to 80h and vice versa
    48                              <1> 	%else
    49                              <1> 							resb	1	; alignment
    50                              <1> 	%endif
    51                              <1> 	endstruc
    52                              <1> %endif
    53                              <1> 
    54                              <1> 
    55                              <1> ; RAM Variables.
    56                              <1> ; Variables should be kept to minimum since they might be located
    57                              <1> ; at the top of interrupt vectors.
    58                              <1> struc RAMVARS
    59                              <1> %ifdef RELOCATE_INT13H_STACK
    60                              <1> 							resb	252
    61                              <1> 	.dwStackChangeDSDI:
    62                              <1> 	.wStackChangeDI			resb	2	; Used during stack
    63                              <1> 	.wStackChangeDS			resb	2	; switching only
    64                              <1> 	.rgbTopOfStack:						; 256 bytes of stack
    65                              <1> 	.fpInt13hEntryStack		resb	4
    66                              <1> %endif
    67                              <1> %ifdef MODULE_MFM_COMPATIBILITY
    68                              <1> 	.fpMFMint13h			resb	4
    69                              <1> %endif
    70 00000000 ????????            <1> 	.fpOldI13h				resb	4	; Far pointer to old INT 13h handler
    71 00000004 ????                <1> 	.wDrvDetectSignature	resb	2	; Signature when BIOS is in drive detection mode
    72 00000006 ????                <1> 	.wSignature				resb	2	; Sign for finding stolen 1...64 kiB
    73 00000008 ??                  <1> 	.bTimeoutTicksLeft		resb	1
    74 00000009 ??                  <1> 	.bLastTimeoutUpdate		resb	1
    75                              <1> 
    76                              <1> 	.wFirstDrvAndCount:
    77 0000000A ??                  <1> 	.bFirstDrv				resb	1	; Number of first drive for this BIOS
    78                              <1> 	.wDrvCntAndFlopCnt:					; Both the hard disk and floppy counts in one word
    79                              <1> 										; (yes, misaligned, but it is only used this way during initialization)
    80 0000000B ??                  <1> 	.bDrvCnt				resb	1	; Number of drives handled by this BIOS
    81                              <1> 
    82                              <1> 	; Variables for drive number translation
    83                              <1> %ifdef NEED_XLATEVARS
    84 0000000C ????????            <1> 	.xlateVars				resb	XLATEVARS_size
    85                              <1> %endif
    86                              <1> endstruc
    87                              <1> 
    88                              <1> ; Note!!! .wDrvDetectSignature and .wSignature are intentionally in different locations.
    89                              <1> RAMVARS_RAM_SIGNATURE			EQU	"Xu"	; RAMVARS signature for .wSignature
    90                              <1> RAMVARS_DRV_DETECT_SIGNATURE	EQU	5A5Ah	; Signature when BIOS is in drive detection mode
    91                              <1> 
    92                              <1> 
    93                              <1> %ifdef MODULE_SERIAL_FLOPPY
    94                              <1>   %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    95                              <1> 	%if RAMVARS.xlateVars != RAMVARS.bDrvCnt+1 || XLATEVARS.bFlopCreateCnt != 0
    96                              <1> 		%error "bFlopCreateCnt needs to be the first thing in XLATEVARS, and .xlateVars needs to come immediately after .bDrvCnt.  In at least one place, we read .wDrvCntAndFlopCnt to get both counts in one fetch"
    97                              <1> 	%endif
    98                              <1>   %endif
    99                              <1> %endif
   100                              <1> 
   101                              <1> 
   102                              <1> 
   103                              <1> ;
   104                              <1> ; IDEPACK NOTE: The first six bytes of this structure are directly put on the
   105                              <1> ; wire for MODULE_SERIAL, please do not change the order or insert other members.
   106                              <1> ;
   107                              <1> struc IDEPACK	; PIOVARS and MEMPIOVARS overwrite the first 7 bytes
   108 00000000 ??                  <1> 	.bFeatures				resb	1
   109 00000001 ??                  <1> 	.bDrvAndHead			resb	1	; LBA28 27...24
   110                              <1> 
   111                              <1> 	.wSectorCountAndLbaLow:
   112 00000002 ??                  <1> 	.bSectorCount			resb	1
   113                              <1> 	.bSectorNumber:
   114 00000003 ??                  <1> 	.bLbaLow				resb	1	; LBA 7...0
   115                              <1> 
   116                              <1> 	.wCylinder:
   117                              <1> 	.wLbaMiddleAndHigh:
   118 00000004 ??                  <1> 	.bLbaMiddle				resb	1	; LBA 15...8
   119 00000005 ??                  <1> 	.bLbaHigh				resb	1	; LBA 23...16
   120                              <1> 
   121 00000006 ??                  <1> 	.bCommand				resb	1
   122 00000007 ??                  <1> 	.bDeviceControl			resb	1	; Offset 7 shared with PIOVARS and MEMPIOVARS
   123 00000008 ??                  <1> 							resb	1	; Used by PIOVARS and MEMPIOVARS
   124                              <1> 
   125                              <1> %ifdef MODULE_EBIOS
   126                              <1> 	; Parameters for 48-bit LBA
   127 00000009 ??                  <1> 	.bLbaLowExt				resb	1	; LBA48 31...24
   128                              <1> 	.wLbaMiddleAndHighExt:
   129 0000000A ??                  <1> 	.bLbaMiddleExt			resb	1	; LBA48 39...32
   130 0000000B ??                  <1> 	.bLbaHighExt			resb	1	; LBA48 47...40
   131                              <1> %endif
   132                              <1> 
   133                              <1> 							alignb	2	; Keep the INTPACK structure and stack pointer WORD aligned
   134                              <1> 
   135 0000000C <res 1Ah>           <1> 	.intpack				resb	INTPACK_size
   136                              <1> endstruc
   137                              <1> 
   138                              <1> SIZE_OF_IDEPACK_WITHOUT_INTPACK		EQU	(IDEPACK_size - INTPACK_size)
   139                              <1> 
   140                              <1> 
   141                              <1> %endif ; RAMVARS_INC
    57                                  	%include "BootVars.inc"			; For BOOTVARS struct
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Defines for BOOTVARS struct used by boot menu
     3                              <1> ;					and drive initialization.
     4                              <1> 
     5                              <1> ;
     6                              <1> ; XTIDE Universal BIOS and Associated Tools
     7                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
     8                              <1> ;
     9                              <1> ; This program is free software; you can redistribute it and/or modify
    10                              <1> ; it under the terms of the GNU General Public License as published by
    11                              <1> ; the Free Software Foundation; either version 2 of the License, or
    12                              <1> ; (at your option) any later version.
    13                              <1> ;
    14                              <1> ; This program is distributed in the hope that it will be useful,
    15                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                              <1> ; GNU General Public License for more details.
    18                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    19                              <1> ;
    20                              <1> 
    21                              <1> %ifndef BOOTVARS_INC
    22                              <1> %define BOOTVARS_INC
    23                              <1> 
    24                              <1> 
    25                              <1> ; Temporary locations for system interrupt handlers. Stored during ROM initialization
    26                              <1> ; and needed when we do full initialization and drive detection on INT 19h
    27                              <1> TEMPORARY_VECTOR_FOR_SYSTEM_INT13h		EQU		32h	; Unused by BIOS (reserved for DOS)
    28                              <1> TEMPORARY_VECTOR_FOR_SYSTEM_INT19h		EQU		33h	; Unused by BIOS (reserved for DOS)
    29                              <1> 
    30                              <1> 
    31                              <1> ; Default drives
    32                              <1> DEFAULT_FLOPPY_DRIVE_LETTER				EQU	'A'
    33                              <1> DEFAULT_HARD_DRIVE_LETTER				EQU	'C'
    34                              <1> 
    35                              <1> ; Number of times to retry booting before accepting error
    36                              <1> BOOT_READ_RETRY_TIMES		EQU		3
    37                              <1> 
    38                              <1> 
    39                              <1> %ifdef MODULE_HOTKEYS
    40                              <1> 
    41                              <1> struc HOTKEYVARS
    42 00000000 ????????            <1> 	.fpPrevTimerHandler	resb	4		; Previous 08h timer handler
    43 00000004 ????                <1> 	.wTimeWhenDisplayed	resb	2		; System time (ticks) when Hotkey bar was first displayed
    44                              <1> 	.wFddAndHddLetters:
    45 00000006 ??                  <1> 	.bFddLetter			resb	1		; Floppy Drive letter hotkey (upper case)
    46                              <1> 	.wHddLetterAndFlags:
    47 00000007 ??                  <1> 	.bHddLetter			resb	1		; Hard Drive letter hotkey (upper case). Must be after .bFddLetter!
    48 00000008 ??                  <1> 	.bFlags				resb	1		; Must be just after .bHddLetter!  (dependency in Hotkeybar.asm)
    49 00000009 ??                  <1> 	.bScancode			resb	1		; Function hotkey scancode, must be just after .bFlags!
    50                              <1> endstruc
    51                              <1> 
    52                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    53                              <1> %if HOTKEYVARS.bFddLetter+1 != HOTKEYVARS.bHddLetter || HOTKEYVARS.bHddLetter+1 != HOTKEYVARS.bFlags || HOTKEYVARS.bFlags+1 != HOTKEYVARS.bScancode
    54                              <1> %error "HOTKEYVARS: bytes need to come in the order .bFddLetter, then .bHddLetter, then .bFlags, then .bScancode"
    55                              <1> %endif
    56                              <1> %endif
    57                              <1> 
    58                              <1> ; Bit defines for HOTKEYVARS.bFlags
    59                              <1> FLG_HOTKEY_HD_FIRST			EQU		(1<<0)	; First try to boot from HDD, then FDD
    60                              <1> 
    61                              <1> %endif ; MODULE_HOTKEYS
    62                              <1> 
    63                              <1> 
    64                              <1> ; Pre-boot variables. These do not exist after successful boot to OS.
    65                              <1> ; Segment is always 0000h, same as BDA segment
    66                              <1> struc BOOTVARS
    67 00000000 <res 7C00h>         <1> 						resb	7C00h
    68                              <1> 	.rgbAtaInfo:						; 7C00h, ATA Information for drive detection
    69 00007C00 <res 200h>          <1> 	.rgbBootSect		resb 	512		; 7C00h, Boot sector
    70 00007E00 <res 100h>          <1> 						resb	256		; Boot Menu stack
    71                              <1> 	.rgbMnuStack:
    72 00007F00 ????????            <1> 	.dwPostStack		resb	4		; POST stack pointer when entering INT 19h
    73                              <1> %ifdef MODULE_HOTKEYS
    74 00007F04 <res Ah>            <1> 	.hotkeyVars			resb	HOTKEYVARS_size	; Must be located just before DRVDETECTINFO structs
    75                              <1> %endif
    76                              <1> 	.rgDrvDetectInfo:					; Array containing DRVDETECTINFO structs
    77                              <1> endstruc
    78                              <1> 
    79                              <1> 
    80                              <1> ; MAX_HARD_DISK_NAME_LENGTH must be defined ahead of the DRVDETECTINFO structure to avoid problems with NASM
    81                              <1> MAX_HARD_DISK_NAME_LENGTH	EQU		30	; Bytes reserved for drive name
    82                              <1> 
    83                              <1> struc DRVDETECTINFO
    84                              <1> 	.StartOfDrvDetectInfo:
    85 00000000 <res 1Eh>           <1> 	.szDrvName				resb	MAX_HARD_DISK_NAME_LENGTH
    86 0000001E ????                <1> 							resb	2	; Zero word (ensures string terminates)
    87 00000020 ????                <1> 	.wInitErrorFlags		resb	2	; Errors during initialization
    88                              <1> 
    89                              <1> 	; DRVDETECTINFO's size must be an even multiple of DPT's size
    90 00000022 <res 1Ah>           <1> 	.EndOfDriveDetectInfo:	resb	LARGEST_DPT_SIZE - (.EndOfDriveDetectInfo % LARGEST_DPT_SIZE)
    91                              <1> endstruc
    92                              <1> 
    93                              <1> DPT_DRVDETECTINFO_SIZE_MULTIPLIER	EQU		DRVDETECTINFO_size / LARGEST_DPT_SIZE
    94                              <1> 
    95                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    96                              <1> %if MAX_HARD_DISK_NAME_LENGTH % 2 <> 0
    97                              <1> 	%error "MAX_HARD_DISK_NAME_LENGTH needs to be a multiple of 2, memory is moved with word operations."
    98                              <1> %endif
    99                              <1> %endif
   100                              <1> 
   101                              <1> 
   102                              <1> ;--------------------------------------------------------------------
   103                              <1> ; Stores POST stack pointer to BOOTVARS.
   104                              <1> ;
   105                              <1> ; STORE_POST_STACK_POINTER
   106                              <1> ;	Parameters:
   107                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   108                              <1> ;	Returns:
   109                              <1> ;		Nothing
   110                              <1> ;	Corrupts registers:
   111                              <1> ;		Nothing
   112                              <1> ;--------------------------------------------------------------------
   113                              <1> %macro STORE_POST_STACK_POINTER 0
   114                              <1> 	mov		[es:BOOTVARS.dwPostStack], sp
   115                              <1> 	mov		[es:BOOTVARS.dwPostStack+2], ss
   116                              <1> %endmacro
   117                              <1> 
   118                              <1> 
   119                              <1> ;--------------------------------------------------------------------
   120                              <1> ; Initializes stack for boot menu usage.
   121                              <1> ; POST stack is not large enough when DPTs are stored to 30:0h.
   122                              <1> ;
   123                              <1> ; Note regarding LOAD_BDA_SEGMENT_TO: If you force the use of SP
   124                              <1> ; then you also have to unconditionally enable the CLI/STI pair.
   125                              <1> ; The reason for this is that only some buggy 808x CPU:s need the
   126                              <1> ; CLI/STI instruction pair when changing stacks. Other CPU:s disable
   127                              <1> ; interrupts automatically when SS is modified for the duration of
   128                              <1> ; the immediately following instruction to give time to change SP.
   129                              <1> ;
   130                              <1> ; SWITCH_TO_BOOT_MENU_STACK
   131                              <1> ;	Parameters:
   132                              <1> ;		Nothing
   133                              <1> ;	Returns:
   134                              <1> ;		SS:SP:	Pointer to top of Boot Menu stack
   135                              <1> ;	Corrupts registers:
   136                              <1> ;		Nothing
   137                              <1> ;--------------------------------------------------------------------
   138                              <1> %macro SWITCH_TO_BOOT_MENU_STACK 0
   139                              <1> %ifndef USE_186
   140                              <1> 	cli									; Disable interrupts
   141                              <1> %endif
   142                              <1> 	LOAD_BDA_SEGMENT_TO	ss, sp
   143                              <1> 	mov		sp, BOOTVARS.rgbMnuStack	; Load offset to stack
   144                              <1> %ifndef USE_186
   145                              <1> 	sti									; Enable interrupts
   146                              <1> %endif
   147                              <1> %endmacro
   148                              <1> 
   149                              <1> 
   150                              <1> ;--------------------------------------------------------------------
   151                              <1> ; Restores SS and SP to initial boot loader values.
   152                              <1> ;
   153                              <1> ; Note! Must return with AX=0 and CF preserved.
   154                              <1> ; See Int19hMenu_JumpToBootSector_or_RomBoot.
   155                              <1> ;
   156                              <1> ; SWITCH_BACK_TO_POST_STACK
   157                              <1> ;	Parameters:
   158                              <1> ;		AX:		BDA and Interrupt Vector segment (zero)
   159                              <1> ;	Returns:
   160                              <1> ;		SS:SP:	Ptr to POST stack
   161                              <1> ;	Corrupts registers:
   162                              <1> ;		Nothing (not even FLAGS)
   163                              <1> ;--------------------------------------------------------------------
   164                              <1> %macro SWITCH_BACK_TO_POST_STACK 0
   165                              <1> %ifndef USE_386
   166                              <1> 	cli
   167                              <1> 	mov		ss, ax
   168                              <1> 	mov		sp, [ss:BOOTVARS.dwPostStack]
   169                              <1> 	mov		ss, [ss:BOOTVARS.dwPostStack+2]
   170                              <1> 	sti
   171                              <1> %else
   172                              <1> 	mov		ss, ax
   173                              <1> 	lss		sp, [ss:BOOTVARS.dwPostStack]
   174                              <1> %endif
   175                              <1> %endmacro
   176                              <1> 
   177                              <1> 
   178                              <1> %endif ; BOOTVARS_INC
    58                                  	%include "IdeIO.inc"			; Macros for IDE port I/O
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Macros for normal I/O mapped ATA controllers.
     3                              <1> 
     4                              <1> ;
     5                              <1> ; XTIDE Universal BIOS and Associated Tools
     6                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2026 by XTIDE Universal BIOS Team.
     7                              <1> ;
     8                              <1> ; This program is free software; you can redistribute it and/or modify
     9                              <1> ; it under the terms of the GNU General Public License as published by
    10                              <1> ; the Free Software Foundation; either version 2 of the License, or
    11                              <1> ; (at your option) any later version.
    12                              <1> ;
    13                              <1> ; This program is distributed in the hope that it will be useful,
    14                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                              <1> ; GNU General Public License for more details.
    17                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    18                              <1> ;
    19                              <1> 
    20                              <1> %ifndef IDE_IO_INC
    21                              <1> %define IDE_IO_INC
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; OUTPUT_AL_TO_IDE_REGISTER
    25                              <1> ; OUTPUT_AL_TO_IDE_CONTROL_BLOCK_REGISTER
    26                              <1> ;	Parameters:
    27                              <1> ;		AL:		Byte to output
    28                              <1> ;		%1:		DX, DL or
    29                              <1> ;				IDE Register				(OUTPUT_AL_TO_IDE_REGISTER)
    30                              <1> ;				IDE Control Block Register	(OUTPUT_AL_TO_IDE_CONTROL_BLOCK_REGISTER)
    31                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    32                              <1> ;	Returns:
    33                              <1> ;		Nothing
    34                              <1> ;	Corrupts registers:
    35                              <1> ;		BX, DX
    36                              <1> ;--------------------------------------------------------------------
    37                              <1> %macro OUTPUT_AL_TO_IDE_REGISTER 1
    38                              <1> %ifndef MODULE_8BIT_IDE	; Standard IDE controllers only
    39                              <1> 
    40                              <1> 	%ifdef IO_SEQUENCE
    41                              <1> 		%ifndef previous_parameter
    42                              <1> 			%ifnidni %1, dx
    43                              <1> 				%ifidni %1, dl
    44                              <1> 					xor		dh, dh
    45                              <1> 				%else
    46                              <1> 					mov		dx, %1
    47                              <1> 				%endif
    48                              <1> 			%endif
    49                              <1> 			add		dx, [di+DPT.wBasePort]
    50                              <1> 		%elif previous_parameter + 1 = %1
    51                              <1> 			inc		dx
    52                              <1> 		%elif previous_parameter - 1 = %1
    53                              <1> 			dec		dx
    54                              <1> 		%elif previous_parameter = %1
    55                              <1> 		%else
    56                              <1> 			%ifnidni %1, dx
    57                              <1> 				%ifidni %1, dl
    58                              <1> 					xor		dh, dh
    59                              <1> 				%else
    60                              <1> 					mov		dx, %1
    61                              <1> 				%endif
    62                              <1> 			%endif
    63                              <1> 			add		dx, [di+DPT.wBasePort]
    64                              <1> 		%endif
    65                              <1> 		%define previous_parameter %1
    66                              <1> 
    67                              <1> 	%else ; ~IO_SEQUENCE
    68                              <1> 		%undef previous_parameter
    69                              <1> 		%ifnidni %1, dx
    70                              <1> 			%ifidni %1, dl
    71                              <1> 				xor		dh, dh
    72                              <1> 			%else
    73                              <1> 				mov		dx, %1
    74                              <1> 			%endif
    75                              <1> 		%endif
    76                              <1> 		add		dx, [di+DPT.wBasePort]
    77                              <1> 	%endif
    78                              <1> 	out		dx, al
    79                              <1> 
    80                              <1> %else	; Register translations required
    81                              <1> 
    82                              <1> 	%ifnidni %1, dx
    83                              <1> 		%ifnidni %1, dl
    84                              <1> 			mov		dl, %1
    85                              <1> 		%endif
    86                              <1> 	%endif
    87                              <1> 	call	IdeIO_OutputALtoIdeRegisterInDL
    88                              <1> 
    89                              <1> %endif
    90                              <1> %endmacro
    91                              <1> 
    92                              <1> 
    93                              <1> %macro OUTPUT_AL_TO_IDE_CONTROL_BLOCK_REGISTER 1
    94                              <1> %ifndef MODULE_8BIT_IDE	; Standard IDE controllers only
    95                              <1> 
    96                              <1> 	%ifdef IO_SEQUENCE
    97                              <1> 		%ifndef previous_parameter
    98                              <1> 			eMOVZX	bx, BYTE [di+DPT.bIdevarsOffset]
    99                              <1> 			%ifnidni %1, dx
   100                              <1> 				%ifidni %1, dl
   101                              <1> 					xor		dh, dh
   102                              <1> 				%else
   103                              <1> 					mov		dx, %1
   104                              <1> 				%endif
   105                              <1> 			%endif
   106                              <1> 			add		dx, [cs:bx+IDEVARS.wControlBlockPort]
   107                              <1> 		%elif previous_parameter + 1 = %1
   108                              <1> 			inc		dx
   109                              <1> 		%elif previous_parameter - 1 = %1
   110                              <1> 			dec		dx
   111                              <1> 		%elif previous_parameter = %1
   112                              <1> 		%else
   113                              <1> 			eMOVZX	bx, BYTE [di+DPT.bIdevarsOffset]
   114                              <1> 			%ifnidni %1, dx
   115                              <1> 				%ifidni %1, dl
   116                              <1> 					xor		dh, dh
   117                              <1> 				%else
   118                              <1> 					mov		dx, %1
   119                              <1> 				%endif
   120                              <1> 			%endif
   121                              <1> 			add		dx, [cs:bx+IDEVARS.wControlBlockPort]
   122                              <1> 		%endif
   123                              <1> 		%define previous_parameter %1
   124                              <1> 
   125                              <1> 	%else ; ~IO_SEQUENCE
   126                              <1> 		%undef previous_parameter
   127                              <1> 		eMOVZX	bx, BYTE [di+DPT.bIdevarsOffset]
   128                              <1> 		%ifnidni %1, dx
   129                              <1> 			%ifidni %1, dl
   130                              <1> 				xor		dh, dh
   131                              <1> 			%else
   132                              <1> 				mov		dx, %1
   133                              <1> 			%endif
   134                              <1> 		%endif
   135                              <1> 		add		dx, [cs:bx+IDEVARS.wControlBlockPort]
   136                              <1> 	%endif
   137                              <1> 	out		dx, al
   138                              <1> 
   139                              <1> %else	; Register translations required
   140                              <1> 
   141                              <1> 	%ifnidni %1, dx
   142                              <1> 		%ifnidni %1, dl
   143                              <1> 			mov		dl, %1
   144                              <1> 		%endif
   145                              <1> 	%endif
   146                              <1> 	call	IdeIO_OutputALtoIdeControlBlockRegisterInDL
   147                              <1> 
   148                              <1> %endif
   149                              <1> %endmacro
   150                              <1> 
   151                              <1> 
   152                              <1> ;--------------------------------------------------------------------
   153                              <1> ; INPUT_TO_AL_FROM_IDE_REGISTER
   154                              <1> ;	Parameters:
   155                              <1> ;		%1:		DX, DL or IDE Register
   156                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   157                              <1> ;	Returns:
   158                              <1> ;		AL:		Inputted byte
   159                              <1> ;	Corrupts registers:
   160                              <1> ;		BX, DX
   161                              <1> ;--------------------------------------------------------------------
   162                              <1> %macro INPUT_TO_AL_FROM_IDE_REGISTER 1
   163                              <1> %ifndef MODULE_8BIT_IDE	; Standard IDE controllers only
   164                              <1> 
   165                              <1> 	%ifnidni %1, dx
   166                              <1> 		%ifidni %1, dl
   167                              <1> 			xor		dh, dh
   168                              <1> 		%else
   169                              <1> 			mov		dx, %1
   170                              <1> 		%endif
   171                              <1> 	%endif
   172                              <1> 	add		dx, [di+DPT.wBasePort]
   173                              <1> 	in		al, dx
   174                              <1> 
   175                              <1> %else	; Register translations required
   176                              <1> 
   177                              <1> 	%ifnidni %1, dx
   178                              <1> 		%ifnidni %1, dl
   179                              <1> 			mov		dl, %1
   180                              <1> 		%endif
   181                              <1> 	%endif
   182                              <1> 	call	IdeIO_InputToALfromIdeRegisterInDL
   183                              <1> 
   184                              <1> %endif
   185                              <1> %endmacro
   186                              <1> 
   187                              <1> 
   188                              <1> ;--------------------------------------------------------------------
   189                              <1> ; UNROLL_SECTORS_IN_CX_TO_DWORDS
   190                              <1> ; UNROLL_SECTORS_IN_CX_TO_QWORDS
   191                              <1> ; UNROLL_SECTORS_IN_CX_TO_OWORDS
   192                              <1> ;	Parameters:
   193                              <1> ;		CX:		Number of sectors in block
   194                              <1> ;	Returns:
   195                              <1> ;		CX:		Number of DWORDs, QWORDs or OWORDs in block
   196                              <1> ;	Corrupts registers:
   197                              <1> ;		Nothing
   198                              <1> ;--------------------------------------------------------------------
   199                              <1> %macro UNROLL_SECTORS_IN_CX_TO_DWORDS 0
   200                              <1> %ifdef USE_186
   201                              <1> 	shl		cx, 7
   202                              <1> %else
   203                              <1> 	xchg	cl, ch		; Sectors to WORDs (SHL CX, 8)
   204                              <1> 	shr		cx, 1
   205                              <1> %endif
   206                              <1> %endmacro
   207                              <1> 
   208                              <1> %macro UNROLL_SECTORS_IN_CX_TO_QWORDS 0
   209                              <1> %ifdef USE_186
   210                              <1> 	shl		cx, 6
   211                              <1> %else
   212                              <1> 	UNROLL_SECTORS_IN_CX_TO_DWORDS
   213                              <1> 	shr		cx, 1
   214                              <1> %endif
   215                              <1> %endmacro
   216                              <1> 
   217                              <1> %macro UNROLL_SECTORS_IN_CX_TO_OWORDS 0
   218                              <1> %ifdef USE_186
   219                              <1> 	shl		cx, 5
   220                              <1> %else
   221                              <1> ;	UNROLL_SECTORS_IN_CX_TO_QWORDS
   222                              <1> ;	shr		cx, 1
   223                              <1> 	mov		ch, cl		; 2 bytes shorter but possibly slower
   224                              <1> 	mov		cl, 3
   225                              <1> 	shr		cx, cl
   226                              <1> %endif
   227                              <1> %endmacro
   228                              <1> 
   229                              <1> %macro UNROLL_SECTORS_IN_CX_TO_16WORDS 0
   230                              <1> %ifdef USE_186
   231                              <1> 	shl		cx, 4
   232                              <1> %else
   233                              <1> 	mov		ch, cl
   234                              <1> 	mov		cl, 4
   235                              <1> 	shr		cx, cl
   236                              <1> %endif
   237                              <1> %endmacro
   238                              <1> 
   239                              <1> %macro UNROLL_SECTORS_IN_CX_TO_32WORDS 0
   240                              <1> %ifdef USE_186
   241                              <1> 	shl		cx, 3
   242                              <1> %else
   243                              <1> 	shl		cx, 1
   244                              <1> 	shl		cx, 1
   245                              <1> 	shl		cx, 1
   246                              <1> %endif
   247                              <1> %endmacro
   248                              <1> 
