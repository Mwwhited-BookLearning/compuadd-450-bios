    47                              <1> ;--------------------------------------------------------------------
    48                              <1> ; IdeIO_InputToALfromIdeRegisterInDL
    49                              <1> ;	Parameters:
    50                              <1> ;		DL:		IDE Register
    51                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    52                              <1> ;	Returns:
    53                              <1> ;		AL:		Inputted byte
    54                              <1> ;	Corrupts registers:
    55                              <1> ;		BX, DX
    56                              <1> ;--------------------------------------------------------------------
    57                              <1> IdeIO_InputToALfromIdeRegisterInDL:
    58 0000155A 30F6                <1> 	xor		dh, dh	; IDE Register index now in DX...
    59 0000155C 8A4514              <1> 	mov		al, [di+DPT_ATA.bDevice]
    60 0000155F 3C0A                <1> 	cmp		al, DEVICE_8BIT_XTIDE_REV2
    61 00001561 7208                <1> 	jb		SHORT .InputToALfromRegisterInDX	; Standard IDE controllers, Juko D16-X and XTIDE rev 1
    62                              <1> %if NOSWAPA0A3LOOKUPTABLE = 0
    63                              <1> 	mov		bx, dx	; ...and BX for A0<->A3 swap and for memory mapped I/O
    64                              <1> %endif
    65                              <1> 
    66                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
    67                              <1> 	cmp		al, DEVICE_8BIT_XTIDE_REV2_OLIVETTI
    68                              <1> 	jbe		SHORT .ReverseA0andA3fromRegisterIndexInDX
    69                              <1> 
    70                              <1> %if NOSWAPA0A3LOOKUPTABLE <> 0
    71                              <1> 	mov		bl, dl	; ...and BL for memory mapped I/O
    72                              <1> %endif
    73                              <1> 
    74                              <1> 	eSHL_IM	dx, 1	; ADP50L and XT-CF
    75                              <1> 	cmp		al, DEVICE_8BIT_JRIDE_ISA
    76                              <1> 	jb		SHORT .InputToALfromRegisterInDX	; All XT-CF modes
    77                              <1> 	mov		bh, JRIDE_COMMAND_BLOCK_REGISTER_WINDOW_OFFSET >> 8
    78                              <1> 	je		SHORT .InputToALfromMemoryMappedRegisterInBX
    79                              <1> 	mov		bl, dl
    80                              <1> 	mov		bh, ADP50L_COMMAND_BLOCK_REGISTER_WINDOW_OFFSET >> 8
    81                              <1> 
    82                              <1> .InputToALfromMemoryMappedRegisterInBX:
    83                              <1> 	push	ds
    84                              <1> 	mov		ds, [di+DPT.wBasePort]	; Segment for JR-IDE/ISA and ADP50L
    85                              <1> 	mov		al, [bx]
    86                              <1> 	pop		ds
    87                              <1> 	ret
    88                              <1> %endif
    89                              <1> 
    90                              <1> .ReverseA0andA3fromRegisterIndexInDX:
    91                              <1> %if NOSWAPA0A3LOOKUPTABLE = 0
    92                              <1> ; 5 bytes plus the lookup table (8 bytes).
    93                              <1> 	mov		dl, [cs:bx+g_rgbSwapA0andA3fromIdeRegisterIndex]
    94                              <1> %else
    95                              <1> ; 8 bytes. No lookup table.
    96 00001563 F6C201              <1> 	test	dl, 1
    97 00001566 7403                <1> 	jz		SHORT .InputToALfromRegisterInDX
    98 00001568 80F209              <1> 	xor		dl, 1001b						; Set A3, Clear A0
    99                              <1> %endif
   100                              <1> 
   101                              <1> .InputToALfromRegisterInDX:
   102 0000156B 035504              <1> 	add		dx, [di+DPT.wBasePort]
   103 0000156E EC                  <1> 	in		al, dx
   104 0000156F C3                  <1> 	ret
