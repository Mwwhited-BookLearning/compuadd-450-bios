    36                              <1> ; IdeTransfer_StartWithCommandInAL
    37                              <1> ;	Parameters:
    38                              <1> ;		AL:		IDE command that was used to start the transfer
    39                              <1> ;				(all PIO read and write commands including Identify Device)
    40                              <1> ;		ES:SI:	Ptr to data buffer
    41                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    42                              <1> ;		SS:BP:	Ptr to IDEPACK
    43                              <1> ;	Returns:
    44                              <1> ;		AH:		INT 13h Error Code
    45                              <1> ;		CX:		Number of successfully transferred sectors
    46                              <1> ;		CF:		Cleared if success, Set if error
    47                              <1> ;	Corrupts registers:
    48                              <1> ;		AL, BX, DX, SI, ES
    49                              <1> ;--------------------------------------------------------------------
    50 00001202 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    51                              <1> IdeTransfer_StartWithCommandInAL:
    52                              <1> %ifdef USE_PS2
    53                              <1> 	; Turn on the software controlled HDD LED on IBM PS/2 machines
    54                              <1> 	xchg	bx, ax	; Save AX
    55                              <1> 	in		al, 92h	; Read System Control Port A
    56                              <1> 	or		al, 80h	; Set bit 7 to turn on LED (bit 6 would also work)
    57                              <1> 	out		92h, al	; Write it back
    58                              <1> 	xchg	bx, ax	; Restore AX
    59                              <1> %endif
    60                              <1> 	; Are we reading or writing?
    61 00001204 A810                <1> 	test	al, 16	; Bit 4 is cleared on all the read commands but set on 3 of the 4 write commands
    62 00001206 8A6602              <1> 	mov		ah, [bp+IDEPACK.bSectorCount]
    63 00001209 7555                <1> 	jnz		SHORT WriteToDrive
    64 0000120B 3CC5                <1> 	cmp		al, COMMAND_WRITE_MULTIPLE
    65 0000120D 7451                <1> 	je		SHORT WriteToDrive
    66                              <1> 	; Fall to ReadFromDrive
    67                              <1> 
    68                              <1> ;--------------------------------------------------------------------
    69                              <1> ; ReadFromDrive
    70                              <1> ;	Parameters:
    71                              <1> ;		AH:		Number of sectors to transfer (1...128)
    72                              <1> ;		ES:SI:	Ptr to buffer to receive data
    73                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    74                              <1> ;		SS:BP:	Ptr to PIOVARS
    75                              <1> ;	Returns:
    76                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    77                              <1> ;		AH:		BIOS Error code
    78                              <1> ;		CX:		Number of successfully transferred sectors
    79                              <1> ;		CF:		0 if transfer successful
    80                              <1> ;				1 if any error
    81                              <1> ;	Corrupts registers:
    82                              <1> ;		AL, BX, DX, SI, ES
    83                              <1> ;--------------------------------------------------------------------
    84                              <1> ReadFromDrive:
    85                              <1> 	; Prepare to read data to ESSI
    86 0000120F BB[E012]            <1> 	mov		bx, g_rgfnPioRead
    87 00001212 E88F00              <1> 	call	InitializePiovarsInSSBPwithSectorCountInAH
    88                              <1> %ifdef USE_AT
    89 00001215 7243                <1> 	jc		SHORT ReturnWithTransferErrorInAH
    90                              <1> %endif
    91                              <1> 
    92                              <1> 	; Wait until drive is ready to transfer
    93 00001217 E86102              <1> 	call	IdeWait_IRQorDRQ					; Wait until ready to transfer
    94 0000121A 723E                <1> 	jc		SHORT ReturnWithTransferErrorInAH
    95 0000121C 87FE                <1> 	xchg	si, di								; ES:DI now points buffer
    96                              <1> 
    97 0000121E 8B4E04              <1> 	mov		cx, [bp+PIOVARS.wSectorsInBlock]	; Max 128
    98                              <1> 
    99 00001221 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   100                              <1> .ReadNextBlockFromDrive:
   101 00001224 8B5600              <1> 	mov		dx, [bp+PIOVARS.wDataPort]
   102 00001227 384E06              <1> 	cmp		[bp+PIOVARS.bSectorsLeft], cl
   103 0000122A 7618                <1> 	jbe		SHORT .ReadLastBlockFromDrive
   104 0000122C FF5602              <1> 	call	[bp+PIOVARS.fnXfer]
   105                              <1> 
   106                              <1> 	; Wait until ready for next block and check for errors
   107 0000122F 87F7                <1> 	xchg	di, si								; DS:DI now points DPT
   108 00001231 E84702              <1> 	call	IdeWait_IRQorDRQ					; Wait until ready to transfer
   109 00001234 7224                <1> 	jc		SHORT ReturnWithTransferErrorInAH
   110 00001236 87FE                <1> 	xchg	si, di								; ES:DI now points buffer
   111                              <1> 
   112                              <1> 	; Increment number of successfully read sectors
   113 00001238 8B4E04              <1> 	mov		cx, [bp+PIOVARS.wSectorsInBlock]
   114 0000123B 284E06              <1> 	sub		[bp+PIOVARS.bSectorsLeft], cl
   115 0000123E 004E08              <1> 	add		[bp+PIOVARS.bSectorsDone], cl
   116 00001241 EBE1                <1> 	jmp		SHORT .ReadNextBlockFromDrive
   117                              <1> 
   118 00001243 90                  <1> ALIGN JUMP_ALIGN
   119                              <1> .ReadLastBlockFromDrive:
   120 00001244 8A4E06              <1> 	mov		cl, [bp+PIOVARS.bSectorsLeft]		; CH is already zero
   121 00001247 51                  <1> 	push	cx
   122 00001248 FF5602              <1> 	call	[bp+PIOVARS.fnXfer]					; Transfer possibly partial block
   123                              <1> 
   124                              <1> 	; Check for errors in last block
   125 0000124B 89F7                <1> 	mov		di, si								; DS:DI now points DPT
   126                              <1> CheckErrorsAfterTransferringLastBlock:
   127 0000124D BB80FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_BSY)
   128 00001250 E83402              <1> 	call	IdeWait_PollStatusFlagInBLwithTimeoutInBH
   129 00001253 59                  <1> 	pop		cx	; [bp+PIOVARS.bSectorsLeft]
   130 00001254 7204                <1> 	jc		SHORT ReturnWithTransferErrorInAH
   131                              <1> 
   132                              <1> 	; All sectors successfully transferred
   133 00001256 034E08              <1> 	add		cx, [bp+PIOVARS.bSectorsDone]		; Never sets CF
   134                              <1> %ifdef USE_PS2
   135                              <1> 	; Turn off the software controlled HDD LED on IBM PS/2 machines
   136                              <1> 	in		al, 92h	; Read System Control Port A
   137                              <1> 	and		al, 3Fh	; Clear bits 7 and 6 to turn off LED
   138                              <1> 	out		92h, al	; Write it back
   139                              <1> %endif
   140 00001259 C3                  <1> 	ret
   141                              <1> 
   142                              <1> 	; Return number of successfully read sectors
   143                              <1> ReturnWithTransferErrorInAH:
   144                              <1> %ifdef USE_386
   145 0000125A 0FB64E08            <1> 	movzx	cx, BYTE [bp+PIOVARS.bSectorsDone]
   146                              <1> %else
   147                              <1> 	mov		cl, [bp+PIOVARS.bSectorsDone]
   148                              <1> 	mov		ch, 0								; Preserve CF
   149                              <1> %endif
   150                              <1> %ifdef USE_PS2
   151                              <1> 	; Turn off the software controlled HDD LED on IBM PS/2 machines
   152                              <1> 	in		al, 92h	; Read System Control Port A
   153                              <1> 	and		al, 3Fh	; Clear bits 7 and 6 to turn off LED (Clears CF)
   154                              <1> 	out		92h, al	; Write it back
   155                              <1> 	stc				; Restore the CF
   156                              <1> %endif
   157 0000125E C3                  <1> 	ret
