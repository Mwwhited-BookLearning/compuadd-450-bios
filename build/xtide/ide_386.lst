    20                              <2> ; Section containing code
    21                              <2> SECTION .text
    22                              <2> 
    23                              <2> ;--------------------------------------------------------------------
    24                              <2> ; CgaSnow_IsCgaPresent
    25                              <2> ;	Parameters:
    26                              <2> ;		DS:		BDA segment (zero)
    27                              <2> ;	Returns:
    28                              <2> ;		CF:		Set if CGA detected
    29                              <2> ;				Cleared if CGA not detected
    30                              <2> ;	Corrupts registers:
    31                              <2> ;		Nothing
    32                              <2> ;--------------------------------------------------------------------
    33                              <2> ALIGN DISPLAY_JUMP_ALIGN
    34                              <2> CgaSnow_IsCgaPresent:
    35 0000013E 813E6304D403        <2> 	cmp		WORD [BDA.wVidPort], CGA_STATUS_REGISTER - OFFSET_TO_CGA_STATUS_REGISTER
    36 00000144 F8                  <2> 	clc
    37 00000145 7505                <2> 	jne		SHORT .CgaNotFound
    38                              <2> 
    39                              <2> 	; All standard CGA modes use 25 rows but only EGA and later store it to BDA.
    40 00000147 803E840418          <2> 	cmp		BYTE [BDA.bVidRows], 24		; BDA contains rows - 1
    41                              <2> .CgaNotFound:
    42 0000014C C3                  <2> 	ret
    43                              <2> 
    44                              <2> 
    45                              <2> ; CGA snow prevention must be kept optional to avoid unnecessary
    46                              <2> ; overhead when building programs meant for non-CGA systems.
    47                              <2> %ifdef ELIMINATE_CGA_SNOW
    48                              <2> 
    49                              <2> ;--------------------------------------------------------------------
    50                              <2> ; CgaSnow_Stosb
    51                              <2> ; CgaSnow_Stosw
    52                              <2> ;	Parameters:
    53                              <2> ;		AL:		Character to output
    54                              <2> ;		AH:		Attribute to output (CgaSnow_StoswWithoutCgaSnow only)
    55                              <2> ;		DS:		BDA segment (zero)
    56                              <2> ;		ES:DI:	Ptr to video memory where to output
    57                              <2> ;	Returns:
    58                              <2> ;		DI:		Incremented for next character
    59                              <2> ;	Corrupts registers:
    60                              <2> ;		AX, DX
    61                              <2> ;--------------------------------------------------------------------
    62                              <2> ALIGN DISPLAY_JUMP_ALIGN
    63                              <2> CgaSnow_Stosb:
    64                              <2> 	call	LoadCgaStatusRegisterAddressToDXifCgaPresent
    65                              <2> 	jz		SHORT .StosbWithoutWaitSinceUnknownPort
    66                              <2> 
    67                              <2> 	mov		ah, al
    68                              <2> 	cli				; Interrupt request would mess up timing
    69                              <2> 	WAIT_UNTIL_SAFE_CGA_WRITE
    70                              <2> 	mov		al, ah
    71                              <2> .StosbWithoutWaitSinceUnknownPort:
    72                              <2> 	stosb
    73                              <2> 	sti
    74                              <2> 	ret
    75                              <2> 
    76                              <2> ALIGN DISPLAY_JUMP_ALIGN
    77                              <2> CgaSnow_Stosw:
    78                              <2> 	push	bx
    79                              <2> 	call	LoadCgaStatusRegisterAddressToDXifCgaPresent
    80                              <2> 	jz		SHORT .StoswWithoutWaitSinceUnknownPort
    81                              <2> 
    82                              <2> 	xchg	bx, ax
    83                              <2> 	cli				; Interrupt request would mess up timing
    84                              <2> 	WAIT_UNTIL_SAFE_CGA_WRITE
    85                              <2> 	xchg	ax, bx
    86                              <2> .StoswWithoutWaitSinceUnknownPort:
    87                              <2> 	stosw
    88                              <2> 	sti
    89                              <2> 	pop		bx
    90                              <2> 	ret
    91                              <2> 
    92                              <2> 
    93                              <2> ;--------------------------------------------------------------------
    94                              <2> ; CgaSnow_RepMovsb
    95                              <2> ;	Parameters:
    96                              <2> ;		CX:		Number of characters to copy
    97                              <2> ;		DS:		BDA segment (zero)
    98                              <2> ;		ES:SI:	Ptr to video memory where to read from
    99                              <2> ;		ES:DI:	Ptr to video memory where to write to
   100                              <2> ;	Returns:
   101                              <2> ;		SI, DI:	Updated for next character
   102                              <2> ;	Corrupts registers:
   103                              <2> ;		AX, CX, DX
   104                              <2> ;--------------------------------------------------------------------
   105                              <2> %ifdef EXCLUDE_FROM_XUB
   106                              <2> 	%ifdef MODULE_STRINGS_COMPRESSED
   107                              <2> 		%define EXCLUDE
   108                              <2> 	%endif
   109                              <2> 	%ifdef MODULE_BOOT_MENU
   110                              <2> 		%undef EXCLUDE
   111                              <2> 	%endif
   112                              <2> %endif
   113                              <2> 
   114                              <2> %ifndef EXCLUDE
   115                              <2> ALIGN DISPLAY_JUMP_ALIGN
   116                              <2> CgaSnow_RepMovsb:
   117                              <2> 	call	LoadCgaStatusRegisterAddressToDXifCgaPresent
   118                              <2> 	jz		SHORT .RepMovsbWithoutWaitSinceUnknownPort
   119                              <2> 
   120                              <2> .MovsbNextByte:
   121                              <2> 	cli				; Interrupt request would mess up timing
   122                              <2> 	WAIT_UNTIL_SAFE_CGA_WRITE
   123                              <2> 	es movsb
   124                              <2> 	sti
   125                              <2> 	loop	.MovsbNextByte
   126                              <2> 	ret
   127                              <2> .RepMovsbWithoutWaitSinceUnknownPort:
   128                              <2> 	eSEG_STR rep, es, movsb
   129                              <2> 	ret
   130                              <2> %endif
   131                              <2> %undef EXCLUDE
   132                              <2> 
   133                              <2> 
   134                              <2> ;--------------------------------------------------------------------
   135                              <2> ; LoadCgaStatusRegisterAddressToDXifCgaPresent
   136                              <2> ;	Parameters:
   137                              <2> ;		DS:		BDA segment (zero)
   138                              <2> ;	Returns:
   139                              <2> ;		DX:		CGA Status Register Address
   140                              <2> ;		ZF:		Set if CGA not present
   141                              <2> ;				Cleared if CGA present
   142                              <2> ;	Corrupts registers:
   143                              <2> ;		Nothing
   144                              <2> ;--------------------------------------------------------------------
   145                              <2> ALIGN DISPLAY_JUMP_ALIGN
   146                              <2> LoadCgaStatusRegisterAddressToDXifCgaPresent:
   147                              <2> 	test	BYTE [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bFlags], FLG_CONTEXT_CGA
   148                              <2> 	jz		SHORT .NoCgaDetected
   149                              <2> 	mov		dx, CGA_STATUS_REGISTER
   150                              <2> ALIGN DISPLAY_JUMP_ALIGN, ret
   151                              <2> .NoCgaDetected:
   152                              <2> 	ret
   153                              <2> 
   154                              <2> 
   155                              <2> %endif ; ELIMINATE_CGA_SNOW
