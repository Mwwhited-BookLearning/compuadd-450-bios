   308                              <1> ; IdeTransfer_NormalizePointerInESSI
   309                              <1> ;	Parameters:
   310                              <1> ;		DH:		Number of sectors to transfer (when USE_AT defined)
   311                              <1> ;		ES:SI:	Ptr to be normalized
   312                              <1> ;	Returns:
   313                              <1> ;		ES:SI:	Normalized pointer (SI = 0...15)
   314                              <1> ;		AH:		INT 13h Error Code (when USE_AT defined and normalization was attempted)
   315                              <1> ;		CF:		Set if failed to normalize pointer (segment overflow)
   316                              <1> ;				Cleared if success
   317                              <1> ;	Corrupts registers:
   318                              <1> ;		AX, DX
   319                              <1> ;--------------------------------------------------------------------
   320                              <1> IdeTransfer_NormalizePointerInESSI:
   321                              <1> ; Normalization can cause segment overflow if it is done when not needed
   322                              <1> ; (I don't know if any software calls with such seg:off address).
   323                              <1> ; This does not apply to XT systems since nothing will write to main BIOS ROM.
   324                              <1> ; On AT systems things are quite different, even in protected mode the address
   325                              <1> ; is passed in seg:offset form and HMA is accessible in real mode.
   326                              <1> %ifdef USE_AT
   327 000012C3 30D2                <1> 	xor		dl, dl
   328                              <1> 	eSHL_IM	dx, 1
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 000012C5 01D2                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   329 000012C7 4A                  <1> 	dec		dx		; Prevents normalization when bytes + offset will be zero
   330 000012C8 01F2                <1> 	add		dx, si
   331 000012CA 7201                <1> 	jc		SHORT .NormalizationRequired
   332 000012CC C3                  <1> 	ret
   333                              <1> .NormalizationRequired:
   334                              <1> %endif ; USE_AT
   335                              <1> 
   336                              <1> 	NORMALIZE_FAR_POINTER	es, si, ax, dx
   149 000012CD 89F2                <2>  mov %4, %2
   150 000012CF 83E60F              <2>  and %2, BYTE 0Fh
   151                              <2>  eSHR_IM %4, 4
   657                              <3>  eSHIFT_IM %1, %2, shr
   631                              <4> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
