    93                              <1> ;--------------------------------------------------------------------
    94                              <1> ; SerialCommand_IdentifyDeviceToBufferInESSIwithDriveSelectByteInBH
    95                              <1> ;	Parameters:
    96                              <1> ;		BH:		Drive Select byte for Drive and Head Select Register
    97                              <1> ;		DS:		Segment to RAMVARS
    98                              <1> ;		ES:SI:	Ptr to buffer to receive 512-byte IDE Information
    99                              <1> ;		CS:BP:	Ptr to IDEVARS
   100                              <1> ;	Returns:
   101                              <1> ;		CF:		Cleared if success, Set if error
   102                              <1> ;	Corrupts registers:
   103                              <1> ;		AL, BL, CX, DX, SI, DI, ES
   104                              <1> ;--------------------------------------------------------------------
   105 00001746 90<rep 2h>          <1> ALIGN JUMP_ALIGN
   106                              <1> SerialCommand_IdentifyDeviceToBufferInESSIwithDriveSelectByteInBH:
   107                              <1> ;
   108                              <1> ; To improve boot time, we do our best to avoid looking for slave serial drives when we already know the results
   109                              <1> ; from the looking for a master.  This is particularly true when doing a COM port scan, as we will end up running
   110                              <1> ; through all the COM ports and baud rates a second time.
   111                              <1> ;
   112                              <1> ; But drive detection isn't the only case - we also need to get the right drive when called on int13h/25h.
   113                              <1> ;
   114                              <1> ; The decision tree:
   115                              <1> ;
   116                              <1> ;    Master:
   117                              <1> ;		   wSerialPortAndBaud Non-Zero:           -> Continue with wSerialPortAndBaud (1)
   118                              <1> ;		   wSerialPortAndBaud Zero:
   119                              <1> ;			   previous serial drive not found:   -> Scan (2)
   120                              <1> ;			   previous serial drive found:       -> Continue with previous serial drive info (3)
   121                              <1> ;
   122                              <1> ;    Slave:
   123                              <1> ;		   wSerialPortAndBaud Non-Zero:
   124                              <1> ;			   previous serial drive not found:   -> Error - Not Found (4)
   125                              <1> ;			   previous serial drive found:       -> Continue with wSerialPackedAndBaud (5)
   126                              <1> ;		   wSerialPortAndBaud Zero:
   127                              <1> ;			   previous serial drive not found:	  -> Error - Not Found (4)
   128                              <1> ;			   previous serial drive found:       -> Continue with previous serial drive info (6)
   129                              <1> ;
   130                              <1> ; (1) This was a port/baud that was explicitly set with the configurator.  In the drive detection case, as this
   131                              <1> ;     is the Master, we are checking out a new controller, and so don't care if we already have a serial drive.
   132                              <1> ;     And as with the int13h/25h case, we just go off and get the needed information using the user's setting.
   133                              <1> ; (2) We are using the special .ideVarsSerialAuto structure.  During drive detection, we would only be here
   134                              <1> ;     if we hadn't already seen a serial drive (since we only scan if no explicit drives are set),
   135                              <1> ;     so we go off to scan.
   136                              <1> ; (3) We are using the special .ideVarsSerialAuto structure.  We won't get here during drive detection, but
   137                              <1> ;     we might get here on an int13h/25h call.  If we have scanned COM drives, they are the ONLY serial drives
   138                              <1> ;     in use, and so we use the values from the previously seen serial drive DPT.
   139                              <1> ; (4) No master has been found yet, therefore no slave should be found.  Avoiding the slave reduces boot time,
   140                              <1> ;     especially in the full COM port scan case.  Note that this is different from the hardware IDE, where we
   141                              <1> ;     will scan for a slave even if a master is not present.  Note that if ANY master had been previously found,
   142                              <1> ;     we will do the slave scan, which isn't harmful, it just wastes time.  But the most common case (by a wide
   143                              <1> ;     margin) will be just one serial controller.
   144                              <1> ; (5) A COM port scan for a master had been previously completed, and a drive was found.  In a multiple serial
   145                              <1> ;     controller scenario being called with int13h/25h, we need to use the value in bSerialPackedPortAndBaud
   146                              <1> ;     to make sure we get the proper drive.
   147                              <1> ; (6) A COM port scan for a master had been previously completed, and a drive was found.  We would only get here
   148                              <1> ;     if no serial drive was explicitly set by the user in the configurator or that drive had not been found.
   149                              <1> ;     Instead of performing the full COM port scan for the slave, use the port/baud value stored during the
   150                              <1> ;     master scan.
   151                              <1> ;
   152 00001748 2E8B5600            <1> 	mov		dx, [cs:bp+IDEVARS.wSerialPortAndBaud]
   153 0000174C 31C0                <1> 	xor		ax, ax
   154                              <1> 
   155 0000174E 56                  <1> 	push	si
   156 0000174F E86AEF              <1> 	call	FindDPT_ToDSDIforSerialDevice	; Preserves AX
   157 00001752 5E                  <1> 	pop		si
   158                              <1> %ifdef MODULE_SERIAL_FLOPPY
   159 00001753 7306                <1> 	jnc		SHORT .founddpt
   160                              <1> ;
   161                              <1> ; If not found above with FindDPT_ToDSDIforSerialDevice, DI will point to the DPT after the last hard disk DPT
   162                              <1> ; So, if there was a previously found floppy disk, DI will point to that DPT and we use that value for the slave.
   163                              <1> ;
   164 00001755 38060C00            <1> 	cmp		[RAMVARS.xlateVars+XLATEVARS.bFlopCntAndFirst], al	; Zero?
   165 00001759 7403                <1> 	je		SHORT .notfounddpt
   166                              <1> .founddpt:
   167                              <1> %else
   168                              <1> 	jc		SHORT .notfounddpt
   169                              <1> %endif
   170 0000175B 8B4514              <1> 	mov		ax, [di+DPT_SERIAL.wSerialPortAndBaud]
   171                              <1> .notfounddpt:
   172 0000175E F6C710              <1> 	test	bh, FLG_DRVNHEAD_DRV
   173 00001761 7404                <1> 	jz		SHORT .master
   174                              <1> 
   175 00001763 85C0                <1> 	test	ax, ax							; Take care of the case that is different between master and slave.
   176 00001765 74DD                <1> 	jz		SHORT SerialCommand_ReturnError
   177                              <1> 
   178                              <1> ; fall-through
   179                              <1> .master:
   180 00001767 85D2                <1> 	test	dx, dx
   181 00001769 7501                <1> 	jnz		SHORT .identifyDeviceInDX
   182                              <1> 
   183 0000176B 92                  <1> 	xchg	dx, ax							;  move ax to dx (move previously found serial drive to dx, could be zero)
   184                              <1> 
   185                              <1> .identifyDeviceInDX:
   186                              <1> ; fall through to SerialCommand_FallThroughToSerialServerScan_ScanForServer
   187                              <1> 
   188                              <1> ALIGN JUMP_ALIGN
