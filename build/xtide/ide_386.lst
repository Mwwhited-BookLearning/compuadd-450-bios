   261                              <1> 	; Normalize pointer for PIO-transfers and convert to physical address for DMA transfers
   262                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
   263                              <1> 	jb		SHORT IdeTransfer_NormalizePointerInESSI
   264                              <1> 
   265                              <1> 	; Convert ES:SI to physical address
   266                              <1> %ifdef USE_386		; 17 bytes
   267                              <1> 	mov		dx, es				; 2
   268                              <1> 	xor		ax, ax				; 2
   269                              <1> 	shld	ax, dx, 4			; 3
   270                              <1> 	shl		dx, 4				; 3
   271                              <1> 	add		si, dx				; 2
   272                              <1> 	adc		al, ah				; 2
   273                              <1> 	mov		es, ax				; 2
   274                              <1> 							;------
   275                              <1> 							;	 16 cycles on 386
   276                              <1> %elifdef USE_186	; 17 bytes
   277                              <1> 	mov		ax, es				; 2
   278                              <1> 	rol		ax, 4				; 3
   279                              <1> 	mov		dx, ax				; 2
   280                              <1> 	and		al, 0F0h			; 2
   281                              <1> 	xor		dx, ax				; 2
   282                              <1> 	add		si, ax				; 2
   283                              <1> 	adc		dl, dh				; 2
   284                              <1> 	mov		es, dx				; 2
   285                              <1> 							;------
   286                              <1> 							;	 17 cycles on 386
   287                              <1> %else ; 808x
   288                              <1> 	mov		al, 4
   289                              <1> 	mov		dx, es
   290                              <1> 	xchg	cx, ax
   291                              <1> 	rol		dx, cl
   292                              <1> 	mov		cx, dx
   293                              <1> 	xchg	cx, ax
   294                              <1> 	and		al, 0F0h
   295                              <1> 	xor		dx, ax
   296                              <1> 	add		si, ax
   297                              <1> 	adc		dl, dh
   298                              <1> 	mov		es, dx
   299                              <1> 
   300                              <1> %endif
