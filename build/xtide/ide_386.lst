    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Timer_InitializeTimeoutWithTicksInCL
    25                              <1> ;	Parameters:
    26                              <1> ;		CL:		Timeout value in system timer ticks
    27                              <1> ;		DS:		Segment to RAMVARS
    28                              <1> ;	Returns:
    29                              <1> ;		Nothing
    30                              <1> ;	Corrupts registers:
    31                              <1> ;		CX
    32                              <1> ;--------------------------------------------------------------------
    33 00000EAA 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    34                              <1> Timer_InitializeTimeoutWithTicksInCL:
    35 00000EAC 880E0800            <1> 	mov		[RAMVARS.bTimeoutTicksLeft], cl		; Ticks until timeout
    36 00000EB0 E83900              <1> 	call	ReadTimeFromBdaToCX
    37 00000EB3 880E0900            <1> 	mov		[RAMVARS.bLastTimeoutUpdate], cl	; Start time
    38 00000EB7 C3                  <1> 	ret
    39                              <1> 
    40                              <1> 
    41                              <1> ;--------------------------------------------------------------------
    42                              <1> ; Timer_SetCFifTimeout
    43                              <1> ;	Parameters:
    44                              <1> ;		DS:		Segment to RAMVARS
    45                              <1> ;	Returns:
    46                              <1> ;		CF:		Set if timeout
    47                              <1> ;				Cleared if time left
    48                              <1> ;	Corrupts registers:
    49                              <1> ;		CX
    50                              <1> ;--------------------------------------------------------------------
    51                              <1> ALIGN JUMP_ALIGN
    52                              <1> Timer_SetCFifTimeout:
    53 00000EB8 E83100              <1> 	call	ReadTimeFromBdaToCX
    54 00000EBB 3A0E0900            <1> 	cmp		cl, [RAMVARS.bLastTimeoutUpdate]
    55 00000EBF 7409                <1> 	je		SHORT .StillPollingTheSameTick
    56 00000EC1 880E0900            <1> 	mov		[RAMVARS.bLastTimeoutUpdate], cl
    57 00000EC5 802E080001          <1> 	sub		BYTE [RAMVARS.bTimeoutTicksLeft], 1	; DEC does not update CF
    58                              <1> .StillPollingTheSameTick:
    59 00000ECA C3                  <1> 	ret
    60                              <1> 
    61                              <1> 
    62                              <1> ;--------------------------------------------------------------------
    63                              <1> ; Delay is always at least one millisecond since
    64                              <1> ; RTC resolution is 977 microsecs.
    65                              <1> ;
    66                              <1> ; Timer_DelayMicrosecondsFromAX
    67                              <1> ;	Parameters:
    68                              <1> ;		AX:		Number of microsecs to wait
    69                              <1> ;	Returns:
    70                              <1> ;		Nothing
    71                              <1> ;	Corrupts registers:
    72                              <1> ;		AX
    73                              <1> ;--------------------------------------------------------------------
    74                              <1> Timer_DelayMicrosecondsFromAX:
    75                              <1> %ifndef USE_AT
    76                              <1> 	mov		ax, 2
    77                              <1> 	; Fall to Timer_DelayTimerTicksFromAX
    78                              <1> %else
    79 00000ECB 52                  <1> 	push	dx
    80 00000ECC 51                  <1> 	push	cx
    81                              <1> 
    82 00000ECD 31C9                <1> 	xor		cx, cx
    83 00000ECF 92                  <1> 	xchg	dx, ax						; Microsecs now in CX:DX
    84 00000ED0 B486                <1> 	mov		ah, EVENT_WAIT
    85 00000ED2 CD15                <1> 	int		BIOS_SYSTEM_INTERRUPT_15h
    86 00000ED4 FB                  <1> 	sti									; XT BIOSes return with interrupts disabled. TODO: Maybe we can remove this since it's in an AT-only block?
    87                              <1> 
    88 00000ED5 59                  <1> 	pop		cx
    89 00000ED6 5A                  <1> 	pop		dx
    90 00000ED7 B80100              <1> 	mov		ax, 1								; Prepare to wait 1 timer tick
    91 00000EDA 7201                <1> 	jc		SHORT Timer_DelayTimerTicksFromAX	; Event Wait was unsupported or busy
    92 00000EDC C3                  <1> 	ret
    93                              <1> %endif
    94                              <1> 
    95                              <1> 
    96                              <1> ;--------------------------------------------------------------------
    97                              <1> ; First tick might take 0...54.9 ms and remaining ticks
    98                              <1> ; will occur at 54.9 ms intervals.
    99                              <1> ;
   100                              <1> ; Timer_DelayTimerTicksFromAX
   101                              <1> ;	Parameters:
   102                              <1> ;		AX:		Number of timer ticks to wait
   103                              <1> ;	Returns:
   104                              <1> ;		Nothing
   105                              <1> ;	Corrupts registers:
   106                              <1> ;		AX
   107                              <1> ;--------------------------------------------------------------------
   108                              <1> Timer_DelayTimerTicksFromAX:
   109 00000EDD FB                  <1> 	sti								; Make sure that interrupts are enabled
   110 00000EDE E80B00              <1> 	call	ReadTimeFromBdaToCX
   111 00000EE1 01C8                <1> 	add		ax, cx					; AX = end time
   112                              <1> .WaitLoop:
   113 00000EE3 E80600              <1> 	call	ReadTimeFromBdaToCX
   114 00000EE6 39C1                <1> 	cmp		cx, ax
   115 00000EE8 75F9                <1> 	jne		SHORT .WaitLoop			; Loop until end time is reached
   116 00000EEA C3                  <1> 	ret
   117                              <1> 
   118                              <1> 
   119                              <1> ;--------------------------------------------------------------------
   120                              <1> ; ReadTimeFromBdaToCX
   121                              <1> ;	Parameters
   122                              <1> ;		Nothing
   123                              <1> ;	Returns:
   124                              <1> ;		CX:		System time in 54.9 ms ticks
   125                              <1> ;	Corrupts registers:
   126                              <1> ;		Nothing
   127                              <1> ;--------------------------------------------------------------------
   128 00000EEB 90                  <1> ALIGN JUMP_ALIGN
   129                              <1> ReadTimeFromBdaToCX:
   130 00000EEC 1E                  <1> 	push	ds
   131                              <1> 	LOAD_BDA_SEGMENT_TO	ds, cx
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184                              <2>  xor %2, %2
   185                              <2>  mov %1, %2
   186                              <2> %else
   187 00000EED 6A00                <2>  push BYTE 0
   188 00000EEF 1F                  <2>  pop %1
   189                              <2> %endif
   132 00000EF0 8B0E6C04            <1> 	mov		cx, [BDA.dwTimerTicks]	; Read low WORD only
   133 00000EF4 1F                  <1> 	pop		ds
   134 00000EF5 C3                  <1> 	ret
