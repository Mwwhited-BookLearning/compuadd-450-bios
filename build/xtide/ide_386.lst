    55                              <1> ;--------------------------------------------------------------------
    56                              <1> ; GetTemporaryBufferForDPTEtoESDI
    57                              <1> ; GetBufferForDrive80hToESDI
    58                              <1> ;	Parameters:
    59                              <1> ;		DS:		RAMVARS segment
    60                              <1> ;	Returns:
    61                              <1> ;		ES:DI:	Ptr to buffer (in RAMVARS segment)
