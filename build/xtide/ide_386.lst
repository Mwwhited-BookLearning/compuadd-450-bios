    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Idepack_FakeToSSBP
    25                              <1> ;	Parameters:
    26                              <1> ;		Nothing
    27                              <1> ;	Returns:
    28                              <1> ;		SS:BP:	Ptr to IDEPACK
    29                              <1> ;	Corrupts registers:
    30                              <1> ;		AX
    31                              <1> ;--------------------------------------------------------------------
    32                              <1> Idepack_FakeToSSBP:
    33 00000DE1 58                  <1> 	pop		ax
    34 00000DE2 83EC0C              <1> 	sub		sp, BYTE SIZE_OF_IDEPACK_WITHOUT_INTPACK
    35 00000DE5 89E5                <1> 	mov		bp, sp
    36 00000DE7 FFE0                <1> 	jmp		ax
    37                              <1> 
    38                              <1> 
    39                              <1> ;--------------------------------------------------------------------
    40                              <1> ; Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    41                              <1> ;	Parameters:
    42                              <1> ;		AH:		IDE command to issue
    43                              <1> ;		BH:		Timeout ticks
    44                              <1> ;		BL:		IDE Status Register flag to wait after command
    45                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    46                              <1> ;		ES:SI:	Ptr to DAP (EBIOS Disk Address Packet)
    47                              <1> ;		SS:BP:	Ptr to IDEPACK
    48                              <1> ;	Returns:
    49                              <1> ;		AH:		INT 13h Error Code
    50                              <1> ;		CX:		Number of successfully transferred sectors (for transfer commands)
    51                              <1> ;		CF:		Cleared if success, Set if error
    52                              <1> ;	Corrupts registers:
    53                              <1> ;		AL, BX, (CX), DX, SI, ES
    54                              <1> ;--------------------------------------------------------------------
    55                              <1> %ifdef MODULE_EBIOS
    56 00000DE9 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    57                              <1> Idepack_ConvertDapToIdepackAndIssueCommandFromAH:
    58 00000DEC 268A4402            <1> 	mov		al, [es:si+DAP.wSectorCount]
    59 00000DF0 884602              <1> 	mov		[bp+IDEPACK.bSectorCount], al
    60 00000DF3 886606              <1> 	mov		[bp+IDEPACK.bCommand], ah
    61                              <1> 
    62 00000DF6 268A4408            <1> 	mov		al, [es:si+DAP.qwLBA]		; LBA byte 0
    63 00000DFA 884603              <1> 	mov		[bp+IDEPACK.bLbaLow], al
    64 00000DFD 268B4409            <1> 	mov		ax, [es:si+DAP.qwLBA+1]		; LBA bytes 1 and 2
    65 00000E01 894604              <1> 	mov		[bp+IDEPACK.wLbaMiddleAndHigh], ax
    66 00000E04 268A640B            <1> 	mov		ah, [es:si+DAP.qwLBA+3]		; LBA byte 3, LBA28 bits 24...27
    67 00000E08 886609              <1> 	mov		[bp+IDEPACK.bLbaLowExt], ah
    68 00000E0B 268B4C0C            <1> 	mov		cx, [es:si+DAP.qwLBA+4]		; LBA bytes 4 and 5
    69 00000E0F 894E0A              <1> 	mov		[bp+IDEPACK.wLbaMiddleAndHighExt], cx
    70                              <1> 
    71 00000E12 80E40F              <1> 	and		ah, 0Fh						; Limit bits for LBA28
    72 00000E15 E8D0F8              <1> 	call	AccessDPT_GetDriveSelectByteToAL
    73 00000E18 08E0                <1> 	or		al, ah
    74 00000E1A 884601              <1> 	mov		[bp+IDEPACK.bDrvAndHead], al
    75                              <1> 
    76                              <1> 	; Load data buffer pointer to ES:SI
    77 00000E1D 26C47404            <1> 	les		si, [es:si+DAP.dwMemoryAddress]
    78 00000E21 EB1A                <1> 	jmp		SHORT GetDeviceControlByteToIdepackAndStartTransfer
    79                              <1> %endif ; MODULE_EBIOS
    80                              <1> 
    81                              <1> 
    82                              <1> ;--------------------------------------------------------------------
    83                              <1> ; Idepack_TranslateOldInt13hAddressAndIssueCommandFromAH
    84                              <1> ;	Parameters:
    85                              <1> ;		AH:		IDE command to issue
    86                              <1> ;		AL:		Number of sectors to transfer (for xfer commands)
    87                              <1> ;		BH:		Timeout ticks
    88                              <1> ;		BL:		IDE Status Register flag to wait after command
    89                              <1> ;		CH:		Cylinder number, bits 7...0
    90                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9 and 8
    91                              <1> ;				Bits 5...0:	Starting sector number (1...63)
    92                              <1> ;		DH:		Starting head number (0...255)
    93                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    94                              <1> ;		ES:SI:	Ptr to normalized data buffer (for xfer commands)
    95                              <1> ;		SS:BP:	Ptr to IDEPACK (containing INTPACK)
    96                              <1> ;	Returns:
    97                              <1> ;		AH:		INT 13h Error Code
    98                              <1> ;		CX:		Number of successfully transferred sectors (for transfer commands)
    99                              <1> ;		CF:		Cleared if success, Set if error
   100                              <1> ;	Corrupts registers:
   101                              <1> ;		AL, BX, (CX), DX
   102                              <1> ;--------------------------------------------------------------------
   103 00000E23 90                  <1> ALIGN JUMP_ALIGN
   104                              <1> Idepack_TranslateOldInt13hAddressAndIssueCommandFromAH:
   105 00000E24 884602              <1> 	mov		[bp+IDEPACK.bSectorCount], al
   106 00000E27 886606              <1> 	mov		[bp+IDEPACK.bCommand], ah
   107                              <1> 
   108 00000E2A 53                  <1> 	push	bx
   109 00000E2B E8C20D              <1> 	call	Address_OldInt13hAddressToIdeAddress
   110 00000E2E E8B7F8              <1> 	call	AccessDPT_GetDriveSelectByteToAL
   111 00000E31 08F8                <1> 	or		al, bh			; AL now has Drive and Head Select Byte
   112 00000E33 884601              <1> 	mov		[bp+IDEPACK.bDrvAndHead], al
   113 00000E36 885E03              <1> 	mov		[bp+IDEPACK.bLbaLow], bl
   114 00000E39 894E04              <1> 	mov		[bp+IDEPACK.wLbaMiddleAndHigh], cx
   115 00000E3C 5B                  <1> 	pop		bx
   116                              <1> 	; Fall to GetDeviceControlByteToIdepackAndStartTransfer
   117                              <1> 
   118                              <1> GetDeviceControlByteToIdepackAndStartTransfer:
   119 00000E3D E8B0F8              <1> 	call	AccessDPT_GetDeviceControlByteToAL
   120 00000E40 884607              <1> 	mov		[bp+IDEPACK.bDeviceControl], al
   121 00000E43 EB4F                <1> 	jmp		Device_OutputCommandWithParameters
   122                              <1> 
   123                              <1> 
   124                              <1> ;--------------------------------------------------------------------
   125                              <1> ; Idepack_StoreNonExtParametersAndIssueCommandFromAL
   126                              <1> ;	Parameters:
   127                              <1> ;		BH:		Timeout ticks
   128                              <1> ;		BL:		IDE Status Register flag to wait after command
   129                              <1> ;		AL:		IDE command to issue
   130                              <1> ;		AH:		Parameter to Drive and Head Select Register (Head bits only)
   131                              <1> ;		DL:		Parameter to Sector Count Register
   132                              <1> ;		DH:		Parameter to LBA Low / Sector Number Register
   133                              <1> ;		CL:		Parameter to LBA Middle / Cylinder Low Register
   134                              <1> ;		CH:		Parameter to LBA High / Cylinder High Register
   135                              <1> ;		SI:		Parameter to Features Register
   136                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   137                              <1> ;		SS:BP:	Ptr to IDEPACK
   138                              <1> ;	Returns:
   139                              <1> ;		AH:		INT 13h Error Code
   140                              <1> ;		CF:		Cleared if success, Set if error
   141                              <1> ;	Corrupts registers:
   142                              <1> ;		AL, BX, CX, DX
   143                              <1> ;--------------------------------------------------------------------
   144 00000E45 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   145                              <1> Idepack_StoreNonExtParametersAndIssueCommandFromAL:
   146 00000E48 897600              <1> 	mov		[bp+IDEPACK.bFeatures], si
   147 00000E4B 884606              <1> 	mov		[bp+IDEPACK.bCommand], al
   148 00000E4E 895602              <1> 	mov		[bp+IDEPACK.wSectorCountAndLbaLow], dx
   149 00000E51 894E04              <1> 	mov		[bp+IDEPACK.wLbaMiddleAndHigh], cx
   150                              <1> 
   151                              <1> 	; Drive and Head select byte
   152 00000E54 80E40F              <1> 	and		ah, MASK_DRVNHEAD_HEAD		; Keep head bits only
   153 00000E57 E88EF8              <1> 	call	AccessDPT_GetDriveSelectByteToAL
   154 00000E5A 08E0                <1> 	or		al, ah
   155 00000E5C 884601              <1> 	mov		[bp+IDEPACK.bDrvAndHead], al
   156                              <1> 
   157                              <1> 	; Device Control byte with interrupts disabled
   158 00000E5F C6460702            <1> 	mov		BYTE [bp+IDEPACK.bDeviceControl], FLG_DEVCONTROL_nIEN
   159                              <1> 
   160 00000E63 EB2F                <1> 	jmp		Device_OutputCommandWithParameters
   286                                  	%include "Device.asm"
