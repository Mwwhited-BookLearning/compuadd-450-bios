   302 000006CC 51                  <1> 	push	cx
   303                              <1> 
   304 000006CD BF1000              <1> 	mov		di, RAMVARS_size			; Point DS:DI to first DPT
   305                              <1> 	eMOVZX	cx, BYTE [RAMVARS.bDrvCnt]
