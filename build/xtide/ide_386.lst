   184 00001A3A 4F                  <1> 	db		79						; Offset B: Maximum track number, 1.44MB value
   185 00001A3B 00                  <1> 	db		0						; Offset C: Data transfer rate, 1.44MB value
   186 00001A3C 04                  <1> 	db		4						; Offset D: Diskette CMOS drive type, 1.44MB value
   187                              <1> %else
   188                              <1> 	db		39						; Offset B: Maximum track number, 360KB value
   189                              <1> 	db		80h						; Offset C: Data transfer rate, 360KB value
   190                              <1> 	db		1						; Offset D: Diskette CMOS drive type, 360KB value
   191                              <1> %endif
