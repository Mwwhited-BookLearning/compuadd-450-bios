    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=42h, Extended Read Sectors.
    25                              <1> ;
    26                              <1> ; AH42h_HandlerForExtendedReadSectors
    27                              <1> ;	Parameters:
    28                              <1> ;		SI:		Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		DS:SI:	Ptr to Disk Address Packet
    34                              <1> ;	Returns with INTPACK:
    35                              <1> ;		AH:		Int 13h return status
    36                              <1> ;		CF:		0 if successful, 1 if error
    37                              <1> ;	Return with Disk Address Packet in INTPACK:
    38                              <1> ;		.wSectorCount	Number of sectors read successfully
    39                              <1> ;--------------------------------------------------------------------
    40 00001C71 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    41                              <1> AH42h_HandlerForExtendedReadSectors:
    42 00001C74 E8ADFF              <1> 	call	Prepare_ByLoadingDapToESSIandVerifyingForTransfer
    43 00001C77 2E8AA7[651C]        <1> 	mov		ah, [cs:bx+g_rgbReadCommandLookup]
    44 00001C7C BB08FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRQ)
    45 00001C7F E86AF1              <1> 	call	Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    46                              <1> 	; Fall to AH42h_ReturnFromInt13hAfterStoringErrorCodeFromAHandTransferredSectorsFromCX
    47                              <1> 
    48                              <1> 
    49                              <1> ;--------------------------------------------------------------------
    50                              <1> ; AH42h_ReturnFromInt13hAfterStoringErrorCodeFromAHandTransferredSectorsFromCX
    51                              <1> ;	Parameters:
    52                              <1> ;		AH:		INT 13h Error Code
    53                              <1> ;		CX:		Number of successfully transferred sectors
    54                              <1> ;		SS:BP:	Ptr to IDEPACK
    55                              <1> ;	Returns:
    56                              <1> ;		Nothing, jumps to Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    57                              <1> ;	Corrupts registers:
    58                              <1> ;		SI, DS
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> AH42h_ReturnFromInt13hAfterStoringErrorCodeFromAHandTransferredSectorsFromCX:
    61 00001C82 8E5E0E              <1> 	mov		ds, [bp+IDEPACK.intpack+INTPACK.ds]
    62 00001C85 8B7612              <1> 	mov		si, [bp+IDEPACK.intpack+INTPACK.si]
    63 00001C88 894C02              <1> 	mov		[si+DAP.wSectorCount], cx
    64 00001C8B E9F2FB              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
