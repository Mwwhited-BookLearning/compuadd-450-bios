   311                              <1> ; IdeCommand_ReadLBAlowRegisterToAL
   312                              <1> ;
   313                              <1> ; Returns LBA low register / Sector number register contents.
   314                              <1> ; Note that this returns valid value only after transfer command (read/write/verify)
   315                              <1> ; has stopped to an error. Do not call this otherwise.
   316                              <1> ;
   317                              <1> ;	Parameters:
   318                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   319                              <1> ;	Returns:
   320                              <1> ;		AL:		Byte read from the register
   321                              <1> ;	Corrupts registers:
   322                              <1> ;		BX, DX (only DX if MODULE_ATAPI is included)
