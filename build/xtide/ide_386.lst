    20                              <2> %ifndef INT_CONTROLLER_INC
    21                              <2> %define INT_CONTROLLER_INC
    22                              <2> 
    23                              <2> ; 8259 Master and Slave Interrupt Controller Ports
    24                              <2> MASTER_8259_IRR_AND_ISR_in	EQU		20h		; Interrupt Request Register / Interrupt In-Service Register
    25                              <2> MASTER_8259_COMMAND_out		EQU		20h		; Command output
    26                              <2> MASTER_8259_IMR				EQU		21h		; Interrupt Mask Register
    27                              <2> MASTER_8259_INIT_out		EQU		21h		; Initialization Command Parameters
    28                              <2> SLAVE_8259_IRR_AND_ISR_in	EQU		0A0h	; Interrupt Request Register / Interrupt In-Service Register
    29                              <2> SLAVE_8259_COMMAND_out		EQU		0A0h	; Command output
    30                              <2> SLAVE_8259_IMR				EQU		0A1h	; Interrupt Mask Register
    31                              <2> SLAVE_8259_INIT_out			EQU		0A1h	; Initialization Command Parameters
    32                              <2> 
    33                              <2> ; 8259 Interrupt Controller Commands
    34                              <2> COMMAND_CLEAR_ROTATE_IN_AUTOMATIC_EOI_MODE	EQU		00h
    35                              <2> COMMAND_READ_INTERRUPT_REQUEST_REGISTER		EQU		0Ah
    36                              <2> COMMAND_READ_INTERRUPT_INSERVICE_REGISTER	EQU		0Bh
    37                              <2> COMMAND_END_OF_INTERRUPT					EQU		20h
    38                              <2> COMMAND_NO_OPERATION						EQU		40h
    39                              <2> COMMAND_CLEAR_SPECIAL_MASK_MODE				EQU		48h
    40                              <2> COMMAND_SPECIFIC_EOI_FOR_IR0				EQU		60h
    41                              <2> COMMAND_SPECIFIC_EOI_FOR_IR1				EQU		61h
    42                              <2> COMMAND_SPECIFIC_EOI_FOR_IR2				EQU		62h
    43                              <2> COMMAND_SPECIFIC_EOI_FOR_IR3				EQU		63h
    44                              <2> COMMAND_SPECIFIC_EOI_FOR_IR4				EQU		64h
    45                              <2> COMMAND_SPECIFIC_EOI_FOR_IR5				EQU		65h
    46                              <2> COMMAND_SPECIFIC_EOI_FOR_IR6				EQU		66h
    47                              <2> COMMAND_SPECIFIC_EOI_FOR_IR7				EQU		67h
    48                              <2> COMMAND_SET_SPECIAL_MASK_MODE				EQU		68h
    49                              <2> COMMAND_SET_ROTATE_IN_AUTOMATIC_EOI_MODE	EQU		80h
    50                              <2> COMMAND_ROTATE_ON_NONSPECIFIC_EOI			EQU		0A0h
    51                              <2> COMMAND_IR0_LOWEST_PRIORITY					EQU		0C0h
    52                              <2> COMMAND_IR1_LOWEST_PRIORITY					EQU		0C1h
    53                              <2> COMMAND_IR2_LOWEST_PRIORITY					EQU		0C2h
    54                              <2> COMMAND_IR3_LOWEST_PRIORITY					EQU		0C3h
    55                              <2> COMMAND_IR4_LOWEST_PRIORITY					EQU		0C4h
    56                              <2> COMMAND_IR5_LOWEST_PRIORITY					EQU		0C5h
    57                              <2> COMMAND_IR6_LOWEST_PRIORITY					EQU		0C6h
    58                              <2> COMMAND_IR7_LOWEST_PRIORITY					EQU		0C7h
    59                              <2> COMMAND_EOI_AND_IR0_LOWEST_PRIORITY			EQU		0E0h
    60                              <2> COMMAND_EOI_AND_IR1_LOWEST_PRIORITY			EQU		0E1h
    61                              <2> COMMAND_EOI_AND_IR2_LOWEST_PRIORITY			EQU		0E2h
    62                              <2> COMMAND_EOI_AND_IR3_LOWEST_PRIORITY			EQU		0E3h
    63                              <2> COMMAND_EOI_AND_IR4_LOWEST_PRIORITY			EQU		0E4h
    64                              <2> COMMAND_EOI_AND_IR5_LOWEST_PRIORITY			EQU		0E5h
    65                              <2> COMMAND_EOI_AND_IR6_LOWEST_PRIORITY			EQU		0E6h
    66                              <2> COMMAND_EOI_AND_IR7_LOWEST_PRIORITY			EQU		0E7h
    67                              <2> 
    68                              <2> 
    69                              <2> %endif ; INT_CONTROLLER_INC
