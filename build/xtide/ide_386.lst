    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Creates new Disk Parameter Table for detected hard disk.
    25                              <1> ; Drive is then fully accessible using any BIOS function.
    26                              <1> ;
    27                              <1> ; CreateDPT_FromAtaInformation
    28                              <1> ;	Parameters:
    29                              <1> ;		BH:		Drive Select byte for Drive and Head Register
    30                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
    31                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    32                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
    33                              <1> ;		DS:		RAMVARS segment
    34                              <1> ;		ES:		BDA Segment
    35                              <1> ;	Returns:
    36                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    37                              <1> ;		CF:		Cleared
    38                              <1> ;	Corrupts registers:
    39                              <1> ;		AX, BX, CX, DX
    40                              <1> ;--------------------------------------------------------------------
    41                              <1> CreateDPT_FromAtaInformation:
    42 000005BE E8E700              <1> 	call	FindDPT_ForNewDriveToDSDI
    43                              <1> 	; Fall to .InitializeDPT
    44                              <1> 
    45                              <1> ;--------------------------------------------------------------------
    46                              <1> ; .InitializeDPT
    47                              <1> ;	Parameters:
    48                              <1> ;		BH:		Drive Select byte for Drive and Head Register
    49                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
    50                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    51                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
    52                              <1> ;	Returns:
    53                              <1> ;		Nothing
    54                              <1> ;	Corrupts registers:
    55                              <1> ;		AX
    56                              <1> ;--------------------------------------------------------------------
    57                              <1> .InitializeDPT:
    58 000005C1 E88300              <1> 	call	CreateDPT_StoreIdevarsOffsetAndBasePortFromCSBPtoDPTinDSDI
    59                              <1> 	; Fall to .StoreDriveSelectAndDriveControlByte
    60                              <1> 
    61                              <1> ;--------------------------------------------------------------------
    62                              <1> ; .StoreDriveSelectAndDriveControlByte
    63                              <1> ;	Parameters:
    64                              <1> ;		BH:		Drive Select byte for Drive and Head Register
    65                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    66                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    67                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
    68                              <1> ;	Returns:
    69                              <1> ;		Nothing
    70                              <1> ;	Corrupts registers:
    71                              <1> ;		AX
    72                              <1> ;--------------------------------------------------------------------
    73                              <1> .StoreDriveSelectAndDriveControlByte:
    74 000005C4 88F8                <1> 	mov		al, bh
    75 000005C6 83E010              <1> 	and		ax, BYTE FLG_DRVNHEAD_DRV		; AL now has Master/Slave bit
    76                              <1> %ifdef MODULE_IRQ
    77 000005C9 2E386605            <1> 	cmp		[cs:bp+IDEVARS.bIRQ], ah		; Interrupts enabled?
    78 000005CD 7402                <1> 	jz		SHORT .StoreFlags				;  If not, do not set interrupt flag
    79 000005CF 0C20                <1> 	or		al, FLGL_DPT_ENABLE_IRQ
    80                              <1> .StoreFlags:
    81                              <1> %endif
    82 000005D1 8905                <1> 	mov		[di+DPT.wFlags], ax
    83                              <1> 	; Fall to .StoreCHSparametersAndAddressingMode
    84                              <1> 
    85                              <1> ;--------------------------------------------------------------------
    86                              <1> ; .StoreCHSparametersAndAddressingMode
    87                              <1> ;	Parameters:
    88                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    89                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    90                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
    91                              <1> ;	Returns:
    92                              <1> ;		Nothing
    93                              <1> ;	Corrupts registers:
    94                              <1> ;		AX, BX, CX, DX
    95                              <1> ;--------------------------------------------------------------------
    96                              <1> .StoreCHSparametersAndAddressingMode:
    97                              <1> 	; Apply any user limited values to ATA ID
    98 000005D3 E83002              <1> 	call	AtaID_ModifyESSIforUserDefinedLimitsAndReturnTranslateModeInDX
    99                              <1> 
   100                              <1> 	; Translate P-CHS to L-CHS
   101 000005D6 E86C01              <1> 	call	AtaGeometry_GetLCHStoAXBLBHfromAtaInfoInESSIwithTranslateModeInDX
   102 000005D9 894506              <1> 	mov		[di+DPT.wLchsCylinders], ax
   103 000005DC 895D08              <1> 	mov		[di+DPT.wLchsHeadsAndSectors], bx
   104 000005DF 88D0                <1> 	mov		al, dl
   105                              <1> 	eSHL_IM	al, TRANSLATEMODE_FIELD_POSITION
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668                              <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 000005E1 C0E002              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   106 000005E4 08C1                <1> 	or		cl, al
   107                              <1> 
   108                              <1> 	; Store P-CHS and flags
   109 000005E6 E8AB01              <1> 	call	AtaGeometry_GetPCHStoAXBLBHfromAtaInfoInESSI
   110 000005E9 4A                  <1> 	dec		dx						; Set ZF if TRANSLATEMODE_LARGE, SF if TRANSLATEMODE_NORMAL
   111 000005EA 7E03                <1> 	jle		SHORT .JumpOverSetBitForAssistedLBA
   112                              <1> 
   113                              <1> 	; Set LBA bit for Assisted LBA
   114 000005EC 80C940              <1> 	or		cl, FLGL_DPT_LBA
   115                              <1> .JumpOverSetBitForAssistedLBA:
   116 000005EF 7506                <1> 	jnz		SHORT .NothingToChange
   117                              <1> 
   118                              <1> 	; We cannot have 16 P-Heads heads in Revised ECHS mode (8193 or more cylinders)
   119                              <1> 	; but 16 heads are allowed when there are 8192 or less cylinders (ECHS).
   120                              <1> 	; Both of these are LARGE modes so do not confuse with NORMAL mode.
   121 000005F1 E8CC01              <1> 	call	AtaGeometry_IsDriveSmallEnoughForECHS
   122 000005F4 83D3FF              <1> 	adc		bx, -1					; Adjust 16 P-Heads to 15 if needed
   123                              <1> 
   124                              <1> .NothingToChange:
   125 000005F7 080D                <1> 	or		[di+DPT.bFlagsLow], cl	; Shift count and addressing mode
   126 000005F9 895D0A              <1> 	mov		[di+DPT.wPchsHeadsAndSectors], bx
   127                              <1> %ifdef MODULE_COMPATIBLE_TABLES OR MODULE_EBIOS
   128                              <1> 	; Store P-Cylinders here for Compatible DPTs when FLGL_DPT_LBA is not set
   129                              <1> 	; or when drive has over 15,482,880 sectors
   130 000005FC 89450C              <1> 	mov		[di+DPT.wPchsCylinders], ax
   131                              <1> %endif
   132                              <1> 
   133                              <1> %ifdef MODULE_EBIOS
   134 000005FF F6C140              <1> 	test	cl, FLGL_DPT_LBA
   135 00000602 7433                <1> 	jz		SHORT .NoLbaSoNoEBIOS
   136                              <1> 
   137                              <1> 	; Store P-Cylinders but only if we have 15,482,880 or less sectors since
   138                              <1> 	; we only need P-Cylinders so we can return it from AH=48h
   139 00000604 E81701              <1> 	call	AtaGeometry_GetLbaSectorCountToBXDXAXfromAtaInfoInESSI
   140 00000607 2D0140              <1> 	sub		ax, (MAX_SECTOR_COUNT_TO_RETURN_PCHS+1) & 0FFFFh
   141 0000060A 81DAEC00            <1> 	sbb		dx, (MAX_SECTOR_COUNT_TO_RETURN_PCHS+1) >> 16
   142 0000060E 83DB00              <1> 	sbb		bx, BYTE 0
   143 00000611 7316                <1> 	jnc		SHORT .StoreNumberOfLbaSectors
   144                              <1> 
   145                              <1> 	; Since we might have altered the default P-CHS parameters to be
   146                              <1> 	; presented to the drive (AH=09h), we need to calculate new
   147                              <1> 	; P-Cylinders. It could be read from the ATA ID after
   148                              <1> 	; COMMAND_INITIALIZE_DEVICE_PARAMETERS but that is too much trouble.
   149                              <1> 	; P-Cyls = MIN(16383*16*63, LBA sector count) / (P-Heads * P-Sectors per track)
   150 00000613 E80801              <1> 	call	AtaGeometry_GetLbaSectorCountToBXDXAXfromAtaInfoInESSI
   151 00000616 91                  <1> 	xchg	cx, ax							; Sector count to DX:CX
   152 00000617 8A450A              <1> 	mov		al, [di+DPT.bPchsHeads]
   153 0000061A F6650B              <1> 	mul		BYTE [di+DPT.bPchsSectorsPerTrack]
   154 0000061D 91                  <1> 	xchg	cx, ax
   155 0000061E F7F1                <1> 	div		cx								; AX = new P-Cylinders
   156                              <1> 
   157                              <1> 	; We could remove wPchsCylinders from DPT if we calculate it on AH=48h
   158                              <1> 	; (and for compatible DPTs) but that would require extra code so we save ROM space instead.
   159 00000620 89450C              <1> 	mov		[di+DPT.wPchsCylinders], ax
   160                              <1> 
   161                              <1> 	; Store CHS sector count as total sector count. We must not use
   162                              <1> 	; LBA sector count if it is 15,482,880 or less.
   163 00000623 F7E1                <1> 	mul		cx
   164 00000625 31DB                <1> 	xor		bx, bx
   165 00000627 EB05                <1> 	jmp		SHORT .StoreTotalSectorsFromBXDXAX
   166                              <1> 
   167                              <1> 
   168                              <1> ;--------------------------------------------------------------------
   169                              <1> ; .StoreNumberOfLbaSectors
   170                              <1> ;	Parameters:
   171                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   172                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   173                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
   174                              <1> ;	Returns:
   175                              <1> ;		Nothing
   176                              <1> ;	Corrupts registers:
   177                              <1> ;		AX, BX, CX, DX
   178                              <1> ;--------------------------------------------------------------------
   179                              <1> .StoreNumberOfLbaSectors:
   180                              <1> 	; Store LBA 28/48 total sector count
   181 00000629 E8F200              <1> 	call	AtaGeometry_GetLbaSectorCountToBXDXAXfromAtaInfoInESSI
   182 0000062C 080D                <1> 	or		[di+DPT.bFlagsLow], cl		; LBA48 flag
   183                              <1> .StoreTotalSectorsFromBXDXAX:
   184 0000062E 89450E              <1> 	mov		[di+DPT.twLbaSectors], ax
   185 00000631 895510              <1> 	mov		[di+DPT.twLbaSectors+2], dx
   186 00000634 895D12              <1> 	mov		[di+DPT.twLbaSectors+4], bx
   187                              <1> .NoLbaSoNoEBIOS:
   188                              <1> %endif ; MODULE_EBIOS
   189                              <1> 	; Fall to .StoreDeviceSpecificParameters
   190                              <1> 
   191                              <1> ;--------------------------------------------------------------------
   192                              <1> ; .StoreDeviceSpecificParameters
   193                              <1> ;	Parameters:
   194                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   195                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   196                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
   197                              <1> ;	Returns:
   198                              <1> ;		Nothing
   199                              <1> ;	Corrupts registers:
   200                              <1> ;		AX, BX, CX, DX
   201                              <1> ;--------------------------------------------------------------------
   202                              <1> .StoreDeviceSpecificParameters:
   203 00000637 E82B08              <1> 	call	Device_FinalizeDPT
   204                              <1> 
   205                              <1> ;----------------------------------------------------------------------
   206                              <1> ; Update drive counts (hard and floppy)
   207                              <1> ;----------------------------------------------------------------------
   208                              <1> %ifdef MODULE_SERIAL
   209                              <1> ; Device_FinalizeDPT returns with CF set only when a floppy was found which can't happen without MODULE_SERIAL
   210                              <1> %ifdef MODULE_SERIAL_FLOPPY
   211                              <1> ;
   212                              <1> ; These two instructions serve two purposes:
   213                              <1> ; 1. If the drive is a floppy drive (CF set), then we effectively increment the counter.
   214                              <1> ; 2. If this is a hard disk, and there have been any floppy drives previously added, then the hard disk is
   215                              <1> ;    effectively discarded.  This is more of a safety check then code that should ever normally be hit (see below).
   216                              <1> ;    Since the floppy DPT's come after the hard disk DPT's, without expensive (code size) code to relocate a DPT,
   217                              <1> ;    this was necessary.  Now, this situation shouldn't happen in normal operation, for a couple of reasons:
   218                              <1> ;		A. xtidecfg always puts configured serial ports at the end of the IDEVARS list
   219                              <1> ;		B. the auto serial code is always executed last
   220                              <1> ;		C. the serial server always returns floppy drives last
   221                              <1> ;
   222 0000063A 80160C0000          <1> 	adc		BYTE [RAMVARS.xlateVars+XLATEVARS.bFlopCreateCnt], 0
   223 0000063F 7504                <1> 	jnz		SHORT .AllDone
   224                              <1> %else ; ~MODULE_SERIAL_FLOPPY
   225                              <1> ;
   226                              <1> ; Even without floppy support enabled, we shouldn't try to mount a floppy image as a hard disk, which
   227                              <1> ; could lead to unpredictable results since no MBR will be present, etc.  The server doesn't know that
   228                              <1> ; floppies are supported, so it is important to still fail here if a floppy is seen during the drive scan.
   229                              <1> ;
   230                              <1> 	jc		SHORT .AllDone
   231                              <1> %endif ; MODULE_SERIAL_FLOPPY
   232                              <1> %endif ; MODULE_SERIAL
   233                              <1> 
   234 00000641 FE060B00            <1> 	inc		BYTE [RAMVARS.bDrvCnt]		; Increment drive count to RAMVARS
   235                              <1> 
   236                              <1> %ifdef MODULE_SERIAL
   237                              <1> .AllDone:
   238 00000645 F8                  <1> 	clc
   239                              <1> %endif
   240                              <1> 
   241 00000646 C3                  <1> 	ret
   242                              <1> 
   243                              <1> 
   244                              <1> ;--------------------------------------------------------------------
   245                              <1> ; CreateDPT_StoreIdevarsOffsetAndBasePortFromCSBPtoDPTinDSDI
   246                              <1> ;	Parameters:
   247                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
   248                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   249                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
   250                              <1> ;	Returns:
   251                              <1> ;		Nothing
   252                              <1> ;	Corrupts registers:
   253                              <1> ;		AX
   254                              <1> ;--------------------------------------------------------------------
   255                              <1> CreateDPT_StoreIdevarsOffsetAndBasePortFromCSBPtoDPTinDSDI:
   256 00000647 896D02              <1> 	mov		[di+DPT.bIdevarsOffset], bp		; IDEVARS must start in first 256 bytes of ROM
   257 0000064A 2E8B4600            <1> 	mov		ax, [cs:bp+IDEVARS.wBasePort]
   258 0000064E 894504              <1> 	mov		[di+DPT.wBasePort], ax
   259 00000651 C3                  <1> 	ret
   248                                  	%include "FindDPT.asm"			; For finding DPTs
