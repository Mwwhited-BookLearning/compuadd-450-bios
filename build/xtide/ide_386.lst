   147                              <1> ; Device_OutputCommandWithParameters
   148                              <1> ;	Parameters:
   149                              <1> ;		BH:		Default system timer ticks for timeout (can be ignored)
   150                              <1> ;		BL:		IDE Status Register bit to poll after command
   151                              <1> ;		ES:SI:	Ptr to buffer (for data transfer commands)
   152                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   153                              <1> ;		SS:BP:	Ptr to IDEPACK
   154                              <1> ;	Returns:
   155                              <1> ;		AH:		INT 13h Error Code
   156                              <1> ;		CX:		Number of successfully transferred sectors (for transfer commands)
   157                              <1> ;		CF:		Cleared if success, Set if error
   158                              <1> ;	Corrupts registers:
   159                              <1> ;		AL, BX, (CX), DX, (ES:SI for data transfer commands)
   160                              <1> ;--------------------------------------------------------------------
   161                              <1> %ifdef MODULE_SERIAL	; IDE + Serial
   162 00000E91 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   163                              <1> Device_OutputCommandWithParameters:
   164 00000E94 F6450104            <1> 	test	BYTE [di+DPT.bFlagsHigh], FLGH_DPT_SERIAL_DEVICE
   165                              <1> %ifdef USE_386
   166 00000E98 0F84C802            <1> 	jz		IdeCommand_OutputWithParameters
   167 00000E9C E94507              <1> 	jmp		SerialCommand_OutputWithParameters
   168                              <1> %else ; ~USE_386
   169                              <1> 	jnz		SHORT .OutputCommandToSerialPort
   170                              <1> 	jmp		IdeCommand_OutputWithParameters
   171                              <1> 
   172                              <1> ALIGN JUMP_ALIGN
   173                              <1> .OutputCommandToSerialPort:
   174                              <1> 	jmp		SerialCommand_OutputWithParameters
   175                              <1> %endif
   176                              <1> 
   177                              <1> %else					; IDE
   178                              <1> 	Device_OutputCommandWithParameters		EQU		IdeCommand_OutputWithParameters
   179                              <1> %endif
