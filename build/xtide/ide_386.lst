   177                              <2> ; DisplayContext_PrepareOffScreenBufferInESBXwithLengthInCX
   178                              <2> ;	Parameters:
   179                              <2> ;		CX:		Off screen buffer length in characters
   180                              <2> ;		ES:BX:	Ptr to off screen buffer
   181                              <2> ;	Returns:
   182                              <2> ;		Nothing
   183                              <2> ;	Corrupts registers:
   184                              <2> ;		AX, DI
   185                              <2> ;--------------------------------------------------------------------
   186                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   187                              <2> ALIGN DISPLAY_JUMP_ALIGN
   188                              <2> DisplayContext_PrepareOffScreenBufferInESBXwithLengthInCX:
   189                              <2> 	push	ds
   190                              <2> 
   191                              <2> 	LOAD_BDA_SEGMENT_TO	ds, di
   192                              <2> 	xchg	ax, bx
   193                              <2> 	mov		bx, es
   194                              <2> 	call	DisplayContext_SetCharacterPointerFromBXAX	; ES:DI now has the pointer
   195                              <2> 
   196                              <2> 	mov		bl, ATTRIBUTES_NOT_USED
   197                              <2> 	mov		ax, BUFFER_OUTPUT_WITH_CHAR_ONLY
   198                              <2> 	call	DisplayContext_SetCharOutputFunctionFromAXwithAttribFlagInBL
   199                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.wCharOutParam], cx
   200                              <2> 
   201                              <2> 	mov		bx, di
   202                              <2> 	pop		ds
   203                              <2> 	ret
   204                              <2> %endif ; EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   205                              <2> 
   206                              <2> 
