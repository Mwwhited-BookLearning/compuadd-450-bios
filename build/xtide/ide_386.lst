    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Initializes RAMVARS.
    25                              <1> ; Drive detection can be started after this function returns.
    26                              <1> ;
    27                              <1> ; RamVars_Initialize
    28                              <1> ;	Parameters:
    29                              <1> ;		Nothing
    30                              <1> ;	Returns:
    31                              <1> ;		DS:		RAMVARS segment
    32                              <1> ;	Corrupts registers:
    33                              <1> ;		AX, CX, DX, DI
    34                              <1> ;--------------------------------------------------------------------
    35                              <1> RamVars_Initialize:
    36 000004D5 06                  <1> 	push	es
    37                              <1> 
    38 000004D6 2EA14200            <1> 	mov		ax, [cs:ROMVARS.wRamVars]
    39 000004DA 85C0                <1> 	test	ax, ax						; UMB segment or LITE_MODE_RAMVARS_SEGMENT?
    40 000004DC 750E                <1> 	jnz		SHORT .InitializeRamvars	; No need to steal RAM
    41                              <1> 
    42 000004DE BF1304              <1> 	mov		di, BDA.wBaseMem
    43 000004E1 8ED8                <1> 	mov		ds, ax
    44 000004E3 2EA04B00            <1> 	mov		al, [cs:ROMVARS.bStealSize]
    45 000004E7 2905                <1> 	sub		[di], ax
    46                              <1> %ifdef USE_186
    47 000004E9 6B0540              <1> 	imul	ax, [di], 64
    48                              <1> %else
    49                              <1> 	mov		al, 64
    50                              <1> 	mul		WORD [di]
    51                              <1> %endif
    52                              <1> 
    53                              <1> .InitializeRamvars:
    54 000004EC 31FF                <1> 	xor		di, di
    55 000004EE 8ED8                <1> 	mov		ds, ax
    56 000004F0 8EC0                <1> 	mov		es, ax
    57 000004F2 B91000              <1> 	mov		cx, RAMVARS_size
    58 000004F5 E888FE              <1> 	call	Memory_ZeroESDIwithSizeInCX
    59 000004F8 C70604005A5A        <1> 	mov		WORD [RAMVARS.wDrvDetectSignature], RAMVARS_DRV_DETECT_SIGNATURE
    60 000004FE C70606005875        <1> 	mov		WORD [RAMVARS.wSignature], RAMVARS_RAM_SIGNATURE
    61                              <1> %ifdef MODULE_DRIVEXLATE
    62 00000504 E8CF07              <1> 	call	DriveXlate_Reset
    63                              <1> %endif
    64                              <1> 
    65 00000507 07                  <1> 	pop		es
    66 00000508 C3                  <1> 	ret
    67                              <1> 
    68                              <1> 
    69                              <1> ;--------------------------------------------------------------------
    70                              <1> ; Returns segment to RAMVARS.
    71                              <1> ; RAMVARS might be located at the top of interrupt vectors (0030:0000h),
    72                              <1> ; at the top of system base RAM or in a user configured UMB.
    73                              <1> ;
    74                              <1> ; RamVars_GetSegmentToDS
    75                              <1> ;	Parameters:
    76                              <1> ;		Nothing
    77                              <1> ;	Returns:
    78                              <1> ;		DS:		RAMVARS segment
    79                              <1> ;	Corrupts registers:
    80                              <1> ;		DI
    81                              <1> ;--------------------------------------------------------------------
    82 00000509 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    83                              <1> RamVars_GetSegmentToDS:
    84 0000050C 2E8E1E4200          <1> 	mov		ds, [cs:ROMVARS.wRamVars]
    85 00000511 8CDF                <1> 	mov		di, ds
    86 00000513 85FF                <1> 	test	di, di					; UMB segment or LITE_MODE_RAMVARS_SEGMENT?
    87 00000515 7516                <1> 	jnz		SHORT .Return
    88                              <1> 
    89                              <1> ;%ifdef USE_186
    90                              <1> ;	imul	di, [BDA.wBaseMem], 64	; 2 bytes less but slower, especially on 386/486 processors
    91                              <1> ;%else
    92 00000517 8B3E1304            <1> 	mov		di, [BDA.wBaseMem]		; Load available base memory size in kB
    93                              <1> 	eSHL_IM	di, 6					; Segment to first stolen kB (*=40h)
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668                              <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 0000051B C1E706              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
    94                              <1> ;%endif
    95 0000051E 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    96                              <1> .LoopStolenKBs:
    97 00000520 8EDF                <1> 	mov		ds, di					; EBDA segment to DS
    98 00000522 83C740              <1> 	add		di, BYTE 64				; DI to next stolen kB
    99 00000525 813E06005875        <1> 	cmp		WORD [RAMVARS.wSignature], RAMVARS_RAM_SIGNATURE
   100 0000052B 75F3                <1> 	jne		SHORT .LoopStolenKBs	; Loop until sign found (always found eventually)
   101                              <1> .Return:
   102 0000052D C3                  <1> 	ret
   103                              <1> 
