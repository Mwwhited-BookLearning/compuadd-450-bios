   206                              <1> ; DetectPrint_TryToBootFromDL
   207                              <1> ;	Parameters:
   208                              <1> ;		DL:		Drive to boot from (translated, 00h or 80h)
   209                              <1> ;		DS:		RAMVARS segment
   210                              <1> ;	Returns:
   211                              <1> ;		Nothing
   212                              <1> ;	Corrupts registers:
   213                              <1> ;		AX, DH, SI, DI
   214                              <1> ;--------------------------------------------------------------------
   215                              <1> DetectPrint_TryToBootFromDL:
   216 000009EB 55                  <1> 	push	bp
   217 000009EC 89E5                <1> 	mov		bp, sp
   218                              <1> 
   219                              <1> %ifdef MODULE_DRIVEXLATE
   220                              <1> 
   221 000009EE E8A702              <1> 	call	DriveXlate_ToOrBack	; DL = Untranslated Drive number
   222 000009F1 88D6                <1> 	mov		dh, dl
   223 000009F3 E8A202              <1> 	call	DriveXlate_ToOrBack	; DL = Translated Drive number
   224                              <1> 
   225 000009F6 E88C02              <1> 	call	DriveXlate_ConvertDriveNumberFromDLtoDriveLetter	; DL = Translated letter
   226 000009F9 86F2                <1> 	xchg	dl, dh
   227 000009FB E88702              <1> 	call	DriveXlate_ConvertDriveNumberFromDLtoDriveLetter	; DL = Untranslated letter
   228 000009FE 52                  <1> 	push	dx
   229 000009FF 86F2                <1> 	xchg	dl, dh
   230 00000A01 52                  <1> 	push	dx
   231                              <1> 
   232 00000A02 E86F02              <1> 	call	DriveXlate_ConvertDriveLetterInDLtoDriveNumber	; Restore DL
   233                              <1> 
   234                              <1> %else
   235                              <1> 	ePUSH_T	ax, ' '			; No drive translation so print space
   236                              <1> 
   237                              <1> 	; Get boot drive letters
   238                              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
   239                              <1> 	test	dl, dl
   240                              <1> 	eCMOVNS	al, DEFAULT_FLOPPY_DRIVE_LETTER
   241                              <1> 	push	ax
   242                              <1> 
   243                              <1> %endif ; MODULE_DRIVEXLATE
   244                              <1> 
   245 00000A05 BE[F500]            <1> 	mov		si, g_szTryToBoot
   246 00000A08 EB03                <1> 	jmp		SHORT DetectPrint_FormatCSSIfromParamsInSSBP
