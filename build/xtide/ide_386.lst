    24                              <1> ; Int 13h function AH=43h, Extended Write Sectors.
    25                              <1> ;
    26                              <1> ; AH43h_HandlerForExtendedWriteSectors
    27                              <1> ;	Parameters:
    28                              <1> ;		SI:		Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		AL:		0 or 1 to write with verify off
    34                              <1> ;				2 to write with verify (if supported)
    35                              <1> ;		DS:SI:	Ptr to Disk Address Packet
    36                              <1> ;	Returns with INTPACK:
    37                              <1> ;		AH:		Int 13h return status
    38                              <1> ;		CF:		0 if successful, 1 if error
    39                              <1> ;	Return with Disk Address Packet in INTPACK:
    40                              <1> ;		.wSectorCount	Number of sectors written successfully
    41                              <1> ;--------------------------------------------------------------------
    42 00001C8E 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    43                              <1> AH43h_HandlerForExtendedWriteSectors:
    44 00001C90 807E1E02            <1> 	cmp		BYTE [bp+IDEPACK.intpack+INTPACK.al], 2	; Verify requested?
    45 00001C94 73C7                <1> 	jae		SHORT Prepare_ReturnFromInt13hWithInvalidFunctionError
    46                              <1> 
    47 00001C96 E88BFF              <1> 	call	Prepare_ByLoadingDapToESSIandVerifyingForTransfer
    48 00001C99 2E8AA7[691C]        <1> 	mov		ah, [cs:bx+g_rgbWriteCommandLookup]
    49 00001C9E BB08FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRQ)
    50 00001CA1 E848F1              <1> 	call	Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    51 00001CA4 EBDC                <1> 	jmp		SHORT AH42h_ReturnFromInt13hAfterStoringErrorCodeFromAHandTransferredSectorsFromCX
