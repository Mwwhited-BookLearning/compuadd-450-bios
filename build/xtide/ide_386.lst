    20                              <2> ; Section containing code
    21                              <2> SECTION .text
    22                              <2> 
    23                              <2> ;--------------------------------------------------------------------
    24                              <2> ; OPTIMIZE_STRING_OPERATION
    25                              <2> ;	Parameters
    26                              <2> ;		%1:		String instruction without size (only MOVS and STOS is supported)
    27                              <2> ;		CX:		Number of BYTEs to operate
    28                              <2> ;		DS:SI:	Ptr to source data (for MOVS)
    29                              <2> ;		ES:DI:	Ptr to destination
    30                              <2> ;	Returns:
    31                              <2> ;		CF:		Cleared
    32                              <2> ;		CX:		Zero
    33                              <2> ;		SI, DI:	Updated by number of bytes operated
    34                              <2> ;	Corrupts registers:
    35                              <2> ;		Nothing
    36                              <2> ;--------------------------------------------------------------------
    37                              <2> %macro OPTIMIZE_STRING_OPERATION 1
    38                              <2> 	shr		cx, 1
    39                              <2> 	rep		%1w
    40                              <2> 	eRCL_IM	cx, 1
    41                              <2> 	rep		%1b
    42                              <2> %endmacro
    43                              <2> 
    44                              <2> 
    45                              <2> ;--------------------------------------------------------------------
    46                              <2> ; Memory_CopyCXbytesFromDSSItoESDI
    47                              <2> ;	Parameters
    48                              <2> ;		CX:		Number of bytes to copy
    49                              <2> ;		DS:SI:	Ptr to source data
    50                              <2> ;		ES:DI:	Ptr to destination buffer
    51                              <2> ;	Returns:
    52                              <2> ;		CF:		Cleared
    53                              <2> ;		SI, DI:	Updated by number of bytes copied
    54                              <2> ;	Corrupts registers:
    55                              <2> ;		Nothing
    56                              <2> ;--------------------------------------------------------------------
    57                              <2> %ifndef EXCLUDE_FROM_XUB
    58                              <2> ALIGN JUMP_ALIGN
    59                              <2> Memory_CopyCXbytesFromDSSItoESDI:
    60                              <2> 	push	cx
    61                              <2> 	OPTIMIZE_STRING_OPERATION movs
    62                              <2> 	pop		cx
    63                              <2> 	ret
    64                              <2> %endif
    65                              <2> 
    66                              <2> 
    67                              <2> ;--------------------------------------------------------------------
    68                              <2> ; Memory_ZeroESDIwithSizeInCX
    69                              <2> ;	Parameters
    70                              <2> ;		CX:		Number of bytes to zero
    71                              <2> ;		ES:DI:	Ptr to destination buffer
    72                              <2> ;	Returns:
    73                              <2> ;		DI:		Updated by number of BYTEs stored
    74                              <2> ;	Corrupts registers:
    75                              <2> ;		AX, CX
    76                              <2> ;--------------------------------------------------------------------
    77 0000037E 90<rep 2h>          <2> ALIGN JUMP_ALIGN
    78                              <2> Memory_ZeroESDIwithSizeInCX:
    79 00000380 31C0                <2> 	xor		ax, ax
    80                              <2> 	; Fall to Memory_StoreCXbytesFromAccumToESDI
    81                              <2> 
    82                              <2> ;--------------------------------------------------------------------
    83                              <2> ; Memory_StoreCXbytesFromAccumToESDI
    84                              <2> ;	Parameters
    85                              <2> ;		AX:		Word to use to fill buffer
    86                              <2> ;		CX:		Number of BYTEs to store
    87                              <2> ;		ES:DI:	Ptr to destination buffer
    88                              <2> ;	Returns:
    89                              <2> ;		DI:		Updated by number of BYTEs stored
    90                              <2> ;	Corrupts registers:
    91                              <2> ;		CX
    92                              <2> ;--------------------------------------------------------------------
    93                              <2> Memory_StoreCXbytesFromAccumToESDI:
    94                              <2> 	OPTIMIZE_STRING_OPERATION stos
    38 00000382 D1E9                <3>  shr cx, 1
    39 00000384 F3AB                <3>  rep %1w
    40                              <3>  eRCL_IM cx, 1
   692                              <4> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   693                              <4> %ifdef USE_386
   694                              <4>  %if %2 = 1
   695                              <4>  FSIS ], %1
   696                              <4>  %if strpos
   697                              <4>  eSHIFT_IM %1, %2, rcl
   698                              <4>  %else
   699 00000386 11C9                <4>  adc %1, %1
   700                              <4>  %endif
   701                              <4>  %else
   702                              <4>  eSHIFT_IM %1, %2, rcl
   703                              <4>  %endif
   704                              <4> %else
   705                              <4>  eSHIFT_IM %1, %2, rcl
   706                              <4> %endif
   707                              <4> %endif
    41 00000388 F3AA                <3>  rep %1b
    95 0000038A C3                  <2> 	ret
    96                              <2> 
    97                              <2> 
    98                              <2> ;--------------------------------------------------------------------
    99                              <2> ; Memory_ZeroSSBPwithSizeInCX
   100                              <2> ;	Parameters
   101                              <2> ;		CX:		Number of bytes to zero
   102                              <2> ;		SS:BP:	Ptr to buffer to zero
   103                              <2> ;	Returns:
   104                              <2> ;		Nothing
   105                              <2> ;	Corrupts registers:
   106                              <2> ;		CX
   107                              <2> ;--------------------------------------------------------------------
   108                              <2> %ifdef INCLUDE_MENU_LIBRARY
   109                              <2> ALIGN JUMP_ALIGN
   110                              <2> Memory_ZeroSSBPwithSizeInCX:
   111                              <2> 	push	es
   112                              <2> 	push	di
   113                              <2> 	push	ax
   114                              <2> 	call	Registers_CopySSBPtoESDI
   115                              <2> 	call	Memory_ZeroESDIwithSizeInCX
   116                              <2> 	pop		ax
   117                              <2> 	pop		di
   118                              <2> 	pop		es
   119                              <2> 	ret
   120                              <2> %endif
   121                              <2> 
