   203                              <1> ;--------------------------------------------------------------------
   204                              <1> ; AtaID_GetMaxPioModeToAXandMinCycleTimeToCX
   205                              <1> ;	Parameters:
   206                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   207                              <1> ;	Returns:
   208                              <1> ;		AL:		Max supported PIO mode
   209                              <1> ;		AH:		FLGH_DPT_IORDY if IORDY supported, zero otherwise
   210                              <1> ;		CX:		Minimum Cycle Time in nanosecs
   211                              <1> ;	Corrupts registers:
   212                              <1> ;		BX
   213                              <1> ;--------------------------------------------------------------------
   214                              <1> AtaID_GetMaxPioModeToAXandMinCycleTimeToCX:
   215                              <1> 	; Get PIO mode and cycle time for PIO 0...2
   216                              <1> %ifdef USE_386
   217 00000856 260FB64467          <1> 	movzx	ax, BYTE [es:si+ATA1.bPioMode]	; AH = 0, AL = PIO mode 0, 1 or 2
   218 0000085B 678D1C00            <1> 	lea		bx, [eax+eax]
   219                              <1> %else
   220                              <1> 	mov		al, [es:si+ATA1.bPioMode]
   221                              <1> 	cbw
   222                              <1> 	mov		bx, ax
   223                              <1> 	eSHL_IM	bx, 1						; Shift for WORD lookup
   224                              <1> %endif
   225 0000085F 2E8B8F[8C08]        <1> 	mov		cx, [cs:bx+.rgwPio0to2CycleTimeInNanosecs]
   226                              <1> 
   227                              <1> 	; Check if IORDY is supported
   228 00000864 26F6446308          <1> 	test	BYTE [es:si+ATA2.wCaps+1], A2_wCaps_IORDY >> 8
   229 00000869 7420                <1> 	jz		SHORT .ReturnPioTimings		; No PIO 3 or higher if no IORDY
   230 0000086B B480                <1> 	mov		ah, FLGH_DPT_IORDY			; *FIXME* Actually, CF specification v4.1 says that use of IORDY is invalid for PIO modes 5 and 6.
   231                              <1> 
   232                              <1> 	; Check if Advanced PIO modes are supported (3 and above)
   233 0000086D 26F6446A02          <1> 	test	BYTE [es:si+ATA2.wFields], A2_wFields_64to70
   234 00000872 7417                <1> 	jz		SHORT .ReturnPioTimings
   235                              <1> 
   236                              <1> 	; Get Advanced PIO mode (Hard Disks supports up to 4 but CF cards can support 5 and 6)
   237 00000874 260ABC8000          <1> 	or		bh, [es:si+ATA2.bPIOSupp]
   238 00000879 7410                <1> 	jz		SHORT .ReturnPioTimings
   239                              <1> .CheckNextFlag:
   240 0000087B 40                  <1> 	inc		ax
   241 0000087C D0EF                <1> 	shr		bh, 1
   242 0000087E 75FB                <1> 	jnz		SHORT .CheckNextFlag
   243                              <1> 	MIN_U	al, 6						; Make sure not above lookup tables
    22 00000880 3C06                <2>  cmp %1, %2
    23 00000882 7202                <2>  jb %%Return
    24 00000884 B006                <2>  mov %1, %2
    25                              <2> %%Return:
   244 00000886 268B8C8800          <1> 	mov		cx, [es:si+ATA2.wPIOMinCyF]	; Advanced modes use IORDY
   245                              <1> .ReturnPioTimings:
   246 0000088B C3                  <1> 	ret
   247                              <1> 
