   113                              <2> ; BDA struct with only Hard Disk related locations
   114                              <2> struc HDBDA
   115 00000000 <res 474h>          <2> 					resb	474h
   116 00000474 ??                  <2> 	.bHDLastSt		resb	1		; 0:474h, Status of Last Operation (XT+)
   117 00000475 ??                  <2> 	.bHDCount		resb	1		; 0:475h, Number of HDs Attached (XT+)
   118 00000476 ??                  <2> 	.bHDCtrl		resb	1		; 0:476h, Control Byte (temp, XT+)
   119 00000477 ??                  <2> 	.bHDPortOff		resb	1		; 0:477h, Port Offset (XT)
   120 00000478 <res 15h>           <2> 					resb	15h
   121                              <2> 	.bHDStatus:						; 0:48Ch, Status Register (AT+)
   122                              <2> 	.bHDError:						; 0:48Dh, Error Register (AT+)
   123 0000048D ????                <2> 	.wHDStAndErr	resb	2
   124 0000048F ??                  <2> 	.bHDTaskFlg		resb	1		; 0:48Eh, Task Complete Flag (AT+)
   125                              <2> endstruc
