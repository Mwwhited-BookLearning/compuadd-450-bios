    57                              <1> %define ROM_VERSION_STRING		incbin "Revision.inc"	; This file must include a trailing space
    58                              <1> ; Note!
    59                              <1> ; NASM will throw weird errors when using ROM_VERSION_STRING if it's not a single statement on its own line.
    60                              <1> ; This is likely due to the "unusual" way it is defined above. Make sure to not have any additional strings
    61                              <1> ; on the same line, either before or after. In fact, do not even put a preceding label on the same line!
    62                              <1> %define BUILD_DATE_STRING		"(",__DATE__,")"
    63                              <1> %define FLASH_SIGNATURE			"XUB212"	; Also known as the ROMVARS version. Do not terminate with NULL.
