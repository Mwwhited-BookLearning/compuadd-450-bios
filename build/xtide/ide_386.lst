   215                              <1> ;--------------------------------------------------------------------
   216                              <1> ; StartDetectionWithDriveSelectByteInBHandStringInCX
   217                              <1> ;	Parameters:
   218                              <1> ;		BH:		Drive Select byte for Drive and Head Register
   219                              <1> ;		CX:		Offset to "Master" or "Slave" string
   220                              <1> ;		CS:BP:	Ptr to IDEVARS for the drive
   221                              <1> ;		DS:		RAMVARS segment
   222                              <1> ;		ES:		Zero (BDA segment)
   223                              <1> ;	Returns:
   224                              <1> ;		Nothing
   225                              <1> ;	Corrupts registers:
   226                              <1> ;		AX, BL, CX, DX, SI, DI
   227                              <1> ;--------------------------------------------------------------------
   228                              <1> StartDetectionWithDriveSelectByteInBHandStringInCX:
   229 00000964 E82400              <1> 	call	DetectPrint_StartDetectWithMasterOrSlaveStringInCXandIdeVarsInCSBP
   230                              <1> 	; Fall to .ReadAtaInfoFromHardDisk
