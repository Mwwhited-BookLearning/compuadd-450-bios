   259                              <1> DetectPrint_NullTerminatedStringFromCSSI:
   260                              <1> DetectPrint_NullTerminatedStringFromCSSIandSetCF:
   261                              <1> ;
   262                              <1> ; We send all CSSI strings through the Format routine for the case of
   263                              <1> ; compressed strings, but this doesn't hurt in the non-compressed case either
   264                              <1> ; (perhaps a little slower, but shouldn't be noticeable to the user)
   265                              <1> ; and results in smaller code size.
   266                              <1> ;
   267 00000A0A 55                  <1> 	push	bp
   268 00000A0B 89E5                <1> 	mov		bp, sp
   269                              <1> 	; Fall to DetectPrint_FormatCSSIfromParamsInSSBP
   270                              <1> 
   271                              <1> ;--------------------------------------------------------------------
   272                              <1> ; DetectPrint_FormatCSSIfromParamsInSSBP
   273                              <1> ;	Parameters:
   274                              <1> ;		CS:SI:	Ptr to string to format
   275                              <1> ;		BP:		SP before pushing parameters
   276                              <1> ;	Returns:
   277                              <1> ;		BP:		Popped from stack
   278                              <1> ;		CF:		Set since menu event was handled successfully
   279                              <1> ;	Corrupts registers:
   280                              <1> ;		AX, DI
   281                              <1> ;--------------------------------------------------------------------
   282                              <1> DetectPrint_FormatCSSIfromParamsInSSBP:
   283                              <1> 	CALL_DISPLAY_LIBRARY FormatNullTerminatedStringFromCSSI
    22                              <2>  %ifidn %1, PushDisplayContext
    23                              <2>  call DisplayContext_Push
    24                              <2>  %elifidn %1, PopDisplayContext
    25                              <2>  call DisplayContext_Pop
    26                              <2>  %elifidn %1, PrepareOffScreenBufferInESBXwithLengthInCX
    27                              <2>  call DisplayContext_PrepareOffScreenBufferInESBXwithLengthInCX
    28                              <2>  %else
    29 00000A0D BF[6401]            <2>  mov di, %1
    30 00000A10 E83AF7              <2>  call Display_FunctionFromDI
    31                              <2>  %endif
   284 00000A13 F9                  <1> 	stc				; Successful return from menu event
   285 00000A14 5D                  <1> 	pop		bp
   286 00000A15 C3                  <1> 	ret
