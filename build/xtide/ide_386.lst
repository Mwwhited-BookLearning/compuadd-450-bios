    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; BootSector_TryToLoadFromDriveDL_AndBoot
    25                              <1> ;	Parameters:
    26                              <1> ;		DL:		Drive to boot from (translated, 00h or 80h)
    27                              <1> ;		DS:		RAMVARS segment
    28                              <1> ;	Returns:
    29                              <1> ;		ES:BX:	Ptr to boot sector (if successful)
    30                              <1> ;		CF:		Cleared if boot sector loaded successfully
    31                              <1> ;				(only matters when jumping to
    32                              <1> ;				Int19h_JumpToBootSectorInESBXOrRomBoot)
    33                              <1> ;	Corrupts registers:
    34                              <1> ;		AX, CX, DH, SI, DI
    35                              <1> ;--------------------------------------------------------------------
    36                              <1> BootSector_TryToLoadFromDriveDL_AndBoot:
    37 00000D71 E877FC              <1> 	call	DetectPrint_TryToBootFromDL
    38 00000D74 E81D00              <1> 	call	BootSector_LoadFirstSectorFromDriveDL
    39 00000D77 7308                <1> 	jnc		SHORT .FirstSectorLoadedToESBX
    40                              <1> 
    41                              <1> 	; Do not display timeout error (80h) for floppy drives since
    42                              <1> 	; it most likely mean no diskette in drive. This way we do not
    43                              <1> 	; display error code every time user intends to boot from hard disk
    44                              <1> 	; when A then C boot order is used.
    45 00000D79 E84200              <1> 	call	BootSector_DriveDLIsEmptyFloppydrive
    46 00000D7C 742B                <1> 	jz		SHORT BootSector_LoadFirstSectorFromDriveDL.Return
    47                              <1> .PrintFailedToLoadErrorCode:
    48 00000D7E E95EFC              <1> 	jmp		DetectPrint_FailedToLoadFirstSector
    49                              <1> 
    50                              <1> .FirstSectorLoadedToESBX:
    51 00000D81 84D2                <1> 	test	dl, dl
    52 00000D83 79D3                <1> 	jns		SHORT Int19h_JumpToBootSectorInESBXOrRomBoot	; Don't check for boot sector signature for floppy booter games
    53 00000D85 2681BFFE0155AA      <1> 	cmp		WORD [es:bx+510], 0AA55h						; Valid boot sector?
    54 00000D8C 74CA                <1> 	je		SHORT Int19h_JumpToBootSectorInESBXOrRomBoot	; With CF cleared
    55 00000D8E BE[0001]            <1> 	mov		si, g_szBootSectorNotFound
    56 00000D91 E976FC              <1> 	jmp		DetectPrint_NullTerminatedStringFromCSSI
    57                              <1> 
    58                              <1> 
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> ; BootSector_LoadFirstSectorFromDriveDL
    61                              <1> ;	Parameters:
    62                              <1> ;		DL:		Drive to boot from (translated, 00h or 80h)
    63                              <1> ;	Returns:
    64                              <1> ;		AH:		INT 13h error code
    65                              <1> ;		ES:BX:	Ptr to boot sector (if successful)
    66                              <1> ;		CF:		Cleared if read successful
    67                              <1> ;				Set if any error
    68                              <1> ;	Corrupts registers:
    69                              <1> ;		AL, CX, DH, DI
    70                              <1> ;--------------------------------------------------------------------
    71                              <1> BootSector_LoadFirstSectorFromDriveDL:
    72                              <1> 	LOAD_BDA_SEGMENT_TO	es, bx				; ES:BX now points to...
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184                              <2>  xor %2, %2
   185                              <2>  mov %1, %2
   186                              <2> %else
   187 00000D94 6A00                <2>  push BYTE 0
   188 00000D96 07                  <2>  pop %1
   189                              <2> %endif
    73 00000D97 BB007C              <1> 	mov		bx, BOOTVARS.rgbBootSect		; ...boot sector location
    74 00000D9A BF0300              <1> 	mov		di, BOOT_READ_RETRY_TIMES		; Initialize retry counter
    75                              <1> 
    76                              <1> .ReadRetryLoop:
    77 00000D9D B80102              <1> 	mov		ax, 0201h						; Read 1 sector
    78 00000DA0 B90100              <1> 	mov		cx, 1							; Cylinder 0, Sector 1
    79 00000DA3 30F6                <1> 	xor		dh, dh							; Head 0
    80 00000DA5 CD13                <1> 	int		BIOS_DISK_INTERRUPT_13h
    81 00000DA7 7201                <1> 	jc		SHORT .FailedToLoadFirstSector
    82                              <1> .Return:
    83 00000DA9 C3                  <1> 	ret
    84                              <1> 
    85                              <1> .FailedToLoadFirstSector:
    86 00000DAA 4F                  <1> 	dec		di								; Decrement retry counter (preserve CF)
    87 00000DAB 74FC                <1> 	jz		SHORT .Return					; Loop while retries left
    88                              <1> 
    89                              <1> 	; If the boot drive is a floppy drive and it is deemed to be empty then
    90                              <1> 	; we give up immediately to avoid unnecessarily long delays when booting.
    91                              <1> 	; This is particularly aggravating when using builds with first-A-then-C
    92                              <1> 	; boot order (i.e. non-interactive builds such as the Tiny build).
    93 00000DAD E80E00              <1> 	call	BootSector_DriveDLIsEmptyFloppydrive
    94 00000DB0 74F7                <1> 	jz		SHORT .Return					; With CF set
    95                              <1> 
    96                              <1> 	; Reset drive and retry
    97 00000DB2 31C0                <1> 	xor		ax, ax							; AH=00h, Disk Controller Reset
    98 00000DB4 84D2                <1> 	test	dl, dl							; Floppy drive?
    99                              <1> 	eCMOVS	ah, RESET_HARD_DISK				; AH=0Dh, Reset Hard Disk (Alternate reset)
   356 00000DB6 7902                <2>  jns SHORT %%Return
   357 00000DB8 B40D                <2>  mov %1, %2
   358                              <2> %%Return:
   100 00000DBA CD13                <1> 	int		BIOS_DISK_INTERRUPT_13h
   101 00000DBC EBDF                <1> 	jmp		SHORT .ReadRetryLoop
   102                              <1> 
   103                              <1> 
   104                              <1> ;--------------------------------------------------------------------
   105                              <1> ; BootSector_DriveDLIsEmptyFloppydrive
   106                              <1> ;	Parameters:
   107                              <1> ;		AH:		INT 13h error code
   108                              <1> ;		DL:		Drive to boot from (translated, 00h or 80h)
   109                              <1> ;	Returns:
   110                              <1> ;		CF:		Set
   111                              <1> ;		ZF:		Set if DL is a floppy drive with no diskette inserted
   112                              <1> ;				Cleared if not
   113                              <1> ;	Corrupts registers:
   114                              <1> ;		Nothing
   115                              <1> ;--------------------------------------------------------------------
   116                              <1> BootSector_DriveDLIsEmptyFloppydrive:
   117 00000DBE 84D2                <1> 	test	dl, dl
   118 00000DC0 7508                <1> 	jnz		SHORT .Return					; Hard Drive
   119 00000DC2 80FC80              <1> 	cmp		ah, RET_HD_TIMEOUT
   120 00000DC5 7403                <1> 	je		SHORT .Return
   121 00000DC7 80FC31              <1> 	cmp		ah, RET_HD_NOMEDIA
   122                              <1> .Return:
   123 00000DCA F9                  <1> 	stc
   124 00000DCB C3                  <1> 	ret
   125                              <1> 
