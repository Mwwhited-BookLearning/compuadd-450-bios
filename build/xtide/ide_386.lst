   117                              <1> ;	Returns:
   118                              <1> ;		BX:DX:AX:	48-bit sector count
   119                              <1> ;	Corrupts registers:
   120                              <1> ;		Nothing
   121                              <1> ;--------------------------------------------------------------------
   122                              <1> AccessDPT_GetLbaSectorCountToBXDXAX:
   123 00000700 8B450E              <1> 	mov		ax, [di+DPT.twLbaSectors]
   124 00000703 8B5510              <1> 	mov		dx, [di+DPT.twLbaSectors+2]
   125 00000706 8B5D12              <1> 	mov		bx, [di+DPT.twLbaSectors+4]
   126 00000709 C3                  <1> 	ret
   127                              <1> %endif ; MODULE_EBIOS
   128                              <1> 
