    22                              <1> SECTION .text
    23                              <1> 
    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Adjust ATA information for compatibility, debug, etc purposes.
    26                              <1> ; We can also completely ignore the drive if necessary.
    27                              <1> ;
    28                              <1> ; AtaID_FixIllegalValuesFromESSI
    29                              <1> ;	Parameters:
    30                              <1> ;		AH:		INT 13h Error Code from reading ATA information
    31                              <1> ;		CF:		Cleared if successfully read ATA information,
    32                              <1> ;				Set if failed to read ATA information
    33                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    34                              <1> ;	Returns:
    35                              <1> ;		ES:SI:	Ata information with possible corrections made
    36                              <1> ;		AH:		INT 13h Error Code from reading ATA information
    37                              <1> ;		CF 		Cleared if drive now accepted
    38                              <1> ;	Corrupts registers:
    39                              <1> ;		AL, BX, CX, DX, DI
    40                              <1> ;--------------------------------------------------------------------
    41                              <1> %ifndef NO_ATAID_CORRECTION
    42                              <1> %ifndef EXCLUDE_FROM_BIOSDRVS
    43                              <1> AtaID_PopESSIandFixIllegalValuesFromESSI:
    44 000007F3 5E                  <1> 	pop		si
    45 000007F4 07                  <1> 	pop		es
    46                              <1> %endif
    47                              <1> AtaID_FixIllegalValuesFromESSI:	; Unused entrypoint OK
    48 000007F5 720E                <1> 	jc		SHORT .Return	; Nothing to fix since failed to read ATA Info
    49                              <1> 
    50                              <1> 	; Only correct cylinders since there are no reports that head or sectors could be wrong
    51 000007F7 B9FF3F              <1> 	mov		cx, MAX_PCHS_CYLINDERS
    52                              <1> 	MIN_U	[es:si+ATA1.wCylCnt], cx	; Limit to max allowed value
    22 000007FA 26394C02            <2>  cmp %1, %2
    23 000007FE 7204                <2>  jb %%Return
    24 00000800 26894C02            <2>  mov %1, %2
    25                              <2> %%Return:
    53                              <1> 
    54                              <1> 	; Note! There are ATA ID words 54-58 that also need to be modified! However,
    55                              <1> 	; the drive itself should modify them when we do Initialize Device Parameters command at AH=9h.
    56                              <1> 	; Verification from real drive needed before we fix them manually
    57                              <1> 
    58 00000804 F8                  <1> 	clc						; Return success
    59                              <1> .Return:
    60 00000805 C3                  <1> 	ret
    61                              <1> %endif ; NO_ATAID_CORRECTION
    62                              <1> 
    63                              <1> 
    64                              <1> %ifndef EXCLUDE_FROM_BIOSDRVS
    65                              <1> ;--------------------------------------------------------------------
    66                              <1> ; AtaID_VerifyFromESSI
    67                              <1> ;	Parameters:
    68                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    69                              <1> ;	Returns:
    70                              <1> ;		ZF:		Set if ATA-ID verified successfully
    71                              <1> ;				Cleared if failed to verify ATA-ID
    72                              <1> ;	Corrupts registers:
    73                              <1> ;		AX, BX, CX
    74                              <1> ;--------------------------------------------------------------------
    75                              <1> %ifndef NO_ATAID_VALIDATION
    76                              <1> AtaID_VerifyFromESSI:
    77                              <1> 	; We cannot start by reading ATA version since the ID might be
    78                              <1> 	; corrupted. We start by making sure P-CHS values are valid.
    79                              <1> 	; If they are, we assume the ATA ID to be valid. Fortunately we can do
    80                              <1> 	; further checking for ATA-5 and later since they contain signature and
    81                              <1> 	; checksum bytes. Those are not available for ATA-4 and older.
    82                              <1> 
    83                              <1> 	; Verify P-CHS cylinders
    84                              <1> 	mov		bx, ATA1.wCylCnt
    85                              <1> 	mov		ax, MAX_PCHS_CYLINDERS
    86                              <1> 	call	.CompareCHorSfromOffsetBXtoMaxValueInAX
    87                              <1> 
    88                              <1> 	mov		bl, ATA1.wHeadCnt & 0FFh
    89                              <1> 	mov		ax, MAX_PCHS_HEADS
    90                              <1> 	call	.CompareCHorSfromOffsetBXtoMaxValueInAX
    91                              <1> 
    92                              <1> 	mov		bl, ATA1.wSPT & 0FFh
    93                              <1> 	mov		al, MAX_PCHS_SECTORS_PER_TRACK
    94                              <1> 	call	.CompareCHorSfromOffsetBXtoMaxValueInAX
    95                              <1> 
    96                              <1> 	; Check signature byte. It is only found on ATA-5 and later. It should be zero on
    97                              <1> 	; ATA-4 and older.
    98                              <1> 	mov		al, [es:si+ATA6.bSignature]
    99                              <1> 	test	al, al
   100                              <1> 	jz		SHORT .AtaIDverifiedSuccessfully	; Old ATA so Signature and Checksum is not available
   101                              <1> 	cmp		al, A6_wIntegrity_SIGNATURE
   102                              <1> 	jne		SHORT .FailedToVerifyAtaID
   103                              <1> 
   104                              <1> 	; Check checksum byte since signature was present
   105                              <1> 	mov		cx, ATA6_size
   106                              <1> 	jmp		Memory_SumCXbytesFromESSItoAL		; Returns with ZF set according to result
   107                              <1> 
   108                              <1> ;--------------------------------------------------------------------
   109                              <1> ; .CompareCHorSfromOffsetBXtoMaxValueInAX
   110                              <1> ;	Parameters:
   111                              <1> ;		AX:		Maximum valid C, H or S value
   112                              <1> ;		BX:		C, H or S offset to ATA-ID
   113                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   114                              <1> ;	Returns:
   115                              <1> ;		Exits from AtaID_VerifyFromESSI with ZF cleared if invalid value
   116                              <1> ;	Corrupts registers:
   117                              <1> ;		CX
   118                              <1> ;--------------------------------------------------------------------
   119                              <1> .CompareCHorSfromOffsetBXtoMaxValueInAX:
   120                              <1> 	mov		cx, [es:bx+si]
   121                              <1> 	jcxz	.InvalidPCHorSinOffsetBX
   122                              <1> 	cmp		cx, ax			; Compare to max valid value
   123                              <1> 	jbe		SHORT .ValidPCHorSinOffsetBX
   124                              <1> .InvalidPCHorSinOffsetBX:
   125                              <1> 	pop		cx				; Clear return address for this function
   126                              <1> 	inc		cx				; Clear ZF to indicate invalid ATA-ID (safe to do since return address in CX will never be FFFFh)
   127                              <1> .AtaIDverifiedSuccessfully:
   128                              <1> .FailedToVerifyAtaID:
   129                              <1> .ValidPCHorSinOffsetBX:
   130                              <1> 	ret
   131                              <1> %endif ; NO_ATAID_VALIDATION
   132                              <1> 
   133                              <1> 
   134                              <1> ;--------------------------------------------------------------------
   135                              <1> ; Writes user defined limits from ROMVARS to ATA ID read from the drive.
   136                              <1> ; Modifying the ATA ID reduces code and possibilities for bugs since
   137                              <1> ; only little further checks are needed elsewhere.
   138                              <1> ;
   139                              <1> ; AtaID_ModifyESSIforUserDefinedLimitsAndReturnTranslateModeInDX
   140                              <1> ;	Parameters:
   141                              <1> ;		DS:DI:	Ptr to incomplete Disk Parameter Table
   142                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   143                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
   144                              <1> ;	Returns:
   145                              <1> ;		DX:		User defined P-CHS to L-CHS translate mode
   146                              <1> ;	Corrupts registers:
   147                              <1> ;		AX, BX
   148                              <1> ;--------------------------------------------------------------------
   149                              <1> AtaID_ModifyESSIforUserDefinedLimitsAndReturnTranslateModeInDX:
   150 00000806 E801FF              <1> 	call	AccessDPT_GetPointerToDRVPARAMStoCSBX
   151 00000809 1E                  <1> 	push	ds
   152                              <1> 
   153 0000080A 0E                  <1> 	push	cs
   154 0000080B 1F                  <1> 	pop		ds
   155                              <1> 
   156                              <1> 	; Load User Defined CHS or LBA to BX:AX
   157 0000080C 8A17                <1> 	mov		dl, [bx+DRVPARAMS.wFlags]			; Only load the flags we actually need
   158 0000080E 8B4702              <1> 	mov		ax, [bx+DRVPARAMS.wCylinders]		; Or .dwMaximumLBA
   159 00000811 8B5F04              <1> 	mov		bx, [bx+DRVPARAMS.wHeadsAndSectors]	; Or .dwMaximumLBA+2
   160                              <1> 
   161 00000814 06                  <1> 	push	es
   162 00000815 1F                  <1> 	pop		ds		; DS:SI now points to ATA information
   163                              <1> 
   164                              <1> 	; * User defined CHS *
   165 00000816 F6C220              <1> 	test	dl, FLG_DRVPARAMS_USERCHS
   166 00000819 7417                <1> 	jz		SHORT .NoUserDefinedCHS
   167                              <1> 
   168                              <1> 	; Apply new CHS and disable LBA (we also want to set CHS addressing)
   169 0000081B 894402              <1> 	mov		[si+ATA1.wCylCnt], ax
   170                              <1> 	eMOVZX	ax, bl
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 0000081E 0FB6C3              <2>  movzx %1, %2
   438                              <2> %endif
   171 00000821 894406              <1> 	mov		[si+ATA1.wHeadCnt], ax
   172 00000824 88F8                <1> 	mov		al, bh
   173 00000826 89440C              <1> 	mov		[si+ATA1.wSPT], ax
   174 00000829 806463FD            <1> 	and		BYTE [si+ATA1.wCaps+1], ~(A1_wCaps_LBA>>8)
   175 0000082D 80A4A700FB          <1> 	and		BYTE [si+ATA6.wSetSup83+1], ~(A6_wSetSup83_LBA48>>8)
   176                              <1> .NoUserDefinedCHS:
   177                              <1> 
   178                              <1> 	; * User defined LBA *
   179 00000832 F6C240              <1> 	test	dl, FLG_DRVPARAMS_USERLBA
   180 00000835 7417                <1> 	jz		SHORT .NoUserDefinedLBA
   181                              <1> 
   182                              <1> 	; Apply new LBA and disable LBA48
   183 00000837 3B5C7A              <1> 	cmp		bx, [si+ATA1.dwLBACnt+2]
   184 0000083A 7712                <1> 	ja		SHORT .NoUserDefinedLBA		; Do not set larger than drive
   185 0000083C 7205                <1> 	jb		SHORT .StoreNewLBA
   186 0000083E 3B4478              <1> 	cmp		ax, [si+ATA1.dwLBACnt]
   187 00000841 770B                <1> 	ja		SHORT .NoUserDefinedLBA		; Allow same size to disable LBA48
   188                              <1> .StoreNewLBA:
   189 00000843 894478              <1> 	mov		[si+ATA1.dwLBACnt], ax
   190 00000846 895C7A              <1> 	mov		[si+ATA1.dwLBACnt+2], bx
   191 00000849 80A4A700FB          <1> 	and		BYTE [si+ATA6.wSetSup83+1], ~(A6_wSetSup83_LBA48>>8)
   192                              <1> .NoUserDefinedLBA:
   193                              <1> 
   194                              <1> 	; * Load P-CHS to L-CHS translate mode to DX *
   195 0000084E 83E20C              <1> 	and		dx, BYTE MASK_DRVPARAMS_TRANSLATEMODE
   196                              <1> 	eSHR_IM	dx, TRANSLATEMODE_FIELD_POSITION
   657                              <2>  eSHIFT_IM %1, %2, shr
