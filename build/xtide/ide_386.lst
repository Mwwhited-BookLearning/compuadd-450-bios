    22                              <1> SECTION .text
    23                              <1> 
    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; AdvAtaInit_DetectControllerForIdeBaseInBX
    26                              <1> ;	Parameters:
    27                              <1> ;		BX:		IDE Controller base port
    28                              <1> ;	Returns:
    29                              <1> ;		AX:		ID WORD specific for detected controller
    30                              <1> ;				Zero if no controller detected
    31                              <1> ;		DX:		Controller base port (not IDE)
    32                              <1> ;		CF:		Set if controller detected
    33                              <1> ;				Cleared if no controller
    34                              <1> ;	Corrupts registers:
    35                              <1> ;		BX, CX
    36                              <1> ;--------------------------------------------------------------------
    37                              <1> AdvAtaInit_DetectControllerForIdeBaseInBX:
    38                              <1> 	; Detect if system has PCI bus. If it does, we can skip VLB detection. This is a
    39                              <1> 	; good thing since detecting Vision QD6580 is dangerous since Intel PIIX4 south bridge
    40                              <1> 	; mirrors Interrupt Controller registers from Axh to Bxh. This can lead to faulty
    41                              <1> 	; detection of QD6580 that will eventually crash the system when ports are written.
    42                              <1> 
    43                              <1> 	; We should save the 32-bit registers but we don't since system BIOS has stored
    44                              <1> 	; them already and we don't use the 32-bit registers ourselves anywhere at the moment.
    45 00000EF6 53                  <1> 	push	bx
    46 00000EF7 57                  <1> 	push	di
    47                              <1> ;	xor		edi, edi		; Some BIOSes require this to be set to zero
    48                              <1> 	; *FIXME* The above instruction is commented away since RBIL says that this
    49                              <1> 	; only applies to software looking for the protected-mode entry point.
    50 00000EF8 B801B1              <1> 	mov		ax, PCI_INSTALLATION_CHECK	; May corrupt EAX, EBX, ECX, EDX, EDI
    51 00000EFB CD1A                <1> 	int		BIOS_TIME_PCI_PNP_INTERRUPT_1Ah
    52 00000EFD 5F                  <1> 	pop		di
    53 00000EFE 5B                  <1> 	pop		bx
    54 00000EFF 84E4                <1> 	test	ah, ah
    55 00000F01 7411                <1> 	jz		SHORT .ThisSystemHasPCIbus
    56                              <1> 
    57                              <1> 	; Detect VLB controllers
    58 00000F03 E86300              <1> 	call	Vision_DetectAndReturnIDinAXandPortInDXifControllerPresent
    59 00000F06 7505                <1> 	jnz		SHORT .NoVisionControllerFound
    60                              <1> 
    61 00000F08 E87D00              <1> 	call	Vision_DoesIdePortInBXbelongToControllerWithIDinAX
    62 00000F0B 7405                <1> 	jz		SHORT .AdvancedControllerFoundForPortBX
    63                              <1> 
    64                              <1> .NoVisionControllerFound:
    65 00000F0D E81701              <1> 	call	PDC20x30_DetectControllerForIdeBaseInBX
    66 00000F10 7302                <1> 	jnc		SHORT .NoAdvancedControllerForPortBX
    67                              <1> 
    68                              <1> .AdvancedControllerFoundForPortBX:
    69 00000F12 F9                  <1> 	stc
    70 00000F13 C3                  <1> 	ret
    71                              <1> 
    72                              <1> .NoAdvancedControllerForPortBX:
    73                              <1> .ThisSystemHasPCIbus:
    74 00000F14 31C0                <1> 	xor		ax, ax		; Clear ID in AX and CF
    75 00000F16 C3                  <1> 	ret
    76                              <1> 
    77                              <1> 
    78                              <1> ;--------------------------------------------------------------------
    79                              <1> ; AdvAtaInit_GetControllerMaxPioModeToALandMinPioCycleTimeToBX
    80                              <1> ;	Parameters:
    81                              <1> ;		AX:		ID WORD specific for detected controller
    82                              <1> ;	Returns:
    83                              <1> ;		AL:		Max supported PIO mode (only if ZF set)
    84                              <1> ;		AH:		~FLGH_DPT_IORDY if IORDY not supported, -1 otherwise (only if ZF set)
    85                              <1> ;		BX:		Min PIO cycle time (only if ZF set)
    86                              <1> ;		ZF:		Set if PIO limit necessary
    87                              <1> ;				Cleared if no need to limit timings
    88                              <1> ;	Corrupts registers:
    89                              <1> ;		Nothing
    90                              <1> ;--------------------------------------------------------------------
    91                              <1> AdvAtaInit_GetControllerMaxPioModeToALandMinPioCycleTimeToBX:
    92 00000F17 80FC50              <1> 	cmp		ah, ID_QD6580_ALTERNATE
    93                              <1> %ifdef USE_386
    94 00000F1A 0F839000            <1> 	jae		Vision_GetMaxPioModeToALandMinCycleTimeToBX
    95 00000F1E E96001              <1> 	jmp		PDC20x30_GetMaxPioModeToALandMinPioCycleTimeToBX
    96                              <1> %else
    97                              <1> 	jae		SHORT .Vision
    98                              <1> 	jmp		PDC20x30_GetMaxPioModeToALandMinPioCycleTimeToBX
    99                              <1> .Vision:
   100                              <1> 	jmp		Vision_GetMaxPioModeToALandMinCycleTimeToBX
   101                              <1> %endif
   102                              <1> 
   103                              <1> 
   104                              <1> ;--------------------------------------------------------------------
   105                              <1> ; AdvAtaInit_InitializeControllerForDPTinDSDI
   106                              <1> ;	Parameters:
   107                              <1> ;		DS:DI:	Ptr to DPT for Single or Slave Drive
   108                              <1> ;	Returns:
   109                              <1> ;		AH:		Int 13h return status
   110                              <1> ;		CF:		Cleared if success or no controller to initialize
   111                              <1> ;				Set if error
   112                              <1> ;	Corrupts registers:
   113                              <1> ;		AL, BX, CX, DX
   114                              <1> ;--------------------------------------------------------------------
   115                              <1> AdvAtaInit_InitializeControllerForDPTinDSDI:
   116                              <1> 	; Call Controller Specific initialization function
   117 00000F21 8B4516              <1> 	mov		ax, [di+DPT_ADVANCED_ATA.wControllerID]
   118 00000F24 85C0                <1> 	test	ax, ax
   119 00000F26 7414                <1> 	jz		SHORT .NoAdvancedController	; Return with CF cleared
   120                              <1> 
   121 00000F28 80FC50              <1> 	cmp		ah, ID_QD6580_ALTERNATE
   122 00000F2B 7303                <1> 	jae		SHORT .Vision
   123 00000F2D E95D01              <1> 	jmp		PDC20x30_InitializeForDPTinDSDI
   124                              <1> 
