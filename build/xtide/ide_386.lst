   100 0000149B 7804                <1> 	js		SHORT .UpdateTimeout				;  If so, jump to timeout update
   101 0000149D 84E0                <1> 	test	al, ah								; Test secondary flag
   102 0000149F 751B                <1> 	jnz		SHORT IdeError_GetBiosErrorCodeToAHfromPolledStatusRegisterInAL
