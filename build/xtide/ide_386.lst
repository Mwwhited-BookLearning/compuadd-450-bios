    71                              <1> %ifdef MODULE_EBIOS
    72                              <1> 	%include "EBIOS.inc"			; Equates for EBIOS functions
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	Equates used in Enhanced INT 13h functions (EBIOS).
     3                              <2> 
     4                              <2> ;
     5                              <2> ; XTIDE Universal BIOS and Associated Tools
