    20                              <2> %ifndef ADVANCEDID_INC
    21                              <2> %define ADVANCEDID_INC
    22                              <2> 
    23                              <2> ; Controller IDs contained in high byte of ID word.
    24                              <2> ; Low byte is controller specific to be used in controller initialization and such
    25                              <2> 
    26                              <2> ID_NOT_ADVANCED_CONTROLLER	EQU		0
    27                              <2> 
    28                              <2> ; Promise
    29                              <2> ID_PDC20230					EQU		1
    30                              <2> ID_PDC20630					EQU		2
    31                              <2> 
    32                              <2> ; Vision
    33                              <2> ; QDI Vision Controller Identification nibbles used by hardware so do not modify these
    34                              <2> ID_QD6580_ALTERNATE			EQU		80
    35                              <2> ID_QD6580					EQU		160
    36                              <2> ID_QD6500					EQU		192
    37                              <2> 
    38                              <2> 
    39                              <2> %endif ; ADVANCEDID_INC
    57                              <1> 	%include "PDC20x30.inc"			; For Promise PDC 20230-C and 20630 controllers
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	Promise PDC 20230-C and 20630 VLB IDE controller
     3                              <2> ;					specifications.
     4                              <2> 
     5                              <2> ;
     6                              <2> ; XTIDE Universal BIOS and Associated Tools
     7                              <2> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
     8                              <2> ;
     9                              <2> ; This program is free software; you can redistribute it and/or modify
    10                              <2> ; it under the terms of the GNU General Public License as published by
    11                              <2> ; the Free Software Foundation; either version 2 of the License, or
    12                              <2> ; (at your option) any later version.
    13                              <2> ;
    14                              <2> ; This program is distributed in the hope that it will be useful,
    15                              <2> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                              <2> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                              <2> ; GNU General Public License for more details.
    18                              <2> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    19                              <2> ;
    20                              <2> 
    21                              <2> %ifndef PDC20x30_INC
    22                              <2> %define PDC20x30_INC
    23                              <2> 
    24                              <2> ; 
    25                              <2> 
    26                              <2> ; SECTOR_COUNT_REGISTER (1F2) in programming mode
    27                              <2> FLG_PDCSCR_BOTHMAX			EQU		(1<<6)	; Master and Slave at maximum speed
    28                              <2> 
    29                              <2> ; SECTOR_NUMBER_REGISTER (1F3) in programming mode
    30                              <2> FLG_PDCSNR_UNKNOWN_BIT7		EQU		(1<<7)	; Set to 1 for speed setting 7 of device 0 or 1
    31                              <2> FLG_PDCSNR_ID3				EQU		(1<<6)	; VLB bus speed: 0 > 33 MHz, 1 <= 33 MHz
    32                              <2> POS_PDCSNR_DEV0SPEED		EQU		3
    33                              <2> MASK_PDCSNR_DEV0SPEED		EQU		(7<<POS_PDCSNR_DEV0SPEED)	; 0 to 7
    34                              <2> MASK_PDCSNR_DEV1SPEED		EQU		(7<<0)						; 0 to 7
    35                              <2> 
    36                              <2> ; Disassembly of VG4.BIN: (might have errors)
    37                              <2> ; FLG_PDCSNR_UNKNOWN_BIT7 will be set if no dev1, no matter what speed 
    38                              <2> ; FLG_PDCSNR_UNKNOWN_BIT7 will be cleared if dev1 found but no master
    39                              <2> ; FLG_PDCSNR_UNKNOWN_BIT7 will be cleared if dev0 and dev1 speeds are both 7 !
    40                              <2> ; FLG_PDCSNR_UNKNOWN_BIT7 will be cleared if dev 1 is 7 !
    41                              <2> ; If dev 1 is 6 or less and dev 0 is 7, then dev0-- and set FLG_PDCSCR_UNKNOWN_BIT7
    42                              <2> ; 
    43                              <2> 
    44                              <2> 
    45                              <2> 
    46                              <2> ; LOW_CYLINDER_REGISTER in programming mode
    47                              <2> ; This is only on PDC 20630!
    48                              <2> FLG_PDCLCR_DEV0SPEED_BIT4	EQU		(1<<7)	; Possibly speed bit 4 (speed settings 8 to 15)?
    49                              <2> FLG_PDCLCR_DEV1SPEED_BIT4	EQU		(1<<6)	; Same as above but for device 1
    50                              <2> FLG_PDCLCR_DEV0IORDY		EQU		(1<<5)	; Not sure about this
    51                              <2> FLG_PDCLCR_DEV1IORDY		EQU		(1<<4)	; Same as above but for device 1
    52                              <2> FLG_PDCLCR_ENABLE_EXTRA_REGISTERS	EQU	(1<<3)
    53                              <2> 
    54                              <2> 
    55                              <2> ; PDC 20630 specific registers mapped after IDE registers
    56                              <2> PDC20630_INDEX_REGISTER		EQU		8		; 1F8h
    57                              <2> PDC20630_DATA_REGISTER		EQU		9		; 1F9h
    58                              <2> 
    59                              <2> ; PDC 20630 registers to access through index and data register
    60                              <2> PDCREG0_TIMING_OF_DEV0_LOW	EQU		0		; Low, high, what timings?
    61                              <2> PDCREG1_TIMING_OF_DEV0_HIGH	EQU		1
    62                              <2> PDCREG2_TIMING_OF_DEV1_LOW	EQU		2
    63                              <2> PDCREG3_TIMING_OF_DEV1_HIGH	EQU		3
    64                              <2> PDCREG7_STATUS				EQU		7
    65                              <2> 
    66                              <2> FLG_PDCSTATUS_DMA_ERROR				EQU	(1<<4)	; ?
    67                              <2> FLG_PDCSTATUS_DMA_READ_COMPLETED	EQU	(1<<1)	; ?
    68                              <2> FLG_PDCSTATUS_DMA_WRITE_COMPLETED	EQU	(1<<0)	; ?
    69                              <2> 
    70                              <2> 
    71                              <2> %endif ; PDC20x30_INC
    58                              <1> 	%include "Vision.inc"			; For QDI Vision QD65xx VLB IDE Controllers
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	QDI Vision QD6500 and QD6580 VLB IDE controller
     3                              <2> ;					specifications.
     4                              <2> ;
     5                              <2> ;					Specifications can be found at http://www.ryston.cz/petr/vlb/vlbidechips.html
     6                              <2> ;					QD6580 DOS Driver Analysis: http://www.ryston.cz/petr/qd/dos37.html
     7                              <2> 
     8                              <2> ;
     9                              <2> ; XTIDE Universal BIOS and Associated Tools
    10                              <2> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
    11                              <2> ;
    12                              <2> ; This program is free software; you can redistribute it and/or modify
    13                              <2> ; it under the terms of the GNU General Public License as published by
    14                              <2> ; the Free Software Foundation; either version 2 of the License, or
    15                              <2> ; (at your option) any later version.
    16                              <2> ;
    17                              <2> ; This program is distributed in the hope that it will be useful,
    18                              <2> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    19                              <2> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    20                              <2> ; GNU General Public License for more details.
    21                              <2> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    22                              <2> ;
    23                              <2> 
    24                              <2> %ifndef VISION_INC
    25                              <2> %define VISION_INC
    26                              <2> 
    27                              <2> ; Possible base addresses for QD6500 and QD6580
    28                              <2> QD65XX_BASE_PORT					EQU		30h
    29                              <2> QD65XX_ALTERNATIVE_BASE_PORT		EQU		0B0h	; This is the default setting but Intel PIIX4 South Bridge
    30                              <2> 													; (and likely other PCI chipsets as well) mirror PIC registers here
    31                              <2> 
    32                              <2> ; Vision Register offsets from QD chip base port
    33                              <2> QD6500_IDE_TIMING_REGISTER				EQU	0
    34                              <2> QD6580_PRIMARY_IDE_TIMING_REGISTER		EQU	0		; QD6500 has only one channel
    35                              <2> QD65XX_CONFIG_REGISTER_in				EQU	1
    36                              <2> QD6580_SECONDARY_IDE_TIMING_REGISTER	EQU	2		; Same definitions as Primary IDE Timing Register
    37                              <2> QD6580_CONTROL_REGISTER					EQU	3
    38                              <2> 
    39                              <2> 
    40                              <2> ; Bit definitions for QD65xx IDE Timing Register(s)
    41                              <2> MASK_QD6500IDE_ACTIVE_TIME				EQU	7h		; Active time in VLB clocks (bits 0...2)
    42                              <2> 													; 000b = 8 clocks (<= 33 MHz), 9 clocks (>33 MHz)
    43                              <2> 													; 111b = 1 clock (<= 33 MHz), 2 clocks (>33 MHz)
    44                              <2> MASK_QD6580IDE_ACTIVE_TIME				EQU	0Fh		; Active time in VLB clocks (bits 0...3)
    45                              <2> 													; 0000b = 17 clocks, 1111b = 2 clocks
    46                              <2> 
    47                              <2> MASK_QD6500IDE_RECOVERY_TIME			EQU	0F0h	; Recovery time in VLB clocks (bits 4...7)
    48                              <2> 													; 0000b = 18 clocks (<= 33 MHz), 15 clocks (>33 MHz)
    49                              <2> 													; 1111b = 3 clocks (<= 33 MHz), 0 clocks (>33 MHz)
    50                              <2> MASK_QD6580IDE_RECOVERY_TIME			EQU	MASK_QD6500IDE_RECOVERY_TIME
    51                              <2> 													; 0000b = 15 clocks, 1101b = 2 clocks
    52                              <2> POSITION_QD65XXIDE_RECOVERY_TIME		EQU	4
    53                              <2> 
    54                              <2> 
    55                              <2> ; Bit definitions for QD65xx Config Register (read only)
    56                              <2> FLG_QDCONFIG_PRIMARY_IDE				EQU	(1<<0)	; IDE Controller Base Address
    57                              <2> 													; 0 = 170h, 1 = 1F0h
    58                              <2> FLG_QDCONFIG_ALTERNATIVE_BASE			EQU	(1<<1)	; QD Vision Controller Base Address
    59                              <2> 													; 0 = 30h, 1 = B0h
    60                              <2> FLG_QDCONFIG_ID3						EQU	(1<<2)	; VLB bus speed
    61                              <2> 													; 0 = > 33 MHz, 1 = <= 33 MHz
    62                              <2> FLG_QDCONFIG_QD6500STATUS				EQU	(1<<3)	; QD6500 Enabled/Disabled status
    63                              <2> 													; 0 = Enabled, 1 = Disabled
    64                              <2> MASK_QDCONFIG_CONTROLLER_ID				EQU	0F0h	; QDI Vision Controller Identification nibble
    65                              <2> 
    66                              <2> 
    67                              <2> ; Bit definitions for QD6580 Control Register
    68                              <2> FLG_QDCONTROL_SECONDARY_DISABLED_in		EQU	(1<<0)	; 0 = Primary and Secondary IDE enabled (Primary at 1F0h and Secondary at 170h)
    69                              <2> 													; 1 = Only Primary IDE enabled (always at 1F0h)
    70                              <2> FLG_QDCONTROL_HDONLY_in					EQU	(1<<1)	; 0 = Hard drive or ATAPI device
    71                              <2> 													; 1 = Hard drives only
    72                              <2> FLG_QDCONTROL_NONATAPI					EQU	(1<<7)	; Set to 1 for non-ATAPI devices (hard drives,
    73                              <2> 													; probably Read ahead and/or post-write control?)
    74                              <2> MASK_QDCONTROL_FLAGS_TO_SET			EQU	01011111b	; Bits that must be set when writing the Control Register
    75                              <2> 
    76                              <2> 
    77                              <2> 
    78                              <2> ; Minimum and Maximum Active and Recovery Time Values
    79                              <2> QD6500_MAX_ACTIVE_TIME_CLOCKS			EQU	8		; VLB clocks
    80                              <2> QD6500_MIN_ACTIVE_TIME_CLOCKS			EQU	1		; VLB clocks
    81                              <2> QD6580_MAX_ACTIVE_TIME_CLOCKS			EQU	17		; VLB clocks
    82                              <2> QD6580_MIN_ACTIVE_TIME_CLOCKS			EQU	2		; VLB clocks
    83                              <2> QD65xx_MAX_RECOVERY_TIME_CLOCKS			EQU	15		; VLB clocks
    84                              <2> QD65xx_MIN_RECOVERY_TIME_CLOCKS			EQU	2		; VLB clocks
    85                              <2> 
    86                              <2> 
    87                              <2> ; Cycle times for different VLB bus clocks
    88                              <2> VLB_33MHZ_CYCLE_TIME					EQU	30		; ns
    89                              <2> VLB_40MHZ_CYCLE_TIME					EQU	25		; ns
    90                              <2> 
    91                              <2> 
    92                              <2> %endif ; VISION_INC
    59                              <1> %endif
    60                              <1> 
    61                              <1> %ifdef MODULE_WIN9X_CMOS_HACK
    62                              <1> 	%ifndef USE_386
    63                              <1> 		%error "MODULE_WIN9X_CMOS_HACK requires USE_386!"
    64                              <1> 	%endif
    65                              <1> %endif
