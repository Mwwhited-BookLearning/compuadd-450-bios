    14                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                              <1> ; GNU General Public License for more details.
    17                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    18                              <1> ;
    19                              <1> 
    20                              <1> %ifndef INT13H_INC
    21                              <1> %define INT13H_INC
    22                              <1> 
    23                              <1> ; Signature for XTIDE Universal BIOS specific functions
    24                              <1> XUB_INT13h_SIGNATURE	EQU		RAMVARS_RAM_SIGNATURE
    25                              <1> 
    26                              <1> ; Hard Disk function (INT 13h) return status codes in AH
    27                              <1> RET_HD_SUCCESS			EQU		0h		; Operation successful, no error occurred
    28                              <1> RET_HD_INVALID			EQU		1h		; Invalid value passed or unsupported func
    29                              <1> RET_HD_ADDRMARK			EQU		2h		; Missing address mark
    30                              <1> RET_HD_WRITEPROT		EQU		3h		; Removable media is write protected (floppy)
    31                              <1> RET_HD_NOT_FOUND		EQU		4h		; Requested sector not found
    32                              <1> RET_HD_RESETFAIL		EQU		5h		; Reset failed (hard disk)
    33                              <1> RET_HD_CHANGED			EQU		6h		; Floppy disk removed/Disk changeline (floppy)
    34                              <1> RET_HD_PARAMACT			EQU		7h		; Drive parameter activity failed (Bad parameter table (hard disk)/Initialization failed)
    35                              <1> RET_HD_OVERRUN			EQU		8h		; DMA overrun (floppy)
    36                              <1> RET_HD_BOUNDARY			EQU		9h		; Data boundary error (DMA crossed 64K boundary)
    37                              <1> RET_HD_BADSECTOR		EQU		0Ah		; Bad sector detected
    38                              <1> RET_HD_BADTRACK			EQU		0Bh		; Bad track detected
    39                              <1> RET_HD_UNCORRECC		EQU		10h		; Uncorrectable ECC error
    40                              <1> RET_HD_ECC				EQU		11h		; Corrected ECC error
    41                              <1> RET_HD_CONTROLLER		EQU		20h		; Hard disk controller or drive problem
    42                              <1> RET_HD_NOMEDIA			EQU		31h		; No media in removable media drive
    43                              <1> RET_HD_SEEK_FAIL		EQU		40h		; Seek operation failed
    44                              <1> RET_HD_TIMEOUT			EQU		80h		; Drive failed to respond
    45                              <1> RET_HD_NOTREADY			EQU		0AAh	; Drive is not ready or is not selected
    46                              <1> RET_HD_NOTLOCKED		EQU		0B0h	; Volume not locked in drive
    47                              <1> RET_HD_LOCKED			EQU		0B1h	; Volume locked in drive
    48                              <1> RET_HD_NOTREMOVABLE		EQU		0B2h	; Volume not removable
    49                              <1> RET_HD_INUSE			EQU		0B3h	; Volume in use
    50                              <1> RET_HD_LOCKEXCEEDED		EQU		0B4h	; Lock count exceeded
    51                              <1> RET_HD_EJECTFAIL		EQU		0B5h	; Valid eject request failed
    52                              <1> RET_HD_UNDEFINED		EQU		0BBh	; Undefined error occurred
    53                              <1> RET_HD_WRFAULT			EQU		0CCh	; Write fault on selected drive
    54                              <1> RET_HD_STATUSERR		EQU		0E0h	; Status error without error
    55                              <1> RET_HD_SENSEFAIL		EQU		0FFh	; Sense operation failed
    56                              <1> 
    57                              <1> 
    58                              <1> ; Floppy Drive types returned by INT 13h, AH=08h
    59                              <1> FLOPPY_TYPE_525_OR_35_DD	EQU	0
    60                              <1> FLOPPY_TYPE_525_DD			EQU	1
    61                              <1> FLOPPY_TYPE_525_HD			EQU	2
    62                              <1> FLOPPY_TYPE_35_DD			EQU	3
    63                              <1> FLOPPY_TYPE_35_HD			EQU	4
    64                              <1> FLOPPY_TYPE_35_ED			EQU	6
    65                              <1> 
    66                              <1> 
    67                              <1> %define TIMEOUT_AND_STATUS_TO_WAIT(timeout, status)		(((timeout)<<8) | (status))
    68                              <1> 
    69                              <1> 
    70                              <1> %endif ; INT13H_INC
    54                                  	%include "CustomDPT.inc"		; For Disk Parameter Table
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Defines for DPT structs containing custom
     3                              <1> ;					Disk Parameter Table used by this BIOS.
     4                              <1> 
     5                              <1> ;
     6                              <1> ; XTIDE Universal BIOS and Associated Tools
     7                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
     8                              <1> ;
     9                              <1> ; This program is free software; you can redistribute it and/or modify
    10                              <1> ; it under the terms of the GNU General Public License as published by
    11                              <1> ; the Free Software Foundation; either version 2 of the License, or
    12                              <1> ; (at your option) any later version.
    13                              <1> ;
    14                              <1> ; This program is distributed in the hope that it will be useful,
    15                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    16                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    17                              <1> ; GNU General Public License for more details.
    18                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    19                              <1> ;
    20                              <1> 
    21                              <1> %ifndef CUSTOMDPT_INC
    22                              <1> %define CUSTOMDPT_INC
    23                              <1> 
    24                              <1> ; Base DPT for all device types
    25                              <1> struc DPT
    26                              <1> 	; General Disk Parameter Table related
    27                              <1> 	.wFlags:
    28 00000000 ??                  <1> 	.bFlagsLow				resb	1
    29 00000001 ??                  <1> 	.bFlagsHigh				resb	1
    30 00000002 ??                  <1> 	.bIdevarsOffset			resb	1	; Offset to IDEVARS for this drive
    31 00000003 ??                  <1> 	.bInitError				resb	1	; Flags for AH=09h initialization errors
    32 00000004 ????                <1> 	.wBasePort				resb	2	; Segment for JR-IDE/ISA and ADP50L
    33                              <1> 
    34                              <1> 	; CHS variables
    35 00000006 ????                <1> 	.wLchsCylinders			resb	2	; (1...1027, yes 1027)
    36                              <1> 	.wLchsHeadsAndSectors:
    37 00000008 ??                  <1> 	.bLchsHeads				resb	1	; (1...255)
    38 00000009 ??                  <1> 	.bLchsSectorsPerTrack	resb	1	; (1...63)
    39                              <1> 	.wPchsHeadsAndSectors:
    40 0000000A ??                  <1> 	.bPchsHeads				resb	1	; (1...16)
    41 0000000B ??                  <1> 	.bPchsSectorsPerTrack	resb	1	; (1...63)
    42                              <1> %ifdef MODULE_COMPATIBLE_TABLES OR MODULE_EBIOS
    43 0000000C ????                <1> 	.wPchsCylinders			resb	2
    44                              <1> %endif
    45                              <1> 
    46                              <1> 	; Total LBA sector count
    47                              <1> %ifdef MODULE_EBIOS
    48 0000000E ????????????        <1> 	.twLbaSectors			resb	6	; 48-bit sector count for LBA addressing
    49                              <1> %endif
    50                              <1> 							alignb	2	; WORD alignment for DPT_SERIAL or DPT_ATA
    51                              <1> endstruc
    52                              <1> 
    53                              <1> 	; Bit definitions for DPT.bFlagsLow
    54                              <1> 	MASKL_DPT_CHS_SHIFT_COUNT			EQU	(3<<0)				; Bits 0...1, P-CHS to L-CHS bit shift count (0...3)
    55                              <1> 	MASKL_DPT_TRANSLATEMODE				EQU	MASK_DRVPARAMS_TRANSLATEMODE	; Bits 2...3, NORMAL, LARGE or Assisted LBA addressing mode
    56                              <1> 	FLGL_DPT_ASSISTED_LBA				EQU	(1<<(TRANSLATEMODE_FIELD_POSITION+1))
    57                              <1> 	FLGL_DPT_SLAVE						EQU	FLG_DRVNHEAD_DRV	; Bit 4, Drive is a Slave Drive
    58                              <1> %ifdef MODULE_IRQ
    59                              <1> 	FLGL_DPT_ENABLE_IRQ					EQU	(1<<5)				; Bit 5, Enable IRQ
    60                              <1> %endif
    61                              <1> 	FLGL_DPT_LBA						EQU	FLG_DRVNHEAD_LBA	; Bit 6, Drive supports LBA and so EBIOS functions can be supported
    62                              <1> %ifdef MODULE_EBIOS
    63                              <1> 	FLGL_DPT_LBA48						EQU	(1<<7)				; Bit 7, Drive supports 48-bit LBA (must be bit 7!)
    64                              <1> %endif
    65                              <1> 
    66                              <1> 
    67                              <1> 	; Bit definitions for DPT.bFlagsHigh
    68                              <1> 	FLGH_DPT_USE_BLOCK_MODE_COMMANDS	EQU	(1<<1)				; Bit 1, Use block transfer commands (must be bit 1!)
    69                              <1> %ifdef MODULE_SERIAL
    70                              <1> 	FLGH_DPT_SERIAL_DEVICE				EQU	(1<<2)				; Bit 2, Serial Port Device
    71                              <1> %endif
    72                              <1> %ifdef MODULE_POWER_MANAGEMENT
    73                              <1> 	FLGH_DPT_POWER_MANAGEMENT_SUPPORTED	EQU (1<<3)				; Bit 3, Drive supports power management (must be bit 3!)
    74                              <1> 	FLGH_DPT_APM_SUPPORTED				EQU	(1<<4)				; Bit 4, Drive supports advanced power management (must be bit 4!)
    75                              <1> %endif
    76                              <1> %ifdef MODULE_ADVANCED_ATA
    77                              <1> 	FLGH_DPT_IORDY						EQU	(1<<7)				; Bit 7, Controller and Drive supports IORDY
    78                              <1> %endif
    79                              <1> 
    80                              <1> 	; Serial device only
    81                              <1> %ifdef MODULE_SERIAL_FLOPPY
    82                              <1> 	FLGH_DPT_SERIAL_FLOPPY						EQU	(1<<4)		; Bit 4, Drive is a serial floppy drive
    83                              <1> 	FLGH_DPT_SERIAL_FLOPPY_TYPE_FIELD_POSITION	EQU	5			; Bits 7...5, Serial floppy drive type
    84                              <1> %endif
    85                              <1> 
    86                              <1> 
    87                              <1> 	; Flags for DPT.bInitError
    88                              <1> 	FLG_INITERROR_FAILED_TO_SELECT_DRIVE				EQU (1<<0)
    89                              <1> 	FLG_INITERROR_FAILED_TO_INITIALIZE_CHS_PARAMETERS	EQU (1<<1)
    90                              <1> 	FLG_INITERROR_FAILED_TO_SET_WRITE_CACHE				EQU (1<<2)
    91                              <1> 	FLG_INITERROR_FAILED_TO_RECALIBRATE_DRIVE			EQU (1<<3)
    92                              <1> 	FLG_INITERROR_FAILED_TO_SET_BLOCK_MODE				EQU (1<<4)
    93                              <1> 	FLG_INITERROR_FAILED_TO_SET_PIO_MODE				EQU (1<<5)
    94                              <1> 	FLG_INITERROR_FAILED_TO_INITIALIZE_STANDBY_TIMER	EQU	(1<<6)
    95                              <1> 	FLG_INITERROR_FAILED_TO_SET_XTCF_MODE				EQU	(1<<7)
    96                              <1> 	FLG_INITERROR_FAILED_TO_SET_8BIT_MODE				EQU	FLG_INITERROR_FAILED_TO_SET_XTCF_MODE
    97                              <1> 
    98                              <1> 
    99                              <1> 
   100                              <1> ; DPT for ATA devices
   101                              <1> struc DPT_ATA
   102 00000000 <res 14h>           <1> 	.dpt					resb	DPT_size
   103 00000014 ??                  <1> 	.bDevice				resb	1	; Device Type from IDEVARS (overrided when 32-bit controller detected or XT-CF mode is changed)
   104 00000015 ??                  <1> 	.bBlockSize				resb	1	; Current block size in sectors (do not set to zero!)
   105                              <1> endstruc
   106                              <1> 
   107                              <1> 
   108                              <1> 
   109                              <1> ; Additional variables needed to initialize and reset Advanced IDE Controllers.
   110                              <1> ; EBDA must be reserved for DPTs when using these!
   111                              <1> %ifdef MODULE_ADVANCED_ATA
   112                              <1> struc DPT_ADVANCED_ATA
   113 00000000 <res 16h>           <1> 	.dpt_ata				resb	DPT_ATA_size
   114 00000016 ????                <1> 	.wControllerID			resb	2	; Controller specific ID WORD (from Advanced Controller detection)
   115 00000018 ????                <1> 	.wControllerBasePort	resb	2	; Advanced Controller port (not IDE port)
   116 0000001A ????                <1> 	.wMinPioCycleTime		resb	2	; Minimum PIO Cycle Time in ns
   117 0000001C ??                  <1> 	.bPioMode				resb	1	; Best supported PIO mode
   118 0000001D ??                  <1> 							alignb	2
   119                              <1> endstruc
   120                              <1> %endif
   121                              <1> 
   122                              <1> 
   123                              <1> ; DPT for Serial devices
   124                              <1> %ifdef MODULE_SERIAL
   125                              <1> struc DPT_SERIAL
   126 00000000 <res 14h>           <1> 	.dpt					resb	DPT_size
   127                              <1> 	.wSerialPortAndBaud:
   128 00000014 ??                  <1> 	.bSerialPort			resb	1	; Serial connection I/O port address, divided by 4
   129 00000015 ??                  <1> 	.bSerialBaud			resb 	1	; Serial connection baud rate divisor
   130                              <1> endstruc
   131                              <1> 
   132                              <1> ; On performance critical situations we compare DPT_ATA.bDevice without checking FLGH_DPT_SERIAL_DEVICE
   133                              <1> ; first! DPT_ATA.bDevice uses small values so there will be no problems.
   134                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   135                              <1> 	%if DPT_SERIAL.bSerialPort <> DPT_ATA.bDevice
   136                              <1> 		%error "DPT_ATA.bDevice and DPT_SERIAL.bSerialPort must be in same offsets!"
   137                              <1> 	%endif
   138                              <1> %endif
   139                              <1> %endif ; MODULE_SERIAL
   140                              <1> 
   141                              <1> 
   142                              <1> ; This is the common size for all DPTs. All DPTs must be equal size.
   143                              <1> %ifdef MODULE_ADVANCED_ATA
   144                              <1> 	LARGEST_DPT_SIZE			EQU		DPT_ADVANCED_ATA_size
   145                              <1> %else
   146                              <1> 	LARGEST_DPT_SIZE			EQU		DPT_ATA_size
   147                              <1> %endif
   148                              <1> 
   149                              <1> 
   150                              <1> 	; Number of Sectors per Track is fixed to 63 for LBA assist calculation.
   151                              <1> 	; 1024 cylinders, 256 heads, 63 sectors = 8.4 GB limit (but DOS does not support more than 255 heads)
   152                              <1> 	MAX_LCHS_CYLINDERS			EQU		1024
   153                              <1> 	LBA_ASSIST_SPT				EQU		63
   154                              <1> 
   155                              <1> 
   156                              <1> %endif ; CUSTOMDPT_INC
    55                                  	%include "RomVars.inc"			; For ROMVARS and IDEVARS structs
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Defines for ROMVARS struct containing variables stored
     3                              <1> ;					in BIOS ROM.
     4                              <1> 
     5                              <1> ;
     6                              <1> ; XTIDE Universal BIOS and Associated Tools
     7                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2026 by XTIDE Universal BIOS Team.
