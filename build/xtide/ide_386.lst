   413                              <2> ; DisplayPrint_NullTerminatedStringFromBXSI
   414                              <2> ;	Parameters:
   415                              <2> ;		DS:		BDA segment (zero)
   416                              <2> ;		BX:SI:	Ptr to NULL terminated string
   417                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   418                              <2> ;	Returns:
   419                              <2> ;		DI:		Updated offset to video RAM
   420                              <2> ;	Corrupts registers:
   421                              <2> ;		AX, DX
   422                              <2> ;--------------------------------------------------------------------
   423                              <2> ALIGN DISPLAY_JUMP_ALIGN
   424                              <2> DisplayPrint_NullTerminatedStringFromBXSI:
   425 0000029B 56                  <2> 	push	si
   426 0000029C 51                  <2> 	push	cx
   427                              <2> 
   428 0000029D 31C9                <2> 	xor		cx, cx
   429                              <2> ALIGN DISPLAY_JUMP_ALIGN
   430                              <2> .PrintNextCharacter:
   431 0000029F 8EDB                <2> 	mov		ds, bx				; String segment to DS
   432 000002A1 AC                  <2> 	lodsb
   433 000002A2 8ED9                <2> 	mov		ds, cx				; BDA segment to DS
   434 000002A4 84C0                <2> 	test	al, al				; NULL?
   435 000002A6 7405                <2> 	jz		SHORT .EndOfString
   436 000002A8 E8E4FF              <2> 	call	DisplayPrint_CharacterFromAL
   437 000002AB EBF2                <2> 	jmp		SHORT .PrintNextCharacter
   438                              <2> 
   439                              <2> ALIGN DISPLAY_JUMP_ALIGN
   440                              <2> .EndOfString:
   441 000002AD 59                  <2> 	pop		cx
   442 000002AE 5E                  <2> 	pop		si
   443                              <2> 
   444                              <2> DisplayPrint_Ret:				; random ret to jump to
   445 000002AF C3                  <2> 	ret
