    22                              <2> %ifndef COMPATIBLE_DPT
    23                              <2> %define COMPATIBLE_DPT
    24                              <2> 
    25                              <2> ; Standard DPT for small drives with 1024 or less cylinders
    26                              <2> struc STANDARD_DPT
    27 00000000 ????                <2> 	.wPchsCylinders		resb	2	; 0-1, Physical number of cylinders
    28 00000002 ??                  <2> 	.bPchsHeads			resb	1	; 2, Physical number of heads
    29 00000003 ????                <2> 	.bReserved3to4		resb	2	; 3-4, Reserved
    30 00000005 ????                <2> 	.wPrecompCylinder	resb	2	; 5-6, Write Precompensation Cylinder
    31 00000007 ??                  <2> 	.bReserved7			resb	1	; 7, Reserved
    32 00000008 ??                  <2> 	.bDrvControlByte	resb	1	; 8, Drive Control Byte
    33 00000009 ??????              <2> 	.bReserved9to11		resb	3	; 9-11, Reserved
    34 0000000C ????                <2> 	.wLandingZone		resb	2	; 12-13, Landing Zone Cylinder
    35 0000000E ??                  <2> 	.bPchsSectPerTrack	resb	1	; 14, Physical sectors per track
    36 0000000F ??                  <2> 	.bReserved15		resb	1	; 15, Reserved
    37                              <2> endstruc
    38                              <2> 
    39                              <2> 
    40                              <2> ; Translated DPT for drives with more than 1024 cylinders
    41                              <2> struc TRANSLATED_DPT
    42 00000000 ????                <2> 	.wLchsCylinders		resb	2	; 0-1, Logical number of cylinders
    43 00000002 ??                  <2> 	.bLchsHeads			resb	1	; 2, Logical number of heads
    44 00000003 ??                  <2> 	.bSignature			resb	1	; 3, Axh signature to indicate Translated DPT
    45 00000004 ??                  <2> 	.bPchsSectPerTrack	resb	1	; 4, Physical sectors per track
    46 00000005 ????                <2> 	.wPrecompCylinder	resb	2	; 5-6, Write Precompensation Cylinder
    47 00000007 ??                  <2> 	.bReserved7			resb	1	; 7, Reserved
    48 00000008 ??                  <2> 	.bDrvControlByte	resb	1	; 8, Drive Control Byte
    49 00000009 ????                <2> 	.wPchsCylinders		resb	2	; 9-10, Physical number of cylinders
    50 0000000B ??                  <2> 	.bPchsHeads			resb	1	; 11, Physical number of heads
    51 0000000C ????                <2> 	.wLandingZone		resb	2	; 12-13, Landing Zone Cylinder
    52 0000000E ??                  <2> 	.bLchsSectPerTrack	resb	1	; 14, Logical sectors per track
    53 0000000F ??                  <2> 	.bChecksum			resb	1	; 15, Checksum: 2's complement of the 8-bit unsigned sum of bytes 0-14
    54                              <2> endstruc
    55                              <2> 
    56                              <2> TRANSLATED_DPT_SIGNATURE	EQU		0A0h
    57                              <2> 
    58                              <2> 
    59                              <2> ; Device Parameter Table Extension (returned by AH=48h EBIOS function)
    60                              <2> struc DPTE
    61 00000000 ????                <2> 	.wBasePort				resb	2	; 0, Command Block Base Port Address
    62 00000002 ????                <2> 	.wControlBlockPort		resb	2	; 2, Control Block Base Port Address
    63 00000004 ??                  <2> 	.bDrvnhead				resb	1	; 4, Drive and Head Select Register upper nibble
    64 00000005 ??                  <2> 	.bBiosVendor			resb	1	; 5, BIOS Vendor Specific
    65 00000006 ??                  <2> 	.bIRQ					resb	1	; 6, IRQ for this device
    66 00000007 ??                  <2> 	.bBlockSize				resb	1	; 7, Current block size in sectors
    67 00000008 ??                  <2> 	.bDmaChannelAndType		resb	1	; 8, DMA information
    68 00000009 ??                  <2> 	.bPioMode				resb	1	; 9, PIO mode
    69 0000000A ????                <2> 	.wFlags					resb	2	; 10, BIOS selected hardware specific option flags
    70 0000000C ????                <2> 	.wReserved				resb	2	; 12, Reserved. Must be zero.
    71 0000000E ??                  <2> 	.bRevision				resb	1	; 14, Revision level of this table (11h)
    72 0000000F ??                  <2> 	.bChecksum				resb	1	; 15, Checksum: 2's complement of the sum of bytes 0-14
    73                              <2> endstruc
    74                              <2> 
    75                              <2> ; Flags for DPTE.wFlags
    76                              <2> FLG_FAST_PIO_ENABLED		EQU	(1<<0)	; Set if using PIO mode 1 or above (DPTE.bPioMode is valid when set)
    77                              <2> FLG_DMA_ENABLED				EQU	(1<<1)	; Set if DMA enabled (DPTE.bDmaChannelAndType is valid when set)
    78                              <2> FLG_BLOCK_MODE_ENABLED		EQU	(1<<2)	; Set if Block Mode transfers are enabled (DPTE.bBlockSize is valid when set)
    79                              <2> FLG_CHS_TRANSLATION_ENABLED	EQU	(1<<3)	; Set for drives with more than 1024 cylinders
    80                              <2> FLG_LBA_TRANSLATION_ENABLED	EQU	(1<<4)	; Set when LBA addresses from DAP are passed directly to the drive
    81                              <2> FLG_REMOVABLE_MEDIA			EQU	(1<<5)
    82                              <2> FLG_ATAPI_DEVICE			EQU	(1<<6)
    83                              <2> FLG_32BIT_XFER_MODE			EQU	(1<<7)	; Set when using 32-bit data transfers
    84                              <2> FLG_ATAPI_USES_IRQ			EQU	(1<<8)	; ATAPI Device uses IRQ for data transfers
    85                              <2> ; L-CHS translation type for old INT 13h (when FLG_CHS_TRANSLATION_ENABLED is set)
    86                              <2> MASK_CHS_TRANSLATION_TYPE	EQU	(3<<TRANSLATION_TYPE_FIELD_POSITION)
    87                              <2> 	TRANSLATION_TYPE_FIELD_POSITION	EQU	9
    88                              <2> 	BIT_SHIFT_TRANSLATION			EQU	0	; LARGE
    89                              <2> 	LBA_ASSISTED_TRANSLATION		EQU	1	; Assisted LBA
    90                              <2> 											; 2 = reserved
    91                              <2> 	VENDOR_SPECIFIC_TRANSLATION		EQU	3
    92                              <2> 
    93                              <2> 
    94                              <2> DPTE_REVISION				EQU		11h
    95                              <2> 
    96                              <2> 
    97                              <2> %endif ; COMPATIBLE_DPT
    69                              <1> %endif
