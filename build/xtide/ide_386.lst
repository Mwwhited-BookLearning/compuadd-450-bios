    21                              <1> ;--------------------------------------------------------------------
    22                              <1> ; CMOS_WriteALtoIndexInDL
    23                              <1> ;	Parameters:
    24                              <1> ;		AL:		Byte to write
    25                              <1> ;		DL:		CMOS address to write to
    26                              <1> ;	Returns:
    27                              <1> ;		Interrupts enabled and NMI disabled
    28                              <1> ;	Corrupts registers:
    29                              <1> ;		Nothing
    30                              <1> ;--------------------------------------------------------------------
    31                              <1> CMOS_WriteALtoIndexInDL:
    32 00000397 50                  <1> 	push	ax
    33 00000398 E80C00              <1> 	call	SetDLtoIndexRegister
    34 0000039B 58                  <1> 	pop		ax
    35 0000039C E671                <1> 	out		CMOS_DATA_REGISTER, al
    36 0000039E FB                  <1> 	sti
    37 0000039F C3                  <1> 	ret
    38                              <1> 
    39                              <1> 
    40                              <1> ;--------------------------------------------------------------------
    41                              <1> ; CMOS_ReadFromIndexInDLtoAL
    42                              <1> ;	Parameters:
    43                              <1> ;		DL:		CMOS address to read from
    44                              <1> ;	Returns:
    45                              <1> ;		AL:		Byte read from CMOS
    46                              <1> ;		Interrupts enabled and NMI disabled
    47                              <1> ;	Corrupts registers:
    48                              <1> ;		Nothing
    49                              <1> ;--------------------------------------------------------------------
    50                              <1> CMOS_ReadFromIndexInDLtoAL:
    51 000003A0 E80400              <1> 	call	SetDLtoIndexRegister
    52 000003A3 E471                <1> 	in		al, CMOS_DATA_REGISTER
    53 000003A5 FB                  <1> 	sti
    54 000003A6 C3                  <1> 	ret
    55                              <1> 
    56                              <1> 
    57                              <1> ;--------------------------------------------------------------------
    58                              <1> ; SetDLtoIndexRegister
    59                              <1> ;	Parameters:
    60                              <1> ;		DL:		CMOS address to select
    61                              <1> ;	Returns:
    62                              <1> ;		Interrupts disabled and NMI disabled
    63                              <1> ;	Corrupts registers:
    64                              <1> ;		AL
    65                              <1> ;--------------------------------------------------------------------
    66                              <1> SetDLtoIndexRegister:
    67 000003A7 88D0                <1> 	mov		al, dl
    68 000003A9 0C80                <1> 	or		al, FLG_CMOS_INDEX_NMI_DISABLE	; Disable NMI
    69 000003AB FA                  <1> 	cli
    70 000003AC E670                <1> 	out		CMOS_INDEX_REGISTER, al
    71 000003AE C3                  <1> 	ret		; Return works as I/O delay
    72                              <1> 
    73                              <1> 
    74                              <1> ;--------------------------------------------------------------------
    75                              <1> ; CMOS_Verify10hTo2Dh
    76                              <1> ;	Parameters:
    77                              <1> ;		Nothing
    78                              <1> ;	Returns:
    79                              <1> ;		ZF:		Set if valid checksum
    80                              <1> ;		Interrupts disabled and NMI disabled
    81                              <1> ;	Corrupts registers:
    82                              <1> ;		AX, CX, DX
    83                              <1> ;--------------------------------------------------------------------
    84                              <1> CMOS_Verify10hTo2Dh:
    85                              <1> 	; Get checksum WORD from CMOS
    86 000003AF B22E                <1> 	mov		dl, CHECKSUM_OF_BYTES_10hTo2Dh_HIGH
    87 000003B1 E8ECFF              <1> 	call	CMOS_ReadFromIndexInDLtoAL
    88 000003B4 86C4                <1> 	xchg	ah, al
    89 000003B6 42                  <1> 	inc		dx			; CHECKSUM_OF_BYTES_10hTo2Dh_LOW
    90 000003B7 E8E6FF              <1> 	call	CMOS_ReadFromIndexInDLtoAL
    91 000003BA 50                  <1> 	push	ax			; Store checksum word
    92                              <1> 
    93                              <1> 	; Verify checksum
    94 000003BB E81200              <1> 	call	GetSumOfBytes10hto2DhtoCX
    95 000003BE 58                  <1> 	pop		ax
    96 000003BF 39C8                <1> 	cmp		ax, cx		; ZF set if checksum verified
    97 000003C1 C3                  <1> 	ret
    98                              <1> 
    99                              <1> 
   100                              <1> ;--------------------------------------------------------------------
   101                              <1> ; CMOS_StoreNewChecksumFor10hto2Dh
   102                              <1> ;	Parameters:
   103                              <1> ;		Nothing
   104                              <1> ;	Returns:
   105                              <1> ;		Interrupts disabled and NMI disabled
   106                              <1> ;	Corrupts registers:
   107                              <1> ;		AX, CX, DX
   108                              <1> ;--------------------------------------------------------------------
   109                              <1> CMOS_StoreNewChecksumFor10hto2Dh:
   110 000003C2 E80B00              <1> 	call	GetSumOfBytes10hto2DhtoCX
   111                              <1> 
   112                              <1> 	; Write it to CMOS
   113 000003C5 91                  <1> 	xchg	ax, cx
   114 000003C6 B22F                <1> 	mov		dl, CHECKSUM_OF_BYTES_10hTo2Dh_LOW
   115 000003C8 E8CCFF              <1> 	call	CMOS_WriteALtoIndexInDL
   116 000003CB 86E0                <1> 	xchg	al, ah
   117 000003CD 4A                  <1> 	dec		dx			; CHECKSUM_OF_BYTES_10hTo2Dh_HIGH
   118 000003CE EBC7                <1> 	jmp		SHORT CMOS_WriteALtoIndexInDL
   119                              <1> 
   120                              <1> 
   121                              <1> ;--------------------------------------------------------------------
   122                              <1> ; GetSumOfBytes10hto2DhtoCX
   123                              <1> ;	Parameters:
   124                              <1> ;		Nothing
   125                              <1> ;	Returns:
   126                              <1> ;		CX:		Sum of CMOS bytes 10h to 2Dh
   127                              <1> ;		Interrupts disabled and NMI disabled
   128                              <1> ;	Corrupts registers:
   129                              <1> ;		AX, DX
   130                              <1> ;--------------------------------------------------------------------
   131                              <1> GetSumOfBytes10hto2DhtoCX:
   132 000003D0 31C9                <1> 	xor		cx, cx			; Sum
   133 000003D2 B210                <1> 	mov		dl, 10h			; First index
   134 000003D4 30E4                <1> 	xor		ah, ah
