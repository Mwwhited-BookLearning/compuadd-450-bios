    20                              <1> ; Structure containing variables for PIO transfer functions.
    21                              <1> ; This struct must not be larger than IDEPACK without INTPACK.
    22                              <1> struc PIOVARS	; Must not be larger than 9 bytes! See IDEPACK in RamVars.inc.
    23 00000000 ????                <1> 	.wDataPort				resb	2	; 0-1, IDE Data Port
    24 00000002 ????                <1> 	.fnXfer					resb	2	; 2-3, Offset to transfer function
    25 00000004 ????                <1> 	.wSectorsInBlock		resb	2	; 4-5, Block size in sectors
    26 00000006 ??                  <1> 	.bSectorsLeft			resb	1	; 6, Sectors left to transfer
    27 00000007 ??                  <1> 							resb	1	; 7, IDEPACK.bDeviceControl
    28 00000008 ??                  <1> 	.bSectorsDone			resb	1	; 8, Number of sectors xferred
