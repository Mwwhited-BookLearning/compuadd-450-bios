   147                              <2> ;--------------------------------------------------------------------
   148                              <2> ; DisplayFormat_ParseCharacters
   149                              <2> ;	Parameters:
   150                              <2> ;		DS:		BDA segment (zero)
   151                              <2> ;		SS:BP:	Pointer to first format parameter (-=2 updates to next parameter)
   152                              <2> ;		CS:SI:	Pointer to string to format
   153                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   154                              <2> ;	Returns:
   155                              <2> ;		CS:SI:	Ptr to end of format string (ptr to one past NULL)
   156                              <2> ;		DI:		Updated offset to video RAM
   157                              <2> ;	Corrupts registers:
   158                              <2> ;		AX, BX, CX, DX, BP
   159                              <2> ;--------------------------------------------------------------------
   160                              <2> DisplayFormatCompressed_BaseFormatOffset:
   161                              <2> DisplayFormat_ParseCharacters_FromAX:
   162 000002F2 89C6                <2> 	mov		si, ax
   163                              <2> 	; fall through to DisplayFormat_ParseCharacters
   164                              <2> 
   165                              <2> ALIGN DISPLAY_JUMP_ALIGN
   166                              <2> DisplayFormat_ParseCharacters:
   167                              <2> ;
   168                              <2> ; This routine is used to output all strings from the ROM.  The strings in ROMVARS are not compressed,
   169                              <2> ; and must be handled differently.
   170                              <2> ;
   171 000002F4 83FE7F              <2> 	cmp		si, BYTE 7Fh		; well within the boundaries of ROMVARS_size
   172 000002F7 8CCB                <2> 	mov		bx, cs				; preload bx with cs in case we take the following jump
   173 000002F9 72A0                <2> 	jb		SHORT DisplayPrint_NullTerminatedStringFromBXSI
   174                              <2> 
   175                              <2> .decode:
   176 000002FB 2EAC                <2> 	cs lodsb					; load next byte of the string
   177 000002FD 88C5                <2> 	mov		ch, al				; save a copy for later processing of high order bits
   178 000002FF A8C0                <2> 	test	al, 0C0h			; check for translation/format character
   179 00000301 7414                <2> 	jz		SHORT DisplayFormatCompressed_TranslatesAndFormats
   180                              <2> 
   181 00000303 243F                <2> 	and		al, 3Fh								; "Normal" character, mask off high order bits
   182 00000305 043A                <2> 	add		al, StringsCompressed_NormalBase	; and add character offset (usually around 0x40)
   183                              <2> 
   184                              <2> .output:
   185 00000307 E885FF              <2> 	call 	DisplayPrint_CharacterFromAL
   186                              <2> 
   187                              <2> .process_after_output:
   188                              <2> 	eSHL_IM	ch, 1								; check high order bits for end of string or space
   661                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <3> %ifdef USE_386
   663                              <3>  %if %2 = 1
   664                              <3>  FSIS ], %1
   665                              <3>  %if strpos
   666                              <3>  eSHIFT_IM %1, %2, shl
   667                              <3>  %else
   668 0000030A 00ED                <3>  add %1, %1
   669                              <3>  %endif
   670                              <3>  %else
   671                              <3>  eSHIFT_IM %1, %2, shl
   672                              <3>  %endif
   673                              <3> %else
   674                              <3>  eSHIFT_IM %1, %2, shl
   675                              <3> %endif
   676                              <3> %endif
   189 0000030C 79A5                <2> 	jns		SHORT DisplayFormatCompressed_ret
   190 0000030E 73EB                <2> 	jnc		SHORT .decode
   191 00000310 B020                <2> 	mov		al, ' '
   192 00000312 E87AFF              <2> 	call	DisplayPrint_CharacterFromAL
   193 00000315 EBE4                <2> 	jmp		SHORT .decode
   194                              <2> 
   195                              <2> 
   196                              <2> ALIGN DISPLAY_JUMP_ALIGN
   197                              <2> DisplayFormatCompressed_TranslatesAndFormats:
   198                              <2> ;
   199                              <2> ; This routine is here (above DisplayFormat_ParseCharacters) to reduce the amount of code between
   200                              <2> ; DisplayFormatCompressed_BaseFormatOffset and jump targets (must fit in 256 bytes)
   201                              <2> ;
   202                              <2> 	eSHL_IM	ch, 1				; setup ch for later testing of null in .process_after_output
   661                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <3> %ifdef USE_386
   663                              <3>  %if %2 = 1
   664                              <3>  FSIS ], %1
   665                              <3>  %if strpos
   666                              <3>  eSHIFT_IM %1, %2, shl
   667                              <3>  %else
   668 00000317 00ED                <3>  add %1, %1
   669                              <3>  %endif
   670                              <3>  %else
   671                              <3>  eSHIFT_IM %1, %2, shl
   672                              <3>  %endif
   673                              <3> %else
   674                              <3>  eSHIFT_IM %1, %2, shl
   675                              <3> %endif
   676                              <3> %endif
   203 00000319 83E01F              <2> 	and		ax, 001Fh			; also clears AH for addition with BX and DX below
   204                              <2> 
   205 0000031C BB[E203]            <2> 	mov		bx, StringsCompressed_TranslatesAndFormats	; calculate offset of translation/formats offset byte
   206 0000031F 01C3                <2> 	add		bx, ax
   207                              <2> 
   208 00000321 3C14                <2> 	cmp		al, StringsCompressed_FormatsBegin			; determine if this is a translation or a format
   209 00000323 2E8A07              <2> 	mov		al, [cs:bx]									; fetch translation/formats byte
   210 00000326 72DF                <2> 	jb		SHORT DisplayFormat_ParseCharacters.output	; check if this a translation or a format
   211                              <2> 														; if it is translation, output and postprocess for eos
   212                              <2> 														; note that the flags for this conditional jump were
   213                              <2> 														; set with the cmp al,StringsCompressed_FormatsBegin
   214                              <2> 
   215 00000328 BA[F202]            <2> 	mov		dx, DisplayFormatCompressed_BaseFormatOffset	; calculate address to jump to for format handler
   216 0000032B 29C2                <2> 	sub		dx, ax
   217                              <2> 
   218 0000032D 8B4600              <2> 	mov		ax, [bp]			; preload ax with parameter
   219 00000330 4D                  <2> 	dec		bp					; if no parameter is needed (format 'nl' for example),
   220 00000331 4D                  <2> 	dec		bp					; the format handler can reincrement bp
   221                              <2> 
   222 00000332 BB0005              <2> 	mov		bx, 0500h			; preload bh with 5 decimal places for numeric output
   223                              <2> 								; bl is zero, indicating not to output a 'h' (default base 10)
   224                              <2> 
   225 00000335 56                  <2> 	push	si					; preserve si and cx, in the case of outputing a string
   226 00000336 51                  <2> 	push	cx
   227                              <2> 
   228 00000337 BE0A00              <2> 	mov		si, 10				; preload si with 10 for numeric output (default base 10)
   229 0000033A FFD2                <2> 	call	dx					; call the format routine
   230                              <2> 
   231 0000033C 59                  <2> 	pop		cx					; restore cx and si
   232 0000033D 5E                  <2> 	pop		si
   233                              <2> 
   234 0000033E EBCA                <2> 	jmp		SHORT DisplayFormat_ParseCharacters.process_after_output	; continue postprocessing, check for end of string
    37                              <1> %else
