    20                              <2> ; Section containing code
    21                              <2> SECTION .text
    22                              <2> 
    23                              <2> 
    24                              <2> ;--------------------------------------------------------------------
    25                              <2> ; Supports following formatting types:
    26                              <2> ;	%a		Specifies attribute for next character
    27                              <2> ;	%A		Specifies attribute for remaining string (or until next %A)
    28                              <2> ;	%d		Prints signed 16-bit decimal integer
    29                              <2> ;	%u		Prints unsigned 16-bit decimal integer
    30                              <2> ;	%x		Prints 16-bit hexadecimal integer
    31                              <2> ;	%s		Prints string (from CS segment)
    32                              <2> ;	%S		Prints string (far pointer)
    33                              <2> ;	%c		Prints character
    34                              <2> ;	%t		Prints character number of times (character needs to be pushed first, then repeat times)
    35                              <2> ;	%%		Prints '%' character (no parameter pushed)
    36                              <2> ;
    37                              <2> ;	Any placeholder can be set to minimum length by specifying
    38                              <2> ;	minimum number of characters. For example %8d would append spaces
    39                              <2> ;	after integer so that at least 8 characters would be printed.
    40                              <2> ;
    41                              <2> ;	When placing '-' after number, then spaces will be used for prepending.
    42                              <2> ;	For example %8-d would prepend integer with spaces so that at least
    43                              <2> ;	8 characters would be printed.
    44                              <2> ;
    45                              <2> ; DisplayPrint_FormattedNullTerminatedStringFromCSSI
    46                              <2> ;	Parameters:
    47                              <2> ;		BP:		SP before pushing parameters
    48                              <2> ;		DS:		BDA segment (zero)
    49                              <2> ;		CS:SI:	Pointer to string to format
    50                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
    51                              <2> ;		Stack:	Parameters for formatting placeholders.
    52                              <2> ;				Parameter for first placeholder must be pushed first.
    53                              <2> ;				Low word must pushed first for placeholders requiring
    54                              <2> ;				32-bit parameters (two words).
    55                              <2> ;	Returns:
    56                              <2> ;		DI:		Updated offset to video RAM
    57                              <2> ;	Corrupts registers:
    58                              <2> ;		AX, DX
    59                              <2> ;--------------------------------------------------------------------
    60                              <2> ALIGN DISPLAY_JUMP_ALIGN
    61                              <2> DisplayPrint_FormattedNullTerminatedStringFromCSSI:
    62 00000264 55                  <2> 	push	bp
    63 00000265 56                  <2> 	push	si
    64 00000266 51                  <2> 	push	cx
    65 00000267 53                  <2> 	push	bx
    66 00000268 FF365E04            <2> 	push	WORD [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bAttribute]
    67                              <2> 
    68 0000026C 4D                  <2> 	dec		bp					; Point BP to...
    69 0000026D 4D                  <2> 	dec		bp					; ...first stack parameter
    70 0000026E E88300              <2> 	call	DisplayFormat_ParseCharacters
    71                              <2> 
    72                              <2> 	; Pop original character attribute
    73 00000271 58                  <2> 	pop		ax
    74 00000272 A25E04              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bAttribute], al
    75                              <2> 
    76 00000275 5B                  <2> 	pop		bx
    77 00000276 59                  <2> 	pop		cx
    78 00000277 5E                  <2> 	pop		si
    79 00000278 5D                  <2> 	pop		bp
    80                              <2> 
    81 00000279 C3                  <2> 	ret
    82                              <2> 
    83                              <2> 
    84                              <2> ;--------------------------------------------------------------------
    85                              <2> ; DisplayPrint_SignedWordFromAXWithBaseInBL
    86                              <2> ;	Parameters:
    87                              <2> ;		AX:		Word to display
    88                              <2> ;		BL:		Integer base (binary=2, octal=8, decimal=10, hexadecimal=16)
    89                              <2> ;		DS:		BDA segment (zero)
    90                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
    91                              <2> ;	Returns:
    92                              <2> ;		DI:		Updated offset to video RAM
    93                              <2> ;	Corrupts registers:
    94                              <2> ;		AX, BH, DX
    95                              <2> ;--------------------------------------------------------------------
    96                              <2> %ifndef EXCLUDE_FROM_XUB
    97                              <2> ALIGN DISPLAY_JUMP_ALIGN
    98                              <2> DisplayPrint_SignedWordFromAXWithBaseInBL:
    99                              <2> 	sahf
   100                              <2> 	jns		SHORT DisplayPrint_WordFromAXWithBaseInBL
   101                              <2> 
   102                              <2> 	push	ax
   103                              <2> 	mov		al, '-'
   104                              <2> 	call	DisplayPrint_CharacterFromAL
   105                              <2> 	pop		ax
   106                              <2> 	neg		ax
   107                              <2> 	; Fall to DisplayPrint_WordFromAXWithBaseInBL
   108                              <2> %endif
   109                              <2> 
   110                              <2> 
   111                              <2> ;--------------------------------------------------------------------
   112                              <2> ; DisplayPrint_WordFromAXWithBaseInBL
   113                              <2> ;	Parameters:
   114                              <2> ;		AX:		Word to display
   115                              <2> ;		BL:		Integer base (binary=2, octal=8, decimal=10, hexadecimal=16)
   116                              <2> ;		DS:		BDA segment (zero)
   117                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   118                              <2> ;	Returns:
   119                              <2> ;		DI:		Updated offset to video RAM
   120                              <2> ;	Corrupts registers:
   121                              <2> ;		AX, BH, DX
   122                              <2> ;--------------------------------------------------------------------
   123                              <2> %ifndef MODULE_STRINGS_COMPRESSED
   124                              <2> ALIGN DISPLAY_JUMP_ALIGN
   125                              <2> DisplayPrint_WordFromAXWithBaseInBL:
   126                              <2> 	push	cx
   127                              <2> 
   128                              <2> 	xor		cx, cx
   129                              <2> 	xor		bh, bh				; Base now in BX
   130                              <2> ALIGN DISPLAY_JUMP_ALIGN
   131                              <2> .DivideLoop:
   132                              <2> 	inc		cx					; Increment character count
   133                              <2> 	xor		dx, dx				; DX:AX now holds the integer
   134                              <2> 	div		bx					; Divide DX:AX by base
   135                              <2> 	push	dx					; Push remainder
   136                              <2> 	test	ax, ax				; All divided?
   137                              <2> 	jnz		SHORT .DivideLoop	;  If not, loop
   138                              <2> 
   139                              <2> ALIGN DISPLAY_JUMP_ALIGN
   140                              <2> PrintAllPushedDigits:			; Unused entrypoint OK
   141                              <2> .PrintNextDigit:
   142                              <2> 	pop		ax					; Pop digit
   143                              <2> 	cmp		al, 10				; Convert binary digit in AL to ASCII hex digit ('0'-'9' or 'A'-'F')
   144                              <2> 	sbb		al, 69h
   145                              <2> 	das
   146                              <2> 	call	DisplayPrint_CharacterFromAL
   147                              <2> 	loop	.PrintNextDigit
   148                              <2> 
   149                              <2> 	pop		cx
   150                              <2> 	ret
   151                              <2> %endif ; ~MODULE_STRINGS_COMPRESSED
   152                              <2> 
   153                              <2> ;--------------------------------------------------------------------
   154                              <2> ; DisplayPrint_QWordFromSSBPwithBaseInBX
   155                              <2> ;	Parameters:
   156                              <2> ;		SS:BP:	QWord to display
   157                              <2> ;		BX:		Integer base (binary=2, octal=8, decimal=10, hexadecimal=16)
   158                              <2> ;		DS:		BDA segment (zero)
   159                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   160                              <2> ;	Returns:
   161                              <2> ;		DI:		Updated offset to video RAM
   162                              <2> ;	Corrupts registers:
   163                              <2> ;		AX, DX, [SS:BP]
   164                              <2> ;--------------------------------------------------------------------
   165                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_XTIDECFG
   166                              <2> ALIGN DISPLAY_JUMP_ALIGN
   167                              <2> DisplayPrint_QWordFromSSBPwithBaseInBX:
   168                              <2> 	push	cx
   169                              <2> 
   170                              <2> 	mov		cx, bx				; CX = Integer base
   171                              <2> 	xor		bx, bx				; BX = Character count
   172                              <2> ALIGN DISPLAY_JUMP_ALIGN
   173                              <2> .DivideLoop:
   174                              <2> 	call	Math_DivQWatSSBPbyCX; Divide by base
   175                              <2> 	push	dx					; Push remainder
   176                              <2> 	inc		bx					; Increment character count
   177                              <2> 	cmp		WORD [bp], BYTE 0	; All divided?
   178                              <2> 	jne		SHORT .DivideLoop	;  If not, loop
   179                              <2> 	xchg	cx, bx				; Character count to CX, Integer base to BX
   180                              <2> 	jmp		SHORT PrintAllPushedDigits
   181                              <2> %endif
   182                              <2> 
   183                              <2> 
   184                              <2> ;--------------------------------------------------------------------
   185                              <2> ; DisplayPrint_CharacterBufferFromBXSIwithLengthInCX
   186                              <2> ;	Parameters:
   187                              <2> ;		CX:		Buffer length (characters)
   188                              <2> ;		BX:SI:	Ptr to NULL terminated string
   189                              <2> ;		DS:		BDA segment (zero)
   190                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   191                              <2> ;	Returns:
   192                              <2> ;		DI:		Updated offset to video RAM
   193                              <2> ;	Corrupts registers:
   194                              <2> ;		AX, DX
   195                              <2> ;--------------------------------------------------------------------
   196                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   197                              <2> ALIGN DISPLAY_JUMP_ALIGN
   198                              <2> DisplayPrint_CharacterBufferFromBXSIwithLengthInCX:
   199                              <2> 	jcxz	.NothingToPrintSinceZeroLength
   200                              <2> 	push	si
   201                              <2> 	push	cx
   202                              <2> 
   203                              <2> ALIGN DISPLAY_JUMP_ALIGN
   204                              <2> .PrintNextCharacter:
   205                              <2> 	mov		ds, bx
   206                              <2> 	lodsb
   207                              <2> 	LOAD_BDA_SEGMENT_TO	ds, dx
   208                              <2> 	call	DisplayPrint_CharacterFromAL
   209                              <2> 	loop	.PrintNextCharacter
   210                              <2> 
   211                              <2> 	pop		cx
   212                              <2> 	pop		si
   213                              <2> .NothingToPrintSinceZeroLength:
   214                              <2> 	ret
   215                              <2> %endif
   216                              <2> 
   217                              <2> 
   218                              <2> ;--------------------------------------------------------------------
   219                              <2> ; DisplayPrint_ClearScreenWithCharInALandAttributeInAH
   220                              <2> ;	Parameters:
   221                              <2> ;		AL:		Character to clear with
   222                              <2> ;		AH:		Attribute to clear with
   223                              <2> ;		DS:		BDA segment (zero)
   224                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   225                              <2> ;	Returns:
   226                              <2> ;		Nothing
   227                              <2> ;	Corrupts registers:
   228                              <2> ;		AX, DX
   229                              <2> ;--------------------------------------------------------------------
   230                              <2> %ifdef INCLUDE_MENU_LIBRARY
   231                              <2> ALIGN DISPLAY_JUMP_ALIGN
   232                              <2> DisplayPrint_ClearScreenWithCharInALandAttributeInAH:
   233                              <2> 	push	di
   234                              <2> 	push	cx
   235                              <2> 
   236                              <2> 	xchg	cx, ax
   237                              <2> 	xor		ax, ax
   238                              <2> 	call	DisplayCursor_SetCoordinatesFromAX		; Updates DI
   239                              <2> 	call	DisplayPage_GetColumnsToALandRowsToAH
   240                              <2> 	mul		ah		; AX = AL*AH = Characters on screen
   241                              <2> 	xchg	cx, ax	; AX = Char+Attr, CX = WORDs to store
   242                              <2> 	rep stosw
   243                              <2> 
   244                              <2> 	pop		cx
   245                              <2> 	pop		di
   246                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], di
   247                              <2> 	ret
   248                              <2> %endif
   249                              <2> 
   250                              <2> 
   251                              <2> ;--------------------------------------------------------------------
   252                              <2> ; DisplayPrint_ClearAreaWithHeightInAHandWidthInAL
   253                              <2> ;	Parameters:
   254                              <2> ;		AH:		Area height
   255                              <2> ;		AL:		Area width
   256                              <2> ;		DS:		BDA segment (zero)
   257                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   258                              <2> ;	Returns:
   259                              <2> ;		DI:		Updated offset to video RAM
   260                              <2> ;	Corrupts registers:
   261                              <2> ;		AX, DX
   262                              <2> ;--------------------------------------------------------------------
   263                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   264                              <2> ALIGN DISPLAY_JUMP_ALIGN
   265                              <2> DisplayPrint_ClearAreaWithHeightInAHandWidthInAL:
   266                              <2> 	push	si
   267                              <2> 	push	cx
   268                              <2> 	push	bx
   269                              <2> 
   270                              <2> 	xchg	bx, ax							; Area size to BX
   271                              <2> 	call	DisplayCursor_GetSoftwareCoordinatesToAX
   272                              <2> 	xchg	si, ax							; Software (Y,X) coordinates now in SI
   273                              <2> 	xor		cx, cx
   274                              <2> 
   275                              <2> ALIGN DISPLAY_JUMP_ALIGN
   276                              <2> .ClearRowLoop:
   277                              <2> 	mov		cl, bl							; Area width now in CX
   278                              <2> 	mov		al, SCREEN_BACKGROUND_CHARACTER
   279                              <2> 	call	DisplayPrint_RepeatCharacterFromALwithCountInCX
   280                              <2> 
   281                              <2> 	xchg	ax, si							; Coordinates to AX
   282                              <2> 	inc		ah								; Increment row
   283                              <2> 	mov		si, ax
   284                              <2> 	call	DisplayCursor_SetCoordinatesFromAX
   285                              <2> 	dec		bh								; Decrement rows left
   286                              <2> 	jnz		SHORT .ClearRowLoop
   287                              <2> 
   288                              <2> 	pop		bx
   289                              <2> 	pop		cx
   290                              <2> 	pop		si
   291                              <2> 	ret
   292                              <2> %endif
   293                              <2> 
   294                              <2> %ifdef EXCLUDE_FROM_XUB
   295                              <2> 	%define EXCLUDE
   296                              <2> 	%ifndef MODULE_STRINGS_COMPRESSED
