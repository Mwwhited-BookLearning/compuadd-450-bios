   129                              <1> ;	Returns:
   130                              <1> ;		Nothing
   131                              <1> ;	Corrupts registers:
   132                              <1> ;		AX, SI, DI
   133                              <1> ;--------------------------------------------------------------------
   134                              <1> DetectPrint_DriveNameFromDrvDetectInfoInESBX:
   135 000009C7 55                  <1> 	push	bp
   136 000009C8 89E5                <1> 	mov		bp, sp
   137                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   138                              <1> %if DRVDETECTINFO.szDrvName = 0
   139 000009CA 53                  <1> 	push	bx
   140                              <1> %else
   141                              <1> 	lea		si, [bx+DRVDETECTINFO.szDrvName]
   142                              <1> 	push	si
   143                              <1> %endif
   144                              <1> %endif
   145 000009CB BE[F300]            <1> 	mov		si, g_szDriveName
   146 000009CE EB3D                <1> 	jmp		SHORT DetectPrint_FormatCSSIfromParamsInSSBP
   147                              <1> 
   148                              <1> 
