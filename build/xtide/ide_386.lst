   188                              <1> ; DetectPrint_FailedToLoadFirstSector
   189                              <1> ;	Parameters:
   190                              <1> ;		AH:		INT 13h error code
   191                              <1> ;	Returns:
   192                              <1> ;		CF:		Set
   193                              <1> ;	Corrupts registers:
   194                              <1> ;		AX, CX, SI, DI
   195                              <1> ;--------------------------------------------------------------------
   196                              <1> DetectPrint_FailedToLoadFirstSector:
   197 000009DF 55                  <1> 	push	bp
   198 000009E0 89E5                <1> 	mov		bp, sp
   199                              <1> 	eMOVZX	cx, ah
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 000009E2 0FB6CC              <2>  movzx %1, %2
   438                              <2> %endif
   200 000009E5 51                  <1> 	push	cx					; Push INT 13h error code
   201 000009E6 BE[1301]            <1> 	mov		si, g_szReadError
   202 000009E9 EB22                <1> 	jmp		SHORT DetectPrint_FormatCSSIfromParamsInSSBP	; Sets CF
   203                              <1> 
