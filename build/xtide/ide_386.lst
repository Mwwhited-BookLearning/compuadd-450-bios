    31                                  	%define ORIGIN 0
    32                                  	ORG ORIGIN						; Code start offset 0000h
    33                                  
    34                                  	; We must define included libraries before including "AssemblyLibrary.inc".
    35                                  %define	EXCLUDE_FROM_XUB					; Exclude unused library functions
    36                                  %ifdef MODULE_BOOT_MENU
    37                                  	%define MENUEVENT_INLINE_OFFSETS		; Only one menu required, save space and inline offsets
    38                                  	%define INCLUDE_MENU_LIBRARY
    39                                  	%define MENU_NO_ESC						; User cannot 'esc' out of the menu
    40                                  %else	; If no boot menu included
    41                                  	%define	INCLUDE_DISPLAY_LIBRARY
    42                                  	%define INCLUDE_KEYBOARD_LIBRARY
    43                                  	%define INCLUDE_TIME_LIBRARY
    44                                  %endif
