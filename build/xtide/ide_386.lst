    24                              <1> %macro TEST_USING_DPT_AND_JUMP_IF_SERIAL_DEVICE 1
    25                              <1> 	test	BYTE [di+DPT.bFlagsHigh], FLGH_DPT_SERIAL_DEVICE
    26                              <1> 	jnz		SHORT %1
    27                              <1> %endmacro
    28                              <1> 
    29                              <1> %macro CMP_USING_IDEVARS_IN_CSBP_AND_JUMP_IF 2
    30                              <1> 	cmp		BYTE [cs:bp+IDEVARS.bDevice], %1
    31                              <1> 	je		SHORT %2
    32                              <1> %endmacro
    33                              <1> 
    34                              <1> 
    35                              <1> 
    36                              <1> ;--------------------------------------------------------------------
    37                              <1> ; Device_FinalizeDPT
    38                              <1> ;	Parameters:
    39                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    40                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    41                              <1> ;		CS:BP:	Ptr to IDEVARS for the controller
    42                              <1> ;	Returns:
    43                              <1> ;		Nothing
    44                              <1> ;	Corrupts registers:
    45                              <1> ;		AX, BX, CX, DX
    46                              <1> ;--------------------------------------------------------------------
    47                              <1> %ifdef MODULE_SERIAL	; IDE + Serial
    48                              <1> Device_FinalizeDPT:
    49                              <1> 	; Needs to check IDEVARS vs. checking the DPT as the serial bit in the DPT is set in the Finalize routine
    50 00000E65 2E807E041A          <1> 	cmp		BYTE [cs:bp+IDEVARS.bDevice], DEVICE_SERIAL_PORT
    51                              <1> %ifdef USE_386
    52 00000E6A 0F858B06            <1> 	jne		IdeDPT_Finalize
    53 00000E6E E95509              <1> 	jmp		SerialDPT_Finalize
    54                              <1> %else ; ~USE_386
    55                              <1> 	je		SHORT .FinalizeDptForSerialPortDevice
    56                              <1> 	jmp		IdeDPT_Finalize
    57                              <1> .FinalizeDptForSerialPortDevice:
    58                              <1> 	jmp		SerialDPT_Finalize
    59                              <1> %endif
    60                              <1> 
    61                              <1> %else					; IDE
    62                              <1> 	Device_FinalizeDPT		EQU		IdeDPT_Finalize
    63                              <1> %endif
    64                              <1> 
    65                              <1> 
    66                              <1> ;--------------------------------------------------------------------
    67                              <1> ; Device_ResetMasterAndSlaveController
    68                              <1> ;	Parameters:
    69                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    70                              <1> ;	Returns:
    71                              <1> ;		AH:		INT 13h Error Code
    72                              <1> ;		CF:		Cleared if success, Set if error
    73                              <1> ;	Corrupts registers:
    74                              <1> ;		AL, BX, CX, DX
    75                              <1> ;--------------------------------------------------------------------
    76                              <1> %ifdef MODULE_SERIAL	; IDE + Serial
    77                              <1> Device_ResetMasterAndSlaveController:
    78                              <1> 	TEST_USING_DPT_AND_JUMP_IF_SERIAL_DEVICE	ReturnSuccessForSerialPort
    25 00000E71 F6450104            <2>  test BYTE [di+DPT.bFlagsHigh], FLGH_DPT_SERIAL_DEVICE
    26 00000E75 7530                <2>  jnz SHORT %1
    79 00000E77 E98D02              <1> 	jmp		IdeCommand_ResetMasterAndSlaveController
    80                              <1> 
    81                              <1> %else					; IDE
    82                              <1> 	Device_ResetMasterAndSlaveController	EQU		IdeCommand_ResetMasterAndSlaveController
    83                              <1> %endif
    84                              <1> 
    85                              <1> 
    86                              <1> ;--------------------------------------------------------------------
    87                              <1> ; Device_IdentifyToBufferInESSIwithDriveSelectByteInBH
    88                              <1> ;	Parameters:
    89                              <1> ;		BH:		Drive Select byte for Drive and Head Select Register
    90                              <1> ;		CX:		XUB_INT13h_SIGNATURE to ignore illegal ATA-ID values, otherwise
    91                              <1> ;				correct them (only used if NOT build with NO_ATAID_CORRECTION)
    92                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
    93                              <1> ;		DS:		Segment to RAMVARS
    94                              <1> ;		ES:SI:	Ptr to buffer to receive 512-byte IDE Information
    95                              <1> ;		CS:BP:	Ptr to IDEVARS
    96                              <1> ;	Returns:
    97                              <1> ;		AH:		INT 13h Error Code
    98                              <1> ;		CF:		Cleared if success, Set if error
    99                              <1> ;	Corrupts registers:
   100                              <1> ;		AL, BX, CX, DX, SI, DI, ES
   101                              <1> ;--------------------------------------------------------------------
   102                              <1> %ifndef NO_ATAID_CORRECTION
   103                              <1> Device_IdentifyToBufferInESSIwithDriveSelectByteInBH:
   104 00000E7A 81F95875            <1> 	cmp		cx, XUB_INT13h_SIGNATURE
   105 00000E7E 7405                <1> 	je		SHORT .DoNotFixAtaInformation
   106 00000E80 06                  <1> 	push	es
   107 00000E81 56                  <1> 	push	si
   108                              <1> 	ePUSH_T	cx, AtaID_PopESSIandFixIllegalValuesFromESSI	; Here we modify ATA information if necessary
   751                              <2> %ifndef USE_186
