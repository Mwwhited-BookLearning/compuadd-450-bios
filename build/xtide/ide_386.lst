    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; AccessDPT_GetDriveSelectByteToAL
    25                              <1> ;	Parameters:
    26                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    27                              <1> ;	Returns:
    28                              <1> ;		AL:		Drive Select Byte
    29                              <1> ;	Corrupts registers:
    30                              <1> ;		Nothing
    31                              <1> ;--------------------------------------------------------------------
    32 000006E6 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    33                              <1> AccessDPT_GetDriveSelectByteToAL:
    34 000006E8 8A05                <1> 	mov		al, [di+DPT.bFlagsLow]
    35 000006EA 2450                <1> 	and		al, FLGL_DPT_SLAVE | FLGL_DPT_LBA
    36 000006EC 0CA0                <1> 	or		al, MASK_DRVNHEAD_SET	; Bits set to 1 for old drives
    37 000006EE C3                  <1> 	ret
    38                              <1> 
    39                              <1> 
    40                              <1> ;--------------------------------------------------------------------
    41                              <1> ; AccessDPT_GetDeviceControlByteToAL
    42                              <1> ;	Parameters:
    43                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    44                              <1> ;	Returns:
    45                              <1> ;		AL:		Device Control Byte
    46                              <1> ;	Corrupts registers:
    47                              <1> ;		Nothing
    48                              <1> ;--------------------------------------------------------------------
    49 000006EF 90                  <1> ALIGN JUMP_ALIGN
    50                              <1> AccessDPT_GetDeviceControlByteToAL:
    51                              <1> %ifdef MODULE_IRQ
    52                              <1> 
    53                              <1> %ifndef USE_UNDOC_INTEL
    54                              <1> 	xor		al, al
    55                              <1> %endif
    56                              <1> 
    57 000006F0 F60520              <1> 	test	BYTE [di+DPT.bFlagsLow], FLGL_DPT_ENABLE_IRQ	; Clears CF
    58                              <1> 
    59                              <1> %ifdef USE_UNDOC_INTEL
    60 000006F3 D6                  <1> 	salc	; Clears AL using CF while preserving flags
    61                              <1> %endif
    62                              <1> 
    63 000006F4 7502                <1> 	jnz		SHORT .EnableDeviceIrq
    64 000006F6 B002                <1> 	mov		al, FLG_DEVCONTROL_nIEN	; Disable IRQ
    65                              <1> .EnableDeviceIrq:
    66                              <1> %else	; ifndef MODULE_IRQ
    67                              <1> 	mov		al, FLG_DEVCONTROL_nIEN	; Disable IRQ
    68                              <1> %endif ; MODULE_IRQ
    69 000006F8 C3                  <1> 	ret
    70                              <1> 
    71                              <1> 
    72                              <1> ;--------------------------------------------------------------------
    73                              <1> ; AccessDPT_GetLCHStoAXBLBH
    74                              <1> ;	Parameters:
    75                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    76                              <1> ;	Returns:
    77                              <1> ;		AX:		Number of L-CHS cylinders
    78                              <1> ;		BL:		Number of L-CHS heads
    79                              <1> ;		BH:		Number of L-CHS sectors per track
    80                              <1> ;	Corrupts registers:
    81                              <1> ;		Nothing
    82                              <1> ;--------------------------------------------------------------------
    83                              <1> AccessDPT_GetLCHStoAXBLBH:
    84 000006F9 8B4506              <1> 	mov		ax, [di+DPT.wLchsCylinders]
    85 000006FC 8B5D08              <1> 	mov		bx, [di+DPT.wLchsHeadsAndSectors]
    86 000006FF C3                  <1> 	ret
    87                              <1> 
    88                              <1> 
    89                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
    90                              <1> ;--------------------------------------------------------------------
    91                              <1> ; AccessDPT_IsThisDeviceXTCF
    92                              <1> ;	Parameters:
    93                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    94                              <1> ;	Returns:
    95                              <1> ;		AH:		Device Type
    96                              <1> ;		CF:		Cleared if XTCF
    97                              <1> ;				Set if some other device
    98                              <1> ;	Corrupts registers:
    99                              <1> ;		Nothing
   100                              <1> ;--------------------------------------------------------------------
   101                              <1> AccessDPT_IsThisDeviceXTCF:
   102                              <1> 	mov		ah, [di+DPT_ATA.bDevice]
   103                              <1> 	cmp		ah, FIRST_XTCF_DEVICE
   104                              <1> 	jb		SHORT .DeviceIsNotXTCF
   105                              <1> 	cmp		ah, LAST_XTCF_DEVICE+1
   106                              <1> 	cmc
   107                              <1> .DeviceIsNotXTCF:
   108                              <1> 	ret
   109                              <1> %endif ; MODULE_8BIT_IDE_ADVANCED
   110                              <1> 
