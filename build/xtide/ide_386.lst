    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; PDC20x30_DetectControllerForIdeBaseInBX
    26                              <1> ;	Parameters:
    27                              <1> ;		BX:		IDE Base Port
    28                              <1> ;	Returns:
    29                              <1> ;		AX:		ID WORD for detected controller
    30                              <1> ;		DX:		Controller base port
    31                              <1> ;		CF:		Set if PDC detected
    32                              <1> ;	Corrupts registers:
    33                              <1> ;		BX (only when PDC detected)
    34                              <1> ;--------------------------------------------------------------------
    35                              <1> PDC20x30_DetectControllerForIdeBaseInBX:
    36 00001027 89DA                <1> 	mov		dx, bx
    37 00001029 E82300              <1> 	call	EnablePdcProgrammingMode
    38 0000102C 7520                <1> 	jnz		SHORT DisablePdcProgrammingMode.Return	; PDC controller not detected
    39                              <1> ;	ePUSH_T	ax, DisablePdcProgrammingMode			; Uncomment this if GetPdcIDtoAX needs to be a real function
    40                              <1> 	; Fall to GetPdcIDtoAX
    41                              <1> 
    42                              <1> ;--------------------------------------------------------------------
    43                              <1> ; Programming mode must be enabled for this function.
    44                              <1> ; This function also enables PDC 20630 extra registers.
    45                              <1> ;
    46                              <1> ; GetPdcIDtoAX
    47                              <1> ;	Parameters:
    48                              <1> ;		DX:		IDE Base port
    49                              <1> ;	Returns:
    50                              <1> ;		AH:		PDC ID
    51                              <1> ;	Corrupts registers:
    52                              <1> ;		AL, BX
    53                              <1> ;--------------------------------------------------------------------
    54                              <1> GetPdcIDtoAX:
    55                              <1> ;Force ID_PDC20230 instead of PDC20630 detection
    56                              <1> ;mov	ax, ID_PDC20230<<8
    57                              <1> ;jmp		SHORT DisablePdcProgrammingMode
    58                              <1> 
    59 0000102E 52                  <1> 	push	dx
    60                              <1> 
    61                              <1> 	; Try to enable PDC 20630 extra registers
    62 0000102F 83C204              <1> 	add		dx, BYTE LOW_CYLINDER_REGISTER
    63 00001032 EC                  <1> 	in		al, dx
    64 00001033 0C08                <1> 	or		al, FLG_PDCLCR_ENABLE_EXTRA_REGISTERS
    65 00001035 EE                  <1> 	out		dx, al
    66                              <1> 
    67                              <1> 	; Try to access PDC 20630 registers to see if they are available
    68                              <1> 	; Hopefully this does not cause problems for systems with PDC 20230
    69 00001036 83C204              <1> 	add		dx, BYTE PDC20630_INDEX_REGISTER - LOW_CYLINDER_REGISTER
    70 00001039 B007                <1> 	mov		al, PDCREG7_STATUS	; Try to access PDC 20630 status register
    71 0000103B EE                  <1> 	out		dx, al
    72 0000103C 93                  <1> 	xchg	bx, ax
    73 0000103D EC                  <1> 	in		al, dx				; Does index register contain status register index?
    74 0000103E 38D8                <1> 	cmp		al, bl
    75 00001040 B402                <1> 	mov		ah, ID_PDC20630
    76                              <1> 	eCMOVNE	ah, ID_PDC20230
   348                              <2>  eCMOVNZ %1, %2
   338 00001042 7402                <3>  jz SHORT %%Return
   339 00001044 B401                <3>  mov %1, %2
   340                              <3> %%Return:
    77                              <1> 
    78 00001046 5A                  <1> 	pop		dx
    79                              <1> ;	ret							; Uncomment this to make GetPdcIDtoAX a real function
    80                              <1> 	; Fall to DisablePdcProgrammingMode
    81                              <1> 
    82                              <1> 
    83                              <1> ;--------------------------------------------------------------------
    84                              <1> ; DisablePdcProgrammingMode
    85                              <1> ;	Parameters:
    86                              <1> ;		DX:		Base port
    87                              <1> ;	Returns:
    88                              <1> ;		CF:		Set
    89                              <1> ;	Corrupts registers:
    90                              <1> ;		AL
    91                              <1> ;--------------------------------------------------------------------
    92                              <1> DisablePdcProgrammingMode:
    93 00001047 83C205              <1> 	add		dx, BYTE HIGH_CYLINDER_REGISTER	; 1F5h
    94 0000104A EC                  <1> 	in		al, dx
    95 0000104B 83C2FB              <1> 	add		dx, -HIGH_CYLINDER_REGISTER		; Sets CF for PDC20x30_DetectControllerForIdeBaseInBX
    96                              <1> %if 0
    97                              <1> 	; Disassembly of VG4.BIN shows that bit 7 (programming mode activated)
    98                              <1> 	; is cleared manually after reading from HIGH_CYLINDER_REGISTER
    99                              <1> 	; That does not seem to be necessary.
   100                              <1> 	inc		dx
   101                              <1> 	inc		dx
   102                              <1> 	call	AdvAtaInit_InputWithDelay
   103                              <1> 	and		al, 7Fh
   104                              <1> 	out		dx, al
   105                              <1> 	dec		dx
   106                              <1> 	dec		dx
   107                              <1> 	stc
   108                              <1> %endif
   109                              <1> .Return:
   110 0000104E C3                  <1> 	ret
   111                              <1> 
   112                              <1> 
   113                              <1> ;--------------------------------------------------------------------
   114                              <1> ; EnablePdcProgrammingMode
   115                              <1> ;	Parameters:
   116                              <1> ;		DX:		Base port
   117                              <1> ;	Returns:
   118                              <1> ;		CF:		Cleared
   119                              <1> ;		ZF:		Set if programming mode enabled
   120                              <1> ;	Corrupts registers:
   121                              <1> ;		AL
   122                              <1> ;--------------------------------------------------------------------
   123                              <1> EnablePdcProgrammingMode:
   124                              <1> 	; Set bit 7 to sector count register
   125 0000104F 42                  <1> 	inc		dx
   126 00001050 42                  <1> 	inc		dx
   127 00001051 E813FF              <1> 	call	AdvAtaInit_InputWithDelay	; 1F2h (SECTOR_COUNT_REGISTER)
   128 00001054 0C80                <1> 	or		al, 80h
   129 00001056 EE                  <1> 	out		dx, al
   130                              <1> 
   131                              <1> 	; PDC detection sequence
   132 00001057 83C203              <1> 	add		dx, BYTE HIGH_CYLINDER_REGISTER - SECTOR_COUNT_REGISTER	; 5 - 2
   133 0000105A FA                  <1> 	cli
   134 0000105B E809FF              <1> 	call	AdvAtaInit_InputWithDelay	; 1F5
   135                              <1> 
   136 0000105E 83EA03              <1> 	sub		dx, BYTE HIGH_CYLINDER_REGISTER - SECTOR_COUNT_REGISTER
   137 00001061 E803FF              <1> 	call	AdvAtaInit_InputWithDelay	; 1F2h
   138                              <1> 
   139 00001064 81C20402            <1> 	add		dx, STANDARD_CONTROL_BLOCK_OFFSET + (ALTERNATE_STATUS_REGISTER_in - SECTOR_COUNT_REGISTER)	; 200h+(6-2)
   140 00001068 E8FCFE              <1> 	call	AdvAtaInit_InputWithDelay	; 3F6h
   141                              <1> 
   142 0000106B E8F9FE              <1> 	call	AdvAtaInit_InputWithDelay	; 3F6h
   143                              <1> 
   144 0000106E 81EA0402            <1> 	sub		dx, STANDARD_CONTROL_BLOCK_OFFSET + (ALTERNATE_STATUS_REGISTER_in - SECTOR_COUNT_REGISTER)
   145 00001072 E8F2FE              <1> 	call	AdvAtaInit_InputWithDelay	; 1F2h
   146                              <1> 
   147 00001075 E8EFFE              <1> 	call	AdvAtaInit_InputWithDelay	; 1F2h
   148 00001078 FB                  <1> 	sti
   149                              <1> 
   150                              <1> 	; PDC20230C and PDC20630 clears the bit we set at the beginning
   151 00001079 E8EBFE              <1> 	call	AdvAtaInit_InputWithDelay	; 1F2h
   152 0000107C 4A                  <1> 	dec		dx
   153 0000107D 4A                  <1> 	dec		dx		; Base port
   154 0000107E A880                <1> 	test	al, 80h	; Clears CF
   155 00001080 C3                  <1> 	ret
   156                              <1> 
   157                              <1> 
   158                              <1> ;--------------------------------------------------------------------
   159                              <1> ; PDC20x30_GetMaxPioModeToALandMinPioCycleTimeToBX
   160                              <1> ;	Parameters:
   161                              <1> ;		AX:		ID WORD specific for detected controller
   162                              <1> ;	Returns:
   163                              <1> ;		AL:		Max supported PIO mode (only if ZF set)
   164                              <1> ;		AH:		~FLGH_DPT_IORDY if IORDY not supported, -1 otherwise (only if ZF set)
   165                              <1> ;		BX:		Min PIO cycle time (only if ZF set)
   166                              <1> ;		ZF:		Set if PIO limit necessary
   167                              <1> ;				Cleared if no need to limit timings
   168                              <1> ;	Corrupts registers:
   169                              <1> ;		Nothing
   170                              <1> ;--------------------------------------------------------------------
   171                              <1> PDC20x30_GetMaxPioModeToALandMinPioCycleTimeToBX:
   172 00001081 80FC01              <1> 	cmp		ah, ID_PDC20230
   173 00001084 7506                <1> 	jne		SHORT .Return							; No need to limit anything for ID_PDC20630
   174 00001086 B8027F              <1> 	mov		ax, (~FLGH_DPT_IORDY & 0FFh) << 8 | 2	; Limit PIO to 2 for ID_PDC20230
   175 00001089 BBF000              <1> 	mov		bx, PIO_2_MIN_CYCLE_TIME_NS
   176                              <1> .Return:
   177 0000108C C3                  <1> 	ret
   178                              <1> 
   179                              <1> 
   180                              <1> ;--------------------------------------------------------------------
   181                              <1> ; PDC20x30_InitializeForDPTinDSDI
   182                              <1> ;	Parameters:
   183                              <1> ;		DS:DI:	Ptr to DPT for Single or Slave Drive
   184                              <1> ;	Returns:
   185                              <1> ;		AH:		Int 13h return status
   186                              <1> ;		CF:		Cleared if success or no controller to initialize
   187                              <1> ;				Set if error
   188                              <1> ;	Corrupts registers:
   189                              <1> ;		AL, BX, CX, DX
   190                              <1> ;--------------------------------------------------------------------
   191                              <1> PDC20x30_InitializeForDPTinDSDI:
   192                              <1> %ifdef USE_386
   193 0000108D 30ED                <1> 	xor		ch, ch
   194 0000108F F60510              <1> 	test	BYTE [di+DPT.bFlagsLow], FLGL_DPT_SLAVE
   195 00001092 0F95C1              <1> 	setnz	cl
   196                              <1> %else
   197                              <1> 	xor		cx, cx
   198                              <1> 	test	BYTE [di+DPT.bFlagsLow], FLGL_DPT_SLAVE
   199                              <1> 	jz		SHORT .NotSlave
   200                              <1> 	inc		cx
   201                              <1> .NotSlave:
   202                              <1> %endif
   203                              <1> 
   204 00001095 8B5504              <1> 	mov		dx, [di+DPT.wBasePort]
   205 00001098 E8B4FF              <1> 	call	EnablePdcProgrammingMode
   206 0000109B E81200              <1> 	call	SetSpeedForDriveInCX
   207 0000109E 807D1702            <1> 	cmp		BYTE [di+DPT_ADVANCED_ATA.wControllerID+1], ID_PDC20630
   208 000010A2 7503                <1> 	jne		SHORT .InitializationCompleted
   209 000010A4 E84C00              <1> 	call	SetPdc20630SpeedForDriveInCX
   210                              <1> 
   211                              <1> 	; TODO: Should we first call SetPdc20630SpeedForDriveInCX and then
   212                              <1> 	; force SetSpeedForDriveInCX to PIO 0 (maximum speed setting 8)?
   213                              <1> 	; Need to test with PCD20630.
   214                              <1> 
   215                              <1> .InitializationCompleted:
   216 000010A7 8B5504              <1> 	mov		dx, [di+DPT.wBasePort]
   217 000010AA E89AFF              <1> 	call	DisablePdcProgrammingMode
   218 000010AD 30E4                <1> 	xor		ah, ah
   219 000010AF C3                  <1> 	ret
   220                              <1> 
   221                              <1> 
   222                              <1> ;--------------------------------------------------------------------
   223                              <1> ; SetSpeedForDriveInCX
   224                              <1> ;	Parameters:
   225                              <1> ;		CX:		0 for master, 1 for slave drive
   226                              <1> ;		DX:		IDE Base port
   227                              <1> ;		DS:DI:	Ptr to DPT
   228                              <1> ;	Returns:
   229                              <1> ;		DX:		Sector Number Register (1F3h)
   230                              <1> ;	Corrupts registers:
   231                              <1> ;		AX, BX
   232                              <1> ;--------------------------------------------------------------------
   233                              <1> SetSpeedForDriveInCX:
   234 000010B0 BB[F010]            <1> 	mov		bx, .rgbPioModeToPDCspeedValue
   235 000010B3 8A451C              <1> 	mov		al, [di+DPT_ADVANCED_ATA.bPioMode]
   236                              <1> 	MIN_U	al, 2	; Limit to PIO2
    22 000010B6 3C02                <2>  cmp %1, %2
    23 000010B8 7202                <2>  jb %%Return
    24 000010BA B002                <2>  mov %1, %2
    25                              <2> %%Return:
   237 000010BC 2ED7                <1> 	cs xlat
   238 000010BE 93                  <1> 	xchg	bx, ax
   239                              <1> 
   240 000010BF 83C203              <1> 	add		dx, BYTE SECTOR_NUMBER_REGISTER	; 1F3h
   241 000010C2 B7F8                <1> 	mov		bh, ~MASK_PDCSNR_DEV1SPEED		; Assume slave
   242 000010C4 41                  <1> 	inc		cx
   243 000010C5 B407                <1> 	mov		ah, 7	; Max speed value. Set unknown bit 7 if either of drives are set to this
   244 000010C7 E207                <1> 	loop	.SetSpeed
   245 000010C9 B438                <1> 	mov		ah, 7 << POS_PDCSNR_DEV0SPEED
   246                              <1> 	eSHL_IM	bl, POS_PDCSNR_DEV0SPEED
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668                              <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 000010CB C0E303              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   247 000010CE B7C7                <1> 	mov		bh, ~MASK_PDCSNR_DEV0SPEED
   248                              <1> .SetSpeed:
   249 000010D0 EC                  <1> 	in		al, dx
   250 000010D1 20F8                <1> 	and		al, bh
   251 000010D3 08D8                <1> 	or		al, bl
   252 000010D5 38E3                <1> 	cmp		bl, ah
   253 000010D7 7202                <1> 	jb		SHORT .OutputNewValue
   254 000010D9 0C80                <1> 	or		al, FLG_PDCSNR_UNKNOWN_BIT7		; Flag for PIO 2 and above?
   255                              <1> .OutputNewValue:
   256 000010DB EE                  <1> 	out		dx, al
   257                              <1> 
   258                              <1> 	; The above speed set does not work with Octek VL-COMBO rev 3.2 with PDC20230C
   259                              <1> 	; Only thing to make it work is to set FLG_PDCSCR_BOTHMAX to 1F2h. Are all PDC20230C controllers
   260                              <1> 	; like that? If so, why the above speed is not set? Or does the VL-COMBO or other PDC20230C
   261                              <1> 	; controllers have a jumper to prevent speed setup by software? (PDC20230B can only be set
   262                              <1> 	; by hardware, for example), like pin-compatible operation with older PDC20230B, perhaps?
   263                              <1> 	; Datasheets would be very useful...
   264                              <1> 	; For now, we just set the FLG_PDCSCR_BOTHMAX bit if either of the drives are set to speed 7
   265                              <1> 	;
   266                              <1> 	; Code below is not perfect. It does not properly test if both drives support PIO 2 but
   267                              <1> 	; likely if slave does, so does master (and if slave does not, we clear the
   268                              <1> 	; FLG_PDCSCR_BOTHMAX set by master)
   269 000010DC B301                <1> 	mov		bl, 1	; Set bit 0, see VG4.BIN comments below
   270 000010DE 84C0                <1> 	test	al, al
   271 000010E0 7903                <1> 	jns		SHORT .DoNotSetMaxSpeedBit
   272 000010E2 80CB40              <1> 	or		bl, FLG_PDCSCR_BOTHMAX
   273                              <1> .DoNotSetMaxSpeedBit:
   274 000010E5 4A                  <1> 	dec		dx		; SECTOR_COUNT_REGISTER, 1F2h
   275 000010E6 E87EFE              <1> 	call	AdvAtaInit_InputWithDelay
   276 000010E9 24BF                <1> 	and		al, ~FLG_PDCSCR_BOTHMAX
   277 000010EB 08D8                <1> 	or		al, bl
   278 000010ED EE                  <1> 	out		dx, al
   279                              <1> 
   280                              <1> 	; VG4.BIN ("External BIOS") does the following after programming speed (1F3h)
   281                              <1> 	; (It never seems to set the speed bit we just set above).
   282                              <1> 	; The below code does not seem to have any effect, at least not for PDC20230C.
   283                              <1> 	; Why is bit 0 set to 1F2h?
   284                              <1> 	; Is it just to keep programming mode active if it has timeout, for example?
   285                              <1> 	; But after all that it just reads 1F5h to disable programming mode.
   286                              <1> %if 0
   287                              <1> 	; Test code start
   288                              <1> 	push	cx
   289                              <1> 	mov		cx, 100
   290                              <1> 	DELAY_WITH_LOOP_INSTRUCTION_NA
   291                              <1> 
   292                              <1> 	; Does below tell the controller that new speed is set?
   293                              <1> 	in		al, dx
   294                              <1> 	or		al, 1
   295                              <1> 	out		dx, al
   296                              <1> 
