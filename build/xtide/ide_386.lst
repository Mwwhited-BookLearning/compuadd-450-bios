   124                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_SET_8BIT_MODE
    37 00001A65 B080                <2>  mov al, %1
    38 00001A67 E8B200              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   125                              <1> %endif ; MODULE_8BIT_IDE
   126                              <1> 
   127                              <1> 
   128                              <1> ;;;	InitializeDeviceParameters
   129                              <1> 	; Initialize Logical Sectors per Track and Max Head number
   130 00001A6A 8B450A              <1> 	mov		ax, [di+DPT.wPchsHeadsAndSectors]
   131 00001A6D 48                  <1> 	dec		ax							; Max Head number
   132 00001A6E 86C4                <1> 	xchg	ah, al
   133 00001A70 88C2                <1> 	mov		dl, al						; Sectors per track
   134 00001A72 B091                <1> 	mov		al, COMMAND_INITIALIZE_DEVICE_PARAMETERS
   135 00001A74 BB80B5              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_BSY, FLG_STATUS_BSY)
   136 00001A77 E8CEF3              <1> 	call	Idepack_StoreNonExtParametersAndIssueCommandFromAL
   137                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_INITIALIZE_CHS_PARAMETERS
    37 00001A7A B002                <2>  mov al, %1
    38 00001A7C E89D00              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   138                              <1> 
   139                              <1> 
   140                              <1> ;;;	SetWriteCache
   141                              <1> 	; Enable or Disable Write Cache
   142 00001A7F E888EC              <1> 	call	AccessDPT_GetPointerToDRVPARAMStoCSBX
   143 00001A82 2E8A1F              <1> 	mov		bl, [cs:bx+DRVPARAMS.wFlags]
   144 00001A85 53                  <1> 	push	bx	; Save .wFlags for later use in InitializeBlockMode
   145 00001A86 83E303              <1> 	and		bx, BYTE MASK_DRVPARAMS_WRITECACHE
   146 00001A89 740D                <1> 	jz		SHORT .SkipSetWriteCache		; DEFAULT_WRITE_CACHE
   147 00001A8B 2E8BB7[111B]        <1> 	mov		si, [cs:bx+.rgbWriteCacheCommands]
   148 00001A90 E8E500              <1> 	call	AH23h_SetControllerFeatures
   149                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_SET_WRITE_CACHE
    37 00001A93 B004                <2>  mov al, %1
    38 00001A95 E88400              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   150                              <1> .SkipSetWriteCache:
   151                              <1> 
   152                              <1> 
   153                              <1> ;;;	RecalibrateDrive
   154                              <1> 	; Recalibrate drive by seeking to cylinder 0
   155 00001A98 E8A200              <1> 	call	AH11h_RecalibrateDrive
   156                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_RECALIBRATE_DRIVE
    37 00001A9B B008                <2>  mov al, %1
    38 00001A9D E87C00              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   157                              <1> 
   158                              <1> 
   159                              <1> ;;;	InitializeBlockMode
   160                              <1> 	; Initialize block mode transfers
   161 00001AA0 58                  <1> 	pop		ax	; Restore .wFlags saved in SetWriteCache
   162 00001AA1 A810                <1> 	test	al, FLG_DRVPARAMS_BLOCKMODE	; Tested here so block mode can be enabled with AH=24h
   163 00001AA3 7412                <1> 	jz		SHORT .BlockModeDisabled
   164                              <1> 
   165                              <1> 	; Try block sizes until we find largest possible supported by drive
   166 00001AA5 B380                <1> 	mov		bl, 128
   167                              <1> .TryNextBlockSize:
   168 00001AA7 88D8                <1> 	mov		al, bl
   169 00001AA9 E8EA00              <1> 	call	AH24h_SetBlockSize	; Stores block size to DPT
   170 00001AAC 7309                <1> 	jnc		SHORT .SupportedBlockSizeFound
   171 00001AAE D0EB                <1> 	shr		bl, 1
   172 00001AB0 73F5                <1> 	jnc		SHORT .TryNextBlockSize
   173                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_SET_BLOCK_MODE
    37 00001AB2 B010                <2>  mov al, %1
    38 00001AB4 E86500              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   174                              <1> .BlockModeDisabled:
   175                              <1> .SupportedBlockSizeFound:
   176                              <1> 
   177                              <1> 
   178                              <1> %ifdef MODULE_ADVANCED_ATA
   179                              <1> ;;;	InitializePioMode
   180                              <1> 	; Initialize fastest supported PIO mode
   181 00001AB7 B201                <1> 	mov		dl, PIO_DEFAULT_MODE_DISABLE_IORDY
   182 00001AB9 F6450180            <1> 	test	BYTE [di+DPT.bFlagsHigh], FLGH_DPT_IORDY
   183 00001ABD 7405                <1> 	jz		SHORT .IordyNotSupported
   184                              <1> 
   185                              <1> 	; Advanced PIO mode 3 and above
   186 00001ABF B208                <1> 	mov		dl, PIO_FLOW_CONTROL_MODE_xxx
   187 00001AC1 0A551C              <1> 	or		dl, [di+DPT_ADVANCED_ATA.bPioMode]
   188                              <1> 
   189                              <1> .IordyNotSupported:
   190 00001AC4 BE0300              <1> 	mov		si, FEATURE_SET_TRANSFER_MODE
   191 00001AC7 E8AE00              <1> 	call	AH23h_SetControllerFeatures
   192                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_SET_PIO_MODE
    37 00001ACA B020                <2>  mov al, %1
    38 00001ACC E84D00              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   193                              <1> %endif ; MODULE_ADVANCED_ATA
   194                              <1> 
   195                              <1> 
   196                              <1> %ifdef MODULE_POWER_MANAGEMENT
   197                              <1> ;;;	InitStandbyTimer
   198                              <1> 	; Initialize the standby timer (if supported)
   199 00001ACF 8A7501              <1> 	mov		dh, [di+DPT.bFlagsHigh]
   200 00001AD2 F6C608              <1> 	test	dh, FLGH_DPT_POWER_MANAGEMENT_SUPPORTED
   201 00001AD5 742B                <1> 	jz		SHORT .NoPowerManagementSupport
   202                              <1> 
   203                              <1> 	; Do we need to disable APM?
   204 00001AD7 2E8A164C00          <1> 	mov		dl, [cs:ROMVARS.bIdleTimeout]
   205 00001ADC 52                  <1> 	push	dx
   206 00001ADD F6C610              <1> 	test	dh, FLGH_DPT_APM_SUPPORTED
   207 00001AE0 7403                <1> 	jz		SHORT .NoAdvancedPowerManagementSupport
   208 00001AE2 E8A000              <1> 	call	AH23h_EnableOrDisableAdvancedPowerManagement
   209                              <1> .NoAdvancedPowerManagementSupport:
   210                              <1> 
   211                              <1> 	; COMMAND_IDLE is not enough for Toshiba 1,8" HDD since idle mode is the default mode
   212                              <1> 	; COMMAND_STAND_BY seemed to do the trick
   213 00001AE5 5A                  <1> 	pop		dx
   214 00001AE6 52                  <1> 	push	dx
   215 00001AE7 B0E2                <1> 	mov		al, COMMAND_STAND_BY
   216 00001AE9 BB80B5              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_BSY, FLG_STATUS_BSY)
   217 00001AEC E859F3              <1> 	call	Idepack_StoreNonExtParametersAndIssueCommandFromAL
   218                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_INITIALIZE_STANDBY_TIMER
    37 00001AEF B040                <2>  mov al, %1
    38 00001AF1 E82800              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   219                              <1> 
   220 00001AF4 5A                  <1> 	pop		dx
   221 00001AF5 B0E3                <1> 	mov		al, COMMAND_IDLE
   222 00001AF7 BB80B5              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_BSY, FLG_STATUS_BSY)
   223 00001AFA E84BF3              <1> 	call	Idepack_StoreNonExtParametersAndIssueCommandFromAL
   224                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_INITIALIZE_STANDBY_TIMER
    37 00001AFD B040                <2>  mov al, %1
    38 00001AFF E81A00              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   225                              <1> .NoPowerManagementSupport:
   226                              <1> %endif ; MODULE_POWER_MANAGEMENT
