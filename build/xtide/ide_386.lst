    24                              <1> ; SerialDPT_Finalize
    25                              <1> ;	Parameters:
    26                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    27                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    28                              <1> ;	Returns:
