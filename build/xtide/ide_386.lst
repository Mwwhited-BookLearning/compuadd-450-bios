   242                              <2> ; Keyboard_PrintInputtedCharacter
   243                              <2> ;	Parameters:
   244                              <2> ;		AL:		Character inputted by user
   245                              <2> ;	Returns:
   246                              <2> ;		Nothing
   247                              <2> ;	Corrupts registers:
   248                              <2> ;		AX
   249                              <2> ;--------------------------------------------------------------------
   250                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   251                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   252                              <2> Keyboard_PrintInputtedCharacter:
   253                              <2> 	push	di
   254                              <2> 	CALL_DISPLAY_LIBRARY PrintCharacterFromAL
   255                              <2> 	CALL_DISPLAY_LIBRARY SynchronizeDisplayContextToHardware	; Hardware cursor
   256                              <2> 	pop		di
   257                              <2> 	ret
   258                              <2> %endif
