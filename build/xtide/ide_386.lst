    24                              <2> ; DisplayCursor_GetDefaultCursorShapeToAX
    25                              <2> ;	Parameters:
    26                              <2> ;		DS:		BDA segment (zero)
    27                              <2> ;	Returns:
    28                              <2> ;		AX:		Default text mode cursor shape
    29                              <2> ;	Corrupts registers:
    30                              <2> ;		Nothing
    31                              <2> ;--------------------------------------------------------------------
    32                              <2> ALIGN DISPLAY_JUMP_ALIGN
    33                              <2> DisplayCursor_GetDefaultCursorShapeToAX:
    34 000001E4 B80706              <2> 	mov		ax, CURSOR_NORMAL_COLOR				; CGA, EGA, VGA cursor
    35 000001E7 803E490407          <2> 	cmp		BYTE [VIDEO_BDA.bMode], MDA_TEXT_MODE
    36                              <2> 	eCMOVE	ax, CURSOR_NORMAL_MDA				; MDA cursor
   344                              <3>  eCMOVZ %1, %2
   332 000001EC 7503                <4>  jnz SHORT %%Return
   333 000001EE B80C0B              <4>  mov %1, %2
   334                              <4> %%Return:
    37 000001F1 C3                  <2> 	ret
