    23                              <2> ;--------------------------------------------------------------------
    24                              <2> ; Reboot_ComputerWithBootFlagInAX
    25                              <2> ;	Parameters:
    26                              <2> ; 		AX:		Boot Flag
    27                              <2> ;	Returns:
    28                              <2> ;		Nothing, function never returns
    29                              <2> ;--------------------------------------------------------------------
    30                              <2> Reboot_ComputerWithBootFlagInAX:
    31                              <2> 	LOAD_BDA_SEGMENT_TO	ds, bx
   180                              <3> %ifndef USE_186
   181                              <3>  xor %2, %2
   182                              <3>  mov %1, %2
   183                              <3> %elifidn %3, !
   184                              <3>  xor %2, %2
   185                              <3>  mov %1, %2
   186                              <3> %else
   187 00000363 6A00                <3>  push BYTE 0
   188 00000365 1F                  <3>  pop %1
   189                              <3> %endif
    32 00000366 A37204              <2> 	mov		[BDA.wBoot], ax			; Store boot flag
    33                              <2> 	; Fall to Reboot_AT
    34                              <2> 
    35                              <2> 
    36                              <2> ;--------------------------------------------------------------------
    37                              <2> ; Reboot_AT
    38                              <2> ;	Parameters:
    39                              <2> ; 		Nothing
    40                              <2> ;	Returns:
    41                              <2> ;		Nothing, function never returns
    42                              <2> ;--------------------------------------------------------------------
    43                              <2> Reboot_AT:
    44 00000369 B0FE                <2> 	mov		al, 0FEh				; System reset (AT+ keyboard controller)
    45 0000036B E664                <2> 	out		64h, al					; Reset computer (AT+)
    46                              <2> %ifndef EXCLUDE_FROM_XUB
    47                              <2> 	%ifdef INCLUDE_TIME_LIBRARY
    48                              <2> 		mov		ax, 10
    49                              <2> 		call	Delay_MicrosecondsFromAX
    50                              <2> 	%else
    51                              <2> 		JMP_DELAY
    52                              <2> 	%endif
    53                              <2> %else
    54                              <2> 	JMP_DELAY
    19 0000036D EB00                <3>  jmp SHORT %%NextInstruction
    20                              <3> %%NextInstruction:
    55                              <2> %endif
    56                              <2> 	; Fall to Reboot_XT
    57                              <2> 
    58                              <2> 
    59                              <2> ;--------------------------------------------------------------------
    60                              <2> ; Reboot_XT
    61                              <2> ;	Parameters:
    62                              <2> ; 		Nothing
    63                              <2> ;	Returns:
    64                              <2> ;		Nothing, function never returns
    65                              <2> ;--------------------------------------------------------------------
    66                              <2> Reboot_XT:
    67 0000036F 31C0                <2> 	xor		ax, ax
    68 00000371 50                  <2> 	push	ax
    69 00000372 9D                  <2> 	popf							; Clear FLAGS (disables interrupt)
    70 00000373 8ED8                <2> 	mov		ds, ax
    71 00000375 8EC0                <2> 	mov		es, ax
    72 00000377 8ED0                <2> 	mov		ss, ax
    73 00000379 EA0000FFFF          <2> 	jmp		0FFFFh:0				; XT reset
   131                              <1> 		%include "Memory.asm"
