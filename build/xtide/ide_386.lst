    14                              <1> ; but WITHOUT ANY WARRANTY; without even the implied warranty of
    15                              <1> ; MERCHANTABILITY or FITNESS FOR A PARTICULAR PURPOSE.  See the
    16                              <1> ; GNU General Public License for more details.
    17                              <1> ; Visit http://www.gnu.org/licenses/old-licenses/gpl-2.0.html
    18                              <1> ;
    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=41h, Check if Extensions Present.
    25                              <1> ;
    26                              <1> ; AH41h_HandlerForCheckIfExtensionsPresent
    27                              <1> ;	Parameters:
    28                              <1> ;		DL:		Translated Drive number
    29                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    30                              <1> ;		SS:BP:	Ptr to IDEPACK
    31                              <1> ;	Parameters on INTPACK:
    32                              <1> ;		BX:		55AAh
    33                              <1> ;	Returns with INTPACK:
    34                              <1> ;		AH:		Major version of EBIOS extensions
    35                              <1> ;		BX:		AA55h
    36                              <1> ;		CX:		Support bits
    37                              <1> ;		CF:		0 if successful, 1 if error
    38                              <1> ;--------------------------------------------------------------------
    39                              <1> AH41h_HandlerForCheckIfExtensionsPresent:
    40 00001D64 817E18AA55          <1> 	cmp		WORD [bp+IDEPACK.intpack+INTPACK.bx], 55AAh
    41                              <1> %ifdef USE_386
    42 00001D69 0F85B3FA            <1> 	jne		Int13h_DirectCallToAnotherBios
    43                              <1> %else
    44                              <1> 	jne		SHORT .EbiosNotSupported
    45                              <1> %endif
    46                              <1> 
    47 00001D6D C6461F21            <1> 	mov		BYTE [bp+IDEPACK.intpack+INTPACK.ah], EBIOS_VERSION
    48 00001D71 F75618              <1> 	not		WORD [bp+IDEPACK.intpack+INTPACK.bx]	; 55AAh = AA55h
    49                              <1> 
    50                              <1> %ifdef MODULE_COMPATIBLE_TABLES
    51 00001D74 E80A00              <1> 	call	AH41h_GetSupportBitsToCX
    52 00001D77 894E1C              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.cx], cx
    53                              <1> %else
    54                              <1> 	mov		WORD [bp+IDEPACK.intpack+INTPACK.cx], ENHANCED_DRIVE_ACCESS_SUPPORT
    55                              <1> %endif ; MODULE_COMPATIBLE_TABLES
    56                              <1> 
    57 00001D7A 806624FE            <1> 	and		BYTE [bp+IDEPACK.intpack+INTPACK.flags], ~FLG_FLAGS_CF	; Return with CF cleared
    58 00001D7E E905FB              <1> 	jmp		Int13h_ReturnFromHandlerWithoutStoringErrorCode
    59                              <1> 
    60                              <1> %ifndef USE_386
    61                              <1> .EbiosNotSupported:
    62                              <1> 	jmp		Int13h_DirectCallToAnotherBios
    63                              <1> %endif
    64                              <1> 
    65                              <1> 
    66                              <1> %ifdef MODULE_COMPATIBLE_TABLES
    67                              <1> ;--------------------------------------------------------------------
    68                              <1> ; AH41h_GetSupportBitsToCX
    69                              <1> ;	Parameters:
    70                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    71                              <1> ;	Returns:
    72                              <1> ;		CX:		Support bits returned by AH=41h
    73                              <1> ;	Corrupts registers:
    74                              <1> ;		Nothing
    75                              <1> ;--------------------------------------------------------------------
    76                              <1> AH41h_GetSupportBitsToCX:
    77                              <1> %ifdef USE_AT	; Always in Full mode
    78                              <1> %ifndef MODULE_8BIT_IDE OR MODULE_SERIAL
    79                              <1> 	mov		cx, ENHANCED_DRIVE_ACCESS_SUPPORT | ENHANCED_DISK_DRIVE_SUPPORT
    80                              <1> %else
    81 00001D81 B90100              <1> 	mov		cx, ENHANCED_DRIVE_ACCESS_SUPPORT
    82 00001D84 807D1404            <1> 	cmp		BYTE [di+DPT_ATA.bDevice], DEVICE_8BIT_ATA
    83 00001D88 7303                <1> 	jae		SHORT .DoNotSetEDDflag
    84 00001D8A 80C904              <1> 	or		cl, ENHANCED_DISK_DRIVE_SUPPORT
    85                              <1> %endif
    86                              <1> %else ; ~USE_AT
    87                              <1> 	mov		cx, ENHANCED_DRIVE_ACCESS_SUPPORT
    88                              <1> 
    89                              <1> 	; DPTE needs buffer from RAM so do not return it in lite mode
    90                              <1> 	test	BYTE [cs:ROMVARS.wFlags], FLG_ROMVARS_FULLMODE
    91                              <1> 	jz		SHORT .DoNotSetEDDflag
    92                              <1> 
    93                              <1> %ifdef MODULE_8BIT_IDE OR MODULE_SERIAL
    94                              <1> 	; DPTE contains information for device drivers. We should not return
    95                              <1> 	; DPTE for 8-bit devices since software would think they are 16-bit devices.
    96                              <1> 	cmp		BYTE [di+DPT_ATA.bDevice], DEVICE_8BIT_ATA
    97                              <1> 	jae		SHORT .DoNotSetEDDflag
    98                              <1> %endif
    99                              <1> 
   100                              <1> 	or		cl, ENHANCED_DISK_DRIVE_SUPPORT	; AH=48h returns DPTE
   101                              <1> %endif ; USE_AT
   102                              <1> .DoNotSetEDDflag:
   103 00001D8D C3                  <1> 	ret
   104                              <1> 
   105                              <1> %endif ; MODULE_COMPATIBLE_TABLES
   347                                  %endif
   348                                  
   349                                  	BIOS_SIZE		EQU		(($-$$) + 2047) & ~2047	; Align the size to a 2 kB boundary (required for compatibility reasons)
   350                                  	CNT_ROM_BLOCKS	EQU		BIOS_SIZE >> 9			; BIOS_SIZE / 512
   351                                  %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   352                                  ; Although it's very unlikely to happen, we give warnings for builds that cannot be automatically checksummed due to the size being too large.
   353                                  ; In some cases it's theoretically possible to checksum the build anyway (manually) which is why these are warnings and not errors.
   354                                  %if BIOS_SIZE = 8192				; A small build, possibly a candidate for the ROM socket on a 3Com 3C503 card.
   355                                  	%if ($-$$) > BIOS_SIZE - 3
   356                                  		%warning "This build is too large to be auto-checksummed!"
   357                                  	%endif
   358                                  %elif ($-$$) = BIOS_SIZE			; A large or tiny build.
   359                                  	%warning "This build is too large to be auto-checksummed!"
   360                                  %endif
   361                                  %endif
