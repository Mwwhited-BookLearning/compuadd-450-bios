    51                              <2> ; Registers_CopySSBPtoESDI
    52                              <2> ; Registers_CopySSBPtoDSSI
    53                              <2> ; Registers_CopyDSSItoESDI
    54                              <2> ; Registers_CopyESDItoDSSI
    55                              <2> ;	Parameters
    56                              <2> ;		Nothing
    57                              <2> ;	Returns:
    58                              <2> ;		Copies far pointer to different segment/pointer register pair
    59                              <2> ;	Corrupts registers:
    60                              <2> ;		Nothing
    61                              <2> ;--------------------------------------------------------------------
    62                              <2> %ifdef INCLUDE_MENU_LIBRARY
    63                              <2> ALIGN JUMP_ALIGN
    64                              <2> Registers_CopySSBPtoESDI:
    65                              <2> 	COPY_SSBP_TO_ESDI
    66                              <2> 	ret
    67                              <2> %endif
    68                              <2> 
    69                              <2> %ifndef EXCLUDE_FROM_XUB
    70                              <2> ALIGN JUMP_ALIGN
    71                              <2> Registers_CopySSBPtoDSSI:
    72                              <2> 	COPY_SSBP_TO_DSSI
    73                              <2> 	ret
    74                              <2> 
    75                              <2> ALIGN JUMP_ALIGN
    76                              <2> Registers_CopyDSSItoESDI:
    77                              <2> 	COPY_DSSI_TO_ESDI
    78                              <2> 	ret
    79                              <2> 
    80                              <2> ALIGN JUMP_ALIGN
    81                              <2> Registers_CopyESDItoDSSI:
