    29                              <1> %ifdef MODULE_EBIOS
    30                              <1> ;--------------------------------------------------------------------
    31                              <1> ; AtaGeometry_GetLbaSectorCountToBXDXAXfromAtaInfoInESSI
    32                              <1> ;	Parameters:
    33                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    34                              <1> ;	Returns:
    35                              <1> ;		BX:DX:AX:	48-bit sector count
    36                              <1> ;		CL:			FLGL_DPT_LBA48 if LBA48 supported
    37                              <1> ;					Zero if only LBA28 is supported
    38                              <1> ;	Corrupts registers:
    39                              <1> ;		Nothing
    40                              <1> ;--------------------------------------------------------------------
    41                              <1> AtaGeometry_GetLbaSectorCountToBXDXAXfromAtaInfoInESSI:
    42 0000071E BB[5C03]            <1> 	mov		bx, Registers_ExchangeDSSIwithESDI
    43 00000721 FFD3                <1> 	call	bx	; ATA info now in DS:DI
    44 00000723 53                  <1> 	push	bx	; We will return via Registers_ExchangeDSSIwithESDI
    45                              <1> 
    46                              <1> 	; Check if LBA48 supported
    47 00000724 F685A70004          <1> 	test	BYTE [di+ATA6.wSetSup83+1], A6_wSetSup83_LBA48>>8
    48 00000729 740F                <1> 	jz		SHORT .GetLba28SectorCount
    49                              <1> 
    50                              <1> 	; Get LBA48 sector count
    51 0000072B B180                <1> 	mov		cl, FLGL_DPT_LBA48
    52 0000072D 8B85C800            <1> 	mov		ax, [di+ATA6.qwLBACnt]
    53 00000731 8B95CA00            <1> 	mov		dx, [di+ATA6.qwLBACnt+2]
    54 00000735 8B9DCC00            <1> 	mov		bx, [di+ATA6.qwLBACnt+4]
    55 00000739 C3                  <1> 	ret
    56                              <1> 
    57                              <1> .GetLba28SectorCount:
    58 0000073A 30C9                <1> 	xor		cl, cl
    59 0000073C 31DB                <1> 	xor		bx, bx
    60 0000073E 8B4578              <1> 	mov		ax, [di+ATA1.dwLBACnt]
    61 00000741 8B557A              <1> 	mov		dx, [di+ATA1.dwLBACnt+2]
    62 00000744 C3                  <1> 	ret
    63                              <1> %endif	; MODULE_EBIOS
    64                              <1> 
    65                              <1> 
    66                              <1> ;--------------------------------------------------------------------
    67                              <1> ; AtaGeometry_GetLCHStoAXBLBHfromAtaInfoInESSIwithTranslateModeInDX
    68                              <1> ;	Parameters:
    69                              <1> ;		DX:		Wanted translate mode or TRANSLATEMODE_AUTO to autodetect
    70                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    71                              <1> ;	Returns:
    72                              <1> ;		AX:		Number of L-CHS cylinders (1...1027, yes 1027)
    73                              <1> ;		BL:		Number of L-CHS heads (1...255)
    74                              <1> ;		BH:		Number of L-CHS sectors per track (1...63)
    75                              <1> ;		CX:		Number of bits shifted (0...3)
    76                              <1> ;		DX:		CHS Translate Mode
    77                              <1> ;	Corrupts registers:
    78                              <1> ;		Nothing
    79                              <1> ;--------------------------------------------------------------------
    80                              <1> AtaGeometry_GetLCHStoAXBLBHfromAtaInfoInESSIwithTranslateModeInDX:
    81 00000745 E84C00              <1> 	call	AtaGeometry_GetPCHStoAXBLBHfromAtaInfoInESSI
    82                              <1> 
    83                              <1> 	; Check if user defined translate mode
    84 00000748 4A                  <1> 	dec		dx						; Set ZF if TRANSLATEMODE_LARGE, SF if TRANSLATEMODE_NORMAL
    85 00000749 7904                <1> 	jns		SHORT .CheckIfLargeTranslationWanted
    86 0000074B E87B00              <1> 	call	AtaGeometry_LimitAXtoMaximumLCylinders	; TRANSLATEMODE_NORMAL maximum cylinders
    87 0000074E 42                  <1> 	inc		dx
    88                              <1> .CheckIfLargeTranslationWanted:
    89 0000074F 7450                <1> 	jz		SHORT ConvertPCHfromAXBLtoRevisedEnhancedCHinAXBL
    90 00000751 4A                  <1> 	dec		dx						; Set ZF if TRANSLATEMODE_ASSISTED_LBA
    91 00000752 740C                <1> 	jz		SHORT .UseAssistedLBA
    92                              <1> 	; TRANSLATEMODE_AUTO set
    93                              <1> 
    94                              <1> %ifndef MODULE_EBIOS
    95                              <1> 	; Since we do not have EBIOS functions, we might as well use the faster
    96                              <1> 	; LARGE mode for small drives. Assisted LBA provides more capacity for
    97                              <1> 	; larger drives.
    98                              <1> 	; Generate L-CHS using simple bit shift algorithm (ECHS) if
    99                              <1> 	; 8192 or less cylinders.
   100                              <1> 	cmp		ax, 8192
   101                              <1> 	jbe		SHORT ConvertPCHfromAXBLtoEnhancedCHinAXBL
   102                              <1> %else
   103                              <1> 	; Check if the drive is within the limits of NORMAL addressing.
   104                              <1> 	; If it is, then no CHS translation is necessary.
   105 00000754 3D0004              <1> 	cmp		ax, MAX_LCHS_CYLINDERS
   106 00000757 7656                <1> 	jbe		SHORT ConvertPCHfromAXBLtoEnhancedCHinAXBL
   107                              <1> %endif
   108                              <1> 
   109                              <1> 	; If we have EBIOS functions, we should always use Assisted LBA
   110                              <1> 	; for drives with LBA support. Otherwise the EBIOS functions are
   111                              <1> 	; useless since we never do LBA to P-CHS translation.
   112                              <1> 	; Even if we do not have EBIOS functions, we must do this check
   113                              <1> 	; since user might have forced LBA mode even though the drive does
   114                              <1> 	; not support LBA addressing.
   115 00000759 26F6446302          <1> 	test	BYTE [es:si+ATA1.wCaps+1], A1_wCaps_LBA>>8
   116 0000075E 7441                <1> 	jz		SHORT ConvertPCHfromAXBLtoRevisedEnhancedCHinAXBL
   117                              <1> 
   118                              <1> 	; Assisted LBA provides most capacity but translation algorithm is
   119                              <1> 	; slower. The speed difference doesn't matter on AT systems.
   120                              <1> .UseAssistedLBA:
   121                              <1> 	; Fall to GetSectorCountToDXAXfromCHSinAXBLBH
   122                              <1> 
   123                              <1> 
   124                              <1> ;--------------------------------------------------------------------
   125                              <1> ; GetSectorCountToDXAXfromCHSinAXBLBH
   126                              <1> ;	Parameters:
   127                              <1> ;		AX:		Number of cylinders (1...16383)
   128                              <1> ;		BL:		Number of heads (1...255)
   129                              <1> ;		BH:		Number of sectors per track (1...63)
   130                              <1> ;	Returns:
   131                              <1> ;		DX:AX:	Total number of CHS addressable sectors
   132                              <1> ;	Corrupts registers:
   133                              <1> ;		BX
   134                              <1> ;--------------------------------------------------------------------
   135                              <1> GetSectorCountToDXAXfromCHSinAXBLBH:
   136 00000760 93                  <1> 	xchg	ax, bx
   137 00000761 F6E4                <1> 	mul		ah			; AX = Heads * Sectors per track
   138 00000763 F7E3                <1> 	mul		bx
   139                              <1> 	; Fall to ConvertChsSectorCountFromDXAXtoLbaAssistedLCHSinAXBLBH
   140                              <1> 
   141                              <1> 
   142                              <1> ;--------------------------------------------------------------------
   143                              <1> ; LBA assist calculation (or Assisted LBA)
   144                              <1> ;
   145                              <1> ; This algorithm translates P-CHS sector count up to largest possible
   146                              <1> ; L-CHS sector count (1024, 255, 63). Note that INT 13h interface allows
   147                              <1> ; 256 heads but DOS supports up to 255 head. That is why BIOSes never
   148                              <1> ; use 256 heads.
   149                              <1> ;
   150                              <1> ; L-CHS parameters generated here require the drive to use LBA addressing.
   151                              <1> ;
   152                              <1> ; Here is the algorithm:
   153                              <1> ; If cylinders > 8192
   154                              <1> ;  Variable CH = Total CHS Sectors / 63
   155                              <1> ;  Divide (CH - 1) by 1024 and add 1
   156                              <1> ;  Round the result up to the nearest of 16, 32, 64, 128 and 255. This is the value to be used for the number of heads.
   157                              <1> ;  Divide CH by the number of heads. This is the value to be used for the number of cylinders.
   158                              <1> ;
   159                              <1> ; ConvertChsSectorCountFromDXAXtoLbaAssistedLCHSinAXBLBH:
   160                              <1> ;	Parameters:
   161                              <1> ;		DX:AX:	Total number of P-CHS sectors for CHS addressing
   162                              <1> ;				(max = 16383 * 16 * 63 = 16,514,064)
   163                              <1> ;	Returns:
   164                              <1> ;		AX:		Number of cylinders (?...1027)
   165                              <1> ;		BL:		Number of heads (16, 32, 64, 128 or 255)
   166                              <1> ;		BH:		Number of sectors per track (always 63)
   167                              <1> ;		CX:		Number of bits shifted (0)
   168                              <1> ;		DX:		TRANSLATEMODE_ASSISTED_LBA
   169                              <1> ;	Corrupts registers:
   170                              <1> ;		Nothing
   171                              <1> ;--------------------------------------------------------------------
   172                              <1> ConvertChsSectorCountFromDXAXtoLbaAssistedLCHSinAXBLBH:
   173                              <1> 	; Value CH = Total sector count / 63
   174                              <1> 	; Max = 16,514,064 / 63 = 262128
   175 00000765 B93F00              <1> 	mov		cx, LBA_ASSIST_SPT			; CX = 63
   176                              <1> 
   177                              <1> 	; --- Math_DivDXAXbyCX inlined (and slightly modified) since it's only used here
   178 00000768 31DB                <1> 	xor		bx, bx
   179 0000076A 93                  <1> 	xchg	bx, ax
   180 0000076B 92                  <1> 	xchg	dx, ax
   181 0000076C F7F1                <1> 	div		cx
   182 0000076E 93                  <1> 	xchg	ax, bx
   183 0000076F F7F1                <1> 	div		cx
   184 00000771 89DA                <1> 	mov		dx, bx
   185                              <1> 	; ---
   186                              <1> 
   187 00000773 50                  <1> 	push	ax
   188 00000774 52                  <1> 	push	dx							; Value CH stored for later use
   189                              <1> 
   190                              <1> 	; BX:DX:AX = Value CH - 1
   191                              <1> 	; Max = 262128 - 1 = 262127
   192 00000775 31DB                <1> 	xor		bx, bx
   193 00000777 83E801              <1> 	sub		ax, BYTE 1
   194 0000077A 19DA                <1> 	sbb		dx, bx
   195                              <1> 
   196                              <1> 	; AX = Number of heads = ((Value CH - 1) / 1024) + 1
   197                              <1> 	; Max = (262127 / 1024) + 1 = 256
   198 0000077C E80CFC              <1> 	call	Size_DivideSizeInBXDXAXby1024	; Preserves CX and returns with BH cleared
   199 0000077F 5A                  <1> 	pop		dx
   200 00000780 40                  <1> 	inc		ax							; + 1
   201                              <1> 
   202                              <1> 	; Heads must be 16, 32, 64, 128 or 255 (round up to the nearest)
   203                              <1> 	; Max = 255
   204 00000781 B310                <1> 	mov		bl, 16						; Min number of heads
   205                              <1> .CompareNextValidNumberOfHeads:
   206 00000783 39D8                <1> 	cmp		ax, bx
   207 00000785 7605                <1> 	jbe		SHORT .NumberOfHeadsNowInBX
   208                              <1> 	eSHL_IM	bx, 1						; Double number of heads
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 00000787 01DB                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   209 00000789 7BF8                <1> 	jpo		SHORT .CompareNextValidNumberOfHeads	; Reached 256 heads?
   210 0000078B 4B                  <1> 	dec		bx							;  If so, limit heads to 255
   211                              <1> .NumberOfHeadsNowInBX:
   212                              <1> 
   213                              <1> 	; DX:AX = Number of cylinders = Value CH (without - 1) / number of heads
   214                              <1> 	; Max = 262128 / 255 = 1027
   215 0000078C 58                  <1> 	pop		ax							; Value CH back to DX:AX
   216 0000078D F7F3                <1> 	div		bx
   217                              <1> 
   218 0000078F 86CF                <1> 	xchg	bh, cl						; Sectors per Track to BH, zero to CL (CX)
   219 00000791 B202                <1> 	mov		dl, TRANSLATEMODE_ASSISTED_LBA
   220                              <1> 	; All combinations of value CH from 1 to 262128 divided by number of heads
   221                              <1> 	; (16/32/64/128/255) has been verified to return with DH cleared.
   222                              <1> ReturnLCHSinAXBLBH:
   223 00000793 C3                  <1> 	ret
   224                              <1> 
   225                              <1> 
   226                              <1> ;--------------------------------------------------------------------
   227                              <1> ; AtaGeometry_GetPCHStoAXBLBHfromAtaInfoInESSI
   228                              <1> ;	Parameters:
   229                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
   230                              <1> ;	Returns:
   231                              <1> ;		AX:		Number of P-CHS cylinders (1...16383)
   232                              <1> ;		BL:		Number of P-CHS heads (1...16)
   233                              <1> ;		BH:		Number of P-CHS sectors per track (1...63)
   234                              <1> ;	Corrupts registers:
   235                              <1> ;		Nothing
   236                              <1> ;--------------------------------------------------------------------
   237                              <1> AtaGeometry_GetPCHStoAXBLBHfromAtaInfoInESSI:
   238 00000794 268B4402            <1> 	mov		ax, [es:si+ATA1.wCylCnt]	; Cylinders (1...16383)
   239 00000798 268A5C06            <1> 	mov		bl, [es:si+ATA1.wHeadCnt]	; Heads (1...16)
   240 0000079C 268A7C0C            <1> 	mov		bh, [es:si+ATA1.wSPT]		; Sectors per Track (1...63)
   241 000007A0 C3                  <1> 	ret
   242                              <1> 
   243                              <1> 
   244                              <1> ;--------------------------------------------------------------------
   245                              <1> ; Revised Enhanced CHS calculation (Revised ECHS)
   246                              <1> ;
   247                              <1> ; This algorithm translates P-CHS sector count to L-CHS sector count
   248                              <1> ; with bit shift algorithm. Since 256 heads are not allowed
   249                              <1> ; (DOS limit), this algorithm makes translations so that maximum of
   250                              <1> ; 240 L-CHS heads can be used. This makes the maximum addressable capacity
   251                              <1> ; to 7,927,234,560 bytes ~ 7.38 GiB. LBA addressing needs to be used to
   252                              <1> ; get more capacity.
   253                              <1> ;
   254                              <1> ; L-CHS parameters generated here require the drive to use CHS addressing.
   255                              <1> ;
   256                              <1> ; Here is the algorithm:
   257                              <1> ; If cylinders > 8192 and heads = 16
   258                              <1> ;  Heads = 15
   259                              <1> ;  Cylinders = cylinders * 16 / 15 (losing the fraction component)
   260                              <1> ;  Do a standard ECHS translation
   261                              <1> ;
   262                              <1> ; *FIXME* The above algorithm seems to be conflicting with info found here
   263                              <1> ; https://web.archive.org/web/20000817071418/http://www.firmware.com:80/support/bios/over4gb.htm
   264                              <1> ; which says that Revised ECHS is used when the cylinder count is > 8191.
   265                              <1> ;
   266                              <1> ; ConvertPCHfromAXBLtoRevisedEnhancedCHinAXBL:
   267                              <1> ;	Parameters:
   268                              <1> ;		AX:		Number of P-CHS cylinders (8193...16383)
   269                              <1> ;		BL:		Number of P-CHS heads (1...16)
   270                              <1> ;	Returns:
   271                              <1> ;		AX:		Number of L-CHS cylinders (?...1024)
   272                              <1> ;		BL:		Number of L-CHS heads (?...240)
   273                              <1> ;		CX:		Number of bits shifted (0...3)
   274                              <1> ;		DX:		TRANSLATEMODE_NORMAL or TRANSLATEMODE_LARGE
   275                              <1> ;	Corrupts registers:
   276                              <1> ;		Nothing
   277                              <1> ;--------------------------------------------------------------------
   278                              <1> ConvertPCHfromAXBLtoRevisedEnhancedCHinAXBL:
   279                              <1> 	; Generate L-CHS using simple bit shift algorithm (ECHS) if
   280                              <1> 	; 8192 or less cylinders
   281 000007A1 E81C00              <1> 	call	AtaGeometry_IsDriveSmallEnoughForECHS
   282 000007A4 7209                <1> 	jc		SHORT ConvertPCHfromAXBLtoEnhancedCHinAXBL
   283                              <1> 
   284                              <1> 	eMOVZX	cx, bl	; CX = 16
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 000007A6 0FB6CB              <2>  movzx %1, %2
   438                              <2> %endif
   285 000007A9 4B                  <1> 	dec		bx		; Heads = 15
   286 000007AA F7E1                <1> 	mul		cx		; DX:AX = Cylinders * 16
   287 000007AC 49                  <1> 	dec		cx		; CX = 15
   288 000007AD F7F1                <1> 	div		cx		; AX = (Cylinders * 16) / 15
   289                              <1> 	; Fall to ConvertPCHfromAXBLtoEnhancedCHinAXBL
   290                              <1> 
   291                              <1> 
   292                              <1> ;--------------------------------------------------------------------
   293                              <1> ; Enhanced CHS calculation (ECHS)
   294                              <1> ;
   295                              <1> ; This algorithm translates P-CHS sector count to L-CHS sector count
   296                              <1> ; with simple bit shift algorithm. Since 256 heads are not allowed
   297                              <1> ; (DOS limit), this algorithm require that there are at most 8192
   298                              <1> ; P-CHS cylinders. This makes the maximum addressable capacity
   299                              <1> ; to 4,227,858,432 bytes ~ 3.94 GiB. Use Revised ECHS or Assisted LBA
   300                              <1> ; algorithms if there are more than 8192 P-CHS cylinders.
   301                              <1> ;
   302                              <1> ; L-CHS parameters generated here require the drive to use CHS addressing.
   303                              <1> ;
   304                              <1> ; Here is the algorithm:
   305                              <1> ;  Multiplier = 1
   306                              <1> ;  Cylinder = Cylinder - 1
   307                              <1> ;  Is Cylinder < 1024? If not:
   308                              <1> ;  Do a right bitwise rotation on the cylinder (i.e., divide by 2)
   309                              <1> ;  Do a left bitwise rotation on the multiplier (i.e., multiply by 2)
   310                              <1> ;  Use the multiplier on the Cylinder and Head values to obtain the translated values.
   311                              <1> ;
   312                              <1> ; ConvertPCHfromAXBLtoEnhancedCHinAXBL:
   313                              <1> ;	Parameters:
   314                              <1> ;		AX:		Number of P-CHS cylinders (1...8192, or up to 17475 if fell from above)
   315                              <1> ;		BL:		Number of P-CHS heads (1...16)
   316                              <1> ;	Returns:
   317                              <1> ;		AX:		Number of L-CHS cylinders (?...1024)
   318                              <1> ;		BL:		Number of L-CHS heads (?...128, or up to 240 if fell from above)
   319                              <1> ;		CX:		Number of bits shifted (0...3)
   320                              <1> ;		DX:		TRANSLATEMODE_NORMAL or TRANSLATEMODE_LARGE
   321                              <1> ;	Corrupts registers:
   322                              <1> ;		Nothing
   323                              <1> ;--------------------------------------------------------------------
   324                              <1> ConvertPCHfromAXBLtoEnhancedCHinAXBL:
   325 000007AF 99                  <1> 	cwd					; Assume TRANSLATEMODE_NORMAL
   326 000007B0 31C9                <1> 	xor		cx, cx		; No bits to shift initially
   327                              <1> .ShiftIfMoreThan1024Cylinder:
   328 000007B2 3D0004              <1> 	cmp		ax, MAX_LCHS_CYLINDERS
   329 000007B5 76DC                <1> 	jbe		SHORT ReturnLCHSinAXBLBH
   330 000007B7 D1E8                <1> 	shr		ax, 1		; Halve cylinders
   331                              <1> 	eSHL_IM	bl, 1		; Double heads
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 000007B9 00DB                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   332 000007BB 41                  <1> 	inc		cx			; Increment bit shift count
   333 000007BC B201                <1> 	mov		dl, TRANSLATEMODE_LARGE
   334 000007BE EBF2                <1> 	jmp		SHORT .ShiftIfMoreThan1024Cylinder
   335                              <1> 
   336                              <1> 
   337                              <1> ;--------------------------------------------------------------------
   338                              <1> ; Checks should LARGE mode L-CHS be calculated with ECHS or Revised ECHS
   339                              <1> ; algorithm. Revised ECHS is needed for drives with 8193 or more cylinders
   340                              <1> ; AND 16 heads.
   341                              <1> ;
   342                              <1> ; AtaGeometry_IsDriveSmallEnoughForECHS:
   343                              <1> ;	Parameters:
   344                              <1> ;		AX:		Number of P-Cylinders
   345                              <1> ;		BL:		Number of P-Heads
   346                              <1> ;	Returns:
   347                              <1> ;		CF:		Clear if Reviced ECHS is necessary
   348                              <1> ;				Set if ECHS is enough
   349                              <1> ;	Corrupts registers:
   350                              <1> ;		Nothing
   351                              <1> ;--------------------------------------------------------------------
   352                              <1> AtaGeometry_IsDriveSmallEnoughForECHS:
   353                              <1> 	; Generate L-CHS using simple bit shift algorithm (ECHS) if
   354                              <1> 	; 8192 or less cylinders. Use Revised ECHS if 8193 or more cylinders
   355                              <1> 	; AND 16 heads.
   356 000007C0 3D0120              <1> 	cmp		ax, 8193
   357 000007C3 7203                <1> 	jb		SHORT .RevisedECHSisNotNeeded
   358 000007C5 80FB10              <1> 	cmp		bl, 16	; Drives with 8193 or more cylinders can report 15 heads
   359                              <1> .RevisedECHSisNotNeeded:
   360 000007C8 C3                  <1> 	ret
   361                              <1> 
   362                              <1> 
   363                              <1> ;--------------------------------------------------------------------
   364                              <1> ; AtaGeometry_LimitAXtoMaximumLCylinders
   365                              <1> ;	Parameters:
   366                              <1> ;		AX:		Number of total L-CHS cylinders (1...1027)
   367                              <1> ;	Returns:
   368                              <1> ;		AX:		Number of usable L-CHS cylinders (1...1024)
   369                              <1> ;	Corrupts registers:
   370                              <1> ;		Nothing
   371                              <1> ;--------------------------------------------------------------------
   372                              <1> AtaGeometry_LimitAXtoMaximumLCylinders:
   373                              <1> 	MIN_U	ax, MAX_LCHS_CYLINDERS
    22 000007C9 3D0004              <2>  cmp %1, %2
    23 000007CC 7203                <2>  jb %%Return
    24 000007CE B80004              <2>  mov %1, %2
    25                              <2> %%Return:
   374 000007D1 C3                  <1> 	ret
   375                              <1> 
