    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Prepare_ByLoadingDapToESSIandVerifyingForTransfer
    25                              <1> ;	Parameters:
    26                              <1> ;		SI:		Offset to DAP
    27                              <1> ;		DS:DI:	Ptr to DPT
    28                              <1> ;		SS:BP:	Ptr to IDEPACK
    29                              <1> ;	Parameters on INTPACK:
    30                              <1> ;		DS:SI:	Ptr to Disk Address Packet
    31                              <1> ;	Returns:
    32                              <1> ;		BX:		Index to command lookup table
    33                              <1> ;		ES:SI:	Ptr to Disk Address Packet (DAP)
    34                              <1> ;		Exits from INT 13h if invalid DAP
    35                              <1> ;	Corrupts registers:
    36                              <1> ;		AX, DX
    37                              <1> ;--------------------------------------------------------------------
    38                              <1> %ifdef MODULE_EBIOS
    39 00001C23 90                  <1> ALIGN JUMP_ALIGN
    40                              <1> Prepare_ByLoadingDapToESSIandVerifyingForTransfer:
    41                              <1> 	; Load pointer to DAP to ES:SI and make sure it is valid
    42 00001C24 8E460E              <1> 	mov		es, [bp+IDEPACK.intpack+INTPACK.ds]	; ES:SI to point Disk Address Packet
    43 00001C27 26803C10            <1> 	cmp		BYTE [es:si+DAP.bSize], MINIMUM_DAP_SIZE
    44 00001C2B 7230                <1> 	jb		SHORT InvalidDAP
    45                              <1> 
    46                              <1> 	; Make sure that sector count is valid
    47                              <1> %ifdef USE_UNDOC_INTEL
    48 00001C2D D6                  <1> 	salc	; Clear AL using CF (CF is cleared since JB above fell through)
    49 00001C2E 260A4402            <1> 	or		al, [es:si+DAP.wSectorCount]
    50                              <1> %else
    51                              <1> 	mov		al, [es:si+DAP.wSectorCount]
    52                              <1> 	test	al, al
    53                              <1> %endif
    54 00001C32 742E                <1> 	jz		SHORT ZeroSectorsRequestedSoNoErrors
    55 00001C34 7827                <1> 	js		SHORT InvalidNumberOfSectorsRequested
    56                              <1> 
    57                              <1> %if 0	; Slow version in the unlikely case that high byte needs to be checked.
    58                              <1> 	mov		ax, [es:si+DAP.wSectorCount]
    59                              <1> 	test	ax, ax
    60                              <1> 	jz		SHORT ZeroSectorsRequestedSoNoErrors
    61                              <1> 	cmp		ax, BYTE 127
    62                              <1> 	ja		SHORT InvalidNumberOfSectorsRequested
    63                              <1> %endif
    64                              <1> 
    65                              <1> 	; Get EBIOS command index to BX
    66                              <1> 	; LBA28 or LBA48 command
    67 00001C36 E80700              <1> 	call	Prepare_GetOldInt13hCommandIndexToBX
    68 00001C39 8A05                <1> 	mov		al, [di+DPT.bFlagsLow]
    69                              <1> 	eSHL_IM	al, 1					; Set CF if LBA48 supported
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 00001C3B 00C0                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
    70 00001C3D 10FB                <1> 	adc		bl, bh					; LBA48 EXT commands
    71 00001C3F C3                  <1> 	ret
    72                              <1> %endif ; MODULE_EBIOS
    73                              <1> 
    74                              <1> 
    75                              <1> ;--------------------------------------------------------------------
    76                              <1> ; Prepare_GetOldInt13hCommandIndexToBX
    77                              <1> ;	Parameters:
    78                              <1> ;		DS:DI:	Ptr to DPT
    79                              <1> ;	Returns:
    80                              <1> ;		BX:		Index to command lookup table
    81                              <1> ;	Corrupts registers:
    82                              <1> ;		Nothing
    83                              <1> ;--------------------------------------------------------------------
    84                              <1> ALIGN JUMP_ALIGN
    85                              <1> Prepare_GetOldInt13hCommandIndexToBX:
    86                              <1> 	; Block mode or single sector
    87 00001C40 8A5D01              <1> 	mov		bl, [di+DPT.bFlagsHigh]
    88 00001C43 83E302              <1> 	and		bx, BYTE FLGH_DPT_USE_BLOCK_MODE_COMMANDS	; Bit 1
    89 00001C46 C3                  <1> 	ret
    90                              <1> 
    91                              <1> 
    92                              <1> ;---------------------------------------------------------------------
    93                              <1> ; Prepare_BufferToESSIforOldInt13hTransfer
    94                              <1> ;	Parameters:
    95                              <1> ;		AL:		Number of sectors to transfer
    96                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    97                              <1> ;		SS:BP:	Ptr to IDEPACK
    98                              <1> ;	Parameters on INTPACK:
    99                              <1> ;		ES:BX:	Ptr to data buffer
   100                              <1> ;	Returns:
   101                              <1> ;		ES:SI:	Ptr to normalized data buffer
   102                              <1> ;		Exits INT 13h if error
   103                              <1> ;	Corrupts registers:
   104                              <1> ;		BX
   105                              <1> ;--------------------------------------------------------------------
   106 00001C47 90                  <1> ALIGN JUMP_ALIGN
   107                              <1> Prepare_BufferToESSIforOldInt13hTransfer:
   108 00001C48 8B7618              <1> 	mov		si, [bp+IDEPACK.intpack+INTPACK.bx]	; Load offset
   109 00001C4B 8E460C              <1> 	mov		es, [bp+IDEPACK.intpack+INTPACK.es]	; Load segment
   110                              <1> 	; Fall to Prepare_ByValidatingSectorsInALforOldInt13h
   111                              <1> 
   112                              <1> ;---------------------------------------------------------------------
   113                              <1> ; Prepare_ByValidatingSectorsInALforOldInt13h
   114                              <1> ;	Parameters:
   115                              <1> ;		AL:		Number of sectors to transfer (1...128 is valid)
   116                              <1> ;	Returns:
   117                              <1> ;		Exits INT 13h if invalid number of sectors in AL
   118                              <1> ;	Corrupts registers:
   119                              <1> ;		Nothing
   120                              <1> ;--------------------------------------------------------------------
   121                              <1> Prepare_ByValidatingSectorsInALforOldInt13h:
   122 00001C4E 84C0                <1> 	test	al, al								; Check if 0 < AL < 128 (Clears OF)
   123 00001C50 7E02                <1> 	jle		SHORT .CheckIf128Sectors			; Jump if not
   124 00001C52 C3                  <1> 	ret		; Continue with transfer
   125                              <1> 
   126 00001C53 90                  <1> ALIGN JUMP_ALIGN
   127                              <1> .CheckIf128Sectors:
   128 00001C54 3C80                <1> 	cmp		al, 128
   129 00001C56 7505                <1> 	jne		SHORT InvalidNumberOfSectorsRequested
   130 00001C58 85F6                <1> 	test	si, si								; Offset must be zero to xfer 128 sectors
   131 00001C5A 7504                <1> 	jnz		SHORT CannotAlignPointerProperly
   132 00001C5C C3                  <1> 	ret		; Continue with transfer
   133                              <1> 
   134                              <1> %ifdef MODULE_EBIOS
   135                              <1> InvalidDAP:
   136                              <1> Prepare_ReturnFromInt13hWithInvalidFunctionError:
   137                              <1> %endif
   138                              <1> InvalidNumberOfSectorsRequested:
   139 00001C5D B401                <1> 	mov		ah, RET_HD_INVALID
   140 00001C5F 3D                  <1> 	SKIP2B	f
   141                              <1> CannotAlignPointerProperly:
   142 00001C60 B409                <1> 	mov		ah, RET_HD_BOUNDARY
   143                              <1> %ifdef MODULE_EBIOS
   144                              <1> ZeroSectorsRequestedSoNoErrors:
   145                              <1> %endif
   146 00001C62 E91BFC              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
   147                              <1> 
   148                              <1> 
   149                              <1> 
   150                              <1> ; Command lookup tables
   151                              <1> g_rgbReadCommandLookup:
   152 00001C65 20                  <1> 	db		COMMAND_READ_SECTORS		; 00b, CHS or LBA28 single sector
   153 00001C66 24                  <1> 	db		COMMAND_READ_SECTORS_EXT	; 01b, LBA48 single sector
   154 00001C67 C4                  <1> 	db		COMMAND_READ_MULTIPLE		; 10b, CHS or LBA28 block mode
   155                              <1> %ifdef MODULE_EBIOS
   156 00001C68 29                  <1> 	db		COMMAND_READ_MULTIPLE_EXT	; 11b, LBA48 block mode
   157                              <1> %endif
   158                              <1> 
   159                              <1> g_rgbWriteCommandLookup:
   160 00001C69 30                  <1> 	db		COMMAND_WRITE_SECTORS
   161 00001C6A 34                  <1> 	db		COMMAND_WRITE_SECTORS_EXT
   162 00001C6B C5                  <1> 	db		COMMAND_WRITE_MULTIPLE
   163                              <1> %ifdef MODULE_EBIOS
   164 00001C6C 39                  <1> 	db		COMMAND_WRITE_MULTIPLE_EXT
   165                              <1> %endif
   166                              <1> 
   167                              <1> %ifdef MODULE_EBIOS
   168                              <1> g_rgbVerifyCommandLookup:
   169 00001C6D 40                  <1> 	db		COMMAND_VERIFY_SECTORS
   170 00001C6E 42                  <1> 	db		COMMAND_VERIFY_SECTORS_EXT
   171 00001C6F 40                  <1> 	db		COMMAND_VERIFY_SECTORS
   172 00001C70 42                  <1> 	db		COMMAND_VERIFY_SECTORS_EXT
   173                              <1> %endif
