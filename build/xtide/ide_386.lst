   261                              <2> ;--------------------------------------------------------------------
   262                              <2> %ifndef EXCLUDE	; 1 of 3
   263                              <2> ALIGN DISPLAY_JUMP_ALIGN
   264                              <2> DisplayContext_SetCharOutputFunctionFromAXwithAttribFlagInBL:
   265                              <2> 	and		bl, FLG_CONTEXT_ATTRIBUTES
   266                              <2> 	and		BYTE [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bFlags], ~FLG_CONTEXT_ATTRIBUTES
   267                              <2> 	or		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bFlags], bl
   268                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fnCharOut], ax
   269                              <2> 	ret
   270                              <2> %endif
