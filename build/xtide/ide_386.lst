   130 00000F35 E88200              <1> 	call	Vision_InitializeWithIDinAH
   131 00000F38 31C0                <1> 	xor		ax, ax						; Success
   132                              <1> 
   133 00000F3A 5E                  <1> 	pop		si
   134 00000F3B 5D                  <1> 	pop		bp
