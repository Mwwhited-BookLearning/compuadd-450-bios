    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; DriveXlate_ConvertDriveLetterInDLtoDriveNumber
    25                              <1> ;	Parameters:
    26                              <1> ;		DS:		RAMVARS segment
    27                              <1> ;		DL:		Drive letter ('A'...)
    28                              <1> ;	Returns:
    29                              <1> ;		DL:		Drive number (0xh for Floppy Drives, 8xh for Hard Drives)
    30                              <1> ;	Corrupts registers:
    31                              <1> ;		AX
    32                              <1> ;--------------------------------------------------------------------
    33                              <1> DriveXlate_ConvertDriveLetterInDLtoDriveNumber:
    34 00000C74 E8E6F8              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
    35 00000C77 38C2                <1> 	cmp		dl, al
    36 00000C79 7206                <1> 	jb		SHORT .ConvertLetterInDLtoFloppyDriveNumber
    37                              <1> 
    38                              <1> 	; Convert letter in DL to Hard Drive number
    39 00000C7B 28C2                <1> 	sub		dl, al
    40 00000C7D 80CA80              <1> 	or		dl, 80h
    41 00000C80 C3                  <1> 	ret
    42                              <1> 
    43                              <1> .ConvertLetterInDLtoFloppyDriveNumber:
    44 00000C81 80EA41              <1> 	sub		dl, DEFAULT_FLOPPY_DRIVE_LETTER
    45 00000C84 C3                  <1> 	ret
    46                              <1> 
    47                              <1> %ifdef MODULE_HOTKEY
    48                              <1> %if HotkeyBar_FallThroughTo_DriveXlate_ConvertDriveLetterInDLtoDriveNumber <> DriveXlate_ConvertDriveLetterInDLtoDriveNumber
    49                              <1> 	%error "DriveXlate_ConvertDriveLetterInDLtoDriveNumber must be at the top of DriveXlate.asm, and that file must immediately follow HotKeys.asm"
    50                              <1> %endif
    51                              <1> %endif
    52                              <1> 
    53                              <1> ;--------------------------------------------------------------------
    54                              <1> ; DriveXlate_ConvertDriveNumberFromDLtoDriveLetter
    55                              <1> ;	Parameters:
    56                              <1> ;		DL:		Drive number (0xh for Floppy Drives, 8xh for Hard Drives)
    57                              <1> ;		DS:		RAMVARS Segment
    58                              <1> ;	Returns:
    59                              <1> ;		DL:		Drive letter ('A'...)
    60                              <1> ;		CF:		Set if Hard Drive
    61                              <1> ;				Clear if Floppy Drive
    62                              <1> ;	Corrupts registers:
    63                              <1> ;		AX
    64                              <1> ;--------------------------------------------------------------------
    65                              <1> DriveXlate_ConvertDriveNumberFromDLtoDriveLetter:
    66 00000C85 80F280              <1> 	xor		dl, 80h
    67 00000C88 7807                <1> 	js		SHORT .GetDefaultFloppyDrive
    68                              <1> 
    69                              <1> 	; Store default hard drive to boot from
    70 00000C8A E8D0F8              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
    71 00000C8D 00C2                <1> 	add		dl, al
    72 00000C8F F9                  <1> 	stc
    73 00000C90 C3                  <1> 	ret
    74                              <1> 
    75                              <1> .GetDefaultFloppyDrive:
    76 00000C91 80EA3F              <1> 	sub		dl, 80h - DEFAULT_FLOPPY_DRIVE_LETTER	; Clears CF
    77 00000C94 C3                  <1> 	ret
    78                              <1> 
    79                              <1> 
    80                              <1> ;--------------------------------------------------------------------
    81                              <1> ; DriveXlate_ToOrBack
    82                              <1> ;	Parameters:
    83                              <1> ;		DL:		Drive number to be possibly translated
    84                              <1> ;		DS:		RAMVARS segment
    85                              <1> ;	Returns:
    86                              <1> ;		DL:		Translated drive number
    87                              <1> ;	Corrupts registers:
    88                              <1> ;		DI
    89                              <1> ;--------------------------------------------------------------------
    90 00000C95 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    91                              <1> DriveXlate_ToOrBack:
    92 00000C98 97                  <1> 	xchg	di, ax					; Backup AX
    93                              <1> 
    94 00000C99 B480                <1> 	mov		ah, 80h					; Assume hard disk
    95 00000C9B A00F00              <1> 	mov		al, [RAMVARS.xlateVars+XLATEVARS.bHDSwap]
    96 00000C9E 84E2                <1> 	test	dl, ah					; Hard disk?
    97 00000CA0 7506                <1> 	jnz		SHORT .SwapDrive		; If so, jump to swap
    98                              <1> 
    99 00000CA2 A00E00              <1> 	mov		al, [RAMVARS.xlateVars+XLATEVARS.bFDSwap]
   100 00000CA5 98                  <1> 	cbw
   101                              <1> 
   102 00000CA6 90<rep 2h>          <1> ALIGN JUMP_ALIGN
   103                              <1> .SwapDrive:
   104 00000CA8 38D4                <1> 	cmp		ah, dl					; Swap DL from 00h/80h to xxh?
   105 00000CAA 7408                <1> 	je		SHORT .SwapToXXhInAL
   106 00000CAC 38D0                <1> 	cmp		al, dl					; Swap DL from xxh to 00h/80h?
   107 00000CAE 7524                <1> 	jne		SHORT .RestoreAXandReturn
   108 00000CB0 88E0                <1> 	mov		al, ah
   109                              <1> 
   110 00000CB2 90<rep 2h>          <1> ALIGN JUMP_ALIGN
   111                              <1> .SwapToXXhInAL:
   112 00000CB4 88C2                <1> 	mov		dl, al
   113                              <1> 
   114                              <1> %ifdef MODULE_COMPATIBLE_TABLES
   115 00000CB6 3C81                <1> 	cmp		al, 81h
   116 00000CB8 751A                <1> 	jne		SHORT .RestoreAXandReturn
   117                              <1> 
   118                              <1> 	; Since swapping drive 80h <=> 81h, we need to swap
   119                              <1> 	; DPT pointers in interrupt vectors 41h and 46h.
   120 00000CBA 1E                  <1> 	push	ds
   121                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184                              <2>  xor %2, %2
   185                              <2>  mov %1, %2
   186                              <2> %else
   187 00000CBB 6A00                <2>  push BYTE 0
   188 00000CBD 1F                  <2>  pop %1
   189                              <2> %endif
   122 00000CBE A10401              <1> 	mov		ax, [HD0_DPT_POINTER_41h*4]
   123 00000CC1 87061801            <1> 	xchg	[HD1_DPT_POINTER_46h*4], ax
   124 00000CC5 A30401              <1> 	mov		[HD0_DPT_POINTER_41h*4], ax
   125 00000CC8 A10601              <1> 	mov		ax, [HD0_DPT_POINTER_41h*4+2]
   126 00000CCB 87061A01            <1> 	xchg	[HD1_DPT_POINTER_46h*4+2], ax
   127 00000CCF A30601              <1> 	mov		[HD0_DPT_POINTER_41h*4+2], ax
   128 00000CD2 1F                  <1> 	pop		ds
   129                              <1> %endif ; MODULE_COMPATIBLE_TABLES
   130                              <1> 
   131 00000CD3 90                  <1> ALIGN JUMP_ALIGN
   132                              <1> .RestoreAXandReturn:
   133 00000CD4 97                  <1> 	xchg	ax, di					; Restore AX
   134 00000CD5 C3                  <1> 	ret
   135                              <1> 
   136                              <1> 
   137                              <1> ;--------------------------------------------------------------------
   138                              <1> ; Resets drive swapping variables to defaults (no swapping).
   139                              <1> ;
   140                              <1> ; DriveXlate_Reset
   141                              <1> ;	Parameters:
   142                              <1> ;		DS:		RAMVARS segment
   143                              <1> ;	Returns:
   144                              <1> ;		Nothing
   145                              <1> ;	Corrupts registers:
   146                              <1> ;		Nothing
   147                              <1> ;--------------------------------------------------------------------
   148                              <1> DriveXlate_Reset:
   149 00000CD6 C7060E000080        <1> 	mov		WORD [RAMVARS.xlateVars+XLATEVARS.wFDandHDswap], 8000h
   150 00000CDC C3                  <1> 	ret
   151                              <1> 
   152                              <1> 
   153                              <1> ;--------------------------------------------------------------------
   154                              <1> ; Stores drive to be swapped.
   155                              <1> ;
   156                              <1> ; DriveXlate_SetDriveToSwap
   157                              <1> ;	Parameters:
   158                              <1> ;		DL:		Hard Drive to swap to first Hard Drive
   159                              <1> ;				Floppy Drive to swap to first Floppy Drive
   160                              <1> ;		DS:		RAMVARS segment
   161                              <1> ;	Returns:
   162                              <1> ;		Nothing
   163                              <1> ;	Corrupts registers:
   164                              <1> ;		Nothing
