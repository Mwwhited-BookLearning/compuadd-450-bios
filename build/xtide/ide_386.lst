     9                              <2> 
    10                              <2> ; BIOS Data Area (related to floppy drives and hard disks)
    11                              <2> struc BDA
    12 00000000 <res 400h>          <2> 					resb	400h	; 40:0h, Start of BDA
    13 00000400 ????                <2> 	.wCOM1			resb	2		; 0:400h, Serial I/O Address, Port 1
    14 00000402 ????                <2> 	.wCOM2			resb	2		; 0:402h, Serial I/O Address, Port 2
    15 00000404 ????                <2> 	.wCOM3			resb	2		; 0:404h, Serial I/O Address, Port 3
    16 00000406 ????                <2> 	.wCOM4			resb	2		; 0:406h, Serial I/O Address, Port 4
    17 00000408 ????                <2> 	.wLPT1			resb	2		; 0:408h, Parallel I/O Address, Port 1
    18 0000040A ????                <2> 	.wLPT2			resb	2		; 0:40Ah, Parallel I/O Address, Port 2
    19 0000040C ????                <2> 	.wLPT3			resb	2		; 0:40Ch, Parallel I/O Address, Port 3
    20                              <2> 	.wLPT4:							; 0:40Eh, Parallel I/O Address, Port 4 (PC/XT)
    21 0000040E ????                <2> 	.wSegEBDA		resb	2		; 0:40Eh, Extended BIOS Data Area segment (AT+)
    22                              <2> 
    23 00000410 ????                <2> 	.wEquipment		resb	2		; 0:410h, Equipment Word
    24 00000412 ??                  <2> 	.bTest			resb	1		; 0:412h, Manufacturing test
    25 00000413 ????                <2> 	.wBaseMem		resb	2		; 0:413h, Base Memory Size in kB
    26                              <2> 	.wAdptrMem:						; 0:415h, Adapter Memory Size (PC/XT)
    27 00000415 ????                <2> 	.wError			resb	2		; 0:415h, Error Codes (AT+)
    28 00000417 ??                  <2> 	.bKBFlgs1		resb	1		; 0:417h, Keyboard, Shift Flags, Set 1
    29 00000418 ??                  <2> 	.bKBFlgs2		resb	1		; 0:418h, Keyboard, Shift Flags, Set 2
    30 00000419 ??                  <2> 	.bKBNumpad		resb	1		; 0:419h, Keyboard, ALT+Numpad work area
    31 0000041A ????                <2> 	.wKBHead		resb	2		; 0:41Ah, Keyboard, Head of buffer pointer
    32 0000041C ????                <2> 	.wKBTail		resb	2		; 0:41Ch, Keyboard, Tail of buffer pointer
    33 0000041E <res 20h>           <2> 	.rgwKBBuff		resb	32		; 0:41Eh, Keyboard, 16-word buffer
    34                              <2> 
    35 0000043E ??                  <2> 	.bFDRecal		resb	1		; 0:43Eh, Diskette, Recalibrate status
    36 0000043F ??                  <2> 	.bFDMotor		resb	1		; 0:43Fh, Diskette, Motor status
    37                              <2> 
    38 00000440 ??                  <2> 	.bFDMotTime		resb	1		; 0:440h, Diskette, Motor timeout counter
    39 00000441 ??                  <2> 	.bFDRetST		resb	1		; 0:441h, Diskette, Controller status return code
    40 00000442 ??????????????      <2> 	.rgbFDStatus	resb	7		; 0:442h, Diskette, Diskette and Disk Controller status bytes
    41 00000449 ??                  <2> 	.bVidMode		resb	1		; 0:449h, Video, Mode
    42 0000044A ????                <2> 	.wVidColumns	resb	2		; 0:44Ah, Video, Number of columns
    43 0000044C ????                <2> 	.wVidBpP		resb	2		; 0:44Ch, Video, Total number of bytes per page
    44 0000044E ????                <2> 	.wVidPageOff	resb	2		; 0:44Eh, Video, Current page offset
    45                              <2> 
    46 00000450 <res 10h>           <2> 	.rgwVidCurPos	resb	16		; 0:450h, Video, Cursor position, pages 0...7
    47                              <2> 
    48 00000460 ????                <2> 	.wVidCurShape	resb	2		; 0:460h, Video, Cursor shape
    49 00000462 ??                  <2> 	.bVidPageIdx	resb	1		; 0:462h, Video, Active display page
    50 00000463 ????                <2> 	.wVidPort		resb	2		; 0:463h, Video, I/O Port number base
    51 00000465 ??                  <2> 	.bVidModeReg	resb	1		; 0:465h, Video, Internal mode register
    52 00000466 ??                  <2> 	.bVidPalette	resb	1		; 0:466h, Video, Color palette
    53                              <2> 	.wCasTimeCnt:					; 0:467h, Cassette, Time count at data edge (PC)
    54 00000467 ????                <2> 	.wGenOff		resb	2		; 0:467h, General use offset (XT+)
    55                              <2> 	.wCasCRC:						; 0:469h, Cassette, CRC register (PC)
    56 00000469 ????                <2> 	.wGenSeg		resb	2		; 0:469h, General use segment (XT+)
    57                              <2> 	.bCasLast:						; 0:46Bh, Cassette, Last value read
    58 0000046B ??                  <2> 	.bLastIRQ		resb	1		; 0:46Bh, Last interrupt that occurred (XT+)
    59 0000046C ????????            <2> 	.dwTimerTicks	resb	4		; 0:46Ch, Timer ticks count
    60                              <2> 
    61 00000470 ??                  <2> 	.bTimer24h		resb	1		; 0:470h, Timer ticks rollover flag
    62 00000471 ??                  <2> 	.bKBCtrlBrk		resb	1		; 0:471h, Keyboard, Ctrl+Break flag
    63 00000472 ????                <2> 	.wBoot			resb	2		; 0:472h, Warm boot flag
    64 00000474 ??                  <2> 	.bHDLastSt		resb	1		; 0:474h, Hard Disk, Status of Last Operation (XT+)
    65 00000475 ??                  <2> 	.bHDCount		resb	1		; 0:475h, Hard Disk, Number of HDs Attached (XT+)
    66 00000476 ??                  <2> 	.bHDCtrl		resb	1		; 0:476h, Hard Disk, Control Byte (temp, XT+)
    67 00000477 ??                  <2> 	.bHDPortOff		resb	1		; 0:477h, Hard Disk, Port Offset (XT)
    68 00000478 ??                  <2> 	.bLPT1Timeout	resb	1		; 0:478h, Parallel Printer 1, Timeout (XT+)
    69 00000479 ??                  <2> 	.bLPT2Timeout	resb	1		; 0:479h, Parallel Printer 2, Timeout (XT+)
    70 0000047A ??                  <2> 	.bLPT3Timeout	resb	1		; 0:47Ah, Parallel Printer 3, Timeout (XT+)
    71 0000047B ??                  <2> 	.bLPT4Timeout	resb	1		; 0:47Bh, Parallel Printer 4, Timeout (XT+)
    72 0000047C ??                  <2> 	.bCOM1Timeout	resb	1		; 0:47Ch, Serial 1, Timeout (XT+)
    73 0000047D ??                  <2> 	.bCOM2Timeout	resb	1		; 0:47Dh, Serial 2, Timeout (XT+)
    74 0000047E ??                  <2> 	.bCOM3Timeout	resb	1		; 0:47Eh, Serial 3, Timeout (XT+)
    75 0000047F ??                  <2> 	.bCOM4Timeout	resb	1		; 0:47Fh, Serial 4, Timeout (XT+)
    76                              <2> 
    77 00000480 ????                <2> 	.wKBPtrStart	resb	2		; 0:480h, Keyboard, Pointer to start of buffer (XT+)
    78 00000482 ????                <2> 	.wKBPtrEnd		resb	2		; 0:482h, Keyboard, Pointer to end of buffer (XT+)
    79 00000484 ??                  <2> 	.bVidRows		resb	1		; 0:484h, Video, Number of rows minus one (EGA+)
    80 00000485 ????                <2> 	.wVidPpC		resb	2		; 0:485h, Video, Pixels per character (EGA+)
    81 00000487 ??                  <2> 	.bVidOptns		resb	1		; 0:487h, Video, Options (EGA+)
    82 00000488 ??                  <2> 	.bVidSwitches	resb	1		; 0:488h, Video, Switches (EGA+)
    83 00000489 ??                  <2> 	.bVidSave1		resb	1		; 0:489h, Video, Save area 1 (VGA+)
    84 0000048A ??                  <2> 	.bVidSave2		resb	1		; 0:48Ah, Video, Save area 2 (VGA+)
    85 0000048B ??                  <2> 	.bFDCfgData		resb	1		; 0:48Bh, Diskette, Configuration data (AT+)
    86 0000048C ??                  <2> 	.bHDStatus		resb	1		; 0:48Ch, Hard Disk, Status Register (AT+)
    87 0000048D ??                  <2> 	.bHDError		resb	1		; 0:48Dh, Hard Disk, Error Register (AT+)
    88 0000048E ??                  <2> 	.bHDTaskFlg		resb	1		; 0:48Eh, Hard Disk, Task Complete Flag (AT+)
    89 0000048F ??                  <2> 	.bFDCtrlInfo	resb	1		; 0:48Fh, Diskette, Controller information (AT+)
    90                              <2> 
    91 00000490 ??                  <2> 	.bFDMedia0		resb	1		; 0:490h, Diskette 0, Media state (AT+)
    92 00000491 ??                  <2> 	.bFDMedia1		resb	1		; 0:491h, Diskette 1, Media state (AT+)
    93 00000492 ??                  <2> 	.bFDOpStart0	resb	1		; 0:492h, Diskette 0, Operational starting state (AT+)
    94 00000493 ??                  <2> 	.bFDOpStart1	resb	1		; 0:493h, Diskette 1, Operational starting state (AT+)
    95 00000494 ??                  <2> 	.bFDCurCyl0		resb	1		; 0:494h, Diskette 0, Current cylinder (AT+)
    96 00000495 ??                  <2> 	.bFDCurCyl1		resb	1		; 0:495h, Diskette 1, Current cylinder (AT+)
    97 00000496 ??                  <2> 	.bKBFlgs3		resb	1		; 0:496h, Keyboard, Status flags 3 (AT+)
    98 00000497 ??                  <2> 	.bKBFlgs4		resb	1		; 0:497h, Keyboard, Status flags 4 (AT+)
    99 00000498 ????????            <2> 	.dwWaitPtr		resb	4		; 0:498h, User's wait flag pointer (AT+)
   100 0000049C ????????            <2> 	.dwWaitCnt		resb	4		; 0:49Ch, User's wait count (AT+)
   101                              <2> 
   102 000004A0 ??                  <2> 	.bWaitFlg		resb	1		; 0:4A0h, Wait flag (AT+)
   103 000004A1 ??????????????      <2> 	.rgbLAN			resb	7		; 0:4A1h, Local Area Network (AT+)
   104 000004A8 ????????            <2> 	.dwVidPtr		resb	4		; 0:4A8h, Video, Parameter Control Block Pointer (EGA+)
   105 000004AC <res 22h>           <2> 					resb	22h		; Reserved from 0:4ACh...0:4CDh
   106                              <2> 
   107 000004CE ????????            <2> 	.dwDays			resb	4		; 0:4CEh, Clock, Days since 1980 (some BIOSes, AT+)
   108 000004D2 <res 2Eh>           <2> 					resb	2Eh		; Reserved from 0:4D2h...0:4FFh
   109                              <2> 
   110 00000500 ??                  <2> 	.bPrntScrn		resb	1		; 0:500, Print screen status
   111                              <2> endstruc
