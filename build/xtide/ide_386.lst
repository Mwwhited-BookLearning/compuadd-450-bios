   186                              <1> 		stosb			; Store BYTE to [ES:DI]
   187                              <1> 	%endrep
   188                              <1> 	loop	.NextIteration
   189                              <1> %else
   190                              <1> 	%rep 16	; BYTEs
   191                              <1> 		in		al, dx	; Read BYTE
   192                              <1> 		stosb			; Store BYTE to [ES:DI]
   193                              <1> 	%endrep
   194                              <1> 	loop	.NextIteration
   195                              <1> %endif
   196                              <1> 	ret
   197                              <1> %endif
