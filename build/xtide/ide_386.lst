    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Drives must be detected before this function is called unless
    25                              <1> ; MODULE_DRIVEXLATE has been included in the BIOS.
    26                              <1> ;
    27                              <1> ; Interrupts_InitializeInterruptVectors
    28                              <1> ;	Parameters:
    29                              <1> ;		DS:		RAMVARS segment
    30                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
    31                              <1> ;	Returns:
    32                              <1> ;		Nothing
    33                              <1> ;	Corrupts registers:
    34                              <1> ;		All except segments
    35                              <1> ;--------------------------------------------------------------------
    36                              <1> Interrupts_InitializeInterruptVectors:
    37                              <1> 	; Install INT 19h handler to properly reset the system
    38 00000453 B019                <1> 	mov		al, BIOS_BOOT_LOADER_INTERRUPT_19h	; INT 19h interrupt vector offset
    39 00000455 BE[CC0D]            <1> 	mov		si, Int19hReset_Handler				; INT 19h handler to reboot the system
    40 00000458 E84500              <1> 	call	Interrupts_InstallHandlerToVectorInALFromCSSI
    41                              <1> 
    42                              <1> 	; If no drives detected, leave system INT 13h and 40h handlers
    43                              <1> 	; in place. We need our INT 13h handler to swap drive letters.
    44                              <1> %ifndef MODULE_DRIVEXLATE
    45                              <1> 	cmp		BYTE [RAMVARS.bDrvCnt], 0
    46                              <1> 	je		SHORT Interrupts_InstallHandlerToVectorInALFromCSSI.Interrupts_Return
    47                              <1> %endif
    48                              <1> 	; Fall to .InitializeInt13hAnd40h
    49                              <1> 
    50                              <1> ;--------------------------------------------------------------------
    51                              <1> ; .InitializeInt13hAnd40h
    52                              <1> ;	Parameters:
    53                              <1> ;		DS:		RAMVARS segment
    54                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
    55                              <1> ;	Returns:
    56                              <1> ;		Nothing
    57                              <1> ;	Corrupts registers:
    58                              <1> ;		AX, BX, CX, DX, SI, DI
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> .InitializeInt13hAnd40h:
    61                              <1> %ifdef USE_386
    62 0000045B 6650                <1> 	push	eax			; Save the high WORD of EAX
    63                              <1> %endif
    64                              <1> 
    65                              <1> %ifdef MODULE_MFM_COMPATIBILITY
    66                              <1> %ifdef USE_386
    67                              <1> 	mov		eax, [es:BIOS_DISK_INTERRUPT_13h*4]	; Load old INT 13h vector
    68                              <1> 	mov		[RAMVARS.fpMFMint13h], eax			; Store old INT 13h vector
    69                              <1> %else
    70                              <1> 	mov		ax, [es:BIOS_DISK_INTERRUPT_13h*4+2]; Load old INT 13h segment
    71                              <1> 	mov		[RAMVARS.fpMFMint13h+2], ax			; Store old INT 13h segment
    72                              <1> 	xchg	dx, ax
    73                              <1> 	mov		ax, [es:BIOS_DISK_INTERRUPT_13h*4]	; Load old INT 13h offset
    74                              <1> 	mov		[RAMVARS.fpMFMint13h], ax			; Store old INT 13h offset
    75                              <1> %endif ; USE_386
    76                              <1> 
    77                              <1> 	mov		[RAMVARS.fpOldI13h+2], cs
    78                              <1> 	mov		WORD [RAMVARS.fpOldI13h], Int13hMFMcompatibilityHandler
    79                              <1> %else ; ~MODULE_MFM_COMPATIBILITY
    80                              <1> %ifdef USE_386
    81 0000045D 2666A14C00          <1> 	mov		eax, [es:BIOS_DISK_INTERRUPT_13h*4]	; Load old INT 13h vector
    82 00000462 66A30000            <1> 	mov		[RAMVARS.fpOldI13h], eax			; Store old INT 13h vector
    83                              <1> %else
    84                              <1> 	mov		ax, [es:BIOS_DISK_INTERRUPT_13h*4+2]; Load old INT 13h segment
    85                              <1> 	mov		[RAMVARS.fpOldI13h+2], ax			; Store old INT 13h segment
    86                              <1> 	xchg	dx, ax
    87                              <1> 	mov		ax, [es:BIOS_DISK_INTERRUPT_13h*4]	; Load old INT 13h offset
    88                              <1> 	mov		[RAMVARS.fpOldI13h], ax				; Store old INT 13h offset
    89                              <1> %endif ; USE_386
    90                              <1> %endif
    91                              <1> 
    92                              <1> 	; Only store INT 13h handler to 40h if 40h is not already installed.
    93                              <1> 	; At least AMI BIOS for 286 stores 40h handler by itself and calls
    94                              <1> 	; 40h from 13h. That system locks to infinite loop if we blindly copy 13h to 40h.
    95 00000466 E80001              <1> 	call	FloppyDrive_IsInt40hInstalled
    96 00000469 7205                <1> 	jc		SHORT .Int40hAlreadyInstalled
    97                              <1> %ifdef USE_386
    98 0000046B 2666A30001          <1> 	mov		[es:BIOS_DISKETTE_INTERRUPT_40h*4], eax		; Store old INT 13h vector
    99                              <1> %else
   100                              <1> 	mov		[es:BIOS_DISKETTE_INTERRUPT_40h*4], ax		; Store old INT 13h offset
   101                              <1> 	mov		[es:BIOS_DISKETTE_INTERRUPT_40h*4+2], dx	; Store old INT 13h segment
   102                              <1> %endif
   103                              <1> .Int40hAlreadyInstalled:
   104                              <1> 
   105                              <1> %ifdef USE_386
   106 00000470 6658                <1> 	pop		eax			; Restore the high WORD of EAX
   107                              <1> %endif
   108                              <1> 
   109 00000472 B013                <1> 	mov		al, BIOS_DISK_INTERRUPT_13h			; INT 13h interrupt vector offset
   110                              <1> %ifdef RELOCATE_INT13H_STACK
   111                              <1> 	mov		si, Int13h_DiskFunctionsHandlerWithStackChange
   112                              <1> %else
   113 00000474 BE[DC17]            <1> 	mov		si, Int13h_DiskFunctionsHandler
   114                              <1> %endif
   115                              <1> 
   116                              <1> %ifndef MODULE_IRQ
   117                              <1> 	; Fall to Interrupts_InstallHandlerToVectorInALFromCSSI
   118                              <1> %else
   119 00000477 E82600              <1> 	call	Interrupts_InstallHandlerToVectorInALFromCSSI
   120                              <1> 	; Fall to .InitializeHardwareIrqHandlers
   121                              <1> 
   122                              <1> ;--------------------------------------------------------------------
   123                              <1> ; .InitializeHardwareIrqHandlers
   124                              <1> ;	Parameters:
   125                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   126                              <1> ;	Returns:
   127                              <1> ;		Nothing
   128                              <1> ;	Corrupts registers:
   129                              <1> ;		BX, CX, DX, SI, DI, AX
   130                              <1> ;--------------------------------------------------------------------
   131                              <1> .InitializeHardwareIrqHandlers:
   132 0000047A E8BB00              <1> 	call	RamVars_GetIdeControllerCountToCX
   133 0000047D BF5300              <1> 	mov		di, ROMVARS.ideVars0+IDEVARS.bIRQ
   134                              <1> .IdeControllerLoop:
   135 00000480 2E8A05              <1> 	mov		al, [cs:di]
   136 00000483 83C712              <1> 	add		di, BYTE IDEVARS_size			; Increment to next controller
   137 00000486 E80300              <1> 	call	.InstallLowOrHighIrqHandler
   138 00000489 E2F5                <1> 	loop	.IdeControllerLoop
   139                              <1> .Return:
   140 0000048B C3                  <1> 	ret		; This ret is shared with .InstallLowOrHighIrqHandler
   141                              <1> 
   142                              <1> ;--------------------------------------------------------------------
   143                              <1> ; .InstallLowOrHighIrqHandler
   144                              <1> ;	Parameters:
   145                              <1> ;		AL:		IRQ number, 0 if IRQ disabled
   146                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   147                              <1> ;	Returns:
   148                              <1> ;		Nothing
   149                              <1> ;	Corrupts registers:
   150                              <1> ;		BX, SI
   151                              <1> ;--------------------------------------------------------------------
   152                              <1> .InstallLowOrHighIrqHandler:
   153 0000048C 84C0                <1> 	test	al, al
   154 0000048E 74FB                <1> 	jz		SHORT .Return	; IRQ not used
   155                              <1> %ifdef USE_AT
   156 00000490 3C08                <1> 	cmp		al, 8
   157 00000492 7207                <1> 	jb		SHORT .InstallLowIrqHandler
   158                              <1> 	; Fall to .InstallHighIrqHandler
   159                              <1> 
   160                              <1> ;--------------------------------------------------------------------
   161                              <1> ; .InstallHighIrqHandler
   162                              <1> ;	Parameters:
   163                              <1> ;		BX:		IRQ number (8...15)
   164                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   165                              <1> ;	Returns:
   166                              <1> ;		Nothing
   167                              <1> ;	Corrupts registers:
   168                              <1> ;		AL, BX, SI
   169                              <1> ;--------------------------------------------------------------------
   170                              <1> .InstallHighIrqHandler:
   171 00000494 0468                <1> 	add		al, BYTE HARDWARE_IRQ_8_INTERRUPT_70h - 8	; Interrupt vector number
   172 00000496 BE[C815]            <1> 	mov		si, IdeIrq_InterruptServiceRoutineForIrqs8to15
   173 00000499 EB05                <1> 	jmp		SHORT Interrupts_InstallHandlerToVectorInALFromCSSI
   174                              <1> %endif ; USE_AT
   175                              <1> 
   176                              <1> ;--------------------------------------------------------------------
   177                              <1> ; .InstallLowIrqHandler
   178                              <1> ;	Parameters:
   179                              <1> ;		AL:		IRQ number (0...7)
   180                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   181                              <1> ;	Returns:
   182                              <1> ;		Nothing
   183                              <1> ;	Corrupts registers:
   184                              <1> ;		AL, BX, SI
   185                              <1> ;--------------------------------------------------------------------
   186                              <1> .InstallLowIrqHandler:
   187 0000049B 0408                <1> 	add		al, BYTE HARDWARE_IRQ_0_INTERRUPT_08h		; Interrupt vector number
   188 0000049D BE[C015]            <1> 	mov		si, IdeIrq_InterruptServiceRoutineForIrqs2to7
   189                              <1> 	; Fall to Interrupts_InstallHandlerToVectorInALFromCSSI
   190                              <1> %endif ; MODULE_IRQ
   191                              <1> 
   192                              <1> 
   193                              <1> ;--------------------------------------------------------------------
   194                              <1> ; Interrupts_InstallHandlerToVectorInALFromCSSI
   195                              <1> ;	Parameters:
   196                              <1> ;		AL:		Interrupt vector number (for example 13h)
   197                              <1> ;		ES:		BDA and Interrupt Vector segment (zero)
   198                              <1> ;		CS:SI:	Ptr to interrupt handler
   199                              <1> ;	Returns:
   200                              <1> ;		Nothing
   201                              <1> ;	Corrupts registers:
   202                              <1> ;		AX, BX
   203                              <1> ;--------------------------------------------------------------------
   204                              <1> Interrupts_InstallHandlerToVectorInALFromCSSI:
   205 000004A0 B304                <1> 	mov		bl, 4					; Shift for DWORD offset, MUL smaller than other alternatives
   206 000004A2 F6E3                <1> 	mul		bl
   207 000004A4 93                  <1> 	xchg	ax, bx
   208 000004A5 FA                  <1> 	cli
   209 000004A6 268937              <1> 	mov		[es:bx], si				; Store offset
   210 000004A9 268C4F02            <1> 	mov		[es:bx+2], cs			; Store segment
   211 000004AD FB                  <1> 	sti
   212                              <1> .Interrupts_Return:
   213 000004AE C3                  <1> 	ret
   214                              <1> 
