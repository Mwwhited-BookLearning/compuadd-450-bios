    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Checks if drive is handled by this BIOS, and return DPT pointer.
    25                              <1> ;
    26                              <1> ; FindDPT_ForDriveNumberInDL
    27                              <1> ;	Parameters:
    28                              <1> ;		DL:		Drive number
    29                              <1> ;		DS:		RAMVARS segment
    30                              <1> ;	Returns:
    31                              <1> ;		CF:		Cleared if drive is handled by this BIOS
    32                              <1> ;				Set if drive belongs to some other BIOS
    33                              <1> ;		DI:		DPT Pointer if drive is handled by this BIOS
    34                              <1> ;				Zero if drive belongs to some other BIOS
    35                              <1> ;	Corrupts registers:
    36                              <1> ;		Nothing
    37                              <1> ;--------------------------------------------------------------------
    38 00000652 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    39                              <1> FindDPT_ForDriveNumberInDL:
    40 00000654 97                  <1> 	xchg	di, ax								; Save the contents of AX in DI
    41                              <1> 
    42                              <1> ;
    43                              <1> ; Check Our Hard Disks
    44                              <1> ;
    45 00000655 A10A00              <1> 	mov		ax, [RAMVARS.wFirstDrvAndCount]		; Drive count to AH, First number to AL
    46 00000658 00C4                <1> 	add		ah, al								; One past last drive to AH
    47                              <1> 
    48                              <1> %ifdef MODULE_SERIAL_FLOPPY
    49 0000065A 38E2                <1> 	cmp		dl, ah								; Above last supported?
    50 0000065C 7306                <1> 	jae		SHORT .HardDiskNotHandledByThisBIOS
    51                              <1> 
    52 0000065E 38C2                <1> 	cmp		dl, al								; Below first supported?
    53 00000660 7312                <1> 	jae		SHORT .CalcDPTForDriveNumber
    54                              <1> 
    55 00000662 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    56                              <1> .HardDiskNotHandledByThisBIOS:
    57                              <1> ;
    58                              <1> ; Check Our Floppy Disks
    59                              <1> ;
    60 00000664 E8C9FE              <1> 	call	RamVars_UnpackFlopCntAndFirstToAL
    61 00000667 7827                <1> 	js		SHORT .DiskIsNotHandledByThisBIOS
    62                              <1> 
    63 00000669 98                  <1> 	cbw											; Always 0h (no floppy drive covered above)
    64 0000066A 10C4                <1> 	adc		ah, al								; Add in first drive number and number of drives
    65                              <1> 
    66 0000066C 38D4                <1> 	cmp		ah, dl								; Check second drive if two, first drive if only one
    67 0000066E 7404                <1> 	je		SHORT .CalcDPTForDriveNumber
    68 00000670 38D0                <1> 	cmp		al, dl								; Check first drive in all cases, redundant but OK to repeat
    69 00000672 751C                <1> 	jne		SHORT .DiskIsNotHandledByThisBIOS
    70                              <1> %else
    71                              <1> 	cmp		dl, ah								; Above last supported?
    72                              <1> 	jae		SHORT .DiskIsNotHandledByThisBIOS
    73                              <1> 
    74                              <1> 	cmp		dl, al								; Below first supported?
    75                              <1> 	jb		SHORT .DiskIsNotHandledByThisBIOS
    76                              <1> %endif
    77                              <1> 	; Fall to .CalcDPTForDriveNumber
    78                              <1> 
    79                              <1> ;--------------------------------------------------------------------
    80                              <1> ; Finds Disk Parameter Table for drive number.
    81                              <1> ; Not intended to be called except by FindDPT_ForDriveNumberInDL
    82                              <1> ;
    83                              <1> ; .CalcDPTForDriveNumber
    84                              <1> ;	Parameters:
    85                              <1> ;		DL:		Drive number
    86                              <1> ;		DS:		RAMVARS segment
    87                              <1> ;		DI:		Saved copy of AX from entry at FindDPT_ForDriveNumberInDL
    88                              <1> ;	Returns:
    89                              <1> ;		DS:DI:	Ptr to DPT
    90                              <1> ;		CF:		Clear
    91                              <1> ;	Corrupts registers:
    92                              <1> ;		Nothing
    93                              <1> ;--------------------------------------------------------------------
    94                              <1> ALIGN JUMP_ALIGN
    95                              <1> .CalcDPTForDriveNumber:
    96 00000674 52                  <1> 	push	dx
    97                              <1> 
    98                              <1> %ifdef MODULE_SERIAL_FLOPPY
    99 00000675 A10A00              <1> 	mov		ax, [RAMVARS.wFirstDrvAndCount]
   100                              <1> 
   101 00000678 84D2                <1> 	test	dl, dl
   102 0000067A 7808                <1> 	js		SHORT .Harddisk
   103                              <1> 
   104 0000067C E8B1FE              <1> 	call	RamVars_UnpackFlopCntAndFirstToAL
   105 0000067F 00E2                <1> 	add		dl, ah						; add in end of hard disk DPT list, floppies start immediately after
   106                              <1> 
   107 00000681 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   108                              <1> .Harddisk:
   109 00000684 28C2                <1> 	sub		dl, al						; subtract off beginning of either hard disk or floppy list (as appropriate)
   110                              <1> %else
   111                              <1> 	sub		dl, [RAMVARS.bFirstDrv]		; subtract off beginning of hard disk list
   112                              <1> %endif
   113                              <1> 
   114                              <1> .CalcDPTForNewDrive:
   115 00000686 B01E                <1> 	mov		al, LARGEST_DPT_SIZE
   116 00000688 F6E2                <1> 	mul		dl
   117 0000068A 83C010              <1> 	add		ax, RAMVARS_size			; Clears CF (will not overflow)
   118                              <1> 
   119 0000068D 5A                  <1> 	pop		dx
   120                              <1> 
   121 0000068E 97                  <1> 	xchg	di, ax						; Restore AX from entry at FindDPT_ForDriveNumber, put DPT pointer in DI
   122 0000068F C3                  <1> 	ret
   123                              <1> 
   124                              <1> ALIGN JUMP_ALIGN
   125                              <1> .DiskIsNotHandledByThisBIOS:
   126                              <1> ;
   127                              <1> ; Drive not found...
   128                              <1> ;
   129 00000690 31C0                <1> 	xor		ax, ax								; Clear DPT pointer
   130 00000692 F9                  <1> 	stc											; Is not supported by our BIOS
   131                              <1> 
   132 00000693 97                  <1> 	xchg	di, ax								; Restore AX from save at top
   133 00000694 C3                  <1> 	ret
   134                              <1> 
   135                              <1> 
   136                              <1> ;--------------------------------------------------------------------
   137                              <1> ; Iteration routines for FindDPT_MasterOrSingleForIdevarsOffsetInDL and
   138                              <1> ; FindDPT_SlaveForIdevarsOffsetInDL, for use with FindDPT_IterateAllDPTs
   139                              <1> ;
   140                              <1> ; Returns when DPT is found on the controller with Idevars offset in DL
   141                              <1> ;
   142                              <1> ; IterateFindSecondDPTforIdevars
   143                              <1> ; IterateFindFirstDPTforIdevars
   144                              <1> ;		DL:		Offset to IDEVARS to search from DPTs
   145                              <1> ;		SI:		Offset to this callback function
   146                              <1> ;		DS:DI:	Ptr to DPT to examine
   147                              <1> ;	Returns:
   148                              <1> ;		CF:		Cleared if wanted DPT found
   149                              <1> ;				Set if wrong DPT
   150                              <1> ;--------------------------------------------------------------------
   151                              <1> IterateFindSecondDPTforIdevars:
   152 00000695 E80700              <1> 	call	IterateFindFirstDPTforIdevars
   153 00000698 7204                <1> 	jc		SHORT WrongController
   154 0000069A BE[9F06]            <1> 	mov		si, IterateFindFirstDPTforIdevars
   155                              <1> SetCFandReturn:
   156 0000069D F9                  <1> 	stc
   157                              <1> WrongController:
   158 0000069E C3                  <1> 	ret
   159                              <1> 
   160                              <1> IterateFindFirstDPTforIdevars:
   161 0000069F 3A5502              <1> 	cmp		dl, [di+DPT.bIdevarsOffset]			; Clears CF if matched
   162 000006A2 75F9                <1> 	jne		SHORT SetCFandReturn
   163 000006A4 C3                  <1> 	ret
   164                              <1> 
   165                              <1> 
   166                              <1> ;--------------------------------------------------------------------
   167                              <1> ; Finds pointer to first unused Disk Parameter Table.
   168                              <1> ; Should only be used before DetectDrives is complete (not valid after this time).
   169                              <1> ;
   170                              <1> ; FindDPT_ForNewDriveToDSDI
   171                              <1> ;	Parameters:
   172                              <1> ;		DS:		RAMVARS segment
   173                              <1> ;	Returns:
   174                              <1> ;		DS:DI:	Ptr to first unused DPT
   175                              <1> ;	Corrupts registers:
   176                              <1> ;		AX
   177                              <1> ;--------------------------------------------------------------------
   178 000006A5 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   179                              <1> FindDPT_ForNewDriveToDSDI:
   180 000006A8 52                  <1> 	push	dx
   181                              <1> 
   182                              <1> %ifdef MODULE_SERIAL_FLOPPY
   183 000006A9 8B160B00            <1> 	mov		dx, [RAMVARS.wDrvCntAndFlopCnt]
   184 000006AD 00F2                <1> 	add		dl, dh
   185                              <1> %else
   186                              <1> 	mov		dl, [RAMVARS.bDrvCnt]
   187                              <1> %endif
   188                              <1> 
   189 000006AF EBD5                <1> 	jmp		SHORT FindDPT_ForDriveNumberInDL.CalcDPTForNewDrive
   190                              <1> 
   191                              <1> ;--------------------------------------------------------------------
   192                              <1> ; IterateToDptWithFlagsHighInBL
   193                              <1> ;	Parameters:
   194                              <1> ;		DS:DI:	Ptr to DPT to examine
   195                              <1> ;		BL:		Bit(s) to test in DPT.bFlagsHigh
   196                              <1> ;	Returns:
   197                              <1> ;		CF:		Cleared if wanted DPT found
   198                              <1> ;				Set if wrong DPT
   199                              <1> ;	Corrupts registers:
   200                              <1> ;		Nothing
   201                              <1> ;--------------------------------------------------------------------
   202                              <1> %ifdef MODULE_SERIAL
   203 000006B1 90<rep 3h>          <1> ALIGN JUMP_ALIGN
   204                              <1> IterateToDptWithFlagsHighInBL:
   205 000006B4 845D01              <1> 	test	[di+DPT.bFlagsHigh], bl				; Clears CF
   206 000006B7 7501                <1> 	jnz		SHORT .ReturnRightDPT
   207 000006B9 F9                  <1> 	stc
   208                              <1> .ReturnRightDPT:
   209 000006BA C3                  <1> 	ret
   210                              <1> %endif
   211                              <1> 
   212                              <1> ;--------------------------------------------------------------------
   213                              <1> ; FindDPT_ToDSDIforSerialDevice
   214                              <1> ;	Parameters:
   215                              <1> ;		DS:		RAMVARS segment
   216                              <1> ;	Returns:
   217                              <1> ;		DS:DI:	Ptr to DPT
   218                              <1> ;		CF:		Cleared if wanted DPT found
   219                              <1> ;				Set if DPT not found, or no DPTs present
   220                              <1> ;	Corrupts registers:
   221                              <1> ;		BL, SI
   222                              <1> ;--------------------------------------------------------------------
   223                              <1> %ifdef MODULE_SERIAL
   224 000006BB 90                  <1> ALIGN JUMP_ALIGN
   225                              <1> FindDPT_ToDSDIforSerialDevice:
   226 000006BC B304                <1> 	mov		bl, FLGH_DPT_SERIAL_DEVICE
   227                              <1> 	; Fall to FindDPT_ToDSDIforFlagsHighInBL
   228                              <1> %endif
   229                              <1> 
   230                              <1> ;--------------------------------------------------------------------
   231                              <1> ; FindDPT_ToDSDIforFlagsHighInBL
   232                              <1> ;	Parameters:
   233                              <1> ;		DS:		RAMVARS segment
   234                              <1> ;		BL:		Bit(s) to test in DPT.bFlagsHigh
   235                              <1> ;	Returns:
   236                              <1> ;		DS:DI:	Ptr to DPT
   237                              <1> ;		CF:		Cleared if wanted DPT found
   238                              <1> ;				Set if DPT not found, or no DPTs present
   239                              <1> ;	Corrupts registers:
   240                              <1> ;		SI
   241                              <1> ;--------------------------------------------------------------------
   242                              <1> %ifdef MODULE_SERIAL
   243                              <1> ;%ifdef MODULE_IRQ
   244                              <1> ;ALIGN JUMP_ALIGN
   245                              <1> ;FindDPT_ToDSDIforFlagsHighInBL:	; This label is unused
   246                              <1> ;%endif
   247 000006BE BE[B406]            <1> 	mov		si, IterateToDptWithFlagsHighInBL
   248 000006C1 EB09                <1> 	jmp		SHORT FindDPT_IterateAllDPTs
   249                              <1> %endif
