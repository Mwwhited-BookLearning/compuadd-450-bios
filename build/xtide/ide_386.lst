    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Initializes the BIOS.
    25                              <1> ; This function is called from main BIOS ROM search routine.
    26                              <1> ;
    27                              <1> ; Initialize_FromMainBiosRomSearch
    28                              <1> ;	Parameters:
    29                              <1> ;		Nothing
    30                              <1> ;	Returns:
    31                              <1> ;		Nothing
    32                              <1> ;	Corrupts registers:
    33                              <1> ;		Nothing
    34                              <1> ;--------------------------------------------------------------------
    35                              <1> Initialize_FromMainBiosRomSearch:		; unused entrypoint ok
    36 00000401 9C                  <1> 	pushf								; To store IF
    37 00000402 FB                  <1> 	sti									; Enable interrupts for keystrokes
    38 00000403 1E                  <1> 	push	ds
    39 00000404 50                  <1> 	push	ax							; We use AX to install very late init handler
    40                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184                              <2>  xor %2, %2
   185                              <2>  mov %1, %2
   186                              <2> %else
   187 00000405 6A00                <2>  push BYTE 0
   188 00000407 1F                  <2>  pop %1
   189                              <2> %endif
    41                              <1> 
    42 00000408 F606170404          <1> 	test	BYTE [BDA.bKBFlgs1], (1<<2)	; Clears ZF if CTRL is held down
    43 0000040D 750A                <1> 	jnz		SHORT .SkipRomInitialization
    44                              <1> 
    45                              <1> 	; Install INT 19h handler (boot loader) where drives are detected
    46 0000040F C7066400[EB0C]      <1> 	mov		WORD [BIOS_BOOT_LOADER_INTERRUPT_19h*4], Int19h_BootLoaderHandler
    47 00000415 8C0E6600            <1> 	mov		[BIOS_BOOT_LOADER_INTERRUPT_19h*4+2], cs
    48                              <1> 
    49                              <1> %ifdef MODULE_VERY_LATE_INIT
    50                              <1> 	push	es
    51                              <1> 	; Install special INT 13h handler that initializes XTIDE Universal BIOS
    52                              <1> 	; when our INT 19h is not called
    53                              <1> 	les		ax, [BIOS_DISK_INTERRUPT_13h*4]	; Load system INT 13h handler
    54                              <1> 	mov		WORD [BIOS_DISK_INTERRUPT_13h*4], Int13hBiosInit_Handler
    55                              <1> 	mov		[BIOS_DISK_INTERRUPT_13h*4+2], cs
    56                              <1> 	mov		[TEMPORARY_VECTOR_FOR_SYSTEM_INT13h*4], ax
    57                              <1> 	mov		[TEMPORARY_VECTOR_FOR_SYSTEM_INT13h*4+2], es
    58                              <1> 	pop		es
    59                              <1> %endif
    60                              <1> 
    61                              <1> .SkipRomInitialization:
    62 00000419 58                  <1> 	pop		ax
    63 0000041A 1F                  <1> 	pop		ds
    64 0000041B 9D                  <1> 	popf
    65 0000041C CB                  <1> 	retf
    66                              <1> 
    67                              <1> 
    68                              <1> ;--------------------------------------------------------------------
    69                              <1> ; Initializes the BIOS variables and detects IDE drives.
    70                              <1> ;
    71                              <1> ; Initialize_AndDetectDrives
    72                              <1> ;	Parameters:
    73                              <1> ;		ES:		BDA Segment
    74                              <1> ;	Returns:
    75                              <1> ;		DS:		RAMVARS segment
    76                              <1> ;	Corrupts registers:
    77                              <1> ;		All, except ES
    78                              <1> ;--------------------------------------------------------------------
    79                              <1> Initialize_AndDetectDrives:
    80 0000041D E86505              <1> 	call	DetectPrint_InitializeDisplayContext
    81 00000420 E8AD05              <1> 	call	DetectPrint_RomFoundAtSegment
    82 00000423 E8AF00              <1> 	call	RamVars_Initialize
    83 00000426 E82001              <1> 	call	BootVars_Initialize
    84                              <1> %ifdef MODULE_HOTKEYS
    85                              <1> 	; This is a simple fix for the so called "No Fixed Disk Present in FDISK"-bug introduced in r551. MODULE_HOTKEYS includes the internal
    86                              <1> 	; module MODULE_DRIVEXLATE which is needed if interrupt handlers are installed before drive detection. The reason for this is that
    87                              <1> 	; Interrupts_InitializeInterruptVectors won't install our interrupt 13h handler if no drives were detected (unless MODULE_DRIVEXLATE is included).
    88                              <1> 	; Since the drive detection hasn't been done yet, the handler will not be installed, causing the above mentioned bug.
    89 00000429 E82700              <1> 	call	Interrupts_InitializeInterruptVectors	; HotkeyBar requires INT 40h so install handlers before drive detection
    90 0000042C E87104              <1> 	call	DetectDrives_FromAllIDEControllers
    91                              <1> %else
    92                              <1> 	; Without MODULE_HOTKEYS (or actually MODULE_DRIVEXLATE) we *must* use this call order.
    93                              <1> 	call	DetectDrives_FromAllIDEControllers
    94                              <1> 	call	Interrupts_InitializeInterruptVectors
    95                              <1> %endif
    96 0000042F 8C060400            <1> 	mov		[RAMVARS.wDrvDetectSignature], es		; No longer in drive detection mode (set normal timeouts)
    97                              <1> 	; Fall to .StoreDptPointersToIntVectors
    98                              <1> 
    99                              <1> ;--------------------------------------------------------------------
   100                              <1> ; .StoreDptPointersToIntVectors
   101                              <1> ;	Parameters:
   102                              <1> ;		DS:		RAMVARS segment
   103                              <1> ;		ES:		BDA and interrupt vector segment (zero)
   104                              <1> ;	Returns:
   105                              <1> ;		Nothing
   106                              <1> ;	Corrupts registers:
   107                              <1> ;		AX, BX, CX, DX, SI, DI
   108                              <1> ;--------------------------------------------------------------------
   109                              <1> %ifdef MODULE_COMPATIBLE_TABLES
   110                              <1> .StoreDptPointersToIntVectors:
   111                              <1> %ifndef USE_AT
   112                              <1> 	test	BYTE [cs:ROMVARS.wFlags], FLG_ROMVARS_FULLMODE
   113                              <1> 	jz		SHORT .SkipToReturn				; Only Full operating mode has extra RAM to spare
   114                              <1> %endif
   115                              <1> 
   116 00000433 BB0401              <1> 	mov		bx, HD0_DPT_POINTER_41h * 4
   117 00000436 B280                <1> 	mov		dl, 80h
   118                              <1> .FindForNextDrive:
   119 00000438 E81902              <1> 	call	FindDPT_ForDriveNumberInDL		; DPT to DS:DI
   120 0000043B 720C                <1> 	jc		SHORT .NextDrive				; Store nothing if not our drive
   121                              <1> 
   122 0000043D 52                  <1> 	push	dx
   123 0000043E E8D505              <1> 	call	CompatibleDPT_CreateToAXSIforDriveDL
   124 00000441 5A                  <1> 	pop		dx
   125                              <1> 
   126 00000442 268937              <1> 	mov		[es:bx], si
   127 00000445 26894702            <1> 	mov		[es:bx+2], ax
   128                              <1> 
   129                              <1> .NextDrive:
   130 00000449 42                  <1> 	inc		dx
   131 0000044A 83C314              <1> 	add		bx, (HD1_DPT_POINTER_46h - HD0_DPT_POINTER_41h) * 4
   132 0000044D 80FA82              <1> 	cmp		dl, 82h
   133 00000450 72E6                <1> 	jb		SHORT .FindForNextDrive
   134                              <1> 
   135                              <1> .SkipToReturn:
   136                              <1> %endif ; MODULE_COMPATIBLE_TABLES
   137 00000452 C3                  <1> 	ret
   243                                  	%include "Interrupts.asm"		; For Interrupt initialization
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Functions for initializing the BIOS.
