   216                              <1> %ifdef MODULE_IRQ
   217                              <1> ;--------------------------------------------------------------------
   218                              <1> ; Interrupts_UnmaskInterruptControllerForDriveInDSDI
   219                              <1> ;	Parameters:
   220                              <1> ;		DS:DI:	Ptr to DPT
   221                              <1> ;	Returns:
   222                              <1> ;		Nothing
   223                              <1> ;	Corrupts registers:
   224                              <1> ;		AX, BX, DX
   225                              <1> ;--------------------------------------------------------------------
   226                              <1> Interrupts_UnmaskInterruptControllerForDriveInDSDI:
   227                              <1> 	eMOVZX	bx, BYTE [di+DPT.bIdevarsOffset]	; Clears CF on pre-386 CPUs
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 000004AF 0FB65D02            <2>  movzx %1, %2
   438                              <2> %endif
   228                              <1> %ifndef USE_386
   229                              <1> %ifdef USE_UNDOC_INTEL
   230                              <1> 	salc
   231                              <1> 	or		al, [cs:bx+IDEVARS.bIRQ]
   232                              <1> %else
   233                              <1> 	mov		al, [cs:bx+IDEVARS.bIRQ]
   234                              <1> 	test	al, al
   235                              <1> %endif
   236                              <1> %else ; USE_386
   237 000004B3 2E8A4705            <1> 	mov		al, [cs:bx+IDEVARS.bIRQ]
   238 000004B7 84C0                <1> 	test	al, al
   239                              <1> %endif
   240 000004B9 7419                <1> 	jz		SHORT .Return	; Interrupts disabled
   241 000004BB 3C08                <1> 	cmp		al, 8
   242 000004BD 720A                <1> 	jb		SHORT .UnmaskLowIrqController
   243                              <1> 	; Fall to .UnmaskHighIrqController
   244                              <1> 
   245                              <1> ;--------------------------------------------------------------------
   246                              <1> ; .UnmaskHighIrqController
   247                              <1> ;	Parameters:
   248                              <1> ;		AL:		IRQ number (8...15)
   249                              <1> ;	Returns:
   250                              <1> ;		Nothing
   251                              <1> ;	Corrupts registers:
   252                              <1> ;		AX, DX
   253                              <1> ;--------------------------------------------------------------------
   254                              <1> .UnmaskHighIrqController:
   255 000004BF 2C08                <1> 	sub		al, 8				; Slave interrupt number
   256 000004C1 BAA100              <1> 	mov		dx, SLAVE_8259_IMR
   257 000004C4 E80500              <1> 	call	.ClearBitFrom8259MaskRegister
   258 000004C7 B002                <1> 	mov		al, 2				; Master IRQ 2 to allow slave IRQs
   259                              <1> 	; Fall to .UnmaskLowIrqController
   260                              <1> 
   261                              <1> ;--------------------------------------------------------------------
   262                              <1> ; .UnmaskLowIrqController
   263                              <1> ;	Parameters:
   264                              <1> ;		AL:		IRQ number (0...7)
   265                              <1> ;	Returns:
   266                              <1> ;		Nothing
   267                              <1> ;	Corrupts registers:
   268                              <1> ;		AX, DX
   269                              <1> ;--------------------------------------------------------------------
   270                              <1> .UnmaskLowIrqController:
   271 000004C9 BA2100              <1> 	mov		dx, MASTER_8259_IMR
   272                              <1> 	; Fall to .ClearBitFrom8259MaskRegister
   273                              <1> 
   274                              <1> ;--------------------------------------------------------------------
   275                              <1> ; .ClearBitFrom8259MaskRegister
   276                              <1> ;	Parameters:
   277                              <1> ;		AL:		8259 interrupt index (0...7)
   278                              <1> ;		DX:		Port address to Interrupt Mask Register
   279                              <1> ;	Returns:
   280                              <1> ;		Nothing
   281                              <1> ;	Corrupts registers:
   282                              <1> ;		AX
   283                              <1> ;--------------------------------------------------------------------
   284                              <1> .ClearBitFrom8259MaskRegister:
   285 000004CC 51                  <1> 	push	cx
   286 000004CD 91                  <1> 	xchg	cx, ax				; IRQ index to CL
   287 000004CE EC                  <1> 	in		al, dx				; Read Interrupt Mask Register
   288                              <1> %ifdef USE_NEC_V
   289                              <1> 	eCLR1	al, cl				; Clear wanted bit
   290                              <1> %elifdef USE_386
   291 000004CF 0FB3C8              <1> 	btr		ax, cx				; Clear wanted bit
   292                              <1> %else
   293                              <1> 	mov		ch, ~1				; Load bit mask to be rotated
   294                              <1> 	rol		ch, cl				; Rotate mask to correct position for clearing
   295                              <1> 	and		al, ch				; Clear wanted bit
   296                              <1> %endif
   297 000004D2 EE                  <1> 	out		dx, al				; Write modified Interrupt Mask Register
   298 000004D3 59                  <1> 	pop		cx
   299                              <1> .Return:
   300 000004D4 C3                  <1> 	ret
   301                              <1> 
   302                              <1> %endif ; MODULE_IRQ
