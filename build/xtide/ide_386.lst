    87                              <2> ;--------------------------------------------------------------------
    88                              <2> ; Registers_NormalizeESSI
    89                              <2> ; Registers_NormalizeESDI
    90                              <2> ;	Parameters
    91                              <2> ;		DS:SI or ES:DI:	Ptr to normalize
    92                              <2> ;	Returns:
    93                              <2> ;		DS:SI or ES:DI:	Normalized pointer
    94                              <2> ;	Corrupts registers:
    95                              <2> ;		AX, CX
    96                              <2> ;
    97                              <2> ; Inline of NORMALIZE_FAR_POINTER so that we can share the last 2/3 of the
    98                              <2> ; routine with Registers_NormalizeFinish.
    99                              <2> ;
   100                              <2> ;--------------------------------------------------------------------
   101                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_XTIDECFG
   102                              <2> ALIGN JUMP_ALIGN
   103                              <2> Registers_NormalizeESSI:
   104                              <2> 	mov			cx, si
   105                              <2> 	and			si, BYTE 0Fh
   106                              <2> 	jmp			SHORT Registers_NormalizeFinish
   107                              <2> 
   108                              <2> ALIGN JUMP_ALIGN
   109                              <2> Registers_NormalizeESDI:
   110                              <2> 	mov			cx, di
   111                              <2> 	and			di, BYTE 0Fh
   112                              <2> ;;; fall-through
   113                              <2> 
   114                              <2> ALIGN JUMP_ALIGN
   115                              <2> Registers_NormalizeFinish:
   116                              <2> 	eSHR_IM		cx, 4
   117                              <2> 	mov			ax, es
   118                              <2> 	add			ax, cx
   119                              <2> 	mov			es, ax
   120                              <2> 	ret
   121                              <2> %endif
   122                              <2> 
