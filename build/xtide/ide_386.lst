   107                              <1> ;--------------------------------------------------------------------
   108                              <1> ; IdeIO_OutputALtoIdeControlBlockRegisterInDL
   109                              <1> ;	Parameters:
   110                              <1> ;		AL:		Byte to output
   111                              <1> ;		DL:		IDE Control Block Register
   112                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   113                              <1> ;	Returns:
   114                              <1> ;		Nothing
   115                              <1> ;	Corrupts registers:
   116                              <1> ;		BX, DX
   117                              <1> ;--------------------------------------------------------------------
   118                              <1> IdeIO_OutputALtoIdeControlBlockRegisterInDL:
   119 00001570 30F6                <1> 	xor		dh, dh	; IDE Register index now in DX
   120 00001572 8A5D14              <1> 	mov		bl, [di+DPT_ATA.bDevice]
   121 00001575 80FB0A              <1> 	cmp		bl, DEVICE_8BIT_XTIDE_REV2
   122 00001578 720C                <1> 	jb		SHORT .OutputALtoControlBlockRegisterInDX	; Standard IDE controllers, Juko D16-X and XTIDE rev 1
   123                              <1> 
   124                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
   125                              <1> 	cmp		bl, DEVICE_8BIT_XTIDE_REV2_OLIVETTI
   126                              <1> 	jbe		SHORT .ReverseA0andA3fromRegisterIndexInDX
   127                              <1> 
   128                              <1> 	; At this point remaining controllers (JRIDE, XTCF and ADP50L) all have a control
   129                              <1> 	; block offset of 8 or (8<<1) so we add 8 here and do the SHL 1 later if needed.
   130                              <1> 	add		dx, BYTE 8
   131                              <1> 	cmp		bl, DEVICE_8BIT_JRIDE_ISA
   132                              <1> 	jb		SHORT IdeIO_OutputALtoIdeRegisterInDL.ShlRegisterIndexInDXandOutputAL	; All XT-CF modes
   133                              <1> 	mov		bx, JRIDE_CONTROL_BLOCK_REGISTER_WINDOW_OFFSET - 8			; Zeroes BL. -8 compensates for the ADD
   134                              <1> 	je		SHORT IdeIO_OutputALtoIdeRegisterInDL.OutputALtoMemoryMappedRegisterInDXwithWindowOffsetInBX
   135                              <1> 	; The commented instructions below shows what happens next (saved for clarity) but as an optimization
   136                              <1> 	; we can accomplish the same thing with this jump.
   137                              <1> 	jmp		SHORT IdeIO_OutputALtoIdeRegisterInDL.ShlDXandMovHighByteOfADP50LoffsetsToBH
   138                              <1> ;	eSHL_IM	dx, 1
   139                              <1> ;	mov		bh, (ADP50L_CONTROL_BLOCK_REGISTER_WINDOW_OFFSET - 16) >> 8	; -16 compensates for the ADD and SHL
   140                              <1> ;	jmp 	SHORT IdeIO_OutputALtoIdeRegisterInDL.OutputALtoMemoryMappedRegisterInDXwithWindowOffsetInBX
   141                              <1> %endif
   142                              <1> 
   143                              <1> .ReverseA0andA3fromRegisterIndexInDX:
   144                              <1> 	; We cannot use lookup table since A3 will be always set because
   145                              <1> 	; Control Block Registers start from Command Block + 8h. We can do
   146                              <1> 	; a small trick since we only access Device Control Register at
   147                              <1> 	; offset 6h: Always clear A3 and set A0.
   148 0000157A E89CF1              <1> 	call	AccessDPT_GetIdevarsToCSBX
   149 0000157D 2E035702            <1> 	add		dx, [cs:bx+IDEVARS.wControlBlockPort]
   150 00001581 80F209              <1> 	xor		dl, 1001b						; Clear A3, Set A0
   151 00001584 EE                  <1> 	out		dx, al
   152 00001585 C3                  <1> 	ret
   153                              <1> 
   154                              <1> .OutputALtoControlBlockRegisterInDX:
   155 00001586 E890F1              <1> 	call	AccessDPT_GetIdevarsToCSBX
   156 00001589 2E035702            <1> 	add		dx, [cs:bx+IDEVARS.wControlBlockPort]
   157 0000158D EE                  <1> 	out		dx, al
   158 0000158E C3                  <1> 	ret
   159                              <1> 
   160                              <1> 
   161                              <1> ;--------------------------------------------------------------------
   162                              <1> ; IdeIO_OutputALtoIdeRegisterInDL
   163                              <1> ;	Parameters:
   164                              <1> ;		AL:		Byte to output
   165                              <1> ;		DL:		IDE Command Block Register
   166                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   167                              <1> ;	Returns:
   168                              <1> ;		Nothing
   169                              <1> ;	Corrupts registers:
   170                              <1> ;		BX, DX
   171                              <1> ;--------------------------------------------------------------------
   172 0000158F 90                  <1> ALIGN JUMP_ALIGN
   173                              <1> IdeIO_OutputALtoIdeRegisterInDL:
   174 00001590 30F6                <1> 	xor		dh, dh	; IDE Register index now in DX
   175 00001592 8A5D14              <1> 	mov		bl, [di+DPT_ATA.bDevice]
   176 00001595 80FB0A              <1> 	cmp		bl, DEVICE_8BIT_XTIDE_REV2
   177 00001598 720A                <1> 	jb		SHORT OutputALtoRegisterInDX	; Standard IDE controllers, Juko D16-X and XTIDE rev 1
   178                              <1> 
   179                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
   180                              <1> 	cmp		bl, DEVICE_8BIT_XTIDE_REV2_OLIVETTI
   181                              <1> 	jbe		SHORT .ReverseA0andA3fromRegisterIndexInDX
   182                              <1> 
   183                              <1> 	cmp		bl, DEVICE_8BIT_JRIDE_ISA
   184                              <1> 	jb		SHORT .ShlRegisterIndexInDXandOutputAL	; All XT-CF modes
   185                              <1> 	mov		bx, JRIDE_COMMAND_BLOCK_REGISTER_WINDOW_OFFSET	; Zeroes BL
   186                              <1> 	je		SHORT .OutputALtoMemoryMappedRegisterInDXwithWindowOffsetInBX
   187                              <1> .ShlDXandMovHighByteOfADP50LoffsetsToBH:
   188                              <1> 	eSHL_IM	dx, 1
   189                              <1> 	mov		bh, ADP50L_COMMAND_BLOCK_REGISTER_WINDOW_OFFSET >> 8	; BL is zero so we only need to change BH
   190                              <1> 
   191                              <1> .OutputALtoMemoryMappedRegisterInDXwithWindowOffsetInBX:
   192                              <1> 	add		bx, dx
   193                              <1> 	push	ds
   194                              <1> 	mov		ds, [di+DPT.wBasePort]	; Segment for JR-IDE/ISA and ADP50L
   195                              <1> 	mov		[bx], al
   196                              <1> 	pop		ds
   197                              <1> 	ret
   198                              <1> %endif
   199                              <1> 
   200                              <1> .ReverseA0andA3fromRegisterIndexInDX:
   201                              <1> %if NOSWAPA0A3LOOKUPTABLE = 0
   202                              <1> ; 8 bytes plus the lookup table (8 bytes).
   203                              <1> 	mov		bx, dx
   204                              <1> 	mov		dl, [cs:bx+g_rgbSwapA0andA3fromIdeRegisterIndex]
   205                              <1> 	SKIP2B	bx	; Skip eSHL_IM dx, 1
   206                              <1> %elif NOSWAPA0A3LOOKUPTABLE = 1
   207                              <1> ; 9 bytes. No lookup table.
   208                              <1> 	test	dl, 1
   209                              <1> 	jz		SHORT OutputALtoRegisterInDX
   210                              <1> 	xor		dl, 1001b						; Set A3, Clear A0
   211                              <1> 	SKIP2B	bx	; Skip eSHL_IM dx, 1
   212                              <1> %else
   213                              <1> ; 7 bytes. No lookup table.
   214 0000159A D1EA                <1> 	shr		dx, 1
   215 0000159C 7303                <1> 	jnc		SHORT .ShlRegisterIndexInDXandOutputAL
   216 0000159E 83CA04              <1> 	or		dx, 4
   217                              <1> %endif
   218                              <1> 
   219                              <1> .ShlRegisterIndexInDXandOutputAL:
   220                              <1> 	eSHL_IM	dx, 1
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 000015A1 01D2                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   221                              <1> 	; Fall to OutputALtoRegisterInDX
   222                              <1> 
   223 000015A3 90                  <1> ALIGN JUMP_ALIGN
   224                              <1> OutputALtoRegisterInDX:
   225 000015A4 035504              <1> 	add		dx, [di+DPT.wBasePort]
   226 000015A7 EE                  <1> 	out		dx, al
   227 000015A8 C3                  <1> 	ret
   228                              <1> 
   229                              <1> 
   230                              <1> %if NOSWAPA0A3LOOKUPTABLE = 0
   231                              <1> ; A0 <-> A3 lookup table
   232                              <1> g_rgbSwapA0andA3fromIdeRegisterIndex:
   233                              <1> 	db	0000b	; <-> 0000b, 0
   234                              <1> 	db	1000b	; <-> 0001b, 1
   235                              <1> 	db	0010b	; <-> 0010b, 2
   236                              <1> 	db	1010b	; <-> 0011b, 3
   237                              <1> 	db	0100b	; <-> 0100b, 4
   238                              <1> 	db	1100b	; <-> 0101b, 5
   239                              <1> 	db	0110b	; <-> 0110b, 6
   240                              <1> 	db	1110b	; <-> 0111b, 7
   241                              <1> %endif
   242                              <1> 
   243                              <1> %undef NOSWAPA0A3LOOKUPTABLE
   244                              <1> 
