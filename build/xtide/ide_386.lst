    98                              <2> 	call	Keyboard_RemoveAllKeystrokesFromBuffer
    99                              <2> %endif
   100                              <2> 	call	Keyboard_GetKeystrokeToAXandWaitIfNecessary
   101                              <2> 	pop		ax
   102                              <2> %endmacro
