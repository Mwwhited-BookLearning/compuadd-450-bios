    28                              <2> ;--------------------------------------------------------------------
    29                              <2> ; Registers_ExchangeDSSIwithESDI
    30                              <2> ;	Parameters
    31                              <2> ;		Nothing
    32                              <2> ;	Returns:
    33                              <2> ;		DS:SI and ES:DI are exchanged.
    34                              <2> ;	Corrupts registers:
    35                              <2> ;		Nothing
    36                              <2> ;--------------------------------------------------------------------
    37                              <2> %ifndef EXCLUDE
    38 0000035A 90<rep 2h>          <2> ALIGN JUMP_ALIGN
    39                              <2> Registers_ExchangeDSSIwithESDI:
    40 0000035C 1E                  <2> 	push	ds
    41 0000035D 06                  <2> 	push	es
    42 0000035E 1F                  <2> 	pop		ds
    43 0000035F 07                  <2> 	pop		es
    44 00000360 87FE                <2> 	xchg	si, di
    45 00000362 C3                  <2> 	ret
    46                              <2> %endif
    47                              <2> %undef EXCLUDE
    48                              <2> 
