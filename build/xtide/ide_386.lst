    20                              <2> %ifndef EBIOS_INC
    21                              <2> %define EBIOS_INC
    22                              <2> 
    23                              <2> ; EBIOS specification returned by INT 13h, AH=41h
    24                              <2> 
    25                              <2> EDD_V1_1							EQU	21h		; 21h = EDD version 1.1
    26                              <2> EBIOS_VERSION						EQU	EDD_V1_1
    27                              <2> 
    28                              <2> ; Support bits returned by INT 13h, AH=41h
    29                              <2> ENHANCED_DRIVE_ACCESS_SUPPORT		EQU	(1<<0)	; 41h, 42h, 43h 44h, 47h and 48h are available
    30                              <2> DRIVE_LOCKING_AND_EJECTING_SUPPORT	EQU	(1<<1)	; 41h, 45h, 46h, 48h, 49h are available and INT 15h, AH=52h
    31                              <2> ENHANCED_DISK_DRIVE_SUPPORT			EQU	(1<<2)	; 41h, 48h, 4Eh are available (EDD)
    32                              <2> 
    33                              <2> 
    34                              <2> ; Extended Drive Information returned by AH=48h
    35                              <2> struc EDRIVE_INFO
    36 00000000 ????                <2> 	.wSize					resb	2	; 0, Size of this buffer, at least 26
    37 00000002 ????                <2> 	.wFlags					resb	2	; 2, Information flags
    38 00000004 ????????            <2> 	.dwCylinders			resb	4	; 4, Total number of addressable cylinders
    39 00000008 ????????            <2> 	.dwHeads				resb	4	; 8, Total number of addressable heads
    40 0000000C ????????            <2> 	.dwSectorsPerTrack		resb	4	; 12, Number of sectors per track
    41 00000010 ????????????????    <2> 	.qwTotalSectors			resb	8	; 16, Total number of addressable sectors
    42 00000018 ????                <2> 	.wSectorSize			resb	2	; 24, Number of bytes per sector
    43 0000001A ????????            <2> 	.fpDPTE					resb	4	; 26, Optional pointer to Device Parameter Table Extension
    44                              <2> endstruc
    45                              <2> 
    46                              <2> MINIMUM_EDRIVEINFO_SIZE			EQU		26	; 26 bytes does not include EDD pointer
    47                              <2> EDRIVEINFO_SIZE_WITH_DPTE		EQU		EDRIVE_INFO_size
    48                              <2> MAX_SECTOR_COUNT_TO_RETURN_PCHS	EQU		15482880
    49                              <2> 
    50                              <2> ; Flags for EDRIVE_INFO.wFlags
    51                              <2> FLG_DMA_BOUNDARY_ERRORS_HANDLED_BY_BIOS				EQU	(1<<0)
    52                              <2> FLG_CHS_INFORMATION_IS_VALID						EQU	(1<<1)
    53                              <2> FLG_REMOVABLE_DRIVE									EQU	(1<<2)
    54                              <2> FLG_WRITE_WITH_VERIFY_SUPPORTED						EQU	(1<<3)
    55                              <2> FLG_CHANGE_LINE_SUPPORT								EQU	(1<<4)	; Removable media only
    56                              <2> FLG_LOCKABLE										EQU	(1<<5)	; Removable media only
    57                              <2> FLG_NO_MEDIA_PRESENT_AND_CHS_SET_TO_MAX				EQU	(1<<6)	; Removable media only
    58                              <2> 
    59                              <2> 
    60                              <2> ; Disk Address Packet for read, write and verify functions
    61                              <2> struc DAP
    62 00000000 ??                  <2> 	.bSize					resb	1	; 0, Size of this packet in bytes
    63 00000001 ??                  <2> 	.bReservedAt1			resb	1	; 1, Currently unused, must be zero
    64 00000002 ????                <2> 	.wSectorCount			resb	2	; 2, Number of sectors to process (0...127)
    65                              <2> 	.dwMemoryAddress:
    66 00000004 ????                <2> 	.wOffset				resb	2	; 4, Memory offset for transfer
    67 00000006 ????                <2> 	.wSegment				resb	2	; 6, Memory segment for transfer
    68 00000008 ????????????????    <2> 	.qwLBA					resb	8	; 8, Starting sector for transfer
    69                              <2> endstruc
    70                              <2> 
    71                              <2> MINIMUM_DAP_SIZE			EQU		16
    72                              <2> 
    73                              <2> 
    74                              <2> %endif ; EBIOS_INC
    73                              <1> %endif
