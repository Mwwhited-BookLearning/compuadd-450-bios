    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; BootVars_Initialize
    25                              <1> ;	Parameters:
    26                              <1> ;		DS:		RAMVARS Segment
    27                              <1> ;		ES:		BDA Segment
    28                              <1> ;	Returns:
    29                              <1> ;		Nothing
    30                              <1> ;	Corrupts registers:
    31                              <1> ;		AX, CX, DX, DI
    32                              <1> ;--------------------------------------------------------------------
    33                              <1> BootVars_Initialize:
    34                              <1> 	; Clear all DRVDETECTINFO structs to zero
    35 00000549 B03C                <1> 	mov		al, DRVDETECTINFO_size
    36 0000054B 2EF6264800          <1> 	mul		BYTE [cs:ROMVARS.bIdeCnt]
    37 00000550 91                  <1> 	xchg	cx, ax
    38                              <1> %ifndef MODULE_HOTKEYS
    39                              <1> 	mov		di, BOOTVARS.rgDrvDetectInfo	; We must not initialize anything before this!
    40                              <1> 	jmp		Memory_ZeroESDIwithSizeInCX
    41                              <1> 
    42                              <1> %else ; if MODULE_HOTKEYS
    43                              <1> 	; Also zero HOTKEYVARS located above DRVDETECTINFO structs
    44 00000551 BF047F              <1> 	mov		di, BOOTVARS.hotkeyVars
    45 00000554 83C10A              <1> 	add		cx, BYTE HOTKEYVARS_size
    46 00000557 E826FE              <1> 	call	Memory_ZeroESDIwithSizeInCX
    47 0000055A E99206              <1> 	jmp		HotkeyBar_InitializeVariables
    48                              <1> %endif ; MODULE_HOTKEYS
    49                              <1> 
    50                              <1> 
    51                              <1> ;--------------------------------------------------------------------
    52                              <1> ; Returns letter for first hard disk. Usually it will be 'C' but it
    53                              <1> ; can be higher if more than two floppy drives are found.
    54                              <1> ;
    55                              <1> ; BootVars_GetLetterForFirstHardDriveToAX
    56                              <1> ;	Parameters:
    57                              <1> ;		DS:		RAMVARS segment
    58                              <1> ;	Returns:
    59                              <1> ;		AX:		Upper case letter for first hard disk
    60                              <1> ;	Corrupts registers:
    61                              <1> ;		Nothing
    62                              <1> ;--------------------------------------------------------------------
    63                              <1> BootVars_GetLetterForFirstHardDriveToAX:
    64 0000055D E83400              <1> 	call	FloppyDrive_GetCountToAX
    65 00000560 0441                <1> 	add		al, DEFAULT_FLOPPY_DRIVE_LETTER		; First Hard Drive letter comes after last floppy drive letter...
    66                              <1> 	MAX_U	al, DEFAULT_HARD_DRIVE_LETTER		; ...but it can never be 'A' or 'B'
    48 00000562 3C43                <2>  cmp %1, %2
    49 00000564 7702                <2>  ja %%Return
    50 00000566 B043                <2>  mov %1, %2
    51                              <2> %%Return:
    67 00000568 C3                  <1> 	ret
