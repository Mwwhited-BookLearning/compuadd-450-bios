    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int19h_BootLoaderHandler
    25                              <1> ;	Parameters:
    26                              <1> ;		Nothing
    27                              <1> ;	Returns:
    28                              <1> ;		Never returns (loads operating system)
    29                              <1> ;--------------------------------------------------------------------
    30                              <1> Int19h_BootLoaderHandler:
    31 00000CEB FB                  <1> 	sti											; Enable interrupts
    32                              <1> %ifdef CLD_NEEDED
    33 00000CEC FC                  <1> 	cld											; String instructions to increment pointers
    34                              <1> %endif
    35                              <1> %ifdef MODULE_VERY_LATE_INIT
    36                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax					; Load BDA segment (zero) to DS
    37                              <1> 	les		ax, [TEMPORARY_VECTOR_FOR_SYSTEM_INT13h*4]
    38                              <1> 	mov		[BIOS_DISK_INTERRUPT_13h*4], ax
    39                              <1> 	mov		[BIOS_DISK_INTERRUPT_13h*4+2], es
    40                              <1> 	push	ds									; BDA segment (zero)...
    41                              <1> 	pop		es									; ...to ES
    42                              <1> %else
    43                              <1> 	LOAD_BDA_SEGMENT_TO	es, ax					; Load BDA segment (zero) to ES
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184                              <2>  xor %2, %2
   185                              <2>  mov %1, %2
   186                              <2> %else
   187 00000CED 6A00                <2>  push BYTE 0
   188 00000CEF 07                  <2>  pop %1
   189                              <2> %endif
    44                              <1> %endif
    45                              <1> 	; Fall to .PrepareBootLoaderStack
    46                              <1> 
    47                              <1> 
    48                              <1> ;--------------------------------------------------------------------
    49                              <1> ; Drive detection and boot menu use lots of stack so it is
    50                              <1> ; wise to relocate stack. Otherwise something important from
    51                              <1> ; interrupt vectors are likely corrupted, likely our own DPTs if
    52                              <1> ; they are located to 30:0h.
    53                              <1> ;
    54                              <1> ; .PrepareBootLoaderStack
    55                              <1> ;	Parameters:
    56                              <1> ;		ES:		BDA and interrupt vector segment (zero)
    57                              <1> ;	Returns:
    58                              <1> ;		Never returns (loads operating system)
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> .PrepareBootLoaderStack:
    61                              <1> 	STORE_POST_STACK_POINTER
   114 00000CF0 268926007F          <2>  mov [es:BOOTVARS.dwPostStack], sp
   115 00000CF5 268C16027F          <2>  mov [es:BOOTVARS.dwPostStack+2], ss
    62                              <1> 	SWITCH_TO_BOOT_MENU_STACK
   139                              <2> %ifndef USE_186
   140                              <2>  cli
   141                              <2> %endif
   142                              <2>  LOAD_BDA_SEGMENT_TO ss, sp
   180                              <3> %ifndef USE_186
   181                              <3>  xor %2, %2
   182                              <3>  mov %1, %2
   183                              <3> %elifidn %3, !
   184                              <3>  xor %2, %2
   185                              <3>  mov %1, %2
   186                              <3> %else
   187 00000CFA 6A00                <3>  push BYTE 0
   188 00000CFC 17                  <3>  pop %1
   189                              <3> %endif
   143 00000CFD BC007F              <2>  mov sp, BOOTVARS.rgbMnuStack
   144                              <2> %ifndef USE_186
   145                              <2>  sti
   146                              <2> %endif
    63                              <1> 	; Fall to .InitializeDisplay
    64                              <1> 
    65                              <1> 
    66                              <1> ;--------------------------------------------------------------------
    67                              <1> ; .InitializeDisplay
    68                              <1> ;	Parameters:
    69                              <1> ;		ES:		BDA and interrupt vector segment (zero)
    70                              <1> ;	Returns:
    71                              <1> ;		Never returns (loads operating system)
    72                              <1> ;--------------------------------------------------------------------
    73                              <1> .InitializeDisplay:
    74                              <1> 	; Change display mode if necessary
    75 00000D00 2EA14400            <1> 	mov		ax, [cs:ROMVARS.wDisplayMode]	; AH 00h = Set Video Mode
    76 00000D04 3C04                <1> 	cmp		al, DEFAULT_TEXT_MODE
    77 00000D06 7402                <1> 	je		SHORT .InitializeDisplayLibrary
    78 00000D08 CD10                <1> 	int		BIOS_VIDEO_INTERRUPT_10h
    79                              <1> .InitializeDisplayLibrary:
    80 00000D0A E878FC              <1> 	call	DetectPrint_InitializeDisplayContext
    81                              <1> 	; Fall to .InitializeBiosAndDetectDrives
    82                              <1> 
    83                              <1> 
    84                              <1> ;--------------------------------------------------------------------
    85                              <1> ; .InitializeBiosAndDetectDrives
    86                              <1> ;	Parameters:
    87                              <1> ;		ES:		BDA and interrupt vector segment (zero)
    88                              <1> ;	Returns:
    89                              <1> ;		DS:		RAMVARS segment
    90                              <1> ;--------------------------------------------------------------------
    91                              <1> .InitializeBiosAndDetectDrives:
    92 00000D0D E80DF7              <1> 	call	Initialize_AndDetectDrives
    93                              <1> 
    94                              <1> %ifdef MODULE_HOTKEYS
    95                              <1> 	; Last hard drive might have scrolled Hotkey Bar out of screen.
    96                              <1> 	; We want to display it during wait.
    97                              <1> 	;call	HotkeyBar_UpdateDuringDriveDetection
    98                              <1> 
    99 00000D10 1E                  <1> 	push	ds
   100 00000D11 06                  <1> 	push	es
   101 00000D12 1F                  <1> 	pop		ds
   102                              <1> 
   103                              <1> .WaitUntilTimeToCloseHotkeyBar:
   104 00000D13 A16C04              <1> 	mov		ax, [BDA.dwTimerTicks]
   105 00000D16 2B06087F            <1> 	sub		ax, [BOOTVARS.hotkeyVars+HOTKEYVARS.wTimeWhenDisplayed]
   106 00000D1A 83F848              <1> 	cmp		ax, MIN_TIME_TO_DISPLAY_HOTKEY_BAR
   107 00000D1D 72F4                <1> 	jb		SHORT .WaitUntilTimeToCloseHotkeyBar
   108                              <1> 
   109                              <1> 	; Restore system timer tick handler since hotkeys are no longer needed
   110                              <1> %ifdef USE_386
   111 00000D1F 6650                <1> 	push	eax			; Save the high WORD of EAX
   112 00000D21 66A1047F            <1> 	mov		eax, [BOOTVARS.hotkeyVars+HOTKEYVARS.fpPrevTimerHandler]
   113 00000D25 66A32000            <1> 	mov		[BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h*4], eax
   114 00000D29 6658                <1> 	pop		eax			; Restore the high WORD of EAX
   115                              <1> %else
   116                              <1> 	cli
   117                              <1> 	mov		ax, [BOOTVARS.hotkeyVars+HOTKEYVARS.fpPrevTimerHandler]
   118                              <1> 	mov		[BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h*4], ax
   119                              <1> 	mov		ax, [BOOTVARS.hotkeyVars+HOTKEYVARS.fpPrevTimerHandler+2]
   120                              <1> 	mov		[BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h*4+2], ax
   121                              <1> 	sti
   122                              <1> %endif
   123                              <1> 
   124 00000D2B 1F                  <1> 	pop		ds
   125                              <1> %endif
   126                              <1> 	; Fall to .ResetAllDrives
   127                              <1> 
   128                              <1> 
   129                              <1> ;--------------------------------------------------------------------
   130                              <1> ; .ResetAllDrives
   131                              <1> ;	Parameters:
   132                              <1> ;		DS:		RAMVARS segment
   133                              <1> ;		ES:		BDA and interrupt vector segment (zero)
   134                              <1> ;	Returns:
   135                              <1> ;		Nothing
   136                              <1> ;--------------------------------------------------------------------
   137                              <1> .ResetAllDrives:
   138                              <1> 	; Reset all drives in the system, not just our drives.
   139 00000D2C 31C0                <1> 	xor		ax, ax		; Disk Controller Reset
   140 00000D2E B280                <1> 	mov		dl, 80h		; Reset all hard drives and floppy drives
   141 00000D30 CD13                <1> 	int		BIOS_DISK_INTERRUPT_13h
   142                              <1> 	; Fall to SelectDriveToBootFrom
   143                              <1> 
   144                              <1> 
   145                              <1> ;--------------------------------------------------------------------
   146                              <1> ; SelectDriveToBootFrom
   147                              <1> ;	Parameters:
   148                              <1> ;		DS:		RAMVARS segment
   149                              <1> ;		ES:		BDA and interrupt vector segment (zero)
   150                              <1> ;	Returns:
   151                              <1> ;		Never returns (loads operating system)
   152                              <1> ;--------------------------------------------------------------------
   153                              <1> ; The following macro could be easily inlined below.  Why a macro?  Depending on the combination
   154                              <1> ; of MODULE_HOTKEYS or MODULE_BOOT_MENU, this code needs to either come before or after the
   155                              <1> ; call to the boot menu.
   156                              <1> ;
   157                              <1> %macro TRY_TO_BOOT_DL_AND_DH_DRIVES 0
   158                              <1> 	push	dx									; it's OK if this is left on the stack, if we are
   159                              <1> 												; successful, the following call does not return
   160                              <1> 	call	BootSector_TryToLoadFromDriveDL_AndBoot
   161                              <1> 	pop		dx
   162                              <1> 	mov		dl, dh
   163                              <1> 	call	BootSector_TryToLoadFromDriveDL_AndBoot
   164                              <1> %endmacro
   165                              <1> 
   166                              <1> 
   167                              <1> SelectDriveToBootFrom:		; Function starts here
   168                              <1> %ifdef MODULE_HOTKEYS
   169 00000D32 26A00D7F            <1> 	mov		al, [es:BOOTVARS.hotkeyVars+HOTKEYVARS.bScancode]
   170 00000D36 3C42                <1> 	cmp		al, ROM_BOOT_HOTKEY_SCANCODE
   171 00000D38 741A                <1> 	je		SHORT .RomBoot						; CF clear so ROM boot
   172                              <1> %ifdef MODULE_BOOT_MENU
   173                              <1> 	cmp		al, BOOT_MENU_HOTKEY_SCANCODE
   174                              <1> 	je		SHORT .BootMenu
   175                              <1> %endif ; MODULE_BOOT_MENU
   176                              <1> 
   177                              <1> .TryUsingHotKeysCode:
   178 00000D3A E813FF              <1> 	call	HotkeyBar_GetBootDriveNumbersToDX
   179 00000D3D E89DFF              <1> 	call	DriveXlate_SetDriveToSwap			; Enable primary boot device translation
   180 00000D40 86F2                <1> 	xchg	dl, dh
   181 00000D42 E898FF              <1> 	call	DriveXlate_SetDriveToSwap			; Enable secondary boot device translation
   182 00000D45 86F2                <1> 	xchg	dl, dh
   183 00000D47 E84EFF              <1> 	call	DriveXlate_ToOrBack					; Translate now so boot device will appear as 00h or 80h to OS
   184                              <1> 	TRY_TO_BOOT_DL_AND_DH_DRIVES
   158 00000D4A 52                  <2>  push dx
   159                              <2> 
   160 00000D4B E82300              <2>  call BootSector_TryToLoadFromDriveDL_AndBoot
   161 00000D4E 5A                  <2>  pop dx
   162 00000D4F 88F2                <2>  mov dl, dh
   163 00000D51 E81D00              <2>  call BootSector_TryToLoadFromDriveDL_AndBoot
   185                              <1> 	;; falls through to boot menu, if it is present.  If not present, falls through to rom boot.
   186                              <1> %endif ; MODULE_HOTKEYS
   187                              <1> 
   188                              <1> 
   189                              <1> %ifdef MODULE_BOOT_MENU
   190                              <1> .BootMenu:
   191                              <1> 	call	BootMenu_DisplayAndReturnDriveInDLRomBootClearCF
   192                              <1> 	jnc		SHORT .RomBoot						; CF clear so ROM boot
   193                              <1> 
   194                              <1> 	call	DriveXlate_Reset
   195                              <1> %ifdef MODULE_HOTKEYS
   196                              <1> 	jmp		SHORT .TryUsingHotKeysCode			; Selected drive stored as hotkey
   197                              <1> %else ; Boot menu without hotkeys, secondary boot drive is always 00h or 80h
   198                              <1> 	mov		dh, dl								; Setup for secondary drive
   199                              <1> 	not		dh									; Floppy goes to HD, or vice versa
   200                              <1> 	and		dh, 80h								; Go to first drive of the floppy or HD set
   201                              <1> 	call	DriveXlate_SetDriveToSwap
   202                              <1> 	call	DriveXlate_ToOrBack
   203                              <1> 	TRY_TO_BOOT_DL_AND_DH_DRIVES
   204                              <1> 	jmp		SHORT .BootMenu						; Show boot menu again
   205                              <1> %endif ; MODULE_HOTKEYS
   206                              <1> 
   207                              <1> %endif ; MODULE_BOOT_MENU
   208                              <1> 
   209                              <1> ; No hotkeys and no boot menu means fixed "A then C" boot order
   210                              <1> %ifndef MODULE_HOTKEYS OR MODULE_BOOT_MENU
   211                              <1> 	xor		dl, dl								; Try to boot from Floppy Drive A
   212                              <1> 	call	BootSector_TryToLoadFromDriveDL_AndBoot
   213                              <1> 	mov		dl, 80h								; Try to boot from Hard Drive C
   214                              <1> 	call	BootSector_TryToLoadFromDriveDL_AndBoot
   215                              <1> %endif
   216                              <1> 
   217                              <1> .RomBoot:
   218                              <1> %ifdef MODULE_DRIVEXLATE
   219 00000D54 E87FFF              <1> 	call	DriveXlate_Reset					; Clean up any drive mappings before Rom Boot
   220                              <1> %endif
   221 00000D57 F9                  <1> 	stc
   222                              <1> 	;; fall through to Int19h_JumpToBootSectorInESBXOrRomBoot
   223                              <1> 
   224                              <1> ;--------------------------------------------------------------------
   225                              <1> ; Int19h_JumpToBootSectorInESBXOrRomBoot
   226                              <1> ;
   227                              <1> ; Switches back to the POST stack, clears the DS and ES registers,
   228                              <1> ; and either jumps to the MBR (Master Boot Record) that was just read,
   229                              <1> ; or calls the ROM's boot routine on interrupt 18h.
   230                              <1> ;
   231                              <1> ;	Parameters:
   232                              <1> ;		DL:		Drive to boot from (translated, 00h or 80h)
   233                              <1> ;		CF:		Clear for Boot Sector Boot
   234                              <1> ;				Set for ROM Boot
   235                              <1> ;		ES:BX:	(if CF clear) Ptr to boot sector (ES = zero)
   236                              <1> ;
   237                              <1> ;	Returns:
   238                              <1> ;		Never returns
   239                              <1> ;--------------------------------------------------------------------
   240                              <1> Int19h_JumpToBootSectorInESBXOrRomBoot:
   241 00000D58 8CC0                <1> 	mov		ax, es		; Clear AX. NOTE: can't use XOR (LOAD_BDA_SEGMENT_TO) as it impacts CF
   242                              <1> 	SWITCH_BACK_TO_POST_STACK
   165                              <2> %ifndef USE_386
   166                              <2>  cli
   167                              <2>  mov ss, ax
   168                              <2>  mov sp, [ss:BOOTVARS.dwPostStack]
   169                              <2>  mov ss, [ss:BOOTVARS.dwPostStack+2]
   170                              <2>  sti
   171                              <2> %else
   172 00000D5A 8ED0                <2>  mov ss, ax
   173 00000D5C 360FB226007F        <2>  lss sp, [ss:BOOTVARS.dwPostStack]
   174                              <2> %endif
   243                              <1> 
   244                              <1> ; clear segment registers before boot sector or rom call
   245                              <1> Int19h_JumpToBootSectorInESBXOrRomBootWithoutStackChange:
   246 00000D62 8CC0                <1> 	mov		ax, es		; Clear AX and preserve CF
   247 00000D64 8ED8                <1> 	mov		ds, ax
   248                              <1> %ifdef USE_386
   249 00000D66 8EE0                <1> 	mov		fs, ax
   250 00000D68 8EE8                <1> 	mov		gs, ax
   251                              <1> %endif
   252 00000D6A 7203                <1> 	jc		SHORT .RomBoot
   253                              <1> 
   254                              <1> ; jump to boot sector
   255 00000D6C 06                  <1> 	push	es			; sgment address for MBR
   256 00000D6D 53                  <1> 	push	bx			; offset address for MBR
   257 00000D6E CB                  <1> 	retf				; NOTE:	DL is set to the drive number
   258                              <1> 
   259                              <1> ; Boot by calling INT 18h (ROM Basic or ROM DOS)
   260                              <1> .RomBoot:
   261 00000D6F CD18                <1> 	int		BIOS_BOOT_FAILURE_INTERRUPT_18h	; Never returns
   281                                  	%include "BootSector.asm"		; For loading boot sector
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Reading and jumping to boot sector.
