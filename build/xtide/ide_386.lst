    14                              <1> %include "Delay.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	Delay macros.
     3                              <2> %ifndef DELAY_INC
     4                              <2> %define DELAY_INC
     5                              <2> 
     6                              <2> ;--------------------------------------------------------------------
     7                              <2> ; Clears prefetch queue by jumping to the next instruction.
     8                              <2> ; This delays much more than the nop instruction on fast systems.
     9                              <2> ;
    10                              <2> ; JMP_DELAY
    11                              <2> ;	Parameters
    12                              <2> ;		Nothing
    13                              <2> ;	Returns:
    14                              <2> ;		Nothing
    15                              <2> ;	Corrupts registers:
    16                              <2> ;		Nothing
    17                              <2> ;--------------------------------------------------------------------
    18                              <2> %macro JMP_DELAY 0
    19                              <2> 	jmp		SHORT %%NextInstruction
    20                              <2> %%NextInstruction:
    21                              <2> %endmacro
    22                              <2> 
    23                              <2> 
    24                              <2> ;--------------------------------------------------------------------
    25                              <2> ; Mimimun delays (without fetching) with some CPU architectures:
    26                              <2> ;	8088/8086:	17 cycles for jump + 5 cycles for last comparison
    27                              <2> ;	286:		10 cycles for jump + 4 cycles for last comparison
    28                              <2> ;	386:		13 cycles for jump + ? cycles for last comparison
    29                              <2> ;	486:		 7 cycles for jump + 6 cycles for last comparison
    30                              <2> ;
    31                              <2> ; LOOP instruction uses two bytes so aligned fetching will require:
    32                              <2> ;	8088:		8 cycles (two BYTE reads)
    33                              <2> ;	8086:		4 cycles (one WORD read)
    34                              <2> ;	286:		2 cycles + wait states (usually 1)
    35                              <2> ;	386:		?
    36                              <2> ;	486:		Fetched only once to internal cache
    37                              <2> ;
    38                              <2> ; DELAY_WITH_LOOP_INSTRUCTION_NA	; No JUMP_ALIGN
    39                              <2> ; DELAY_WITH_LOOP_INSTRUCTION
    40                              <2> ;	Parameters
    41                              <2> ;		CX:		Loop iterations (0 is maximum delay with 65536 iterations)
    42                              <2> ;	Returns:
    43                              <2> ;		CX:		Zero
    44                              <2> ;	Corrupts registers:
    45                              <2> ;		Nothing
    46                              <2> ;--------------------------------------------------------------------
    47                              <2> %macro DELAY_WITH_LOOP_INSTRUCTION_NA 0
    48                              <2> %%StartOfLoop:
    49                              <2> 	loop	%%StartOfLoop
    50                              <2> %endmacro
    51                              <2> 
    52                              <2> %macro DELAY_WITH_LOOP_INSTRUCTION 0
    53                              <2> ALIGN JUMP_ALIGN
    54                              <2> %%StartOfLoop:
    55                              <2> 	loop	%%StartOfLoop
    56                              <2> %endmacro
    57                              <2> 
    58                              <2> 
    59                              <2> %endif ; DELAY_INC
    15                              <1> %include "DosFunctions.inc"
     1                              <2> ; Project name	:	AssemblyLibrary
     2                              <2> ; Description	:	Defines for MS-DOS functions.
     3                              <2> %ifndef DOS_FUNCTIONS_INC
     4                              <2> %define DOS_FUNCTIONS_INC
     5                              <2> 
     6                              <2> ; DOS interrupts
     7                              <2> DOS_INTERRUPT_21h									EQU		21h
     8                              <2> DOS_CTRL_C_CTRL_BREAK_HANDLER_23h					EQU		23h
     9                              <2> DOS_CRITICAL_ERROR_HANDLER_24h						EQU		24h
    10                              <2> DOS_TSR_MULTIPLEX_INTERRUPT_2Fh						EQU		2Fh
    11                              <2> 
    12                              <2> ; DOS functions
    13                              <2> WRITE_CHARACTER_TO_STANDARD_OUTPUT					EQU		02h		; DOS 1+
    14                              <2> WRITE_STRING_TO_STANDARD_OUTPUT						EQU		09h		; DOS 1+
    15                              <2> SELECT_DEFAULT_DRIVE								EQU		0Eh		; DOS 1+
    16                              <2> GET_CURRENT_DEFAULT_DRIVE							EQU		19h		; DOS 1+
    17                              <2> SET_INTERRUPT_VECTOR								EQU		25h		; DOS 1+
    18                              <2> GET_DISK_TRANSFER_AREA_ADDRESS						EQU		2Fh		; DOS 2+
    19                              <2> GET_DOS_VERSION										EQU		30h		; DOS 2+
    20                              <2> GET_DOS_DRIVE_PARAMETER_BLOCK_FOR_SPECIFIC_DRIVE	EQU		32h		; DOS 2+
    21                              <2> GET_INTERRUPT_VECTOR								EQU		35h		; DOS 2+
    22                              <2> SET_CURRENT_DIRECTORY								EQU		3Bh		; DOS 2+
    23                              <2> CREATE_OR_TRUNCATE_FILE								EQU		3Ch		; DOS 2+
    24                              <2> OPEN_EXISTING_FILE									EQU		3Dh		; DOS 2+
    25                              <2> CLOSE_FILE											EQU		3Eh		; DOS 2+
    26                              <2> READ_FROM_FILE_OR_DEVICE							EQU		3Fh		; DOS 2+
    27                              <2> WRITE_TO_FILE_OR_DEVICE								EQU		40h		; DOS 2+
    28                              <2> SET_CURRENT_FILE_POSITION							EQU		42h		; DOS 2+
    29                              <2> CHECK_IF_BLOCK_DEVICE_REMOTE						EQU		4409h	; DOS 3.1+
    30                              <2> GET_CURRENT_DIRECTORY								EQU		47h		; DOS 2+
    31                              <2> TERMINATE_WITH_RETURN_CODE							EQU		4Ch		; DOS 2+
    32                              <2> FIND_FIRST_MATCHING_FILE							EQU		4Eh		; DOS 2+
    33                              <2> FIND_NEXT_MATCHING_FILE								EQU		4Fh		; DOS 2+
    34                              <2> GET_EXTENDED_ERROR_INFORMATION						EQU		59h		; DOS 3.0+
    35                              <2> 
    36                              <2> ; DOS errors
    37                              <2> ERR_DOS_FUNCTION_NUMBER_INVALID						EQU		01h
    38                              <2> ERR_DOS_PATH_NOT_FOUND								EQU		03h
    39                              <2> ERR_DOS_INVALID_DRIVE								EQU		0Fh
    40                              <2> ERR_DOS_NO_MORE_FILES								EQU		12h
    41                              <2> ERR_DOS_DRIVE_NOT_READY								EQU		15h
    42                              <2> 
    43                              <2> 
    44                              <2> ; DOS Program Segment Prefix (PSP, first 256 (100h) bytes on top of program)
    45                              <2> struc PSP
    46 00000000 ????                <2> 	.int20hInstruction				resb	2
    47 00000002 ????                <2> 	.wSizeOfMemoryInParagraphs		resb	2
    48 00000004 ??                  <2> 	.reservedAt4h					resb	1
    49 00000005 ??????????          <2> 	.callToDosFunctionDispatcher	resb	5
    50 0000000A ????????            <2> 	.fpInt22hTerminate				resb	4
    51 0000000E ????????            <2> 	.fpInt23hCtrlC					resb	4
    52 00000012 ????????            <2> 	.fpInt24hCriticalError			resb	4
    53 00000016 <res 16h>           <2> 	.reservedAt16h					resb	22
    54 0000002C ????                <2> 	.wEnvironmentSegment			resb	2
    55 0000002E <res 22h>           <2> 	.reservedAt2Eh					resb	34
    56 00000050 ??????              <2> 	.int21hAndRetfInstructions		resb	3
    57 00000053 <res 9h>            <2> 	.reservedAt53h					resb	9
    58 0000005C <res 10h>           <2> 	.FCB1							resb	16
    59 0000006C <res 14h>           <2> 	.FCB2							resb	20
    60                              <2> 	.DiskTransferArea:
    61 00000080 ??                  <2> 	.bCommandLineLength				resb	1
    62 00000081 <res 7Fh>           <2> 	.szCommandLine					resb	127
    63                              <2> endstruc
    64                              <2> 
    65                              <2> 
    66                              <2> ; DOS DTA (Disk Transfer Area)
    67                              <2> struc DTA
    68                              <2> 	; Undocumented fields
    69 00000000 <res 15h>           <2> 	.reservedAt0h		resb	21
    70                              <2> 	; Documented fields
    71 00000015 ??                  <2> 	.bFileAttributes	resb	1	; 15h, Attribute of matching file
    72 00000016 ????                <2> 	.wFileTime			resb	2	; 16h, File time
    73 00000018 ????                <2> 	.wFileDate			resb	2	; 18h, File date
    74 0000001A ????????            <2> 	.dwFileSize			resb	4	; 1Ah, File size in bytes
    75 0000001E <res Dh>            <2> 	.szFile				resb	13	; 1Eh, ASCIZ filename + extension
    76                              <2> endstruc
    77                              <2> 
    78                              <2> 
    79                              <2> %endif ; DOS_FUNCTIONS_INC
    16                              <1> %include "File.inc"
     1                              <2> ; File name		:	File.inc
     2                              <2> ; Project name	:	Assembly Library
     3                              <2> ; Created date	:	8.10.2010
     4                              <2> ; Last update	:	6.12.2010
     5                              <2> ; Author		:	Tomi Tilli
     6                              <2> ; Description	:	File library defines.
     7                              <2> %ifndef FILE_INC
     8                              <2> %define FILE_INC
     9                              <2> 
    10                              <2> ; File access and sharing modes
    11                              <2> struc FILE_ACCESS
    12 00000000 ??                  <2> 	.ReadOnly		resb	1
    13 00000001 ??                  <2> 	.WriteOnly		resb	1
    14 00000002 ??                  <2> 	.ReadAndWrite	resb	1
    15                              <2> endstruc
    16                              <2> 
    17                              <2> ; Origin of file seek
    18                              <2> struc SEEK_FROM
    19 00000000 ??                  <2> 	.startOfFile			resb	1	; 00h
    20 00000001 ??                  <2> 	.currentFilePosition	resb	1	; 01h
    21 00000002 ??                  <2> 	.endOfFile				resb	1	; 02h
    22                              <2> endstruc
    23                              <2> 
    24                              <2> ; File attribute flags
    25                              <2> FLG_FILEATTR_READ_ONLY			EQU		(1<<0)
    26                              <2> FLG_FILEATTR_HIDDEN				EQU		(1<<1)
    27                              <2> FLG_FILEATTR_SYSTEM				EQU		(1<<2)
    28                              <2> FLG_FILEATTR_VOLUME_LABEL		EQU		(1<<3)
    29                              <2> FLG_FILEATTR_DIRECTORY			EQU		(1<<4)
    30                              <2> FLG_FILEATTR_ARCHIVE			EQU		(1<<5)
    31                              <2> 
    32                              <2> 
    33                              <2> ; Max number of bytes to read/write per DOS call when transferring DX:CX bytes
    34                              <2> SPLIT_SIZE_FOR_LARGE_TRANSFERS	EQU		(32<<10)
    35                              <2> 
    36                              <2> 
    37                              <2> %endif ; FILE_INC
    17                              <1> %include "Math.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	Math related macros.
     3                              <2> %ifndef MATH_INC
     4                              <2> %define MATH_INC
     5                              <2> 
     6                              <2> FALSE		EQU		0
     7                              <2> TRUE		EQU		1
     8                              <2> 
     9                              <2> 
    10                              <2> ;--------------------------------------------------------------------
    11                              <2> ; MIN_U		Unsigned comparison
    12                              <2> ; MIN_S		Signed comparison
    13                              <2> ;	Parameters:
    14                              <2> ;		%1:		Operand 1
    15                              <2> ;		%2:		Operand 2
    16                              <2> ;	Returns:
    17                              <2> ;		%1:		Lesser operand
    18                              <2> ;	Corrupts registers:
    19                              <2> ;		Nothing
    20                              <2> ;--------------------------------------------------------------------
    21                              <2> %macro MIN_U 2
    22                              <2> 	cmp		%1, %2				; Is %1 smaller?
    23                              <2> 	jb		%%Return			;  If so, return
    24                              <2> 	mov		%1, %2				; Copy %2 to %1
    25                              <2> %%Return:
    26                              <2> %endmacro
    27                              <2> 
    28                              <2> %macro MIN_S 2
    29                              <2> 	cmp		%1, %2				; Is %1 smaller?
    30                              <2> 	jl		%%Return			;  If so, return
    31                              <2> 	mov		%1, %2				; Copy %2 to %1
    32                              <2> %%Return:
    33                              <2> %endmacro
    34                              <2> 
    35                              <2> 
    36                              <2> ;--------------------------------------------------------------------
    37                              <2> ; MAX_U		Unsigned comparison
    38                              <2> ; MAX_S		Signed comparison
    39                              <2> ;	Parameters:
    40                              <2> ;		%1:		Operand 1
    41                              <2> ;		%2:		Operand 2
    42                              <2> ;	Returns:
    43                              <2> ;		%1:		Greater operand
    44                              <2> ;	Corrupts registers:
    45                              <2> ;		Nothing
    46                              <2> ;--------------------------------------------------------------------
    47                              <2> %macro MAX_U 2
    48                              <2> 	cmp		%1, %2				; Is %1 greater?
    49                              <2> 	ja		%%Return			;  If so, return
    50                              <2> 	mov		%1, %2				; Copy %2 to %1
    51                              <2> %%Return:
    52                              <2> %endmacro
    53                              <2> 
    54                              <2> %macro MAX_S 2
    55                              <2> 	cmp		%1, %2				; Is %1 greater?
    56                              <2> 	jg		%%Return			;  If so, return
    57                              <2> 	mov		%1, %2				; Copy %2 to %1
    58                              <2> %%Return:
    59                              <2> %endmacro
    60                              <2> 
    61                              <2> 
    62                              <2> ;--------------------------------------------------------------------
    63                              <2> ; SHL_DXAX
    64                              <2> ;	Parameters:
    65                              <2> ;		%1:		Number of bits to shift. Can be (in preferred order) CX, CL or an immediate value.
    66                              <2> ;	Returns:
    67                              <2> ;		DX:AX	Shifted value
    68                              <2> ;	Corrupts registers:
    69                              <2> ;		CX
    70                              <2> ;--------------------------------------------------------------------
    71                              <2> %macro SHL_DXAX 1
    72                              <2> %ifdef USE_386
    73                              <2> 	%ifnidni %1, cx
    74                              <2> 		; %1 is CL or an immediate
    75                              <2> 		shld	dx, ax, %1
    76                              <2> 		shl		ax, %1
    77                              <2> 	%else
    78                              <2> 		; %1 is CX
    79                              <2> 		shld	dx, ax, cl
    80                              <2> 		shl		ax, cl
    81                              <2> 	%endif
    82                              <2> %else
    83                              <2> 	%ifidni %1, cl
    84                              <2> 		; %1 is CL
    85                              <2> 		xor		ch, ch
    86                              <2> 	%elifnidni %1, cx
    87                              <2> 		; %1 is an immediate
    88                              <2> 		mov		cx, %1
    89                              <2> 	%endif
    90                              <2> ALIGN JUMP_ALIGN
    91                              <2> .ShiftNextBit:
    92                              <2> 	eSHL_IM	ax, 1
    93                              <2> 	eRCL_IM	dx, 1
    94                              <2> 	loop	.ShiftNextBit
    95                              <2> %endif
    96                              <2> %endmacro
    97                              <2> 
    98                              <2> 
    99                              <2> ;--------------------------------------------------------------------
   100                              <2> ; SHR_DXAX
   101                              <2> ;	Parameters:
   102                              <2> ;		%1:		Number of bits to shift. Can be (in preferred order) CX, CL or an immediate value.
   103                              <2> ;	Returns:
   104                              <2> ;		DX:AX	Shifted value
   105                              <2> ;	Corrupts registers:
   106                              <2> ;		CX
   107                              <2> ;--------------------------------------------------------------------
   108                              <2> %macro SHR_DXAX 1
   109                              <2> %ifdef USE_386
   110                              <2> 	%ifnidni %1, cx
   111                              <2> 		; %1 is CL or an immediate
   112                              <2> 		shrd	ax, dx, %1
   113                              <2> 		shr		dx, %1
   114                              <2> 	%else
   115                              <2> 		; %1 is CX
   116                              <2> 		shrd	ax, dx, cl
   117                              <2> 		shr		dx, cl
   118                              <2> 	%endif
   119                              <2> %else
   120                              <2> 	%ifidni %1, cl
   121                              <2> 		; %1 is CL
   122                              <2> 		xor		ch, ch
   123                              <2> 	%elifnidni %1, cx
   124                              <2> 		; %1 is an immediate
   125                              <2> 		mov		cx, %1
   126                              <2> 	%endif
   127                              <2> ALIGN JUMP_ALIGN
   128                              <2> .ShiftNextBit:
   129                              <2> 	shr		dx, 1
   130                              <2> 	rcr		ax, 1
   131                              <2> 	loop	.ShiftNextBit
   132                              <2> %endif
   133                              <2> %endmacro
   134                              <2> 
   135                              <2> 
   136                              <2> %endif ; MATH_INC
    18                              <1> %include "Registers.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	Register related macros.
     3                              <2> %ifndef REGISTERS_INC
     4                              <2> %define REGISTERS_INC
     5                              <2> 
     6                              <2> struc INTPACK
     7                              <2> %ifdef USE_386
     8                              <2> ;	.gs				resb	2
     9                              <2> ;	.fs				resb	2
    10                              <2> %endif
    11 00000000 ????                <2> 	.es				resb	2
    12 00000002 ????                <2> 	.ds				resb	2
    13 00000004 ????                <2> 	.di				resb	2
    14 00000006 ????                <2> 	.si				resb	2
    15 00000008 ????                <2> 	.bp				resb	2
    16 0000000A ????                <2> 	.sp				resb	2
    17                              <2> 	.bx:
    18 0000000C ??                  <2> 	.bl				resb	1
    19 0000000D ??                  <2> 	.bh				resb	1
    20                              <2> 	.dx:
    21 0000000E ??                  <2> 	.dl				resb	1
    22 0000000F ??                  <2> 	.dh				resb	1
    23                              <2> 	.cx:
    24 00000010 ??                  <2> 	.cl				resb	1
    25 00000011 ??                  <2> 	.ch				resb	1
    26                              <2> 	.ax:
    27 00000012 ??                  <2> 	.al				resb	1
    28 00000013 ??                  <2> 	.ah				resb	1
    29 00000014 ????                <2> 	.ip				resb	2
    30 00000016 ????                <2> 	.cs				resb	2
    31 00000018 ????                <2> 	.flags			resb	2
    32                              <2> endstruc
    33                              <2> 
    34                              <2> ; 8086/8088 FLAGS
    35                              <2> FLG_FLAGS_CF		EQU (1<<0)
    36                              <2> FLG_FLAGS_PF		EQU (1<<2)
    37                              <2> FLG_FLAGS_AF		EQU (1<<4)
    38                              <2> FLG_FLAGS_ZF		EQU (1<<6)
    39                              <2> FLG_FLAGS_SF		EQU (1<<7)
    40                              <2> FLG_FLAGS_TF		EQU (1<<8)
    41                              <2> FLG_FLAGS_IF		EQU (1<<9)
    42                              <2> FLG_FLAGS_DF		EQU (1<<10)
    43                              <2> FLG_FLAGS_OF		EQU (1<<11)
    44                              <2> 
