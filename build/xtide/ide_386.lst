    48                                  	%include "AssemblyLibrary.inc"	; Assembly Library. Must be included first!
     1                              <1> ; Project name	:	Assembly Library
     2                              <1> ; Description	:	Common defines for all library functions.
     3                              <1> %ifndef ASSEMBLY_LIBRARY_INC
     4                              <1> %define ASSEMBLY_LIBRARY_INC
     5                              <1> 
     6                              <1> ; Include .inc files
     7                              <1> %include "Emulate.inc"			; Must be included first!
     1                              <2> ; Project name	:	Emulation library
     2                              <2> ; Description	:	Macros for emulating later x86 instructions with older
     3                              <2> ;					processors.
     4                              <2> ;					Macros are used so optimized builds can be done
     5                              <2> ;					easily for different processors.
     6                              <2> ;
     7                              <2> ;					This file must be first to be included to
     8                              <2> ;					any source file.
     9                              <2> %ifndef EMULATE_INC
    10                              <2> %define EMULATE_INC
    11                              <2> 
    12                              <2> ; Defines for processor support (should be set in makefile).
    13                              <2> ; Unsupported instructions will be emulated using macros.
    14                              <2> ; If AT class PC is used (instead of XT), define USE_AT
    15                              <2> 
    16                              <2> ;%define USE_186				; Define to use 18x/V20/V30 instructions
    17                              <2> ;%define USE_286				; Define to use 286 instructions
    18                              <2> ;%define USE_386				; Define to use 386 instructions
    19                              <2> ;%define USE_AT					; Define for AT class machine
    20                              <2> 
    21                              <2> %ifdef USE_NEC_V				; This will run on NEC V20/V30 processors only
    22                              <2> 	%define USE_186				; Define to use 18x/V20/V30 instructions
    23                              <2> 	%ifdef USE_UNDOC_INTEL OR USE_286 OR USE_386
    24                              <2> 		%fatal "Conflicting processor define used together with USE_NEC_V!"
    25                              <2> 	%endif
    26                              <2> %endif
    27                              <2> 
    28                              <2> %ifdef USE_386
    29                              <2> 	%define USE_286				; Define to use 286 instructions
    30                              <2> %endif
    31                              <2> %ifdef USE_286
    32                              <2> 	%define USE_186				; Define to use 18x/V20/V30 instructions
    33                              <2> 	%define USE_UNDOC_INTEL		; Not supported by NEC V20/V30
    34                              <2> %endif
    35                              <2> 
    36                              <2> %ifdef USE_386
    37                              <2> 	CPU 386						; Allow instructions up to 386
    38                              <2> %elifdef USE_286
    39                              <2> 	CPU 286						; Allow instructions up to 286
    40                              <2> %elifdef USE_186
    41                              <2> 	CPU 186						; Allow instructions up to 188/186/V20/V30
    42                              <2> %else
    43                              <2> 	CPU 8086					; Allow 8088/8086 instructions only
    44                              <2> %endif
    45                              <2> 
    46                              <2> BITS 16							; Set 16 bit code generation
    47                              <2> 
    48                              <2> ; Alignments for jump targets.
    49                              <2> ; Following values are optimal for different processor types:
    50                              <2> ; 286 and 386SX			WORD (16-bit, 2 bytes)
    51                              <2> ; 386DX and 486			DWORD (32-bit, 4 bytes)
    52                              <2> ; Pentium and later		QWORD (64-bit, 8 bytes)
    53                              <2> %ifdef USE_AT
    54                              <2> 	%ifdef USE_386
    55                              <2> 		JUMP_ALIGN		EQU		4
    56                              <2> 		WORD_ALIGN		EQU		2
    57                              <2> 	%else ; USE_286
    58                              <2> 		JUMP_ALIGN		EQU		2
    59                              <2> 		WORD_ALIGN		EQU		2
    60                              <2> 	%endif
    61                              <2> %else ; XT
    62                              <2> 	%ifndef USE_086 ; 8088/V20 CPUs
    63                              <2> 		JUMP_ALIGN		EQU		1	; 2 is optimal for 8086 and NEC V30 CPUs but it's not worth the ROM space for most XT machines with 8088 or NEC V20 CPUs.
    64                              <2> 		WORD_ALIGN		EQU		2	; The same applies here but the cost of ROM space is negligible.
    65                              <2> 	%else ; 8086/V30 CPUs
    66                              <2> 		JUMP_ALIGN		EQU		2
    67                              <2> 		WORD_ALIGN		EQU		2
    68                              <2> 	%endif
    69                              <2> %endif
    70                              <2> 
    71                              <2> ;==========================================================================
    72                              <2> 
    73                              <2> ;--------------------------------------------------------------------
    74                              <2> ; Find String In String
    75                              <2> ;
    76                              <2> ; FSIS
    77                              <2> ;	Parameters:
    78                              <2> ;		%1:		String to search for (case-insensitive)
    79                              <2> ;		%2:		String to search in
    80                              <2> ;	Returns:
    81                              <2> ;	strpos:		Position of %1 in %2 if found, 0 if not found
    82                              <2> ;--------------------------------------------------------------------
    83                              <2> %macro FSIS 2.nolist
    84                              <2> %defstr	s1 %1
    85                              <2> %defstr	s2 %2
    86                              <2> %strlen sl1 s1
    87                              <2> %strlen sl2 s2
    88                              <2> %assign strpos 0
    89                              <2> 	%if sl1 <= sl2
    90                              <2> 		%assign strpos sl2 - sl1 + 1
    91                              <2> 		%rep strpos
    92                              <2> 			%substr %%ss s2 strpos, sl1
    93                              <2> 			%ifidni %%ss, s1
    94                              <2> 				%exitrep
    95                              <2> 			%else
    96                              <2> 				%assign strpos strpos - 1
    97                              <2> 			%endif
    98                              <2> 		%endrep
    99                              <2> 	%endif
   100                              <2> %endmacro
   101                              <2> 
   102                              <2> 
   103                              <2> %ifdef USE_NEC_V
   104                              <2> 	%include "NEC_V.inc"
   105                              <2> %endif
   106                              <2> 
   107                              <2> 
   108                              <2> ;--------------------------------------------------------------------
   109                              <2> ; The undocumented instruction SALC (Set AL According to CF).
   110                              <2> ; Available on all Intel processors and truly compatible clones.
   111                              <2> ; Does not work on the NEC V20/V30 or Sony CXQ70108 processors.
   112                              <2> ;
   113                              <2> ; eSALC
   114                              <2> ;	Parameters:
   115                              <2> ;		Nothing
   116                              <2> ;	Returns:
   117                              <2> ;		AL:		FFh if CF=1
   118                              <2> ;				00h if CF=0
   119                              <2> ;	Corrupts registers:
   120                              <2> ;		Nothing
   121                              <2> ;--------------------------------------------------------------------
   122                              <2> %macro eSALC 0
   123                              <2> ;	db		0D6h
   124                              <2> 	salc
   125                              <2> %endmacro
   126                              <2> 
   127                              <2> 
   128                              <2> ;--------------------------------------------------------------------
   129                              <2> ; The AAD instruction (ASCII Adjust before Division).
   130                              <2> ; Available on all Intel processors and truly compatible clones.
   131                              <2> ; Does not work on the NEC V20/V30 or Sony CXQ70108 processors
   132                              <2> ; unless %1 is 10 (0Ah).
   133                              <2> ;
   134                              <2> ; eAAD
   135                              <2> ;	Parameters:
   136                              <2> ;		%1:		Any 8 bit number (0...255)
   137                              <2> ;	Returns:
   138                              <2> ;		AL:		AH * %1 + AL
   139                              <2> ;		AH:		0
   140                              <2> ;		Flags:	Set according to result
   141                              <2> ;	Corrupts registers:
   142                              <2> ;		Nothing
   143                              <2> ;--------------------------------------------------------------------
   144                              <2> %macro eAAD 1
   145                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   146                              <2> 	%if %1 > 255
   147                              <2> 		%error Invalid parameter passed to eAAD (%1 > 255)
   148                              <2> 	%else
   149                              <2> 		db		0D5h, %1
   150                              <2> 	%endif
   151                              <2> %endif
   152                              <2> %endmacro
   153                              <2> 
   154                              <2> 
   155                              <2> ;--------------------------------------------------------------------
   156                              <2> ; The AAM instruction (ASCII Adjust after Multiplication).
   157                              <2> ;
   158                              <2> ; eAAM
   159                              <2> ;	Parameters:
   160                              <2> ;		%1:		Any 8 bit number except 0 (1...255)
   161                              <2> ;	Returns:
   162                              <2> ;		AL:		AL MOD %1
   163                              <2> ;		AH:		AL / %1
   164                              <2> ;		Flags:	Set according to result
   165                              <2> ;	Corrupts registers:
   166                              <2> ;		Nothing
   167                              <2> ;--------------------------------------------------------------------
   168                              <2> %macro eAAM 1
   169                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   170                              <2> 	%if %1 > 255
   171                              <2> 		%error Invalid parameter passed to eAAM (%1 > 255)
   172                              <2> 	%elif %1 = 0
   173                              <2> 		%error Invalid parameter passed to eAAM (%1 = 0). This would cause a divide-by-zero exception!
   174                              <2> 	%else
   175                              <2> 		db		0D4h, %1
   176                              <2> 	%endif
   177                              <2> %endif
   178                              <2> %endmacro
   179                              <2> 
   180                              <2> 
   181                              <2> ;--------------------------------------------------------------------
   182                              <2> ; Emulates BSF (Bit Scan Forward) instruction when necessary.
   183                              <2> ; BSF is used to find index of least significant bit.
   184                              <2> ;
   185                              <2> ; eBSF
   186                              <2> ;	Parameters:
   187                              <2> ;		%1:		Destination WORD Register for bit index (not CX or same as %2!)
   188                              <2> ;		%2:		Source WORD operand where to search bit (not CX or same as %1!)
   189                              <2> ;	Returns:
   190                              <2> ;		%1:		Index of lowest order bit from %2
   191                              <2> ;		ZF:		Set if %2 is zero
   192                              <2> ;				Cleared if %2 is non-zero
   193                              <2> ;	Corrupts registers:
   194                              <2> ;		Nothing
   195                              <2> ;--------------------------------------------------------------------
   196                              <2> %macro eBSF 2
   197                              <2> %ifndef USE_386
   198                              <2> 	FSIS	], %2				; %2 is a memory operand?
   199                              <2> 	%if strpos
   200                              <2> 		cmp		WORD %2, BYTE 0	; Source operand is zero?
   201                              <2> 		je		SHORT %%Return	;  If so, return with ZF set
   202                              <2> 	%else						; No, %2 is a register
   203                              <2> 		test	%2, %2
   204                              <2> 		jz		SHORT %%Return
   205                              <2> 	%endif
   206                              <2> 
   207                              <2> 	push	cx
   208                              <2> 
   209                              <2> %ifdef USE_NEC_V
   210                              <2> 	mov		cx, -1
   211                              <2> 
   212                              <2> ALIGN JUMP_ALIGN
   213                              <2> %%BitLoop:
   214                              <2> 	inc		cx
   215                              <2> 	eTEST1	%2, cl
   216                              <2> 	jz		SHORT %%BitLoop
   217                              <2> 	mov		%1, cx
   218                              <2> 
   219                              <2> %else ; ~USE_NEC_V
   220                              <2> 	mov		cx, 1<<15
   221                              <2> 	mov		%1, -1
   222                              <2> 
   223                              <2> ALIGN JUMP_ALIGN
   224                              <2> %%BitLoop:
   225                              <2> 	rol		cx, 1				; Prepare to test next bit
   226                              <2> 	inc		%1					; Increment bit index
   227                              <2> 	test	%2, cx				; Bit set?
   228                              <2> 	jz		SHORT %%BitLoop
   229                              <2> %endif
   230                              <2> 
   231                              <2> 	pop		cx
   232                              <2> 
   233                              <2> %%Return:
   234                              <2> ;-----------------------------------
   235                              <2> %else ; USE_386
   236                              <2> 	bsf		%1, %2
   237                              <2> %endif
   238                              <2> %endmacro
   239                              <2> 
   240                              <2> 
   241                              <2> ;--------------------------------------------------------------------
   242                              <2> ; Emulates BSR (Bit Scan Reverse) instruction when necessary.
   243                              <2> ; BSR is used to find index of most significant bit.
   244                              <2> ;
   245                              <2> ; eBSR
   246                              <2> ;	Parameters:
   247                              <2> ;		%1:		Destination WORD Register for bit index (not CX or same as %2!)
   248                              <2> ;		%2:		Source WORD operand where to search bit (not CX or same as %1!)
   249                              <2> ;	Returns:
   250                              <2> ;		%1:		Index of highest order bit from %2
   251                              <2> ;		ZF:		Set if %2 is zero
   252                              <2> ;				Cleared if %2 is non-zero
   253                              <2> ;	Corrupts registers:
   254                              <2> ;		Nothing
   255                              <2> ;--------------------------------------------------------------------
   256                              <2> %macro eBSR 2
   257                              <2> %ifndef USE_386
   258                              <2> 	FSIS	], %2				; %2 is a memory operand?
   259                              <2> 	%if strpos
   260                              <2> 		cmp		WORD %2, BYTE 0	; Source operand is zero?
   261                              <2> 		je		SHORT %%Return	;  If so, return with ZF set
   262                              <2> 	%else						; No, %2 is a register
   263                              <2> 		test	%2, %2
   264                              <2> 		jz		SHORT %%Return
   265                              <2> 	%endif
   266                              <2> 
   267                              <2> 	push	cx
   268                              <2> 
   269                              <2> %ifdef USE_NEC_V
   270                              <2> 	mov		cx, 16
   271                              <2> 
   272                              <2> ALIGN JUMP_ALIGN
   273                              <2> %%BitLoop:
   274                              <2> 	dec		cx
   275                              <2> 	eTEST1	%2, cl
   276                              <2> 	jz		SHORT %%BitLoop
   277                              <2> 	mov		%1, cx
   278                              <2> 
   279                              <2> %else ; ~USE_NEC_V
   280                              <2> 	mov		cx, 1
   281                              <2> 	mov		%1, 16
   282                              <2> 
   283                              <2> ALIGN JUMP_ALIGN
   284                              <2> %%BitLoop:
   285                              <2> 	ror		cx, 1				; Prepare to test next bit
   286                              <2> 	dec		%1					; Decrement bit index
   287                              <2> 	test	%2, cx				; Bit set?
   288                              <2> 	jz		SHORT %%BitLoop
   289                              <2> %endif
   290                              <2> 
   291                              <2> 	pop		cx
   292                              <2> 
   293                              <2> %%Return:
   294                              <2> ;-----------------------------------
   295                              <2> %else ; USE_386
   296                              <2> 	bsr		%1, %2
   297                              <2> %endif
   298                              <2> %endmacro
   299                              <2> 
   300                              <2> 
   301                              <2> ;--------------------------------------------------------------------
   302                              <2> ; Conditional Move.
   303                              <2> ;
   304                              <2> ; eCMOVcc
   305                              <2> ;	Parameters:
   306                              <2> ;		%1:		Destination data
   307                              <2> ;		%2:		Source data
   308                              <2> ;	Returns:
   309                              <2> ;		Nothing
   310                              <2> ;	Corrupts registers:
   311                              <2> ;		Nothing
   312                              <2> ;--------------------------------------------------------------------
   313                              <2> %macro eCMOVA 2
   314                              <2> 	jbe		SHORT %%Return
   315                              <2> 	mov		%1, %2
   316                              <2> %%Return:
   317                              <2> %endmacro
   318                              <2> 
   319                              <2> %macro eCMOVC 2
   320                              <2> 	jnc		SHORT %%Return
   321                              <2> 	mov		%1, %2
   322                              <2> %%Return:
   323                              <2> %endmacro
   324                              <2> 
   325                              <2> %macro eCMOVNC 2
   326                              <2> 	jc		SHORT %%Return
   327                              <2> 	mov		%1, %2
   328                              <2> %%Return:
   329                              <2> %endmacro
   330                              <2> 
   331                              <2> %macro eCMOVZ 2
   332                              <2> 	jnz		SHORT %%Return
   333                              <2> 	mov		%1, %2
   334                              <2> %%Return:
   335                              <2> %endmacro
   336                              <2> 
   337                              <2> %macro eCMOVNZ 2
   338                              <2> 	jz		SHORT %%Return
   339                              <2> 	mov		%1, %2
   340                              <2> %%Return:
   341                              <2> %endmacro
   342                              <2> 
   343                              <2> %macro eCMOVE 2
   344                              <2> 	eCMOVZ	%1, %2
   345                              <2> %endmacro
   346                              <2> 
   347                              <2> %macro eCMOVNE 2
   348                              <2> 	eCMOVNZ	%1, %2
   349                              <2> %endmacro
   350                              <2> 
   351                              <2> %macro eCMOVB 2
   352                              <2> 	eCMOVC	%1, %2
   353                              <2> %endmacro
   354                              <2> 
   355                              <2> %macro eCMOVS 2
   356                              <2> 	jns		SHORT %%Return
   357                              <2> 	mov		%1, %2
   358                              <2> %%Return:
   359                              <2> %endmacro
   360                              <2> 
   361                              <2> %macro eCMOVNS 2
   362                              <2> 	js		SHORT %%Return
   363                              <2> 	mov		%1, %2
   364                              <2> %%Return:
   365                              <2> %endmacro
   366                              <2> 
   367                              <2> 
   368                              <2> ;--------------------------------------------------------------------
   369                              <2> ; Conditional Set.
   370                              <2> ;
   371                              <2> ; eSETcc
   372                              <2> ;	Parameters:
   373                              <2> ;		%1:		Destination data
   374                              <2> ;	Returns:
   375                              <2> ;		Nothing
   376                              <2> ;	Corrupts registers:
   377                              <2> ;		Flags
   378                              <2> ;--------------------------------------------------------------------
   379                              <2> %macro eSETZ 1
   380                              <2> 	mov		%1, 0			; Clear while preserving flags
   381                              <2> 	jnz		SHORT %%Return	; Nothing to set
   382                              <2> 	inc		%1
   383                              <2> %%Return:
   384                              <2> %endmacro
   385                              <2> 
   386                              <2> %macro eSETNZ 1
   387                              <2> 	mov		%1, 0			; Clear while preserving flags
   388                              <2> 	jz		SHORT %%Return	; Nothing to set
   389                              <2> 	inc		%1
   390                              <2> %%Return:
   391                              <2> %endmacro
   392                              <2> 
   393                              <2> 
   394                              <2> ;--------------------------------------------------------------------
   395                              <2> ; Moves byte with zero-extending to any Register.
   396                              <2> ;
   397                              <2> ; eMOVZX
   398                              <2> ;	Parameters:
   399                              <2> ;		%1:		Destination Register (SP not supported)
   400                              <2> ;		%2:		Byte register or byte address
   401                              <2> ;	Returns:
   402                              <2> ;		Nothing
   403                              <2> ;	Corrupts registers:
   404                              <2> ;		FLAGS
   405                              <2> ;--------------------------------------------------------------------
   406                              <2> %macro eMOVZX 2
   407                              <2> %ifndef USE_386
   408                              <2> 	%ifidni %1, ax
   409                              <2> 		mov		al, %2
   410                              <2> 		xor		ah, ah
   411                              <2> 	%elifidni %1, bx
   412                              <2> 		mov		bl, %2
   413                              <2> 		xor		bh, bh		; %2 may use BX in effective address
   414                              <2> 	%elifidni %1, cx
   415                              <2> 		mov		cl, %2
   416                              <2> 		xor		ch, ch
   417                              <2> 	%elifidni %1, dx
   418                              <2> 		mov		dl, %2
   419                              <2> 		xor		dh, dh
   420                              <2> 	%else	; SI, DI, BP (all may be used in effective address)
   421                              <2> 		FSIS	%1, %2
   422                              <2> 		%if strpos
   423                              <2> 			push	ax
   424                              <2> 			mov		al, %2
   425                              <2> 			xor		ah, ah
   426                              <2> 			xchg	%1, ax
   427                              <2> 			pop		ax
   428                              <2> 		%else
   429                              <2> 			xchg	%1, ax
   430                              <2> 			mov		al, %2
   431                              <2> 			xor		ah, ah
   432                              <2> 			xchg	%1, ax
   433                              <2> 		%endif
   434                              <2> 	%endif
   435                              <2> ;-----------------------------------
   436                              <2> %else
   437                              <2> 	movzx	%1, %2
   438                              <2> %endif
   439                              <2> %endmacro
   440                              <2> 
   441                              <2> 
   442                              <2> ;--------------------------------------------------------------------
   443                              <2> ; Emulates PUSHA instruction when necessary.
   444                              <2> ;
   445                              <2> ; ePUSHA
   446                              <2> ;	Parameters:
   447                              <2> ;		Nothing
   448                              <2> ;	Returns:
   449                              <2> ;		Nothing
   450                              <2> ;	Corrupts registers:
   451                              <2> ;		Nothing
   452                              <2> ;--------------------------------------------------------------------
   453                              <2> %macro ePUSHA 0
   454                              <2> %ifndef USE_186
   455                              <2> 	push	ax
   456                              <2> 	push	cx
   457                              <2> 	push	dx
   458                              <2> 	push	bx
   459                              <2> 	push	sp
   460                              <2> 	push	bp
   461                              <2> 	push	si
   462                              <2> 	push	di
   463                              <2> ;-----------------------------------
   464                              <2> %else
   465                              <2> 	pusha
   466                              <2> %endif
   467                              <2> %endmacro
   468                              <2> 
   469                              <2> 
   470                              <2> ;--------------------------------------------------------------------
   471                              <2> ; Emulates POPA instruction when necessary.
   472                              <2> ;
   473                              <2> ; ePOPA
   474                              <2> ;	Parameters:
   475                              <2> ;		Nothing
   476                              <2> ;	Returns:
   477                              <2> ;		Nothing
   478                              <2> ;	Corrupts registers:
   479                              <2> ;		Nothing
   480                              <2> ;--------------------------------------------------------------------
   481                              <2> %macro ePOPA 0
   482                              <2> %ifndef USE_186
   483                              <2> 	pop		di
   484                              <2> 	pop		si
   485                              <2> 	pop		bp
   486                              <2> 	pop		ax		; Skip SP
   487                              <2> 	pop		bx
   488                              <2> 	pop		dx
   489                              <2> 	pop		cx
   490                              <2> 	pop		ax
   491                              <2> ;-----------------------------------
   492                              <2> %else
   493                              <2> 	popa
   494                              <2> %endif
   495                              <2> %endmacro
   496                              <2> 
   497                              <2> 
   498                              <2> ;--------------------------------------------------------------------
   499                              <2> ; Emulates ENTER instruction when necessary.
   500                              <2> ;
   501                              <2> ; eENTER
   502                              <2> ;	Parameters:
   503                              <2> ;		%1:		Number of bytes to reserve from stack
   504                              <2> ;		%2:		The lexical nesting level (not emulated, set to 0)
   505                              <2> ;	Returns:
   506                              <2> ;		SS:BP:	Ptr to old BP
   507                              <2> ;				([bp-2] points to highest local stack frame word)
   508                              <2> ;	Corrupts registers:
   509                              <2> ;		FLAGS
   510                              <2> ;--------------------------------------------------------------------
   511                              <2> %macro eENTER 2
   512                              <2> %ifndef USE_186
   513                              <2> 	push	bp
   514                              <2> 	mov		bp, sp
   515                              <2> 	sub		sp, %1
   516                              <2> ;-----------------------------------
   517                              <2> %else
   518                              <2> 	enter	%1, %2
   519                              <2> %endif
   520                              <2> %endmacro
   521                              <2> 
   522                              <2> ;--------------------------------------------------------------------
   523                              <2> ; Emulates LEAVE instruction when necessary.
   524                              <2> ;
   525                              <2> ; eLEAVE
   526                              <2> ;	Parameters:
   527                              <2> ;		Nothing
   528                              <2> ;	Returns:
   529                              <2> ;		BP:		What it was before eENTER
   530                              <2> ;	Corrupts registers:
   531                              <2> ;		Nothing
   532                              <2> ;--------------------------------------------------------------------
   533                              <2> %macro eLEAVE 0
   534                              <2> %ifndef USE_186
   535                              <2> 	mov		sp, bp
   536                              <2> 	pop		bp
   537                              <2> ;-----------------------------------
   538                              <2> %else
   539                              <2> 	leave
   540                              <2> %endif
   541                              <2> %endmacro
   542                              <2> 
   543                              <2> 
   544                              <2> ;--------------------------------------------------------------------
   545                              <2> ; Emulates LSS instruction when necessary.
   546                              <2> ;
   547                              <2> ; eLSS
   548                              <2> ;	Parameters:
   549                              <2> ;		%1:		Destination register
   550                              <2> ;		%2:		Source memory address without brackets
   551                              <2> ;	Returns:
   552                              <2> ;		IF:		0 (interrupts disabled)
   553                              <2> ;	Corrupts registers:
   554                              <2> ;		Nothing
   555                              <2> ;--------------------------------------------------------------------
   556                              <2> %macro eLSS 2
   557                              <2> %ifndef USE_386
   558                              <2> 	cli							; Disable interrupts
   559                              <2> 	mov		%1, [%2]			; Load offset
   560                              <2> 	mov		ss, [%2+2]			; Load segment
   561                              <2> ;-----------------------------------
   562                              <2> %else
   563                              <2> 	lss		%1, [%2]
   564                              <2> %endif
   565                              <2> %endmacro
   566                              <2> 
   567                              <2> 
   568                              <2> ;--------------------------------------------------------------------
   569                              <2> ; Repeats string instruction with segment override.
   570                              <2> ; This macro prevents 8088/8086 restart bug.
   571                              <2> ;
   572                              <2> ; eSEG_STR
   573                              <2> ;	Parameters:
   574                              <2> ;		%1:		REP/REPE/REPZ or REPNE/REPNZ prefix
   575                              <2> ;		%2:		Source segment override (destination is always ES)
   576                              <2> ;		%3:		String instruction
   577                              <2> ;		%4:		An exclamation mark (!) if the state of the IF must
   578                              <2> ;				be preserved (can not be used together with CMPS or
   579                              <2> ;				SCAS instructions), otherwise it will be set on
   580                              <2> ;				return from the macro (i.e. interrupts will be on)
   581                              <2> ;		CX:		Repeat count
   582                              <2> ;	Returns:
   583                              <2> ;		FLAGS for CMPS and SCAS only
   584                              <2> ;	Corrupts registers:
   585                              <2> ;		FLAGS
   586                              <2> ;--------------------------------------------------------------------
   587                              <2> %macro eSEG_STR 3-4
   588                              <2> %ifndef USE_186	; 8088/8086 has string instruction restart bug when using more than one prefix
   589                              <2> %ifidn %4, !				; Preserve the IF
   590                              <2> 	FSIS	cmps, %3
   591                              <2> %ifn strpos
   592                              <2> 	FSIS	scas, %3
   593                              <2> %endif
   594                              <2> %if strpos
   595                              <2> 	%error "The state of the IF can not be preserved when using CMPS or SCAS!"
   596                              <2> %endif
   597                              <2> 	pushf
   598                              <2> 	cli
   599                              <2> 	%1						; REP is the prefix that can be lost
   600                              <2> 	%2						; SEG is the prefix that won't be lost
   601                              <2> 	%3						; String instruction
   602                              <2> 	popf
   603                              <2> %else						; No need to preserve the IF
   604                              <2> 	cli
   605                              <2> 	%1
   606                              <2> 	%2
   607                              <2> 	%3
   608                              <2> 	sti
   609                              <2> %endif
   610                              <2> %else	; No bug on V20/V30/188/186 and later
   611                              <2> 	%2
   612                              <2> 	%1 %3
   613                              <2> %endif
   614                              <2> %endmacro
   615                              <2> 
   616                              <2> 
   617                              <2> ;--------------------------------------------------------------------
   618                              <2> ; Bit shifts and rotates with immediate.
   619                              <2> ;
   620                              <2> ; eSHIFT_IM
   621                              <2> ;	Parameters:
   622                              <2> ;		%1:		Shift target
   623                              <2> ;		%2:		Number of bits to shift
   624                              <2> ;		%3:		Instruction (SHL, SHR, ROL, ROR, RCL, RCR)
   625                              <2> ;	Returns:
   626                              <2> ;		FLAGS
   627                              <2> ;	Corrupts registers:
   628                              <2> ;		Nothing
   629                              <2> ;--------------------------------------------------------------------
   630                              <2> %macro eSHIFT_IM 3
   631                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <2> %ifndef USE_186
   633                              <2> 	%ifidni %1, cl
   634                              <2> 		times %2	%3		%1, 1
   635                              <2> 	%elifidni %1, ch
   636                              <2> 		times %2	%3		%1, 1
   637                              <2> 	%elifidni %1, cx
   638                              <2> 		times %2	%3		%1, 1
   639                              <2> 	%else
   640                              <2> 		%if %2 > 3	; Size optimized value
   641                              <2> 			push	cx
   642                              <2> 			mov		cl, %2
   643                              <2> 			%3		%1, cl
   644                              <2> 			pop		cx
   645                              <2> 		%else
   646                              <2> 			times %2	%3		%1, 1
   647                              <2> 		%endif
   648                              <2> 	%endif
   649                              <2> ;-----------------------------------
   650                              <2> %else
   651                              <2> 	%3		%1, %2
   652                              <2> %endif
   653                              <2> %endif
   654                              <2> %endmacro
   655                              <2> 
   656                              <2> %macro eSHR_IM 2
   657                              <2> 	eSHIFT_IM	%1, %2, shr
   658                              <2> %endmacro
   659                              <2> 
   660                              <2> %macro eSHL_IM 2
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2> 	%if %2 = 1
   664                              <2> 		FSIS	], %1
   665                              <2> 		%if strpos
   666                              <2> 			eSHIFT_IM	%1, %2, shl
   667                              <2> 		%else
   668                              <2> 			add		%1, %1	; Same size but faster on 386 and 486.
   669                              <2> 		%endif
   670                              <2> 	%else
   671                              <2> 		eSHIFT_IM	%1, %2, shl
   672                              <2> 	%endif
   673                              <2> %else
   674                              <2> 	eSHIFT_IM	%1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
   677                              <2> %endmacro
   678                              <2> 
   679                              <2> %macro eROR_IM 2
   680                              <2> 	eSHIFT_IM	%1, %2, ror
   681                              <2> %endmacro
   682                              <2> 
   683                              <2> %macro eROL_IM 2
   684                              <2> 	eSHIFT_IM	%1, %2, rol
   685                              <2> %endmacro
   686                              <2> 
   687                              <2> %macro eRCR_IM 2
   688                              <2> 	eSHIFT_IM	%1, %2, rcr
   689                              <2> %endmacro
   690                              <2> 
   691                              <2> %macro eRCL_IM 2
   692                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   693                              <2> %ifdef USE_386
   694                              <2> 	%if %2 = 1
   695                              <2> 		FSIS	], %1
   696                              <2> 		%if strpos
   697                              <2> 			eSHIFT_IM	%1, %2, rcl
   698                              <2> 		%else
   699                              <2> 			adc		%1, %1	; Same size but faster on 386 and 486.
   700                              <2> 		%endif
   701                              <2> 	%else
   702                              <2> 		eSHIFT_IM	%1, %2, rcl
   703                              <2> 	%endif
   704                              <2> %else
   705                              <2> 	eSHIFT_IM	%1, %2, rcl
   706                              <2> %endif
   707                              <2> %endif
   708                              <2> %endmacro
   709                              <2> 
   710                              <2> 
   711                              <2> ;--------------------------------------------------------------------
   712                              <2> ; Emulates PUSH imm instruction when necessary.
   713                              <2> ;
   714                              <2> ; ePUSH_I
   715                              <2> ;	Parameters:
   716                              <2> ;		%1:		Immediate to push
   717                              <2> ;	Returns:
   718                              <2> ;		Nothing
   719                              <2> ;	Corrupts registers:
   720                              <2> ;		Nothing
   721                              <2> ;--------------------------------------------------------------------
   722                              <2> %macro ePUSH_I 1
   723                              <2> %ifndef USE_186
   724                              <2> 	push	bp					; Immediate goes here
   725                              <2> 	push	bp
   726                              <2> 	mov		bp, sp
   727                              <2> 	mov		WORD [bp+2], %1
   728                              <2> 	pop		bp
   729                              <2> ;-----------------------------------
   730                              <2> %else
   731                              <2> 	push	%1
   732                              <2> %endif
   733                              <2> %endmacro
   734                              <2> 
   735                              <2> 
   736                              <2> ;--------------------------------------------------------------------
   737                              <2> ; Emulates PUSH imm instruction when necessary.
   738                              <2> ; ePUSH_T uses temporary register for faster performance
   739                              <2> ; and smaller code size than ePUSH_I.
   740                              <2> ;
   741                              <2> ; ePUSH_T
   742                              <2> ;	Parameters:
   743                              <2> ;		%1:		Temporary Register
   744                              <2> ;		%2:		Immediate to push
   745                              <2> ;	Returns:
   746                              <2> ;		Nothing
   747                              <2> ;	Corrupts registers:
   748                              <2> ;		%1
   749                              <2> ;--------------------------------------------------------------------
   750                              <2> %macro ePUSH_T 2
   751                              <2> %ifndef USE_186
   752                              <2> 	%ifidni %2, 0
   753                              <2> 		xor		%1, %1
   754                              <2> 	%else
   755                              <2> 		mov		%1, %2
   756                              <2> 	%endif
   757                              <2> 	push	%1
   758                              <2> ;-----------------------------------
   759                              <2> %else
   760                              <2> 	push	%2
   761                              <2> %endif
   762                              <2> %endmacro
   763                              <2> 
   764                              <2> 
   765                              <2> %endif ; EMULATE_INC
     8                              <1> %include "Macros.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	This is the place to put various generic macros.
     3                              <2> ;					Should be included immediately after Emulate.inc
     4                              <2> %ifndef MACROS_INC
     5                              <2> %define MACROS_INC
     6                              <2> 
     7                              <2> 
     8                              <2> ;--------------------------------------------------------------------
     9                              <2> ; The long (two byte) form of PUSH. Supported by NEC V20/V30.
    10                              <2> ;
    11                              <2> ; LPUSH
    12                              <2> ;	Parameters:
    13                              <2> ;		%1:		Any 16 bit general purpose register.
    14                              <2> ;	Returns:
    15                              <2> ;		Nothing
    16                              <2> ;	Corrupts registers:
    17                              <2> ;		Nothing
    18                              <2> ;--------------------------------------------------------------------
    19                              <2> %macro LPUSH 1.nolist
    20                              <2> 	%ifidni		%1, ax
    21                              <2> 		db		0FFh, 0F0h
    22                              <2> 	%elifidni	%1, cx
    23                              <2> 		db		0FFh, 0F1h
    24                              <2> 	%elifidni	%1, dx
    25                              <2> 		db		0FFh, 0F2h
    26                              <2> 	%elifidni	%1, bx
    27                              <2> 		db		0FFh, 0F3h
    28                              <2> 	%elifidni	%1, sp
    29                              <2> 		db		0FFh, 0F4h
    30                              <2> 	%elifidni	%1, bp
    31                              <2> 		db		0FFh, 0F5h
    32                              <2> 	%elifidni	%1, si
    33                              <2> 		db		0FFh, 0F6h
    34                              <2> 	%elifidni	%1, di
    35                              <2> 		db		0FFh, 0F7h
    36                              <2> 	%else
    37                              <2> 		%error "Invalid parameter passed to LPUSH"
    38                              <2> 	%endif
    39                              <2> %endmacro
    40                              <2> 
    41                              <2> 
    42                              <2> ;--------------------------------------------------------------------
    43                              <2> ; The long (two byte) form of POP. Not supported by NEC V20/V30.
    44                              <2> ; NEC V20/V30 CPU:s will adjust SP but not actually move the contents
    45                              <2> ; of the top WORD on the stack to the destination register.
    46                              <2> ;
    47                              <2> ; LPOP
    48                              <2> ;	Parameters:
    49                              <2> ;		%1:		Any 16 bit general purpose register.
    50                              <2> ;	Returns:
    51                              <2> ;		Nothing
    52                              <2> ;	Corrupts registers:
    53                              <2> ;		Nothing
    54                              <2> ;--------------------------------------------------------------------
    55                              <2> %macro LPOP 1.nolist
    56                              <2> 	%ifidni		%1, ax
    57                              <2> 		db		8Fh, 0C0h
    58                              <2> 	%elifidni	%1, cx
    59                              <2> 		db		8Fh, 0C1h
    60                              <2> 	%elifidni	%1, dx
    61                              <2> 		db		8Fh, 0C2h
    62                              <2> 	%elifidni	%1, bx
    63                              <2> 		db		8Fh, 0C3h
    64                              <2> 	%elifidni	%1, sp
    65                              <2> 		db		8Fh, 0C4h
    66                              <2> 	%elifidni	%1, bp
    67                              <2> 		db		8Fh, 0C5h
    68                              <2> 	%elifidni	%1, si
    69                              <2> 		db		8Fh, 0C6h
    70                              <2> 	%elifidni	%1, di
    71                              <2> 		db		8Fh, 0C7h
    72                              <2> 	%else
    73                              <2> 		%error "Invalid parameter passed to LPOP"
    74                              <2> 	%endif
    75                              <2> %endmacro
    76                              <2> 
    77                              <2> 
    78                              <2> ;--------------------------------------------------------------------
    79                              <2> ; Skips the immediately following 1 byte instruction by using it
    80                              <2> ; as an immediate value to a dummy instruction.
    81                              <2> ; Destroys the contents of %1.
    82                              <2> ;
    83                              <2> ; SKIP1B
    84                              <2> ;	Parameters:
    85                              <2> ;		%1:		Any 8 bit general purpose register or F for flags.
    86                              <2> ;	Returns:
    87                              <2> ;		Nothing
    88                              <2> ;	Corrupts registers:
    89                              <2> ;		%1
    90                              <2> ;--------------------------------------------------------------------
    91                              <2> %macro SKIP1B 1.nolist
    92                              <2> 	%ifidni		%1, f
    93                              <2> 		db		03Ch				; Opcode byte for CMP AL, <immed>
    94                              <2> 		;db		0A8h				; Alt. version TEST AL, <immed>
    95                              <2> 	%elifidni	%1, al
    96                              <2> 		db		0B0h				; Opcode byte for MOV AL, <immed>
    97                              <2> 	%elifidni	%1, ah
    98                              <2> 		db		0B4h				; Opcode byte for MOV AH, <immed>
    99                              <2> 	%elifidni	%1, bl
   100                              <2> 		db		0B3h				; Opcode byte for MOV BL, <immed>
   101                              <2> 	%elifidni	%1, bh
   102                              <2> 		db		0B7h				; Opcode byte for MOV BH, <immed>
   103                              <2> 	%elifidni	%1, cl
   104                              <2> 		db		0B1h				; Opcode byte for MOV CL, <immed>
   105                              <2> 	%elifidni	%1, ch
   106                              <2> 		db		0B5h				; Opcode byte for MOV CH, <immed>
   107                              <2> 	%elifidni	%1, dl
   108                              <2> 		db		0B2h				; Opcode byte for MOV DL, <immed>
   109                              <2> 	%elifidni	%1, dh
   110                              <2> 		db		0B6h				; Opcode byte for MOV DH, <immed>
   111                              <2> 	%else
   112                              <2> 		%error "Invalid parameter passed to SKIP1B"
   113                              <2> 	%endif
   114                              <2> %endmacro
   115                              <2> 
   116                              <2> 
   117                              <2> ;--------------------------------------------------------------------
   118                              <2> ; Skips the immediately following 2 byte instruction by using it
   119                              <2> ; as an immediate value to a dummy instruction.
   120                              <2> ; Destroys the contents of %1.
   121                              <2> ;
   122                              <2> ; SKIP2B
   123                              <2> ;	Parameters:
   124                              <2> ;		%1:		Any 16 bit general purpose register or F for flags.
   125                              <2> ;	Returns:
   126                              <2> ;		Nothing
   127                              <2> ;	Corrupts registers:
   128                              <2> ;		%1
   129                              <2> ;--------------------------------------------------------------------
   130                              <2> %macro SKIP2B 1.nolist
   131                              <2> 	%ifidni		%1, f
   132                              <2> 		db		03Dh				; Opcode byte for CMP AX, <immed>
   133                              <2> 		;db		0A9h				; Alt. version TEST AX, <immed>
   134                              <2> 	%elifidni	%1, ax
   135                              <2> 		db		0B8h				; Opcode byte for MOV AX, <immed>
   136                              <2> 	%elifidni	%1, cx
   137                              <2> 		db		0B9h				; Opcode byte for MOV CX, <immed>
   138                              <2> 	%elifidni	%1, dx
   139                              <2> 		db		0BAh				; Opcode byte for MOV DX, <immed>
   140                              <2> 	%elifidni	%1, bx
   141                              <2> 		db		0BBh				; Opcode byte for MOV BX, <immed>
   142                              <2> 	%elifidni	%1, sp
   143                              <2> 		db		0BCh				; Opcode byte for MOV SP, <immed>
   144                              <2> 	%elifidni	%1, bp
   145                              <2> 		db		0BDh				; Opcode byte for MOV BP, <immed>
   146                              <2> 	%elifidni	%1, si
   147                              <2> 		db		0BEh				; Opcode byte for MOV SI, <immed>
   148                              <2> 	%elifidni	%1, di
   149                              <2> 		db		0BFh				; Opcode byte for MOV DI, <immed>
   150                              <2> 	%else
   151                              <2> 		%error "Invalid parameter passed to SKIP2B"
   152                              <2> 	%endif
   153                              <2> %endmacro
   154                              <2> 
   155                              <2> 
   156                              <2> ;--------------------------------------------------------------------
   157                              <2> ; Load BDA (Bios Data Area) segment to wanted segment register.
   158                              <2> ;
   159                              <2> ; Use an exclamation point (!) as the third parameter when you want
   160                              <2> ; to force the use of the register in the second parameter. This is
   161                              <2> ; useful when that register needs to be zeroed in subsequent code or
   162                              <2> ; when stack usage is undesirable (ie speed is critical).
   163                              <2> ;
   164                              <2> ; The PRESERVE_FLAGS version will zero the register with a MOV instead
   165                              <2> ; of an XOR, thus preserving the flags.  It is one byte larger on
   166                              <2> ; non-186 or higher systems.
   167                              <2> ;
   168                              <2> ; LOAD_BDA_SEGMENT_TO
   169                              <2> ; LOAD_BDA_SEGMENT_PRESERVE_FLAGS_TO
   170                              <2> ;	Parameters:
   171                              <2> ;		%1:		Destination Segment Register
   172                              <2> ;		%2:		Temporary WORD Register
   173                              <2> ;		%3:		Can be ! or empty
   174                              <2> ;	Returns:
   175                              <2> ;		%1:		BDA segment (zero)
   176                              <2> ;	Corrupts registers:
   177                              <2> ;		%2
   178                              <2> ;--------------------------------------------------------------------
   179                              <2> %macro LOAD_BDA_SEGMENT_TO 2-3
   180                              <2> %ifndef USE_186
   181                              <2> 	xor		%2, %2
   182                              <2> 	mov		%1, %2
   183                              <2> %elifidn %3, !
   184                              <2> 	xor		%2, %2
   185                              <2> 	mov		%1, %2
   186                              <2> %else
   187                              <2> 	push	BYTE 0
   188                              <2> 	pop		%1
   189                              <2> %endif
   190                              <2> %endmacro
   191                              <2> 
   192                              <2> %macro LOAD_BDA_SEGMENT_PRESERVE_FLAGS_TO 2-3
   193                              <2> %ifndef USE_186
   194                              <2> 	mov		%2, 0
   195                              <2> 	mov		%1, %2
   196                              <2> %elifidn %3, !
   197                              <2> 	mov		%2, 0
   198                              <2> 	mov		%1, %2
   199                              <2> %else
   200                              <2> 	push	BYTE 0
   201                              <2> 	pop		%1
   202                              <2> %endif
   203                              <2> %endmacro
   204                              <2> 
   205                              <2> 
   206                              <2> ;--------------------------------------------------------------------
   207                              <2> ; eENTER_STRUCT
   208                              <2> ;	Parameters:
   209                              <2> ;		%1:		Number of bytes to reserve from stack
   210                              <2> ;	Returns:
   211                              <2> ;		SS:BP:	Ptr to beginning of struct reserved from stack
   212                              <2> ;	Corrupts registers:
   213                              <2> ;		FLAGS
   214                              <2> ;--------------------------------------------------------------------
   215                              <2> %macro eENTER_STRUCT 1
   216                              <2> 	push	bp
   217                              <2> 	sub		sp, %1
   218                              <2> 	mov		bp, sp
   219                              <2> %endmacro
   220                              <2> 
   221                              <2> ;--------------------------------------------------------------------
   222                              <2> ; eLEAVE_STRUCT
   223                              <2> ;	Parameters:
   224                              <2> ;		%1:		Number of bytes reserved with eENTER_STRUCT
   225                              <2> ;	Returns:
   226                              <2> ;		BP:		What it was before eENTER_STRUCT
   227                              <2> ;	Corrupts registers:
   228                              <2> ;		FLAGS
   229                              <2> ;--------------------------------------------------------------------
   230                              <2> %macro eLEAVE_STRUCT 1
   231                              <2> 	add		sp, %1
   232                              <2> 	pop		bp
   233                              <2> %endmacro
   234                              <2> 
   235                              <2> 
   236                              <2> ;--------------------------------------------------------------------
   237                              <2> ; Small delay between I/O port accesses if needed.
   238                              <2> ;
   239                              <2> ; IO_DELAY
   240                              <2> ;	Parameters:
   241                              <2> ;		Nothing
   242                              <2> ;	Returns:
   243                              <2> ;		Nothing
   244                              <2> ;	Corrupts registers:
   245                              <2> ;		Nothing
   246                              <2> ;--------------------------------------------------------------------
   247                              <2> %macro IO_DELAY 0
   248                              <2> 	jmp		SHORT %%ClearPrefetchQueue
   249                              <2> %%ClearPrefetchQueue:
   250                              <2> %endmacro
   251                              <2> 
   252                              <2> 
   253                              <2> %endif ; MACROS_INC
     9                              <1> %include "BiosData.inc"
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	Equates for BIOS Data Area.
     3                              <2> %ifndef BIOSDATA_INC
     4                              <2> %define BIOSDATA_INC
     5                              <2> 
     6                              <2> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;
     7                              <2> ; BIOS DATA AREA VARIABLES ;
