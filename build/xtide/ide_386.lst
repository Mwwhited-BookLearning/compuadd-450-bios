    18                              <1> ;
    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=15h, Read Disk Drive Size.
    25                              <1> ;
    26                              <1> ; It is unclear what is the total number of sectors to return.
    27                              <1> ; Award BIOS from 1997 returns full capacity instead of L-CHS limit
    28                              <1> ; like we do. I think it makes more sense if this function returns
    29                              <1> ; L-CHS limit.
    30                              <1> ;
    31                              <1> ; AH15h_HandlerForReadDiskDriveSize
    32                              <1> ;	Parameters:
    33                              <1> ;		DL:		Translated Drive number
    34                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    35                              <1> ;		SS:BP:	Ptr to IDEPACK
    36                              <1> ;	Returns with INTPACK:
    37                              <1> ;		If successful:
    38                              <1> ;			AH:		Hard Disk: 3 (Hard disk accessible)
    39                              <1> ;					Floppy:    1 (Floppy disk, without change detection)
    40                              <1> ;			CX:DX:	Total number of sectors
    41                              <1> ;			CF:		0
    42                              <1> ;		If failed:
    43                              <1> ;			AH:		0 (Drive not present)
    44                              <1> ;			CX:DX:	0
    45                              <1> ;			CF:		1
    46                              <1> ;--------------------------------------------------------------------
    47                              <1> AH15h_HandlerForReadDiskDriveSize:
    48                              <1> %ifdef MODULE_SERIAL_FLOPPY
    49 00001B44 B101                <1> 	mov		cl, 1										; 1 = floppy disk, no change detection
    50                              <1> 
    51 00001B46 84D2                <1> 	test	dl,dl										; DO NOT store the sector count if this is a
    52 00001B48 790D                <1> 	jns		.FloppyDrive								; floppy disk, some OS's depend on this not
    53                              <1> 														; happening for floppies in order to boot.
    54                              <1> %endif
    55                              <1> 
    56 00001B4A E81300              <1> 	call	AH15h_GetSectorCountToBXDXAX
    57 00001B4D 89561C              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.cx], dx			; HIWORD to CX
    58 00001B50 87461A              <1> 	xchg	[bp+IDEPACK.intpack+INTPACK.dx], ax			; LOWORD to DX, AL gets drive number
    59                              <1> 
    60 00001B53 30E4                <1> 	xor		ah, ah
    61                              <1> %ifdef MODULE_SERIAL_FLOPPY
    62 00001B55 B103                <1> 	mov		cl, 3										; 3 = Hard Disk Accessible
    63                              <1> .FloppyDrive:
    64                              <1> 
    65 00001B57 E842FD              <1> 	call	Int13h_SetErrorCodeToBdaAndToIntpackInSSBPfromAH_ALHasDriveNumber	; Store success to BDA and CF
    66 00001B5A 884E1F              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.ah], cl
    67                              <1> %else
    68                              <1> 	call	Int13h_SetErrorCodeToBdaAndToIntpackInSSBPfromAH	; Store success to BDA and CF
    69                              <1> 	mov		BYTE [bp+IDEPACK.intpack+INTPACK.ah], 3
    70                              <1> %endif
    71                              <1> 
    72 00001B5D E926FD              <1> 	jmp		Int13h_ReturnFromHandlerWithoutStoringErrorCode
    73                              <1> 
    74                              <1> 
    75                              <1> ;--------------------------------------------------------------------
    76                              <1> ; AH15h_GetSectorCountFromForeignDriveToBXDXAX
    77                              <1> ; AH15h_GetSectorCountToBXDXAX
    78                              <1> ;	Parameters:
    79                              <1> ;		DL:		Drive number (AH15h_GetSectorCountFromForeignDriveToBXDXAX only)
    80                              <1> ;		DS:		RAMVARS segment
    81                              <1> ;		DS:DI:	Ptr to DPT (AH15h_GetSectorCountToBXDXAX only)
    82                              <1> ;	Returns:
    83                              <1> ;		DX:AX:	Total sector count
    84                              <1> ;		BX:		Zero
    85                              <1> ;	Corrupts registers:
    86                              <1> ;		CX
    87                              <1> ;--------------------------------------------------------------------
    88                              <1> %ifdef MODULE_BOOT_MENU
    89                              <1> AH15h_GetSectorCountFromForeignDriveToBXDXAX:
    90                              <1> 	mov		ah, GET_DRIVE_PARAMETERS
    91                              <1> 	call	Int13h_CallPreviousInt13hHandler
    92                              <1> 	jmp		SHORT ConvertAH08hReturnValuesToSectorCount
    93                              <1> %endif
    94                              <1> 
    95                              <1> AH15h_GetSectorCountToBXDXAX:
    96 00001B60 E8B3FE              <1> 	call	AH8h_GetDriveParameters
    97                              <1> 	; Fall to ConvertAH08hReturnValuesToSectorCount
    98                              <1> 
    99                              <1> ConvertAH08hReturnValuesToSectorCount:
   100 00001B63 E86600              <1> 	call	Address_ExtractLCHSparametersFromOldInt13hAddress
   101 00001B66 88F8                <1> 	mov		al, bh		; AL = Max head number
   102 00001B68 41                  <1> 	inc		cx			; Max cylinder number to cylinder count
   103 00001B69 40                  <1> 	inc		ax			; Max head number to head count (AH=8h returns max 254 so no overflow to AH)
   104 00001B6A F6E3                <1> 	mul		bl			; AX = Head count * Sectors per track
   105 00001B6C F7E1                <1> 	mul		cx			; DX:AX = Total sector count for AH=0xh transfer functions
   106 00001B6E 31DB                <1> 	xor		bx, bx
   107 00001B70 C3                  <1> 	ret
