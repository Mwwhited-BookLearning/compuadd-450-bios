    21                              <2> %include "SerialServer.inc"
     1                              <3> ; Project name	:	XTIDE Universal BIOS
     2                              <3> ; Description	:	Serial Server Defines
     3                              <3> 
     4                              <3> %ifndef SERIALSERVER_INC
     5                              <3> %define SERIALSERVER_INC
