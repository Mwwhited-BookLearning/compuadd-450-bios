   250                              <1> ; DetectPrint_NullTerminatedStringFromCSSI
   251                              <1> ; DetectPrint_NullTerminatedStringFromCSSIandSetCF
   252                              <1> ;	Parameters:
   253                              <1> ;		CS:SI:	Ptr to NULL terminated string to print
   254                              <1> ;	Returns:
   255                              <1> ;		CF:		Set since menu event was handled successfully
