    24                              <2> ;--------------------------------------------------------------------
    25                              <2> ; Emulates INSW for XTIDE.
    26                              <2> ;
    27                              <2> ; XTIDE_INSW
    28                              <2> ;	Parameters:
    29                              <2> ;		BL:		Bit mask for toggling XTIDE data low/high reg
    30                              <2> ;		DX:		XTIDE Data Low Register address
    31                              <2> ;		ES:DI:	Ptr to destination buffer
    32                              <2> ;	Returns:
    33                              <2> ;		DI:		Incremented/Decremented for next word
    34                              <2> ;	Corrupts registers:
    35                              <2> ;		AL, FLAGS
    36                              <2> ;--------------------------------------------------------------------
    37                              <2> %macro XTIDE_INSW 0
    38                              <2> %ifdef USE_186	; INS instruction available
    39                              <2> 	insb						; Load low byte from port DX to [ES:DI]
    40                              <2> 	xor		dl, bl				; IDE Data Reg to XTIDE Data High Reg
    41                              <2> 	insb						; Load high byte from port DX to [ES:DI]
    42                              <2> 	xor		dl, bl				; Restore to IDE Data Register
    43                              <2> %else	; If 8088/8086
    44                              <2> 	in		al, dx				; Load low byte from port
    45                              <2> 	xor		dl, bl				; IDE Data Reg to XTIDE Data High Reg
    46                              <2> 	stosb						; Store byte to [ES:DI]
    47                              <2> 	in		al, dx				; Load high byte from port
    48                              <2> 	xor		dl, bl				; Restore to IDE Data Register
    49                              <2> 	stosb						; Store byte to [ES:DI]
    50                              <2> %endif
    51                              <2> %endmacro
    52                              <2> 
    53                              <2> 
    54                              <2> ;--------------------------------------------------------------------
    55                              <2> ; Emulates OUTSW for XTIDE.
    56                              <2> ;
    57                              <2> ; XTIDE_OUTSW
    58                              <2> ;	Parameters:
    59                              <2> ;		BL:		Bit mask for toggling XTIDE data low/high reg
    60                              <2> ;		DX:		XTIDE Data Low Register address
    61                              <2> ;		DS:SI:	Ptr to source buffer
    62                              <2> ;	Returns:
    63                              <2> ;		SI:		Incremented/Decremented for next word
    64                              <2> ;	Corrupts registers:
    65                              <2> ;		AX, FLAGS
    66                              <2> ;--------------------------------------------------------------------
    67                              <2> %macro XTIDE_OUTSW 0
    68                              <2> %ifdef USE_186	; OUTS instruction available
    69                              <2> 	lodsb						; Load low byte from [DS:SI] to AL
    70                              <2> 	xor		dl, bl				; IDE Data Reg to XTIDE Data High Reg
    71                              <2> 	outsb						; Output high byte from [DS:SI]
    72                              <2> 	xor		dl, bl				; XTIDE Data High Reg to Data Low Reg
    73                              <2> 	out		dx, al				; Output low byte from AL
    74                              <2> %else	; If 8088/8086
    75                              <2> 	lodsw						; Load word from [DS:SI]
    76                              <2> 	xor		dl, bl				; IDE Data Reg to XTIDE Data High Reg
    77                              <2> 	xchg	al, ah				; => AL=high byte, AH=low byte
    78                              <2> 	out		dx, al				; Output high byte
    79                              <2> 	xor		dl, bl				; XTIDE Data High Reg to Data Low Reg
    80                              <2> 	mov		al, ah				; Copy low byte to AL
    81                              <2> 	out		dx, al				; Output low byte
    82                              <2> %endif
    83                              <2> %endmacro
    84                              <2> 
    85                              <2> 
    86                              <2> ;--------------------------------------------------------------------
    87                              <2> ; Emulates OUTSW for modified XTIDE.
    88                              <2> ;
    89                              <2> ; XTIDE_MOD_OUTSW
    90                              <2> ;	Parameters:
    91                              <2> ;		DX:		XTIDE Data Low Register address
    92                              <2> ;		DS:SI:	Ptr to source buffer
    93                              <2> ;	Returns:
    94                              <2> ;		SI:		Incremented/Decremented for next word
    95                              <2> ;	Corrupts registers:
    96                              <2> ;		AX, FLAGS
    97                              <2> ;--------------------------------------------------------------------
    98                              <2> %macro XTIDE_MOD_OUTSW 0
    99                              <2> %ifdef USE_186	; OUTS instruction available
   100                              <2> 	lodsb						; Load low byte from [DS:SI] to AL
   101                              <2> 	inc		dx					; IDE Data Reg to XTIDE MOD Data High Reg
   102                              <2> 	outsb						; Output high byte from [DS:SI]
   103                              <2> 	dec		dx					; XTIDE Data High Reg to Data Low Reg
   104                              <2> 	out		dx, al				; Output low byte from AL
   105                              <2> %else	; If 8088/8086
   106                              <2> 	lodsw						; Load word from [DS:SI]
   107                              <2> 	inc		dx					; IDE Data Reg to XTIDE MOD Data High Reg
   108                              <2> 	xchg	al, ah				; => AL=high byte, AH=low byte
   109                              <2> 	out		dx, al				; Output high byte
   110                              <2> 	dec		dx					; XTIDE Data High Reg to Data Low Reg
   111                              <2> 	mov		al, ah				; Copy low byte to AL
   112                              <2> 	out		dx, al				; Output low byte
   113                              <2> %endif
   114                              <2> %endmacro
   115                              <2> 
   116                              <2> 
   117                              <2> ;--------------------------------------------------------------------
   118                              <2> ; Emulates INSW for modified XTIDE for use on Olivetti M24 and derivatives.
   119                              <2> ;
   120                              <2> ; XTIDE_MOD_OLIVETTI_INSW
   121                              <2> ;	Parameters:
   122                              <2> ;		DX:		XTIDE Data Low Register address
   123                              <2> ;		ES:DI:	Ptr to destination buffer
   124                              <2> ;	Returns:
   125                              <2> ;		DI:		Incremented/Decremented for next word
   126                              <2> ;	Corrupts registers:
   127                              <2> ;		AL, FLAGS
   128                              <2> ;--------------------------------------------------------------------
   129                              <2> %macro XTIDE_MOD_OLIVETTI_INSW 0
   130                              <2> %ifdef USE_186	; INS instruction available
   131                              <2> 	insb						; Load low byte from port DX to [ES:DI]
   132                              <2> 	inc		dx					; IDE Data Reg to XTIDE Data High Reg
   133                              <2> 	insb						; Load high byte from port DX to [ES:DI]
   134                              <2> 	dec		dx					; Restore to IDE Data Register
   135                              <2> %else	; If 8088/8086
   136                              <2> 	in		al, dx				; Load low byte from port
   137                              <2> 	inc		dx					; IDE Data Reg to XTIDE Data High Reg
   138                              <2> 	stosb						; Store byte to [ES:DI]
   139                              <2> 	in		al, dx				; Load high byte from port
   140                              <2> 	dec		dx					; Restore to IDE Data Register
   141                              <2> 	stosb						; Store byte to [ES:DI]
   142                              <2> %endif
   143                              <2> %endmacro
   144                              <2> 
   145                              <2> 
   146                              <2> %endif ; IDE_8BIT_INC
    50                              <1> %endif
    51                              <1> 
    52                              <1> %ifdef MODULE_ADVANCED_ATA
    53                              <1> 	%ifndef USE_386
    54                              <1> 		%error "MODULE_ADVANCED_ATA requires USE_386!"
    55                              <1> 	%endif
    56                              <1> 	%include "AdvancedID.inc"
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	ID words for Advanced IDE controllers
     3                              <2> 
     4                              <2> ;
     5                              <2> ; XTIDE Universal BIOS and Associated Tools
     6                              <2> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2013 by XTIDE Universal BIOS Team.
