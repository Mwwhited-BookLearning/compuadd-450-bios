    21                              <2> BUFFER_SIZE_FOR_WORD_INPUT		EQU		6	; 5 chars + NULL
    22                              <2> 
    23                              <2> ; Section containing code
    24                              <2> SECTION .text
    25                              <2> 
    26                              <2> ;--------------------------------------------------------------------
    27                              <2> ; Reads user inputted word.
    28                              <2> ; Function returns when ENTER or ESC will be pressed.
    29                              <2> ;
    30                              <2> ; Keyboard_ReadUserInputtedWordWhilePrinting
    31                              <2> ;	Parameters
    32                              <2> ;		BX:		Numeric base (10 or 16)
    33                              <2> ;	Returns:
    34                              <2> ;		AX:		User inputted word
    35                              <2> ;		ZF:		Set if user cancellation
    36                              <2> ;	Corrupts registers:
    37                              <2> ;		DX
    38                              <2> ;--------------------------------------------------------------------
    39                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
    40                              <2> ALIGN KEYBOARD_JUMP_ALIGN
    41                              <2> Keyboard_ReadUserInputtedWordWhilePrinting:
    42                              <2> 	push	ds
    43                              <2> 	push	si
    44                              <2> 	push	cx
    45                              <2> 
    46                              <2> 	mov		cl, BUFFER_SIZE_FOR_WORD_INPUT
    47                              <2> 	call	Memory_ReserveCLbytesFromStackToDSSI
    48                              <2> 
    49                              <2> 	call	Char_GetFilterFunctionToDXforNumericBaseInBX
    50                              <2> 	call	Registers_ExchangeDSSIwithESDI
    51                              <2> 	call	Keyboard_ReadUserInputtedStringToESDIWhilePrinting
    52                              <2> 	call	Registers_ExchangeDSSIwithESDI	; Does not modify FLAGS
    53                              <2> 	jz		SHORT .CancelledByUser
    54                              <2> 
    55                              <2> 	call	String_ConvertWordToAXfromStringInDSSIwithBaseInBX
    56                              <2> .CancelledByUser:
    57                              <2> 	add		sp, BYTE BUFFER_SIZE_FOR_WORD_INPUT
    58                              <2> 	test	cx, cx							; Set ZF if string length is zero
    59                              <2> 	pop		cx
    60                              <2> 	pop		si
    61                              <2> 	pop		ds
    62                              <2> 	ret
    63                              <2> %endif
    64                              <2> 
    65                              <2> 
    66                              <2> ;--------------------------------------------------------------------
    67                              <2> ; Reads user inputted string to buffer. Character filter is
    68                              <2> ; supported to ignore unwanted characters.
    69                              <2> ; Function returns when ENTER or ESC will be pressed.
    70                              <2> ;
    71                              <2> ; Keyboard_ReadUserInputtedStringToESDIWhilePrinting
    72                              <2> ;	Parameters:
    73                              <2> ;		CX:		Buffer size (with NULL)
    74                              <2> ;		ES:DI:	Ptr to destination buffer
    75                              <2> ;		CS:DX:	Ptr to character filter function:
    76                              <2> ;					Parameters:
    77                              <2> ;						AL:		Character inputted by user
    78                              <2> ;					Returns:
    79                              <2> ;						CF:		Set if character is accepted
    80                              <2> ;								Cleared if character is rejected
    81                              <2> ;					Corrupts registers:
    82                              <2> ;						Nothing
    83                              <2> ;	Returns:
    84                              <2> ;		CX:		String length in characters (without NULL)
    85                              <2> ;		ZF:		Set if user cancellation
    86                              <2> ;	Corrupts registers:
    87                              <2> ;		AX
    88                              <2> ;--------------------------------------------------------------------
    89                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
    90                              <2> ALIGN KEYBOARD_JUMP_ALIGN
    91                              <2> Keyboard_ReadUserInputtedStringToESDIWhilePrinting:
    92                              <2> 	push	di
    93                              <2> 	push	si
    94                              <2> 	push	bx
    95                              <2> 	call	.PrepareDisplayContextForKeyboardInput
    96                              <2> 	jcxz	.ReturnAfterUpdatingZF
    97                              <2> 
    98                              <2> 	xor		bx, bx								; Zero character counter
    99                              <2> 	dec		cx									; Decrement buffer size for NULL
   100                              <2> %ifdef CLD_NEEDED
   101                              <2> 	cld
   102                              <2> %endif
   103                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   104                              <2> .GetCharacterFromUser:
   105                              <2> 	call	Keyboard_GetKeystrokeToAXandWaitIfNecessary	; Get ASCII to AL
   106                              <2> 	call	.ProcessControlCharacter
   107                              <2> 	jz		SHORT .TerminateStringWithNULL
   108                              <2> 	jc		SHORT .PlayBellForRejectedCharacter
   109                              <2> 	call	dx									; Filter character
   110                              <2> 	jnc		SHORT .PlayBellForRejectedCharacter
   111                              <2> 	inc		bx									; Increment number of characters stored
   112                              <2> 	stosb										; Store from AL to ES:DI
   113                              <2> 	call	Keyboard_PrintInputtedCharacter
   114                              <2> 	loop	.GetCharacterFromUser
   115                              <2> .PlayBellForRejectedCharacter:
   116                              <2> 	cmp		al, BS								; No bell for backspace
   117                              <2> 	je		SHORT .GetCharacterFromUser
   118                              <2> 	call	Keyboard_PlayBellForUnwantedKeystroke
   119                              <2> 	jmp		SHORT .GetCharacterFromUser
   120                              <2> 
   121                              <2> .TerminateStringWithNULL:
   122                              <2> 	stosb										; Terminate string with NULL
   123                              <2> 	mov		cx, bx								; String length now in CX
   124                              <2> 
   125                              <2> .ReturnAfterUpdatingZF:
   126                              <2> 	CALL_DISPLAY_LIBRARY PopDisplayContext
   127                              <2> 	test	cx, cx								; Clear or set ZF
   128                              <2> 	pop		bx
   129                              <2> 	pop		si
   130                              <2> 	pop		di
   131                              <2> 	ret
   132                              <2> 
   133                              <2> ;--------------------------------------------------------------------
   134                              <2> ; .PrepareDisplayContextForKeyboardInput
   135                              <2> ;	Parameters:
   136                              <2> ;		Nothing
   137                              <2> ;	Returns:
   138                              <2> ;		Nothing (Display context pushed to stack)
   139                              <2> ;	Corrupts registers:
   140                              <2> ;		AX, BX, SI
   141                              <2> ;--------------------------------------------------------------------
   142                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   143                              <2> .PrepareDisplayContextForKeyboardInput:
   144                              <2> 	pop		bx					; Pop return address to BX
   145                              <2> 	mov		si, di
   146                              <2> 
   147                              <2> 	CALL_DISPLAY_LIBRARY PushDisplayContext
   148                              <2> 	call	DisplayCursor_GetDefaultCursorShapeToAX
   149                              <2> 	CALL_DISPLAY_LIBRARY SetCursorShapeFromAX
   150                              <2> 	CALL_DISPLAY_LIBRARY SynchronizeDisplayContextToHardware
   151                              <2> 
   152                              <2> 	mov		di, si
   153                              <2> 	jmp		bx
   154                              <2> 
   155                              <2> 
   156                              <2> ;--------------------------------------------------------------------
   157                              <2> ; .ProcessControlCharacter
   158                              <2> ;	Parameters:
   159                              <2> ;		AL:		Character inputted by user
   160                              <2> ;		CX:		Number of bytes left in buffer
   161                              <2> ;		BX:		Total number of characters inputted
   162                              <2> ;		ES:DI:	Ptr where to store next character
   163                              <2> ;	Returns:
   164                              <2> ;		AL:		Character inputted by user or NULL if end of input
   165                              <2> ;		BX:		Cleared if user cancellation
   166                              <2> ;		ZF:		Set if user has ended or cancelled key input
   167                              <2> ;		CF:		Set if character is rejected
   168                              <2> ;	Corrupts registers:
   169                              <2> ;		AH
   170                              <2> ;--------------------------------------------------------------------
   171                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   172                              <2> .ProcessControlCharacter:
   173                              <2> 	cmp		al, CR								; ENTER to terminate string?
   174                              <2> 	je		SHORT .EndCharacterInput
   175                              <2> 	cmp		al, ESC								; Cancel input?
   176                              <2> 	je		SHORT .CancelCharacterInput
   177                              <2> 	cmp		al, BS								; Backspace?
   178                              <2> 	je		SHORT .Backspace
   179                              <2> 	jcxz	.RejectCharacter
   180                              <2> 	clc											; Clear CF (ZF is already cleared)
   181                              <2> 	ret
   182                              <2> 
   183                              <2> .Backspace:
   184                              <2> 	test	bx, bx								; At the beginning?
   185                              <2> 	jz		SHORT .RejectCharacter
   186                              <2> 	inc		cx									; Increment bytes left
   187                              <2> 	dec		bx									; Decrement characters inputted
   188                              <2> 	dec		di
   189                              <2> 	call	Keyboard_PrintBackspace
   190                              <2> 	mov		al, BS								; Restore character
   191                              <2> .RejectCharacter:
   192                              <2> 	test	al, al								; Clear ZF...
   193                              <2> 	stc											; ...and set CF
   194                              <2> 	ret
   195                              <2> 
   196                              <2> .CancelCharacterInput:
   197                              <2> 	xor		bx, bx
   198                              <2> .EndCharacterInput:
   199                              <2> 	xor		al, al								; Set ZF and clear CF
   200                              <2> 	ret
   201                              <2> %endif ; EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   202                              <2> 
   203                              <2> 
   204                              <2> ;--------------------------------------------------------------------
   205                              <2> ; Keyboard_PrintBackspace
   206                              <2> ;	Parameters:
   207                              <2> ;		Nothing
   208                              <2> ;	Returns:
   209                              <2> ;		Nothing
   210                              <2> ;	Corrupts registers:
   211                              <2> ;		AX
   212                              <2> ;--------------------------------------------------------------------
   213                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   214                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   215                              <2> Keyboard_PrintBackspace:
   216                              <2> 	mov		al, BS
   217                              <2> 	call	Keyboard_PrintInputtedCharacter
   218                              <2> 	mov		al, ' '
   219                              <2> 	call	Keyboard_PrintInputtedCharacter
   220                              <2> 	mov		al, BS
   221                              <2> 	jmp		SHORT Keyboard_PrintInputtedCharacter
   222                              <2> %endif
   223                              <2> 
   224                              <2> 
   225                              <2> ;--------------------------------------------------------------------
   226                              <2> ; Keyboard_PlayBellForUnwantedKeystroke
