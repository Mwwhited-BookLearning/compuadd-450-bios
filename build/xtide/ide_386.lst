    42                              <1> ;--------------------------------------------------------------------
    43                              <1> ; Int 13h function AH=9h, Initialize Drive Parameters.
    44                              <1> ;
    45                              <1> ; AH9h_HandlerForInitializeDriveParameters
    46                              <1> ;	Parameters:
    47                              <1> ;		DL:		Translated Drive number
    48                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    49                              <1> ;		SS:BP:	Ptr to IDEPACK
    50                              <1> ;	Returns with INTPACK:
    51                              <1> ;		AH:		Int 13h return status
    52                              <1> ;		CF:		0 if successful, 1 if error
    53                              <1> ;--------------------------------------------------------------------
    54                              <1> AH9h_HandlerForInitializeDriveParameters:
    55                              <1> %ifndef USE_186
    56                              <1> 	call	AH9h_InitializeDriveForUse
    57                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    58                              <1> %else
    59 00001A3D 68[8018]            <1> 	push	Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    60                              <1> 	; Fall to AH9h_InitializeDriveForUse
    61                              <1> %endif
    62                              <1> 
