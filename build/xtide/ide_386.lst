   130                              <1> ;--------------------------------------------------------------------
   131                              <1> ; Returns pointer to DRVPARAMS for master or slave drive.
   132                              <1> ;
   133                              <1> ; AccessDPT_GetPointerToDRVPARAMStoCSBX
   134                              <1> ;	Parameters:
   135                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   136                              <1> ;	Returns:
   137                              <1> ;		CS:BX:	Ptr to DRVPARAMS
   138                              <1> ;	Corrupts registers:
   139                              <1> ;		Nothing
   140                              <1> ;--------------------------------------------------------------------
   141                              <1> AccessDPT_GetPointerToDRVPARAMStoCSBX:
   142 0000070A E80C00              <1> 	call	AccessDPT_GetIdevarsToCSBX
   143 0000070D 83C30C              <1> 	add		bx, BYTE IDEVARS.drvParamsMaster+DRVPARAMS_size	; CS:BX points to Slave Drive DRVPARAMS
   144 00000710 F60510              <1> 	test	BYTE [di+DPT.bFlagsLow], FLGL_DPT_SLAVE
   145 00000713 7503                <1> 	jnz		SHORT .Return
   146 00000715 83EB06              <1> 	sub		bx, BYTE DRVPARAMS_size							; CS:BX points to Master Drive DRVPARAMS
   147                              <1> .Return:
   148 00000718 C3                  <1> 	ret
   149                              <1> 
   150                              <1> 
   151                              <1> ;--------------------------------------------------------------------
   152                              <1> ; Needed many times during initialization so it is better to
   153                              <1> ; make it as a function to save bytes.
   154                              <1> ;
   155                              <1> ; AccessDPT_GetIdevarsToCSBX
   156                              <1> ;	Parameters:
   157                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   158                              <1> ;	Returns:
   159                              <1> ;		CS:BX:	Ptr to IDEVARS for the drive
   160                              <1> ;	Corrupts registers:
   161                              <1> ;		Nothing
   162                              <1> ;--------------------------------------------------------------------
   163                              <1> AccessDPT_GetIdevarsToCSBX:
   164                              <1> 	eMOVZX	bx, BYTE [di+DPT.bIdevarsOffset]
