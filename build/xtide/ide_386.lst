   239                              <1> 
   240 00001B0C 5B                  <1> 	pop		bx
   241 00001B0D 5A                  <1> 	pop		dx
   242 00001B0E 5E                  <1> 	pop		si
   243 00001B0F 07                  <1> 	pop		es
   244 00001B10 C3                  <1> 	ret
   245                              <1> 
   246                              <1> 
   247                              <1> .rgbWriteCacheCommands:
