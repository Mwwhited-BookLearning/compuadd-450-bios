   245                              <1> %endif
   246 000012A8 8B4504              <1> 	mov		ax, [di+DPT.wBasePort]
   247 000012AB 894600              <1> 	mov		[bp+PIOVARS.wDataPort], ax
   248                              <1> 	eMOVZX	ax, BYTE [di+DPT_ATA.bBlockSize]
