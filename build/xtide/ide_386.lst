    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Creates new DRVDETECTINFO struct for detected hard disk.
    26                              <1> ;
    27                              <1> ; DriveDetectInfo_CreateForHardDisk
    28                              <1> ;	Parameters:
    29                              <1> ;		DL:		Drive number
    30                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    31                              <1> ;		ES:SI:	Ptr to 512-byte ATA information read from the drive
    32                              <1> ;	Returns:
    33                              <1> ;		ES:BX:	Ptr to DRVDETECTINFO (if successful)
    34                              <1> ;	Corrupts registers:
    35                              <1> ;		AX, BX, CX, DX, DI
    36                              <1> ;--------------------------------------------------------------------
    37                              <1> DriveDetectInfo_CreateForHardDisk:
    38 000007D2 E81700              <1> 	call	DriveDetectInfo_ConvertDPTtoBX		; ES:BX now points to new DRVDETECTINFO
    39                              <1> 
    40                              <1> 	; Store Drive Name
    41 000007D5 1E                  <1> 	push	ds									; Preserve RAMVARS
    42 000007D6 56                  <1> 	push	si
    43                              <1> 
    44 000007D7 06                  <1> 	push	es									; ES copied to DS
    45 000007D8 1F                  <1> 	pop		ds
    46                              <1> 
    47 000007D9 83C636              <1> 	add		si, BYTE ATA1.strModel				; DS:SI now points drive name (Clears CF)
    48                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    49                              <1> %if DRVDETECTINFO.szDrvName = 0
    50 000007DC 89DF                <1> 	mov		di, bx
    51                              <1> %else
    52                              <1> 	lea		di, [bx+DRVDETECTINFO.szDrvName]	; ES:DI now points to name destination
    53                              <1> %endif
    54                              <1> %endif
    55 000007DE B90F00              <1> 	mov		cx, MAX_HARD_DISK_NAME_LENGTH / 2	; Max number of WORDs allowed
    56                              <1> .CopyNextWord:
    57 000007E1 AD                  <1> 	lodsw
    58 000007E2 86E0                <1> 	xchg	al, ah								; Change endianness
    59 000007E4 AB                  <1> 	stosw
    60 000007E5 E2FA                <1> 	loop	.CopyNextWord
    61 000007E7 91                  <1> 	xchg	cx, ax								; Zero AX (CF already cleared from the ADD above)
    62 000007E8 AB                  <1> 	stosw										; Terminate with NULL
    63                              <1> 
    64 000007E9 5E                  <1> 	pop		si
    65 000007EA 1F                  <1> 	pop		ds
    66                              <1> 
    67 000007EB C3                  <1> 	ret
