   370                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   371                              <2> ;	Returns:
   372                              <2> ;		DI:		Updated offset to video RAM
   373                              <2> ;	Corrupts registers:
   374                              <2> ;		AX, DX
   375                              <2> ;--------------------------------------------------------------------
   376                              <2> %ifdef MODULE_STRINGS_COMPRESSED
   377                              <2> ALIGN DISPLAY_JUMP_ALIGN
   378                              <2> DisplayPrint_Newline_FormatAdjustBP:
   379 00000286 45                  <2> 	inc		bp					; we didn't need a parameter after all, readjust BP
   380 00000287 45                  <2> 	inc		bp
   381                              <2> 	; fall through to DisplayPrint_Newline
   382                              <2> %endif
