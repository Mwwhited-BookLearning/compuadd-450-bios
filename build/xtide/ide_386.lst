   380                              <1> ; HotkeyBar_StoreDefaultDriveLettersToHotkeyVars
   381                              <1> ;	Parameters:
   382                              <1> ;		ES:		BDA Segment
   383                              <1> ;	Returns:
   384                              <1> ;		Nothing
   385                              <1> ;	Corrupts registers:
   386                              <1> ;		AX
   387                              <1> ;--------------------------------------------------------------------
   388                              <1> HotkeyBar_StoreDefaultDriveLettersToHotkeyVars:
   389 00000BE3 E877F9              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
   390 00000BE6 B441                <1> 	mov		ah, DEFAULT_FLOPPY_DRIVE_LETTER
   391 00000BE8 86E0                <1> 	xchg	al, ah
   392 00000BEA 26A30A7F            <1> 	mov		[es:BOOTVARS.hotkeyVars+HOTKEYVARS.wFddAndHddLetters], ax
   393 00000BEE C3                  <1> 	ret
   394                              <1> 
