    25                              <2> ; DisplayFunctionFromDI
    26                              <2> ;	Parameters:
    27                              <2> ;		DI:		Function to call (DISPLAY_LIB.functionName)
    28                              <2> ;		Others:	Depends on function to call (DX cannot be parameter)
    29                              <2> ;	Returns:
    30                              <2> ;		Depends on function to call
    31                              <2> ;	Corrupts registers:
    32                              <2> ;		AX (unless used as a return register), DI
    33                              <2> ;--------------------------------------------------------------------
    34                              <2> ALIGN DISPLAY_JUMP_ALIGN
    35                              <2> Display_FunctionFromDI:
    36 0000014D 06                  <2> 	push	es
    37 0000014E 1E                  <2> 	push	ds
    38 0000014F 52                  <2> 	push	dx
    39                              <2> 
    40                              <2> %ifdef CLD_NEEDED
    41 00000150 FC                  <2> 	cld
    42                              <2> %endif
    43                              <2> 	LOAD_BDA_SEGMENT_TO	ds, dx
   180                              <3> %ifndef USE_186
   181                              <3>  xor %2, %2
   182                              <3>  mov %1, %2
   183                              <3> %elifidn %3, !
   184                              <3>  xor %2, %2
   185                              <3>  mov %1, %2
   186                              <3> %else
   187 00000151 6A00                <3>  push BYTE 0
   188 00000153 1F                  <3>  pop %1
   189                              <3> %endif
    44 00000154 89FA                <2> 	mov		dx, di
    45 00000156 C43E5404            <2> 	les		di, [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition]
    46 0000015A FFD2                <2> 	call	dx
    47 0000015C 893E5404            <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], di
    48                              <2> 
    49 00000160 5A                  <2> 	pop		dx
    50 00000161 1F                  <2> 	pop		ds
    51 00000162 07                  <2> 	pop		es
    52 00000163 C3                  <2> 	ret
    53                              <2> 
    54                              <2> ;--------------------------------------------------------------------
    55                              <2> ; Display_FormatNullTerminatedStringFromCSSI
    56                              <2> ;	Parameters:
    57                              <2> ;		Same as DisplayPrint_FormattedNullTerminatedStringFromCSSI
    58                              <2> ;	Returns:
    59                              <2> ;		Stack variables will be cleaned
    60                              <2> ;	Corrupts registers:
    61                              <2> ;		AX
    62                              <2> ;--------------------------------------------------------------------
    63                              <2> ALIGN DISPLAY_JUMP_ALIGN
    64                              <2> Display_FormatNullTerminatedStringFromCSSI:
    65 00000164 58                  <2> 	pop		ax					; Discard return address to inside Display_FunctionFromDI
    66 00000165 E8FC00              <2> 	call	DisplayPrint_FormattedNullTerminatedStringFromCSSI
    67 00000168 893E5404            <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], di
    68                              <2> 
    69 0000016C 5A                  <2> 	pop		dx
    70 0000016D 1F                  <2> 	pop		ds
    71 0000016E 07                  <2> 	pop		es
    72                              <2> 
    73 0000016F 58                  <2> 	pop		ax					; Pop return address
    74 00000170 89EC                <2> 	mov		sp, bp				; Clean stack variables
    75 00000172 FFE0                <2> 	jmp		ax
