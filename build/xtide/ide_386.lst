    64                              <1> ;--------------------------------------------------------------------
    65                              <1> ; Initialize drive to be ready for use.
    66                              <1> ;
    67                              <1> ; AH9h_InitializeDriveForUse
    68                              <1> ;	Parameters:
    69                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    70                              <1> ;		SS:BP:	Ptr to IDEPACK
    71                              <1> ;	Returns:
    72                              <1> ;		AH:		Int 13h return status
    73                              <1> ;		CF:		0 if successful, 1 if error
    74                              <1> ;	Corrupts registers:
    75                              <1> ;		AL, CX
    76                              <1> ;--------------------------------------------------------------------
    77                              <1> AH9h_InitializeDriveForUse:
    78 00001A40 31C0                <1> 	xor		ax, ax				; Clear AH to assume no errors
    79                              <1> 
    80                              <1> %ifdef MODULE_ADVANCED_ATA
    81                              <1> 	; Clear Initialization Error flags from DPT
    82 00001A42 884503              <1> 	mov		[di+DPT.bInitError], al
    83                              <1> %endif
    84                              <1> 
    85                              <1> %ifdef MODULE_SERIAL
    86                              <1> 	; No need to do this for serial devices
    87 00001A45 F6450104            <1> 	test	BYTE [di+DPT.bFlagsHigh], FLGH_DPT_SERIAL_DEVICE	; Clears CF
    88 00001A49 7401                <1> 	jz		SHORT .ContinueInitialization
    89 00001A4B C3                  <1> 	ret		; With AH and CF cleared
    90                              <1> .ContinueInitialization:
    91                              <1> %endif
    92                              <1> 
    93 00001A4C 06                  <1> 	push	es
    94 00001A4D 56                  <1> 	push	si
    95 00001A4E 52                  <1> 	push	dx
    96 00001A4F 53                  <1> 	push	bx
    97                              <1> 
    98                              <1> 
    99                              <1> ;;;	SelectDrive
   100                              <1> 	; Try to select drive and wait until ready
   101 00001A50 E895EC              <1> 	call	AccessDPT_GetDriveSelectByteToAL
   102 00001A53 884601              <1> 	mov		[bp+IDEPACK.bDrvAndHead], al
   103 00001A56 E846F4              <1> 	call	Device_SelectDrive
   104                              <1> 	STORE_ERROR_FLAG_TO_DPT		FLG_INITERROR_FAILED_TO_SELECT_DRIVE
    37 00001A59 B001                <2>  mov al, %1
    38 00001A5B E8BE00              <2>  call SetErrorFlagFromALwithErrorCodeInAH
   105                              <1> %ifdef USE_386
   106 00001A5E 0F82A000            <1> 	jc		.ReturnWithErrorCodeInAH
   107                              <1> %else
   108                              <1> 	jnc		SHORT .ContinueInitializationSinceDriveSelectedSuccessfully
   109                              <1> 	jmp		.ReturnWithErrorCodeInAH
   110                              <1> .ContinueInitializationSinceDriveSelectedSuccessfully:
