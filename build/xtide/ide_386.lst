    67                              <1> %ifdef MODULE_COMPATIBLE_TABLES
    68                              <1> 	%include "CompatibleDPT.inc"
     1                              <2> ; Project name	:	XTIDE Universal BIOS
     2                              <2> ; Description	:	Defines for DPT structs to present drive geometry
     3                              <2> ;					to ill behaving applications that want
     4                              <2> ;					to read DPT from interrupt vectors 41h and 46h.
