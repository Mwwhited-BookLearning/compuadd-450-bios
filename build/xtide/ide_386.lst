    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=25h, Get Drive Information.
    25                              <1> ;
    26                              <1> ; AH25h_HandlerForGetDriveInformation
    27                              <1> ;	Parameters:
    28                              <1> ;		CX, ES:	Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		CX:		XUB_INT13h_SIGNATURE to ignore illegal ATA-ID values, otherwise
    34                              <1> ;				correct them (only used if NOT build with NO_ATAID_CORRECTION)
    35                              <1> ;		ES:BX:	Ptr to buffer to receive 512-byte drive information
    36                              <1> ;	Returns with INTPACK:
    37                              <1> ;		AH:		Int 13h return status
    38                              <1> ;		CF:		0 if successful, 1 if error
    39                              <1> ;--------------------------------------------------------------------
    40                              <1> AH25h_HandlerForGetDriveInformation:
    41 00001BBA B801EC              <1> 	mov		ax, (COMMAND_IDENTIFY_DEVICE << 8 | 1)		; Read 1 sector
    42 00001BBD E88800              <1> 	call	Prepare_BufferToESSIforOldInt13hTransfer	; Preserves AX
    43 00001BC0 BB08FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRQ)
    44                              <1> %ifdef USE_186
    45 00001BC3 68[8018]            <1> 	push	Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    46 00001BC6 E95BF2              <1> 	jmp		Idepack_TranslateOldInt13hAddressAndIssueCommandFromAH
    47                              <1> %else
    48                              <1> 	call	Idepack_TranslateOldInt13hAddressAndIssueCommandFromAH
    49                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    50                              <1> %endif
   338                                  	%include "Address.asm"			; For sector address translations
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Functions for address translations.
     3                              <1> 
     4                              <1> ;
     5                              <1> ; XTIDE Universal BIOS and Associated Tools
     6                              <1> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2025 by XTIDE Universal BIOS Team.
