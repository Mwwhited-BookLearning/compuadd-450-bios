   252                              <2> ; DisplayContext_SetCharOutputFunctionFromAXwithAttribFlagInBL
   253                              <2> ;	Parameters:
   254                              <2> ;		AX:		Offset to character output function
   255                              <2> ;		BL:		Attribute Flag
   256                              <2> ;		DS:		BDA segment (zero)
   257                              <2> ;	Returns:
   258                              <2> ;		Nothing
   259                              <2> ;	Corrupts registers:
