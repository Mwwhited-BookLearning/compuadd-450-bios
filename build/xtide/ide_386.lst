    33                              <1> IdeIrq_WaitForIRQ:
    34 000015AC 1E                  <1> 	push	ds
    35                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax, !		; Zero AX
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184 000015AD 31C0                <2>  xor %2, %2
   185 000015AF 8ED8                <2>  mov %1, %2
   186                              <2> %else
   187                              <2>  push BYTE 0
   188                              <2>  pop %1
   189                              <2> %endif
    36 000015B1 B490                <1> 	mov		ah, OS_HOOK_DEVICE_BUSY		; Hard disk busy (AX=9000h)
    37 000015B3 FA                  <1> 	cli									; Disable interrupts
    38 000015B4 FE0E8E04            <1> 	dec		BYTE [BDA.bHDTaskFlg]		; Clear to zero if still waiting for IRQ
    39 000015B8 1F                  <1> 	pop		ds
    40 000015B9 7502                <1> 	jnz		SHORT .ReturnFromWaitNotify	; IRQ already! (CompactFlash was faster than CPU)	
    41 000015BB CD15                <1> 	int		BIOS_SYSTEM_INTERRUPT_15h	; OS hook, device busy
    42                              <1> 
    43                              <1> .ReturnFromWaitNotify:
    44 000015BD FB                  <1> 	sti									; Enable interrupts
    45 000015BE C3                  <1> 	ret
