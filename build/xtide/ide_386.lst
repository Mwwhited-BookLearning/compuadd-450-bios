   255                              <1> ;--------------------------------------------------------------------
   256                              <1> ; AH9h_Enable8bitModeForDevice8bitAta
   257                              <1> ;	Parameters:
   258                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   259                              <1> ;		SS:BP:	Ptr to IDEPACK
   260                              <1> ;	Returns:
   261                              <1> ;		AH:		Int 13h return status
   262                              <1> ;		CF:		Clear if successful or device is not DEVICE_8BIT_ATA
   263                              <1> ;				Set if failed to set 8-bit mode for DEVICE_8BIT_ATA
   264                              <1> ;	Corrupts registers:
   265                              <1> ;		AL, BX, CX, DX, SI
   266                              <1> ;--------------------------------------------------------------------
   267                              <1> AH9h_Enable8bitModeForDevice8bitAta:
   268 00001B14 807D1404            <1> 	cmp		BYTE [di+DPT_ATA.bDevice], DEVICE_8BIT_ATA
   269                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
   270                              <1> 	jne		SHORT IgnoreInvalidCommandError
   271                              <1> 	jmp		AH23h_Enable8bitPioMode
   272                              <1> %else ; ~MODULE_8BIT_IDE_ADVANCED
   273 00001B18 7466                <1> 	je		AH23h_Enable8bitPioMode
   274                              <1> 	; Fall to IgnoreInvalidCommandError
   275                              <1> %endif ; MODULE_8BIT_IDE_ADVANCED
   276                              <1> %endif ; MODULE_8BIT_IDE
   277                              <1> 
   278                              <1> 
   279                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
   280                              <1> ;--------------------------------------------------------------------
   281                              <1> ; AH9h_SetModeFromALtoXTCF
   282                              <1> ;	Parameters:
   283                              <1> ;		AL:		XT-CF Mode to set
   284                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   285                              <1> ;		SS:BP:	Ptr to IDEPACK
   286                              <1> ;	Returns:
   287                              <1> ;		AH:		Int 13h return status
   288                              <1> ;		CF:		Clear if successful or device is not XT-CF
   289                              <1> ;				Set if failed to set mode for XT-CF
   290                              <1> ;	Corrupts registers:
   291                              <1> ;		AL, BX, CX, DX, SI
   292                              <1> ;--------------------------------------------------------------------
   293                              <1> AH9h_SetModeFromALtoXTCF:
   294                              <1> 	call	AccessDPT_IsThisDeviceXTCF
   295                              <1> 	jnc		AH1Eh_ChangeXTCFmodeBasedOnModeInAL
   296                              <1> 	; Fall to IgnoreInvalidCommandError
   297                              <1> %endif ; MODULE_8BIT_IDE_ADVANCED
   298                              <1> 
   299                              <1> 
   300                              <1> ;--------------------------------------------------------------------
   301                              <1> ; SetErrorFlagFromALwithErrorCodeInAH
   302                              <1> ;	Parameters:
   303                              <1> ;		AH:		BIOS Error Code
   304                              <1> ;		AL:		Error flag to set
   305                              <1> ;		DS:DI:	Ptr to DPT
   306                              <1> ;		CF:		Set if error code in AH
   307                              <1> ;				Clear if AH = 0
   308                              <1> ;	Returns:
   309                              <1> ;		CF:		Clear if no error
   310                              <1> ;				Set if error flag was set
   311                              <1> ;	Corrupts registers:
   312                              <1> ;		Nothing
   313                              <1> ;--------------------------------------------------------------------
   314                              <1> IgnoreInvalidCommandError:
   315 00001B1A 30E4                <1> 	xor		ah, ah	; Clears CF
   316                              <1> SetErrorFlagFromALwithErrorCodeInAH:
   317 00001B1C 7309                <1> 	jnc		SHORT .NoErrorFlagToSet
   318 00001B1E 80FC01              <1> 	cmp		ah, RET_HD_INVALID
   319 00001B21 76F7                <1> 	jbe		SHORT IgnoreInvalidCommandError
   320                              <1> 
   321 00001B23 084503              <1> 	or		[di+DPT.bInitError], al
   322 00001B26 F9                  <1> 	stc
   323                              <1> .NoErrorFlagToSet:
   324 00001B27 C3                  <1> 	ret
