   484                              <1> ;------------------------------------------------------------------------------------------
   485                              <1> ;
   486                              <1> ; Tables for StringsCompress.pl
   487                              <1> ;
   488                              <1> ; Items can be added and removed from this table as needed, with the following rules:
   489                              <1> ;  * Formats follow the special characters.  But other than that, order makes no difference.
   490                              <1> ;  * Some of the formats require "even" and "odd" numbering.  Even tells the code that
   491                              <1> ;    it is a "number-" format, otherwise it doesn't interpret a number first.  The easiest
   492                              <1> ;    way to maintain this is to move one of the "n/a" items to/from the front of the format
   493                              <1> ;    list to maintain the even/odd.
   494                              <1> ;  * Values do not need to remain consistent across versions.  This table is only used
   495                              <1> ;    internally to this file.
   496                              <1> ;  * There can only be 32 of these (0-31).
   497                              <1> ;  * Keeping the list short is good - this translates to a table in the compressed version.
   498                              <1> ;    An error will be reported if a character or format is no longer being used by any
   499                              <1> ;    strings above.
   500                              <1> ;  * Please keep items sequential for ease of further editing.
   501                              <1> ;
   502                              <1> ;$translate{ord(' ')} = 0;    [StringsCompress Processed]
   503                              <1> ;$translate{172}      = 1;     # ONE_QUARTER    [StringsCompress Processed]
   504                              <1> ;$translate{171}      = 2;     # ONE_HALF    [StringsCompress Processed]
   505                              <1> ;$translate{179}      = 3;     # SINGLE_VERTICAL    [StringsCompress Processed]
   506                              <1> ;$translate{175}      = 4;     # ANGLE_QUOTE_RIGHT    [StringsCompress Processed]
   507                              <1> ;$translate{ord('!')} = 5;    [StringsCompress Processed]
   508                              <1> ;$translate{ord('"')} = 6;    [StringsCompress Processed]
   509                              <1> ;$translate{ord(',')} = 7;    [StringsCompress Processed]
   510                              <1> ;$translate{ord('-')} = 8;    [StringsCompress Processed]
   511                              <1> ;$translate{ord('.')} = 9;    [StringsCompress Processed]
   512                              <1> ;$translate{ord('/')} = 10;    [StringsCompress Processed]
   513                              <1> ;$translate{ord('1')} = 11;    [StringsCompress Processed]
   514                              <1> ;$translate{ord('2')} = 12;    [StringsCompress Processed]
   515                              <1> ;$translate{ord('3')} = 13;    [StringsCompress Processed]
   516                              <1> ;$translate{ord('5')} = 14;    [StringsCompress Processed]
   517                              <1> ;$translate{ord('6')} = 15;    [StringsCompress Processed]
   518                              <1> ;$translate{ord('8')} = 16;    [StringsCompress Processed]
   519                              <1> ;$translate{200}      = 17;    # DOUBLE_BOTTOM_LEFT_CORNER    [StringsCompress Processed]
   520                              <1> ;$translate{181}      = 18;    # DOUBLE_LEFT_HORIZONTAL_TO_SINGLE_VERTICAL    [StringsCompress Processed]
   521                              <1> ;$translate{ord('0')} = 19;    [StringsCompress Processed]
   522                              <1> ;
   523                              <1> ; Formats begin immediately after the last Translated character (they are in the same table)
   524                              <1> ;
   525                              <1> ;$format_begin = 20;    [StringsCompress Processed]
   526                              <1> ;
   527                              <1> ;$format{"2-I"} = 20;        # must be even    [StringsCompress Processed]
   528                              <1> ;$format{"u"}   = 21;        # must be odd    [StringsCompress Processed]
   529                              <1> ;$format{"5-u"} = 22;        # must be even    [StringsCompress Processed]
   530                              <1> ;$format{"x"}   = 23;        # must be odd    [StringsCompress Processed]
   531                              <1> ;$format{"5-x"} = 24;        # must be even    [StringsCompress Processed]
   532                              <1> ;$format{"nl"}  = 25;        # n/a    [StringsCompress Processed]
   533                              <1> ;$format{"2-u"} = 26;        # must be even    [StringsCompress Processed]
   534                              <1> ;$format{"A"}   = 27;        # n/a    [StringsCompress Processed]
   535                              <1> ;$format{"c"}   = 28;        # n/a    [StringsCompress Processed]
   536                              <1> ;$format{"s"}   = 29;        # n/a, normal string from DS    [StringsCompress Processed]
   537                              <1> ;$format{"z"}   = 30;        # n/a, boot string from BDA    [StringsCompress Processed]
   538                              <1> ;
   539                              <1> ; NOTE: The last $format cannot exceed 31 (stored in a 5-bit quantity).
   540                              <1> ;
   541                              <1> ; Starting point for the "normal" range, typically around 0x40 to cover upper and lower case
   542                              <1> ; letters.  If lower case 'z' is not used, 0x3a can be a good choice as it adds ':' to the
   543                              <1> ; front end.
   544                              <1> ;
   545                              <1> ;$normal_base = 0x3a;    [StringsCompress Processed]
   546                              <1> ;
   547                              <1> ; End of StringsCompress.pl information
   548                              <1> ;
   549                              <1> ;;; end of input stream
   550                              <1> 
   551                              <1> %endif ; STRINGSCOMPRESSED_STRINGS
