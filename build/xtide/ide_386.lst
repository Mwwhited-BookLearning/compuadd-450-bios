   208                              <2> ; DisplayContext_SetCharacterPointerFromBXAX
   209                              <2> ;	Parameters:
   210                              <2> ;		BX:AX:	Ptr to destination for next character to output
   211                              <2> ;		DS:		BDA segment (zero)
   212                              <2> ;	Returns:
   213                              <2> ;		ES:DI:	Pointer that was in BX:AX
   214                              <2> ;	Corrupts registers:
   215                              <2> ;		AX
   216                              <2> ;--------------------------------------------------------------------
   217                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   218                              <2> ALIGN DISPLAY_JUMP_ALIGN
   219                              <2> DisplayContext_SetCharacterPointerFromBXAX:
   220                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], ax
   221                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition+2], bx
   222                              <2> 	xchg	di, ax
   223                              <2> 	mov		es, bx
   224                              <2> 	ret
   225                              <2> %endif
   226                              <2> 
