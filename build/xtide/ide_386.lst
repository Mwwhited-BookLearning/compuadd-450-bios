    66                              <2> ; DisplayCursor_SetCoordinatesFromAX
    67                              <2> ;	Parameters:
    68                              <2> ;		AL:		Cursor column (X-coordinate)
    69                              <2> ;		AH:		Cursor row (Y-coordinate)
    70                              <2> ;		DS:		BDA segment (zero)
    71                              <2> ;	Returns:
    72                              <2> ;		DI:		Offset to cursor location in video RAM
    73                              <2> ;	Corrupts registers:
    74                              <2> ;		AX, DX
    75                              <2> ;--------------------------------------------------------------------
    76                              <2> ALIGN DISPLAY_JUMP_ALIGN
    77                              <2> DisplayCursor_SetCoordinatesFromAX:
    78 000001F2 92                  <2> 	xchg	dx, ax
    79 000001F3 A04A04              <2> 	mov		al, [VIDEO_BDA.wColumns]		; Column count, 40 or 80
    80 000001F6 F6E6                <2> 	mul		dh								; AX = Column count * row index
    81 000001F8 30F6                <2> 	xor		dh, dh
    82 000001FA 01D0                <2> 	add		ax, dx							; Add column offset
    83                              <2> 	eSHL_IM	ax, 1							; Convert to WORD offset
   661                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <3> %ifdef USE_386
   663                              <3>  %if %2 = 1
   664                              <3>  FSIS ], %1
   665                              <3>  %if strpos
   666                              <3>  eSHIFT_IM %1, %2, shl
   667                              <3>  %else
   668 000001FC 01C0                <3>  add %1, %1
   669                              <3>  %endif
   670                              <3>  %else
   671                              <3>  eSHIFT_IM %1, %2, shl
   672                              <3>  %endif
   673                              <3> %else
   674                              <3>  eSHIFT_IM %1, %2, shl
   675                              <3> %endif
   676                              <3> %endif
    84 000001FE 03064E04            <2> 	add		ax, [VIDEO_BDA.wPageOffset]		; AX = Video RAM offset
    85 00000202 A35404              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], ax
    86 00000205 97                  <2> 	xchg	di, ax
    87 00000206 C3                  <2> 	ret
    88                              <2> 
