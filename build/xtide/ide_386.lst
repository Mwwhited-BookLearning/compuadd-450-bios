   284                              <1> ; Iterates all Disk Parameter Tables.
   285                              <1> ;
   286                              <1> ; FindDPT_IterateAllDPTs
   287                              <1> ;	Parameters:
   288                              <1> ;		AX,BX,DX:	Parameters to callback function
   289                              <1> ;		CS:SI:		Ptr to callback function
   290                              <1> ;					Callback routine should return CF=clear if found
   291                              <1> ;		DS:			RAMVARS segment
   292                              <1> ;	Returns:
   293                              <1> ;		DS:DI:		Ptr to wanted DPT (if found)
   294                              <1> ;					If not found, points to first empty DPT
   295                              <1> ;		CF:			Cleared if wanted DPT found
   296                              <1> ;					Set if DPT not found, or no DPTs present
   297                              <1> ;	Corrupts registers:
   298                              <1> ;		Nothing unless corrupted by callback function
   299                              <1> ;--------------------------------------------------------------------
