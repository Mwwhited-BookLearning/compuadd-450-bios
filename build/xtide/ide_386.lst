    36                              <1> ;--------------------------------------------------------------------
    37                              <1> ; DetectPrint_StartDetectWithMasterOrSlaveStringInCXandIdeVarsInCSBP
    38                              <1> ;	Parameters:
    39                              <1> ;		CS:CX:	Ptr to "Master" or "Slave" string
    40                              <1> ;		CS:BP:	Ptr to IDEVARS
    41                              <1> ;	Returns:
    42                              <1> ;		Nothing
    43                              <1> ;	Corrupts registers:
    44                              <1> ;		AX, CX, DX, SI, DI
    45                              <1> ;--------------------------------------------------------------------
    46                              <1> DetectPrint_StartDetectWithMasterOrSlaveStringInCXandIdeVarsInCSBP:
    47 0000098B 2E8B4600            <1> 	mov		ax, [cs:bp+IDEVARS.wBasePort]	; For IDE: AX=port address, DH=.bDevice
    48                              <1> 	; Fall to DetectPrint_StartDetectWithAutodetectedBasePortInAXandIdeVarsInCSBP
    49                              <1> 
    50                              <1> ;--------------------------------------------------------------------
    51                              <1> ; DetectPrint_StartDetectWithAutodetectedBasePortInAXandIdeVarsInCSBP
    52                              <1> ;	Parameters:
    53                              <1> ;		AX:		Base Port Address
    54                              <1> ;		CS:CX:	Ptr to "Master" or "Slave" string
    55                              <1> ;		CS:BP:	Ptr to IDEVARS
    56                              <1> ;	Returns:
    57                              <1> ;		Nothing
    58                              <1> ;	Corrupts registers:
    59                              <1> ;		AX, CX, DX, SI, DI
    60                              <1> ;--------------------------------------------------------------------
    61                              <1> DetectPrint_StartDetectWithAutodetectedBasePortInAXandIdeVarsInCSBP:
    62 0000098F 2E8B5603            <1> 	mov		dx, [cs:bp+IDEVARS.bDevice-1]	; For Serial: AL=port address>>2, AH=baud rate
    63                              <1> 											;			  DL=COM number character, DH=.bDevice
    64 00000993 55                  <1> 	push	bp								; Setup stack for call to
    65 00000994 89E5                <1> 	mov		bp, sp							; BootMenuPrint_FormatCSSIfromParamsInSSBP
    66                              <1> 
    67 00000996 51                  <1> 	push 	cx								; Push "Master" or "Slave"
    68                              <1> 
    69 00000997 B1D1                <1> 	mov		cl, (g_szDetectPort-$$) & 0xff	; Setup print string for standard IDE
    70                              <1> 											; Note that we modify only the low order bits of CX a lot here,
    71                              <1> 											; saving code space rather than reloading CX completely.
    72                              <1> 											; This optimization requires that all the g_szDetect* strings are
    73                              <1> 											; on the same 256 byte page, which is checked in strings.asm.
    74                              <1> 
    75                              <1> %ifdef MODULE_SERIAL
    76 00000999 80FE1A              <1> 	cmp		dh, DEVICE_SERIAL_PORT			; Check if this is a serial device
    77 0000099C 7521                <1> 	jne		SHORT .pushAndPrint				; CX = string to print, AX = port address, DX won't be used
    78                              <1> 
    79 0000099E B1BB                <1> 	mov		cl, (g_szDetectCOM-$$) & 0xff	; Setup print string for COM ports
    80 000009A0 51                  <1> 	push	cx								; And push now.  We use the fact that format strings can contain
    81                              <1> 											; themselves format strings.
    82                              <1> 
    83 000009A1 52                  <1> 	push	dx								; Push COM number character
    84                              <1> 											; If the string is going to be "Auto", we will push a NULL (zero)
    85                              <1> 											; here for the COM port number, which will be eaten by the
    86                              <1> 											; print routine (DisplayPrint_CharacterFromAL), resulting in
    87                              <1> 											; just "COM" being printed without a character after it.
    88                              <1> 
    89 000009A2 B1C0                <1>  	mov		cl, (g_szDetectCOMAuto-$$) & 0xff	; Setup secondary print string for "Auto"
    90                              <1> 
    91 000009A4 84D2                <1> 	test	dl, dl							; Check if serial port "Auto"
    92 000009A6 7417                <1> 	jz		SHORT .pushAndPrintSerial		; CX = string to print, AX and DX won't be used
    93                              <1> 
    94 000009A8 B1CC                <1> 	mov		cl, (g_szDetectCOMLarge-$$) & 0xff	; Setup secondary print string for "COMn/xx.yK"
    95                              <1> 
    96 000009AA 88E0                <1> 	mov		al, ah							; baud rate divisor to AL
    97 000009AC 98                  <1> 	cbw										; clear AH, AL will always be less than 128
    98 000009AD 96                  <1> 	xchg	si, ax							; move AX to SI for divide
    99 000009AE B88004              <1> 	mov		ax, 1152						; baud rate to display is 115200/divisor, the "00" is handled
   100                              <1> 											; in the print strings
   101 000009B1 99                  <1> 	cwd										; clear top 16-bits of dividend
   102 000009B2 F7F6                <1> 	div		si								; and divide...  Now AX = baud rate/100, DX = 0 (always a clean divide)
   103                              <1> 
   104 000009B4 BE0A00              <1> 	mov		si, 10							; Now separate the whole portion from the fractional for "K" display
   105 000009B7 F7F6                <1> 	div		si								; and divide...  Now AX = baud rate/1000, DX = low order digit
   106                              <1> 
   107 000009B9 39F0                <1> 	cmp		ax, si							; < 10: "2400", "9600", etc.; >= 10: "19.2K", "38.4K", etc.
   108 000009BB 7302                <1> 	jae		SHORT .pushAndPrintSerial
   109                              <1> 
   110 000009BD B1C7                <1> 	mov		cl, (g_szDetectCOMSmall-$$) & 0xff	; Setup secondary print string for "COMn/XXy00"
   111                              <1> 
   112                              <1> .pushAndPrintSerial:
   113                              <1> .pushAndPrint:
   114                              <1> %endif
   115                              <1> 
   116 000009BF 51                  <1> 	push	cx								; Push print string
   117 000009C0 50                  <1> 	push	ax								; Push high order digits, or port address, or N/A
   118 000009C1 52                  <1> 	push	dx								; Push low order digit, or N/A
   119                              <1> 
   120 000009C2 BE[B400]            <1> 	mov		si, g_szDetectOuter				; Load SI with default wrapper string "%s at %s: "
   121                              <1> 
   122 000009C5 EB46                <1> 	jmp		SHORT DetectPrint_FormatCSSIfromParamsInSSBP
   123                              <1> 
   124                              <1> 
