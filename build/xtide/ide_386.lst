    24                              <1> ; STORE_ERROR_FLAG_TO_DPT
    25                              <1> ;	Parameters:
    26                              <1> ;		%1:		Error flag to set
    27                              <1> ;		AH:		BIOS Error Code
    28                              <1> ;		DS:DI:	Ptr to DPT
    29                              <1> ;		CF:		Set if error code in AH
    30                              <1> ;	Returns:
    31                              <1> ;		CF:		Clear if no error
    32                              <1> ;				Set if error flag was set
    33                              <1> ;	Corrupts registers:
    34                              <1> ;		Nothing
    35                              <1> ;--------------------------------------------------------------------
    36                              <1> %macro STORE_ERROR_FLAG_TO_DPT 1
    37                              <1> 	mov		al, %1
    38                              <1> 	call	SetErrorFlagFromALwithErrorCodeInAH
    39                              <1> %endmacro
