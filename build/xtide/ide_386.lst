   156                              <1> IdePioBlock_ReadFrom8bitDataPort:
   157                              <1> %ifdef USE_186
   158 000013B0 C1E109              <1> 	shl		cx, 9		; Sectors to BYTEs
   159 000013B3 F36C                <1> 	rep insb
   160 000013B5 C3                  <1> 	ret
   161                              <1> 
   162                              <1> %else ; 808x
   163                              <1> %ifdef EXTRA_LOOP_UNROLLING_LARGE
   164                              <1> 	UNROLL_SECTORS_IN_CX_TO_32WORDS
   165                              <1> %elifdef EXTRA_LOOP_UNROLLING_SMALL
   166                              <1> 	UNROLL_SECTORS_IN_CX_TO_16WORDS
   167                              <1> %else
   168                              <1> 	UNROLL_SECTORS_IN_CX_TO_OWORDS
   169                              <1> %endif
   170                              <1> ALIGN JUMP_ALIGN
   171                              <1> .NextIteration:
   172                              <1> %ifdef EXTRA_LOOP_UNROLLING_LARGE
   173                              <1> 	%rep 64	; BYTEs
   174                              <1> 		in		al, dx	; Read BYTE
   175                              <1> 		stosb			; Store BYTE to [ES:DI]
   176                              <1> 	%endrep
   177                              <1> 	dec		cx
   178                              <1> 	jz		SHORT .BlockTransferred
   179                              <1> 	jmp		.NextIteration
   180                              <1> 
   181                              <1> ALIGN JUMP_ALIGN
   182                              <1> .BlockTransferred:
   183                              <1> %elifdef EXTRA_LOOP_UNROLLING_SMALL
   184                              <1> 	%rep 32	; BYTEs
