    40                              <2> SET_VIDEO_MODE							EQU		00h
    41                              <2> SET_TEXT_MODE_CURSOR_SHAPE				EQU		01h
    42                              <2> SET_CURSOR_POSITION						EQU		02h
    43                              <2> GET_CURSOR_POSITION_AND_SIZE			EQU		03h
    44                              <2> SELECT_ACTIVE_DISPLAY_PAGE				EQU		05h
    45                              <2> TELETYPE_OUTPUT							EQU		0Eh
    46                              <2> 
