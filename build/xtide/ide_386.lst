   229                              <2> ;	Returns:
   230                              <2> ;		Nothing
   231                              <2> ;	Corrupts registers:
   232                              <2> ;		AX
   233                              <2> ;--------------------------------------------------------------------
   234                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_BIOSDRVS
   235                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   236                              <2> Keyboard_PlayBellForUnwantedKeystroke:
