   224                              <1> ; InitializePiovarsInSSBPwithSectorCountInAH
   225                              <1> ;	Parameters:
   226                              <1> ;		AH:		Number of sectors to transfer (1...128)
   227                              <1> ;		BX:		Offset to transfer function lookup table
   228                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
