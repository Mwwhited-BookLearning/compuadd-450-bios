    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;---------------------------------------------------------------------
    24                              <1> ; Address_ExtractLCHSparametersFromOldInt13hAddress
    25                              <1> ;	Parameters:
    26                              <1> ;		CH:		Cylinder number, bits 7...0
    27                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9 and 8
    28                              <1> ;				Bits 5...0:	Sector number
    29                              <1> ;		DH:		Head number
    30                              <1> ;	Returns:
    31                              <1> ;		BL:		Sector number (1...63)
    32                              <1> ;		BH:		Head number (0...255)
    33                              <1> ;		CX:		Cylinder number (0...1023)
    34                              <1> ;	Corrupts registers:
    35                              <1> ;		Nothing
    36                              <1> ;--------------------------------------------------------------------
    37 00001BC9 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    38                              <1> Address_ExtractLCHSparametersFromOldInt13hAddress:
    39 00001BCC B33F                <1> 	mov		bl, 3Fh				; Load sector number mask
    40 00001BCE 20CB                <1> 	and		bl, cl				; Sector number now in BL
    41                              <1> %ifndef USE_186
    42                              <1> 	sub		cl, bl				; Remove from cylinder number high
    43                              <1> 	rol		cl, 1				; High bits to beginning
    44                              <1> 	rol		cl, 1
    45                              <1> %else
    46 00001BD0 C0E906              <1> 	shr		cl, 6
    47                              <1> %endif
    48 00001BD3 88F7                <1> 	mov		bh, dh				; Copy Head number
    49 00001BD5 86E9                <1> 	xchg	cl, ch				; Cylinder number now in CX
    50 00001BD7 C3                  <1> 	ret
    51                              <1> 
    52                              <1> 
    53                              <1> ;---------------------------------------------------------------------
    54                              <1> ; Converts LARGE addressing mode LCHS parameters to IDE P-CHS parameters.
    55                              <1> ; PCylinder	= (LCylinder << n) + (LHead / PHeadCount)
    56                              <1> ; PHead		= LHead % PHeadCount
    57                              <1> ; PSector	= LSector
    58                              <1> ;
    59                              <1> ; ConvertLargeModeLCHStoPCHS:
    60                              <1> ;	Parameters:
    61                              <1> ;		BL:		Sector number (1...63)
    62                              <1> ;		BH:		Head number (0...239)
    63                              <1> ;		CX:		Cylinder number (0...1023)
    64                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
    65                              <1> ;	Returns:
    66                              <1> ;		BL:		Sector number (1...63)
    67                              <1> ;		BH:		Head number (0...15)
    68                              <1> ;		CX:		Cylinder number (0...16382)
    69                              <1> ;	Corrupts registers:
    70                              <1> ;		AX, DX
    71                              <1> ;--------------------------------------------------------------------
    72                              <1> ALIGN JUMP_ALIGN
    73                              <1> ConvertLargeModeLCHStoPCHS:
    74                              <1> 	; LHead / PHeadCount and LHead % PHeadCount
    75                              <1> 	eMOVZX	ax, bh					; Copy L-CHS Head number to AX
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 00001BD8 0FB6C7              <2>  movzx %1, %2
   438                              <2> %endif
    76 00001BDB F6750A              <1> 	div		BYTE [di+DPT.bPchsHeads]; AL = LHead / PHeadCount, AH = LHead % PHeadCount
    77 00001BDE 88E7                <1> 	mov		bh, ah					; Copy P-CHS Head number to BH
    78 00001BE0 30E4                <1> 	xor		ah, ah					; AX = LHead / PHeadCount
    79                              <1> 
    80                              <1> 	; (LCylinder << n) + (LHead / PHeadCount)
    81 00001BE2 89CA                <1> 	mov		dx, cx					; Copy L-CHS Cylinder number to DX
    82 00001BE4 B103                <1> 	mov		cl, MASKL_DPT_CHS_SHIFT_COUNT	; Load shift count mask
    83 00001BE6 220D                <1> 	and		cl, [di+DPT.bFlagsLow]	; Shift count now in CL
    84 00001BE8 D3E2                <1> 	shl		dx, cl					; DX = LCylinder << n
    85 00001BEA 01D0                <1> 	add		ax, dx					; AX = P-CHS Cylinder number
    86 00001BEC 91                  <1> 	xchg	cx, ax					; Move P-CHS Cylinder number to CX
    87                              <1> DoNotConvertLCHS:
    88 00001BED C3                  <1> 	ret
    89                              <1> 
    90                              <1> ; *FIXME* The above function description doesn't match the code.
    91                              <1> ; If CX has a maximum value of 1023 on entry then there is no way CX can be 16382 on return.
    92                              <1> ; 1023 SHL 3 (MASKL_DPT_CHS_SHIFT_COUNT) is 8184. With the addition of AX (at most 255?)
    93                              <1> ; the result is 8439.
    94                              <1> 
    95                              <1> ;--------------------------------------------------------------------
    96                              <1> ; Address_OldInt13hAddressToIdeAddress
    97                              <1> ;	Parameters:
    98                              <1> ;		CH:		Cylinder number, bits 7...0
    99                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9 and 8
   100                              <1> ;				Bits 5...0:	Starting sector number (1...63)
   101                              <1> ;		DH:		Starting head number (0...255)
   102                              <1> ;		DS:DI:	Ptr to DPT
   103                              <1> ;	Returns:
   104                              <1> ;		BL:		LBA Low Register / Sector Number Register (LBA 7...0)
   105                              <1> ;		CL:		LBA Mid Register / Low Cylinder Register (LBA 15...8)
   106                              <1> ;		CH:		LBA High Register / High Cylinder Register (LBA 23...16)
   107                              <1> ;		BH:		Drive and Head Register (LBA 27...24)
   108                              <1> ;	Corrupts registers:
   109                              <1> ;		AX, DX
   110                              <1> ;--------------------------------------------------------------------
   111 00001BEE 90<rep 2h>          <1> ALIGN JUMP_ALIGN
   112                              <1> Address_OldInt13hAddressToIdeAddress:
   113 00001BF0 E8D9FF              <1> 	call	Address_ExtractLCHSparametersFromOldInt13hAddress
   114 00001BF3 8A05                <1> 	mov		al, [di+DPT.bFlagsLow]
   115 00001BF5 240C                <1> 	and		al, MASKL_DPT_TRANSLATEMODE
   116                              <1> 
   117                              <1> ;;; 0: TRANSLATEMODE_NORMAL
   118 00001BF7 74F4                <1> 	jz		SHORT DoNotConvertLCHS
   119                              <1> 
   120                              <1> ;;; 1: TRANSLATEMODE_LARGE
   121 00001BF9 A808                <1> 	test	al, FLGL_DPT_ASSISTED_LBA
   122 00001BFB 74DB                <1> 	jz		SHORT ConvertLargeModeLCHStoPCHS
   123                              <1> 
   124                              <1> ;;; 2: TRANSLATEMODE_ASSISTED_LBA
   125                              <1> 	; Fall to ConvertAssistedLBAModeLCHStoLBARegisterValues
   126                              <1> 
   127                              <1> 
   128                              <1> ;---------------------------------------------------------------------
   129                              <1> ; Converts LCHS parameters to 28-bit LBA address.
   130                              <1> ; Only 24-bits are used since LHCS to LBA28 conversion has 8.4GB limit.
   131                              <1> ; LBA = ((cylToSeek*headsPerCyl+headToSeek)*sectPerTrack)+sectToSeek-1
   132                              <1> ; headsPerCyl and sectPerTrack are the current translation values (L-CHS).
   133                              <1> ;
   134                              <1> ; Returned address is in same registers that
   135                              <1> ; DoNotConvertLCHS and ConvertLargeModeLCHStoPCHS returns.
   136                              <1> ;
   137                              <1> ; ConvertAssistedLBAModeLCHStoLBARegisterValues:
   138                              <1> ;	Parameters:
   139                              <1> ;		BL:		Sector number (1...63)
   140                              <1> ;		BH:		Head number (0...254)
   141                              <1> ;		CX:		Cylinder number (0...1023)
   142                              <1> ;		DS:DI:	Ptr to Disk Parameter Table
   143                              <1> ;	Returns:
   144                              <1> ;		BL:		LBA Low Register / Sector Number Register (LBA 7...0)
   145                              <1> ;		CL:		LBA Mid Register / Low Cylinder Register (LBA 15...8)
   146                              <1> ;		CH:		LBA High Register / High Cylinder Register (LBA 23...16)
   147                              <1> ;		BH:		Drive and Head Register (LBA 27...24)
   148                              <1> ;	Corrupts registers:
   149                              <1> ;		AX, DX
   150                              <1> ;--------------------------------------------------------------------
   151                              <1> ConvertAssistedLBAModeLCHStoLBARegisterValues:
   152                              <1> 	; cylToSeek*headsPerCyl (18-bit result)
   153                              <1> 	; Max = 1023 * 255 = 260,865 = 3FB01h
   154 00001BFD B83F00              <1> 	mov		ax, LBA_ASSIST_SPT		; Load Sectors per Track
   155 00001C00 91                  <1> 	xchg	cx, ax					; Cylinder number to AX, Sectors per Track to CX
   156                              <1> %ifdef USE_386
   157 00001C01 0FB65508            <1> 	movzx	dx, BYTE [di+DPT.bLchsHeads]
   158                              <1> %else
   159                              <1> 	cwd
   160                              <1> 	mov		dl, [di+DPT.bLchsHeads]
   161                              <1> %endif
   162 00001C05 F7E2                <1> 	mul		dx						; DX:AX = cylToSeek*headsPerCyl
   163                              <1> 
   164                              <1> 	; +=headToSeek (18-bit result)
   165                              <1> 	; Max = 260,865 + 254 = 261,119 = 3FBFFh
   166 00001C07 00F8                <1> 	add		al, bh					; Add Head number to DX:AX
   167 00001C09 10F4                <1> 	adc		ah, dh					; DH = Zero after previous multiplication
   168 00001C0B 10F2                <1> 	adc		dl, dh
   169                              <1> 
   170                              <1> 	; *=sectPerTrack (18-bit by 6-bit multiplication with 24-bit result)
   171                              <1> 	; Max = 261,119 * 63 = 16,450,497 = FB03C1h
   172 00001C0D 92                  <1> 	xchg	ax, dx					; Hiword to AX, loword to DX
   173 00001C0E F6E1                <1> 	mul		cl						; AX = hiword * Sectors per Track
   174 00001C10 88C7                <1> 	mov		bh, al					; Backup hiword * Sectors per Track
   175 00001C12 92                  <1> 	xchg	ax, dx					; Loword back to AX
   176 00001C13 F7E1                <1> 	mul		cx						; DX:AX = loword * Sectors per Track
   177 00001C15 00FA                <1> 	add		dl, bh					; DX:AX = (cylToSeek*headsPerCyl+headToSeek)*sectPerTrack
   178                              <1> 
   179                              <1> 	; +=sectToSeek-1 (24-bit result)
   180                              <1> 	; Max = 16,450,497 + 63 - 1 = 16,450,559 = FB03FFh
   181 00001C17 88EF                <1> 	mov		bh, ch					; Sector number now in BX, CH=zero
   182 00001C19 4B                  <1> 	dec		bx						; sectToSeek-=1
   183 00001C1A 01C3                <1> 	add		bx, ax					; Add loword to BX (BL = Sector Number Register (LBA 7...0))
   184 00001C1C 10D5                <1> 	adc		ch, dl					; Add possible carry to byte2 (CH = High Cylinder Register (LBA 23...16))
   185 00001C1E 88F9                <1> 	mov		cl, bh					; CL = Low Cylinder Register (LBA 15...8)
   186 00001C20 88F7                <1> 	mov		bh, dh					; BH = Drive and Head Register (LBA 27...24)
   187 00001C22 C3                  <1> 	ret
   339                                  	%include "Prepare.asm"			; For buffer pointer normalization
     1                              <1> ; Project name	:	XTIDE Universal BIOS
     2                              <1> ; Description	:	Functions for preparing data buffer for transfer.
