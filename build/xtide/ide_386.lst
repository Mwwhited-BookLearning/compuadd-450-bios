   146                              <1> ;				Zero if Slave Drive not present
   147                              <1> ;	Corrupts registers:
   148                              <1> ;		AL
   149                              <1> ;--------------------------------------------------------------------
   150                              <1> AdvAtaInit_LoadMasterDPTtoDSSIifSlaveInDSDI:
   151                              <1> 	; Must be Slave Drive if previous DPT has same IDEVARS offset
   152 00000F3D 8D75E2              <1> 	lea		si, [di-LARGEST_DPT_SIZE]	; DS:SI points to previous DPT
   153 00000F40 8A4502              <1> 	mov		al, [di+DPT.bIdevarsOffset]
   154 00000F43 3A4402              <1> 	cmp		al, [si+DPT.bIdevarsOffset]
   155 00000F46 7402                <1> 	je		SHORT .MasterAndSlaveDrivePresent
   156                              <1> 
   157                              <1> 	; We only have single drive so zero SI
   158 00000F48 31F6                <1> 	xor		si, si
   159                              <1> .MasterAndSlaveDrivePresent:
   160 00000F4A C3                  <1> 	ret
