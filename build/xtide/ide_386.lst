   112                              <2> %ifdef EXCLUDE_FROM_XUB
   113                              <2> 	%ifndef MODULE_BOOT_MENU
   114                              <2> 		%define EXCLUDE
   115                              <2> 	%endif
   116                              <2> %endif
   117                              <2> 
   118                              <2> %ifndef EXCLUDE OR EXCLUDE_FROM_BIOSDRVS
   119                              <2> ALIGN DISPLAY_JUMP_ALIGN
   120                              <2> DisplayContext_Push:
   121                              <2> 	mov		di, ds					; Backup DS
   122                              <2> 	LOAD_BDA_SEGMENT_TO	ds, ax
   123                              <2> 	pop		ax						; Pop return address
   124                              <2> 
   125                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   126                              <2> 	%assign i 0
   127                              <2> 	%ifdef USE_386
   128                              <2> 		%rep DISPLAY_CONTEXT_size / 4
   129                              <2> 			push	DWORD [VIDEO_BDA.displayContext + i]
   130                              <2> 			%assign i i+4
   131                              <2> 		%endrep
   132                              <2> 	%else
   133                              <2> 		%rep DISPLAY_CONTEXT_size / 2
   134                              <2> 			push	WORD [VIDEO_BDA.displayContext + i]
   135                              <2> 			%assign i i+2
   136                              <2> 		%endrep
   137                              <2> 	%endif
   138                              <2> %endif
   139                              <2> 
   140                              <2> 	mov		ds, di					; Restore DS
   141                              <2> 	jmp		ax
   142                              <2> 
   143                              <2> 
   144                              <2> ALIGN DISPLAY_JUMP_ALIGN
   145                              <2> DisplayContext_Pop:
   146                              <2> 	mov		di, ds					; Backup DS
   147                              <2> 	LOAD_BDA_SEGMENT_TO	ds, ax
   148                              <2> 	pop		ax						; Pop return address
   149                              <2> 
   150                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   151                              <2> 	%ifdef USE_386
   152                              <2> 		%assign i DISPLAY_CONTEXT_size-4
   153                              <2> 		%rep DISPLAY_CONTEXT_size / 4
   154                              <2> 			pop		DWORD [VIDEO_BDA.displayContext + i]
   155                              <2> 			%assign i i-4
   156                              <2> 		%endrep
   157                              <2> 	%else
   158                              <2> 		%assign i DISPLAY_CONTEXT_size-2
   159                              <2> 		%rep DISPLAY_CONTEXT_size / 2
   160                              <2> 			pop		WORD [VIDEO_BDA.displayContext + i]
   161                              <2> 			%assign i i-2
   162                              <2> 		%endrep
   163                              <2> 	%endif
   164                              <2> %endif
   165                              <2> 
   166                              <2> 	push	ax						; Push return address
   167                              <2> 	push	dx
   168                              <2> 	call	DisplayContext_SynchronizeToHardware
   169                              <2> 	pop		dx
   170                              <2> 	mov		ds, di					; Restore DS
   171                              <2> 	ret
   172                              <2> %endif ; EXCLUDE OR EXCLUDE_FROM_BIOSDRVS
   173                              <2> %undef EXCLUDE
