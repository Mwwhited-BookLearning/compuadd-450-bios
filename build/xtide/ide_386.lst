    21                              <1> ; Section containing code
    22                              <1> SECTION .text
    23                              <1> 
    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Int 13h function AH=23h, Set Controller Features Register.
    26                              <1> ;
    27                              <1> ; AH23h_HandlerForSetControllerFeatures
    28                              <1> ;	Parameters:
    29                              <1> ;		AL, CX:	Same as in INTPACK
    30                              <1> ;		DL:		Translated Drive number
    31                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    32                              <1> ;		SS:BP:	Ptr to IDEPACK
    33                              <1> ;	Parameters on INTPACK:
    34                              <1> ;		AL:		Feature Number (parameter to Features Register = subcommand)
    35                              <1> ;	(Parameter registers are undocumented, these are specific for this BIOS):
    36                              <1> ;		BL:		Parameter to Sector Count Register (subcommand specific)
    37                              <1> ;		BH:		Parameter to LBA Low / Sector Number Register (subcommand specific)
    38                              <1> ;		CL:		Parameter to LBA Middle / Cylinder Low Register (subcommand specific)
    39                              <1> ;		CH:		Parameter to LBA High / Cylinder High Register (subcommand specific)
    40                              <1> ;	Returns with INTPACK:
    41                              <1> ;		AH:		Int 13h return status
    42                              <1> ;		CF:		0 if successful, 1 if error
    43                              <1> ;--------------------------------------------------------------------
    44                              <1> AH23h_HandlerForSetControllerFeatures:
    45 00001B71 96                  <1> 	xchg	si, ax		; SI = Feature Number
    46 00001B72 8B5618              <1> 	mov		dx, [bp+IDEPACK.intpack+INTPACK.bx]
    47                              <1> %ifndef USE_186
    48                              <1> 	call	AH23h_SetControllerFeatures
    49                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    50                              <1> %else
    51 00001B75 68[8018]            <1> 	push	Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    52                              <1> 	; Fall to AH23h_SetControllerFeatures
    53                              <1> %endif
    54                              <1> 
    55                              <1> 
    56                              <1> ;--------------------------------------------------------------------
    57                              <1> ; AH23h_SetControllerFeatures
    58                              <1> ;	Parameters:
    59                              <1> ;		DL:		Parameter to Sector Count Register (subcommand specific)
    60                              <1> ;		DH:		Parameter to LBA Low / Sector Number Register (subcommand specific)
    61                              <1> ;		CL:		Parameter to LBA Middle / Cylinder Low Register (subcommand specific)
    62                              <1> ;		CH:		Parameter to LBA High / Cylinder High Register (subcommand specific)
    63                              <1> ;		SI:		Feature Number (parameter to Features Register = subcommand)
    64                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    65                              <1> ;		SS:BP:	Ptr to IDEPACK
    66                              <1> ;	Returns:
    67                              <1> ;		AH:		Int 13h return status
    68                              <1> ;		CF:		0 if successful, 1 if error
    69                              <1> ;	Corrupts registers:
    70                              <1> ;		AL, BX, CX, DX
    71                              <1> ;--------------------------------------------------------------------
    72                              <1> AH23h_SetControllerFeatures:
    73 00001B78 B0EF                <1> 	mov		al, COMMAND_SET_FEATURES
    74 00001B7A BB80B5              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_BSY, FLG_STATUS_BSY)
    75 00001B7D E9C8F2              <1> 	jmp		Idepack_StoreNonExtParametersAndIssueCommandFromAL
    76                              <1> 
    77                              <1> 
    78                              <1> ;--------------------------------------------------------------------
    79                              <1> ; AH23h_Enable8bitPioMode
    80                              <1> ; AH23h_Disable8bitPioMode
    81                              <1> ;	Parameters:
    82                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    83                              <1> ;		SS:BP:	Ptr to IDEPACK
    84                              <1> ;	Returns:
    85                              <1> ;		AH:		Int 13h return status
    86                              <1> ;		CF:		0 if successful, 1 if error
    87                              <1> ;	Corrupts registers:
    88                              <1> ;		AL, BX, CX, DX, SI
    89                              <1> ;--------------------------------------------------------------------
    90                              <1> %ifdef MODULE_8BIT_IDE
    91                              <1> AH23h_Enable8bitPioMode:
    92 00001B80 BE0100              <1> 	mov		si, FEATURE_ENABLE_8BIT_PIO_TRANSFER_MODE
    93 00001B83 EBF3                <1> 	jmp		SHORT AH23h_SetControllerFeatures
    94                              <1> 
    95                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
    96                              <1> AH23h_Disable8bitPioMode:
    97                              <1> 	mov		si, FEATURE_DISABLE_8BIT_PIO_TRANSFER_MODE
    98                              <1> 	call	AH23h_SetControllerFeatures
    99                              <1> 	xor		ah, ah			; Clear error since modern drives might not understand the command and are
   100                              <1> 	ret						; always in 16-bit mode anyway
   101                              <1> %endif ; MODULE_8BIT_IDE_ADVANCED
   102                              <1> %endif ; MODULE_8BIT_IDE
   103                              <1> 
   104                              <1> 
   105                              <1> ;--------------------------------------------------------------------
   106                              <1> ; Enable/disable advanced power management command can be used to scale
   107                              <1> ; power consumption and performance. Drive supporting Enable APM might not
   108                              <1> ; support Disable APM so we set the drive to max performance if stand by
   109                              <1> ; timer value is 0 (idle/standby disabled)
   110                              <1> ;
   111                              <1> ;
   112                              <1> ; AH23h_EnableOrDisableAdvancedPowerManagement
   113                              <1> ;	Parameters:
   114                              <1> ;		DL:		Stand By timer value (0=disable APM)
   115                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   116                              <1> ;		SS:BP:	Ptr to IDEPACK
   117                              <1> ;	Returns:
   118                              <1> ;		AH:		Int 13h return status
   119                              <1> ;		CF:		0 if successful, 1 if error
   120                              <1> ;	Corrupts registers:
   121                              <1> ;		AL, BX, CX, DX, SI
   122                              <1> ;--------------------------------------------------------------------
   123                              <1> %ifdef MODULE_POWER_MANAGEMENT
   124                              <1> AH23h_EnableOrDisableAdvancedPowerManagement:
   125 00001B85 BE0500              <1> 	mov		si, FEATURE_ENABLE_ADVANCED_POWER_MANAGEMENT
   126 00001B88 84D2                <1> 	test	dl, dl
   127 00001B8A 7503                <1> 	jnz		SHORT .EnablePowerSave
   128 00001B8C B2FE                <1> 	mov		dl, 0FEh	; Maximum performance
   129 00001B8E 3D                  <1> 	SKIP2B	f
   130                              <1> 
   131                              <1> ; TODO: We should add power management level to IDEVARS to be adjustable with xtidecfg
   132                              <1> .EnablePowerSave:
   133 00001B8F B2BF                <1> 	mov		dl, 0BFh	; For Toshiba 1.8" HDD: 80h...BFh = Mode 1
   134 00001B91 EBE5                <1> 	jmp		SHORT AH23h_SetControllerFeatures
   135                              <1> %endif ; MODULE_POWER_MANAGEMENT
