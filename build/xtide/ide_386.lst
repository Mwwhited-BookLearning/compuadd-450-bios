   317                              <2> ; SerialServer_WriteProtocol
   318                              <2> ;
   319                              <2> ; NOTE: As with its read counterpart, this loop is very time sensitive.
   320                              <2> ; Although it will still function, adding additional instructions will
   321                              <2> ; impact the write throughput, especially on slower machines.
   322                              <2> ;
   323                              <2> ;	Parameters:
   324                              <2> ;		ES:SI:	Ptr to buffer
   325                              <2> ;		CX:		Words to write, plus 1
   326                              <2> ;		BP/DI:	Initialized for Checksum (-1 in each)
   327                              <2> ;		DH:		I/O Port high byte
   328                              <2> ;		BX:		LineStatus Register address (BH) and Receive/Transmit Register address (BL)
   329                              <2> ;	Returns:
   330                              <2> ;		BP/SI:	Checksum for written bytes, compared against ACK from server in .readLoop
   331                              <2> ;		CX:		Zero
   332                              <2> ;		DL:		Receive/Transmit Register address
   333                              <2> ;		ES:DI:	Ptr to buffer
   334                              <2> ;	Corrupts registers:
   335                              <2> ;		AX
