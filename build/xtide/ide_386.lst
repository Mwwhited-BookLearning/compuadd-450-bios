   115                              <2> ;	Returns:
   116                              <2> ;		AL:		Hardware cursor column (X-coordinate)
   117                              <2> ;		AH:		Hardware cursor row (Y-coordinate)
   118                              <2> ;	Corrupts registers:
   119                              <2> ;		DX
   120                              <2> ;--------------------------------------------------------------------
   121                              <2> ALIGN DISPLAY_JUMP_ALIGN
   122                              <2> DisplayCursor_GetHardwareCoordinatesToAX:
   123 00000217 51                  <2> 	push	cx
   124 00000218 53                  <2> 	push	bx
   125                              <2> 
   126 00000219 B403                <2> 	mov		ah, GET_CURSOR_POSITION_AND_SIZE
   127 0000021B 8A3E6204            <2> 	mov		bh, [VIDEO_BDA.bActivePage]
   128 0000021F CD10                <2> 	int		BIOS_VIDEO_INTERRUPT_10h
   129 00000221 92                  <2> 	xchg	ax, dx
   130                              <2> 
   131 00000222 5B                  <2> 	pop		bx
   132 00000223 59                  <2> 	pop		cx
   133 00000224 C3                  <2> 	ret
   134                              <2> 
