    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Handler for INT 08h System Timer Tick.
    26                              <1> ; Reads key presses and draws hotkey bar.
    27                              <1> ;
    28                              <1> ; HotkeyBar_TimerTickHandler
    29                              <1> ;	Parameters:
    30                              <1> ;		Nothing
    31                              <1> ;	Returns:
    32                              <1> ;		Nothing
    33                              <1> ;	Corrupts registers:
    34                              <1> ;		Nothing
    35                              <1> ;--------------------------------------------------------------------
    36                              <1> ALIGN JUMP_ALIGN
    37                              <1> HotkeyBar_TimerTickHandler:
    38 00000B0C 06                  <1> 	push	es
    39                              <1> %ifndef USE_186		; LOAD_BDA_SEGMENT_TO will corrupt AX on 8088/8086
    40                              <1> 	push	ax
    41                              <1> %endif
    42                              <1> 	LOAD_BDA_SEGMENT_TO es, ax
