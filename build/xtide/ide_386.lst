   396                              <1> ;--------------------------------------------------------------------
   397                              <1> ; HotkeyBar_InitializeVariables
   398                              <1> ;	Parameters:
   399                              <1> ;		DS:		RAMVARS Segment
   400                              <1> ;		ES:		BDA Segment
   401                              <1> ;	Returns:
   402                              <1> ;		Nothing
   403                              <1> ;	Corrupts registers:
   404                              <1> ;		AX, CX, DX, DI
   405                              <1> ;--------------------------------------------------------------------
   406                              <1> HotkeyBar_InitializeVariables:
   407 00000BEF 1E                  <1> 	push	ds
   408 00000BF0 06                  <1> 	push	es
   409 00000BF1 1F                  <1> 	pop		ds
   410                              <1> 
   411                              <1> 	; Store System Timer Tick handler and install our hotkeybar handler
   412 00000BF2 A12000              <1> 	mov		ax, [BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h*4]
   413 00000BF5 A3047F              <1> 	mov		[BOOTVARS.hotkeyVars+HOTKEYVARS.fpPrevTimerHandler], ax
   414 00000BF8 A12200              <1> 	mov		ax, [BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h*4+2]
   415 00000BFB A3067F              <1> 	mov		[BOOTVARS.hotkeyVars+HOTKEYVARS.fpPrevTimerHandler+2], ax
   416 00000BFE B008                <1> 	mov		al, BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h
   417 00000C00 BE[0C0B]            <1> 	mov		si, HotkeyBar_TimerTickHandler
   418 00000C03 E89AF8              <1> 	call	Interrupts_InstallHandlerToVectorInALFromCSSI
   419                              <1> 
   420                              <1> 	; Store time when hotkeybar is displayed
   421                              <1> 	; (it will be displayed after initialization is complete)
   422 00000C06 A16C04              <1> 	mov		ax, [BDA.dwTimerTicks]
   423 00000C09 A3087F              <1> 	mov		[BOOTVARS.hotkeyVars+HOTKEYVARS.wTimeWhenDisplayed], ax
   424                              <1> 
   425 00000C0C 1F                  <1> 	pop		ds
   426                              <1> 
   427                              <1> 	; Initialize HOTKEYVARS by storing default drives to boot from
   428 00000C0D E8D3FF              <1> 	call	HotkeyBar_StoreDefaultDriveLettersToHotkeyVars
   429 00000C10 2E8A164900          <1> 	mov		dl, [cs:ROMVARS.bBootDrv]
   430                              <1> 	; Fall to HotkeyBar_StoreHotkeyToBootvarsForDriveNumberInDL
   431                              <1> 
   432                              <1> 
   433                              <1> ;--------------------------------------------------------------------
   434                              <1> ; HotkeyBar_StoreHotkeyToBootvarsForDriveNumberInDL
   435                              <1> ;	Parameters:
   436                              <1> ;		DS:		RAMVARS segment
   437                              <1> ;		ES:		BDA segment (zero)
   438                              <1> ;		DL:		Drive Number
   439                              <1> ;	Returns:
   440                              <1> ;		Nothing
   441                              <1> ;	Corrupts registers:
   442                              <1> ;		AX, CX, DL, DI
   443                              <1> ;--------------------------------------------------------------------
   444                              <1> HotkeyBar_StoreHotkeyToBootvarsForDriveNumberInDL:
   445 00000C15 E86D00              <1> 	call	DriveXlate_ConvertDriveNumberFromDLtoDriveLetter
   446                              <1> 	; Fall to StoreHotkeyToBootvarsForDriveLetterInDL
   447                              <1> 
   448                              <1> 
   449                              <1> ;--------------------------------------------------------------------
   450                              <1> ; StoreHotkeyToBootvarsForDriveLetterInDL
   451                              <1> ;	Parameters:
   452                              <1> ;		DS:		RAMVARS segment
   453                              <1> ;		ES:		BDA segment (zero)
   454                              <1> ;		DL:		Drive Letter ('A'...)
   455                              <1> ;	Returns:
   456                              <1> ;		Nothing
   457                              <1> ;	Corrupts registers:
   458                              <1> ;		AX, CX, DI
   459                              <1> ;--------------------------------------------------------------------
   460                              <1> StoreHotkeyToBootvarsForDriveLetterInDL:
   461                              <1> 	eMOVZX	ax, dl
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 00000C18 0FB6C2              <2>  movzx %1, %2
   438                              <2> %endif
   462 00000C1B 0C20                <1> 	or		al, 32	; Upper case drive letter to lower case keystroke
   463 00000C1D EB08                <1> 	jmp		SHORT HotkeyBar_StoreHotkeyToBootvarsIfValidKeystrokeInAX
   464                              <1> 
   465                              <1> 
   466                              <1> ;--------------------------------------------------------------------
   467                              <1> ; ScanHotkeysFromKeyBufferAndStoreToBootvars
   468                              <1> ;	Parameters:
   469                              <1> ;		DS:		RAMVARS segment
   470                              <1> ;		ES:		BDA segment (zero)
   471                              <1> ;	Returns:
   472                              <1> ;		AL:		Last scancode value
   473                              <1> ;	Corrupts registers:
   474                              <1> ;		AH, CX
   475                              <1> ;--------------------------------------------------------------------
   476                              <1> ScanHotkeysFromKeyBufferAndStoreToBootvars:
   477 00000C1F E823F7              <1> 	call	Keyboard_GetKeystrokeToAX
   478 00000C22 7427                <1> 	jz		SHORT NoHotkeyToProcess
   479                              <1> 
   480                              <1> 	; Prepare to read another key from buffer
   481                              <1> 	ePUSH_T	cx, ScanHotkeysFromKeyBufferAndStoreToBootvars
   751                              <2> %ifndef USE_186
   752                              <2>  %ifidni %2, 0
   753                              <2>  xor %1, %1
   754                              <2>  %else
   755                              <2>  mov %1, %2
   756                              <2>  %endif
   757                              <2>  push %1
   758                              <2> 
   759                              <2> %else
   760 00000C24 68[1F0C]            <2>  push %2
   761                              <2> %endif
   482                              <1> 	; Fall to HotkeyBar_StoreHotkeyToBootvarsIfValidKeystrokeInAX
   483                              <1> 
   484                              <1> 
   485                              <1> ;--------------------------------------------------------------------
   486                              <1> ; HotkeyBar_StoreHotkeyToBootvarsIfValidKeystrokeInAX
   487                              <1> ;	Parameters:
   488                              <1> ;		AL:		Hotkey ASCII code
   489                              <1> ;		AH:		Hotkey Scancode
   490                              <1> ;		DS:		RAMVARS segment
   491                              <1> ;		ES:		BDA segment (zero)
   492                              <1> ;	Returns:
   493                              <1> ;		AL:		Last scancode seen
   494                              <1> ;		CF:		Set if valid hotkey in AL
   495                              <1> ;				Clear if scancode in AL is not for any hotkey
   496                              <1> ;	Corrupts registers:
   497                              <1> ;		AH, CX, DI
   498                              <1> ;--------------------------------------------------------------------
   499                              <1> HotkeyBar_StoreHotkeyToBootvarsIfValidKeystrokeInAX:
   500 00000C27 BF0D7F              <1> 	mov		di, BOOTVARS.hotkeyVars+HOTKEYVARS.bScancode
   501                              <1> 
   502                              <1> 	; All scancodes are saved, even if it wasn't a drive letter,
   503                              <1> 	; which also covers our function key case.  Invalid function keys
   504                              <1> 	; will not do anything (won't be printed, won't be accepted as input)
   505 00000C2A 268825              <1> 	mov		[es:di], ah
   506                              <1> 
   507                              <1> 	; Drive letter hotkeys remaining, allow 'a' to 'z'
   508 00000C2D E821F7              <1> 	call	Char_IsLowerCaseLetterInAL
   509 00000C30 7319                <1> 	jnc		SHORT .KeystrokeIsNotValidDriveLetter
   510 00000C32 24DF                <1> 	and		al, ~32					; We want to print upper case letters
   511                              <1> 
   512                              <1> 	; Clear HD First flag to assume Floppy Drive hotkey
   513 00000C34 4F                  <1> 	dec		di
   514 00000C35 268025FE            <1> 	and		BYTE [es:di], ~FLG_HOTKEY_HD_FIRST
   515                              <1> 
   516                              <1> 	; Determine if Floppy or Hard Drive hotkey
   517 00000C39 91                  <1> 	xchg	cx, ax
   518 00000C3A E820F9              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
   519 00000C3D 38C1                <1> 	cmp		cl, al
   520 00000C3F 7204                <1> 	jb		SHORT .StoreDriveLetter	; Store Floppy Drive letter
   521                              <1> 
   522                              <1> 	; Store Hard Drive letter
   523 00000C41 26800D01            <1> 	or		BYTE [es:di], FLG_HOTKEY_HD_FIRST
   524                              <1> 
   525                              <1> .StoreDriveLetter:
   526 00000C45 83DF01              <1> 	sbb		di, BYTE 1				; Sub CF if Floppy Drive
   527 00000C48 91                  <1> 	xchg	ax, cx
   528 00000C49 AA                  <1> 	stosb
   529 00000C4A F9                  <1> 	stc								; Valid hotkey scancode returned in AL
   530                              <1> 
   531                              <1> .KeystrokeIsNotValidDriveLetter:
   532                              <1> NoHotkeyToProcess:
   533 00000C4B 26A00D7F            <1> 	mov		al, [es:BOOTVARS.hotkeyVars+HOTKEYVARS.bScancode]
   534 00000C4F C3                  <1> 	ret
   535                              <1> 
   536                              <1> 
   537                              <1> ;--------------------------------------------------------------------
   538                              <1> ; HotkeyBar_GetBootDriveNumbersToDX
   539                              <1> ;	Parameters:
   540                              <1> ;		DS:		RAMVARS segment
   541                              <1> ;		ES:		BDA segment (zero)
   542                              <1> ;	Returns:
   543                              <1> ;		DX:		Drives selected as boot device, DL is primary
   544                              <1> ;	Corrupts registers:
   545                              <1> ;		AX
   546                              <1> ;--------------------------------------------------------------------
   547                              <1> HotkeyBar_GetBootDriveNumbersToDX:
   548 00000C50 268B160A7F          <1> 	mov		dx, [es:BOOTVARS.hotkeyVars+HOTKEYVARS.wFddAndHddLetters]
   549                              <1> 
   550                              <1> 	; HotkeyBar_GetBootDriveNumbersToDX is called when all drives are detected and
   551                              <1> 	; drive letters are known.
   552                              <1> 	; Replace unavailable hard drive letter with first hard drive.
   553                              <1> 	; If we have boot menu, it will be displayed instead.
   554                              <1> %ifndef MODULE_BOOT_MENU
   555 00000C55 E805F9              <1> 	call	BootVars_GetLetterForFirstHardDriveToAX
   556 00000C58 88C4                <1> 	mov		ah, al
   557 00000C5A 2602067504          <1> 	add		al, [es:BDA.bHDCount]	; AL now contains first unavailable HD letter
   558 00000C5F 38C6                <1> 	cmp		dh, al					; Unavailable drive?
   559 00000C61 7202                <1> 	jb		SHORT .ValidHardDriveLetterInDH
   560 00000C63 88E6                <1> 	mov		dh, ah					; Replace unavailable drive with first drive
   561                              <1> .ValidHardDriveLetterInDH:
   562                              <1> %endif
   563                              <1> 
   564 00000C65 26F6060C7F01        <1> 	test	BYTE [es:BOOTVARS.hotkeyVars+HOTKEYVARS.bFlags], FLG_HOTKEY_HD_FIRST
   565 00000C6B 7502                <1> 	jnz		SHORT .noflip
   566 00000C6D 86F2                <1> 	xchg	dl, dh
   567                              <1> .noflip:
   568 00000C6F E80200              <1> 	call	DriveXlate_ConvertDriveLetterInDLtoDriveNumber
   569 00000C72 86F2                <1> 	xchg	dl, dh
   570                              <1> 	; Fall to HotkeyBar_FallThroughTo_DriveXlate_ConvertDriveLetterInDLtoDriveNumber
   571                              <1> 
   572                              <1> HotkeyBar_FallThroughTo_DriveXlate_ConvertDriveLetterInDLtoDriveNumber:
   573                              <1> 
   262                                  %endif
   263                                  %ifdef MODULE_DRIVEXLATE
   264                                  	%include "DriveXlate.asm"		; For swapping drive numbers, must come immediately after HotkeyBar.asm
