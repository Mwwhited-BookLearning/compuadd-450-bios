   332                              <2> ;--------------------------------------------------------------------
   333                              <2> ; DisplayContext_GetCharacterOffsetToAXfromByteOffsetInAX
   334                              <2> ;	Parameters:
   335                              <2> ;		AX:		Offset in bytes from some character to another
   336                              <2> ;		DS:		BDA segment (zero)
   337                              <2> ;	Returns:
   338                              <2> ;		AX:		Offset in characters from some character to another
   339                              <2> ;	Corrupts registers:
   340                              <2> ;		Nothing
   341                              <2> ;--------------------------------------------------------------------
   342                              <2> %ifndef MODULE_STRINGS_COMPRESSED
   343                              <2> ALIGN DISPLAY_JUMP_ALIGN
   344                              <2> DisplayContext_GetCharacterOffsetToAXfromByteOffsetInAX:
   345                              <2> 	test	BYTE [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bFlags], FLG_CONTEXT_ATTRIBUTES
   346                              <2> 	jz		SHORT ReturnOffsetInAX
   347                              <2> 	sar		ax, 1		; BYTE count to WORD count
   348                              <2> 	ret
   349                              <2> %endif
   350                              <2> 
   351                              <2> 
   352                              <2> ;--------------------------------------------------------------------
   353                              <2> ; DisplayContext_GetByteOffsetToAXfromCharacterOffsetInAX
   354                              <2> ;	Parameters:
   355                              <2> ;		AX:		Offset in characters from some character to another
   356                              <2> ;		DS:		BDA segment (zero)
   357                              <2> ;	Returns:
   358                              <2> ;		AX:		Offset in bytes from some character to another
   359                              <2> ;	Corrupts registers:
   360                              <2> ;		Nothing
   361                              <2> ;--------------------------------------------------------------------
   362                              <2> %ifndef MODULE_STRINGS_COMPRESSED
   363                              <2> ALIGN DISPLAY_JUMP_ALIGN
   364                              <2> DisplayContext_GetByteOffsetToAXfromCharacterOffsetInAX:
   365                              <2> 	test	BYTE [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bFlags], FLG_CONTEXT_ATTRIBUTES
   366                              <2> 	jz		SHORT ReturnOffsetInAX
   367                              <2> 	sal		ax, 1		; WORD count to BYTE count
   368                              <2> ALIGN DISPLAY_JUMP_ALIGN, ret
   369                              <2> ReturnOffsetInAX:
   370                              <2> 	ret
   371                              <2> %endif
