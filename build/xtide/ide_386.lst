    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=44h, Extended Verify Sectors.
    25                              <1> ;
    26                              <1> ; AH44h_HandlerForExtendedVerifySectors
    27                              <1> ;	Parameters:
    28                              <1> ;		SI:		Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		DS:SI:	Ptr to Disk Address Packet
    34                              <1> ;	Returns with INTPACK:
    35                              <1> ;		AH:		Int 13h return status
    36                              <1> ;		CF:		0 if successful, 1 if error
    37                              <1> ;	Return with Disk Address Packet in INTPACK:
    38                              <1> ;		.wSectorCount	Number of sectors verified successfully
    39                              <1> ;--------------------------------------------------------------------
    40 00001CA6 90<rep 2h>          <1> ALIGN JUMP_ALIGN
    41                              <1> AH44h_HandlerForExtendedVerifySectors:
    42 00001CA8 E879FF              <1> 	call	Prepare_ByLoadingDapToESSIandVerifyingForTransfer
    43 00001CAB 26FF7402            <1> 	push	WORD [es:si+DAP.wSectorCount]				; Store for successful number of sectors transferred
    44 00001CAF 2E8AA7[6D1C]        <1> 	mov		ah, [cs:bx+g_rgbVerifyCommandLookup]
    45 00001CB4 BB40FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRDY)
    46 00001CB7 E832F1              <1> 	call	Idepack_ConvertDapToIdepackAndIssueCommandFromAH
    47                              <1> 
    48                              <1> 	; Now we need number of succesfully verifed sectors to CX. Since we did not transfer anything,
    49                              <1> 	; we did not have any sector counter like in read and write functions.
    50                              <1> 	; In case of error, drive LBA registers are set to address where the error occurred. We must
    51                              <1> 	; calculate number of succesfully transferred sectors from it.
    52 00001CBA 59                  <1> 	pop		cx
    53 00001CBB 7303                <1> 	jnc		SHORT .AllSectorsVerifiedSuccessfully
    54                              <1> 
    55                              <1> ; TODO: For now we assume serial device do not produce verify errors
    56 00001CBD E814FD              <1> 	call	AH4h_CalculateNumberOfSuccessfullyVerifiedSectors
    57                              <1> 
    58                              <1> ALIGN JUMP_ALIGN
    59                              <1> .AllSectorsVerifiedSuccessfully:
    60 00001CC0 EBC0                <1> 	jmp		SHORT AH42h_ReturnFromInt13hAfterStoringErrorCodeFromAHandTransferredSectorsFromCX
