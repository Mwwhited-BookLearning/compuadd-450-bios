    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=0h, Disk Controller Reset.
    25                              <1> ;
    26                              <1> ; Note: We handle all AH=0h calls, even for drives handled by other
    27                              <1> ; BIOSes!
    28                              <1> ;
    29                              <1> ; AH0h_HandlerForDiskControllerReset
    30                              <1> ;	Parameters:
    31                              <1> ;		DL:		Translated Drive number (ignored so all drives are reset)
    32                              <1> ;				If bit 7 is set all hard disks and floppy disks reset.
    33                              <1> ;		DS:DI:	Ptr to DPT (or Null if foreign drive)
    34                              <1> ;		SS:BP:	Ptr to IDEPACK
    35                              <1> ;	Returns with INTPACK:
    36                              <1> ;		AH:		Int 13h return status (from drive requested in DL)
    37                              <1> ;		CF:		0 if successful, 1 if error
    38                              <1> ;--------------------------------------------------------------------
    39                              <1> AH0h_HandlerForDiskControllerReset:
    40                              <1> 	; Reset foreign Floppy and Hard Drives (those handled by other BIOSes)
    41                              <1> 	eMOVZX	bx, dl										; Copy requested drive to BL and zero BH to assume no errors
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
   414                              <2>  %elifidni %1, cx
   415                              <2>  mov cl, %2
   416                              <2>  xor ch, ch
   417                              <2>  %elifidni %1, dx
   418                              <2>  mov dl, %2
   419                              <2>  xor dh, dh
   420                              <2>  %else
   421                              <2>  FSIS %1, %2
   422                              <2>  %if strpos
   423                              <2>  push ax
   424                              <2>  mov al, %2
   425                              <2>  xor ah, ah
   426                              <2>  xchg %1, ax
   427                              <2>  pop ax
   428                              <2>  %else
   429                              <2>  xchg %1, ax
   430                              <2>  mov al, %2
   431                              <2>  xor ah, ah
   432                              <2>  xchg %1, ax
   433                              <2>  %endif
   434                              <2>  %endif
   435                              <2> 
   436                              <2> %else
   437 00001918 0FB6DA              <2>  movzx %1, %2
   438                              <2> %endif
    42                              <1> 
    43 0000191B 30E4                <1> 	xor		ah, ah										; Disk Controller Reset
    44 0000191D E874FF              <1> 	call	Int13h_CallPreviousInt13hHandler			; Reset floppy drives only or floppy drives and foreign hard disks
    45 00001920 E81B00              <1> 	call	BackupErrorCodeFromTheRequestedDriveToBH
    46                              <1> 
    47                              <1> %ifdef MODULE_SERIAL_FLOPPY
    48                              <1> ;
    49                              <1> ; "Reset" emulated serial floppy drives, if any.  There is nothing to actually do for this reset,
    50                              <1> ; but record the proper error return code if one of these floppy drives is the drive requested.
    51                              <1> ;
    52 00001923 E80AEC              <1> 	call	RamVars_UnpackFlopCntAndFirstToAL
    53 00001926 98                  <1> 	cbw													; Clears AH (there are flop drives) or ffh (there are not)
    54                              <1> 														; Either AH has success code (flop drives are present)
    55                              <1> 														; or it doesn't matter because we won't match drive ffh
    56                              <1> 
    57 00001927 99                  <1> 	cwd													; clears DX (there are flop drives) or ffffh (there are not)
    58                              <1> 
    59 00001928 10C2                <1> 	adc		dl, al										; second drive (CF set) if present
    60                              <1> 														; If no drive is present, this will result in ffh which
    61                              <1> 														; won't match a drive
    62 0000192A E81100              <1> 	call	BackupErrorCodeFromTheRequestedDriveToBH
    63 0000192D 88C2                <1> 	mov		dl, al										; We may end up doing the first drive twice (if there is
    64 0000192F E80C00              <1> 	call	BackupErrorCodeFromTheRequestedDriveToBH	; only one drive), but doing it again is not harmful.
    65                              <1> %endif
    66 00001932 84DB                <1> 	test	bl, bl										; If we were called with a floppy disk, then we are done,
    67 00001934 7903                <1> 	jns		SHORT .SkipHardDiskReset					; don't do hard disks.
    68                              <1> 
    69                              <1> 	; Resetting our hard disks will modify dl and bl to be idevars offset based instead of drive number based,
    70                              <1> 	; such that this call must be the last in the list of reset routines called.
    71                              <1> 	;
    72                              <1> 	; This needs to happen after ResetForeignDrives, as that call may have set the error code for 80h,
    73                              <1> 	; and we need to override that value if we are xlate'd into 80h with one of our drives.
    74                              <1> 	;
    75 00001936 E80C00              <1> 	call	ResetHardDisksHandledByOurBIOS
    76                              <1> 
    77                              <1> .SkipHardDiskReset:
    78 00001939 88FC                <1> 	mov		ah, bh
    79 0000193B E942FF              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    80                              <1> 
    81                              <1> 
    82                              <1> ;--------------------------------------------------------------------
    83                              <1> ; BackupErrorCodeFromTheRequestedDriveToBH
    84                              <1> ;	Parameters:
    85                              <1> ;		AH:		Error code from the last resetted drive
    86                              <1> ;		DL:		Drive last resetted
    87                              <1> ;		BL:		Requested drive (DL when entering AH=00h)
    88                              <1> ;	Returns:
    89                              <1> ;		BH:		Backuped error code
    90                              <1> ;	Corrupts registers:
    91                              <1> ;		Nothing
    92                              <1> ;--------------------------------------------------------------------
    93                              <1> BackupErrorCodeFromTheRequestedDriveToBH:
    94 0000193E 38DA                <1> 	cmp		dl, bl				; Requested drive?
    95                              <1> 	eCMOVE	bh, ah
   344                              <2>  eCMOVZ %1, %2
   332 00001940 7502                <3>  jnz SHORT %%Return
   333 00001942 88E7                <3>  mov %1, %2
   334                              <3> %%Return:
    96 00001944 C3                  <1> 	ret
    97                              <1> 
    98                              <1> 
    99                              <1> ;--------------------------------------------------------------------
   100                              <1> ; ResetHardDisksHandledByOurBIOS
   101                              <1> ;	Parameters:
   102                              <1> ;		BL:		Requested drive (DL when entering AH=00h)
   103                              <1> ;		DS:DI:	Ptr to DPT for requested drive
   104                              <1> ;				If DPT pointer is not available, or error result in BH won't be used anyway,
   105                              <1> ;				enter through .ErrorCodeNotUsed.
   106                              <1> ;		SS:BP:	Ptr to IDEPACK
   107                              <1> ;	Returns:
   108                              <1> ;		BH:		Error code from requested drive (if available)
   109                              <1> ;	Corrupts registers:
   110                              <1> ;		AX, BX, CX, DX, SI, DI
   111                              <1> ;--------------------------------------------------------------------
   112                              <1> ResetHardDisksHandledByOurBIOS:
   113 00001945 30DB                <1> 	xor		bl, bl										; Assume Null IdevarsOffset for now, assuming foreign drive
   114 00001947 85FF                <1> 	test	di, di
   115 00001949 7403                <1> 	jz		SHORT .ErrorCodeNotUsed
   116 0000194B 8A5D02              <1> 	mov		bl, [di+DPT.bIdevarsOffset]					; replace drive number with Idevars pointer for cmp with dl
   117                              <1> .ErrorCodeNotUsed:										; BH will be garbage on exit if this entry point is used,
   118                              <1> 														; but reset of all drives will still happen
   119 0000194E B24E                <1> 	mov		dl, ROMVARS.ideVars0						; starting Idevars offset
   120                              <1> 
   121                              <1> 	; Get count of ALL Idevars structures, not just the ones that are configured.  This may seem odd,
   122                              <1> 	; but it catches the .ideVarsSerialAuto structure, which would not be scanned if the count from
   123                              <1> 	; RamVars_GetIdeControllerCountToCX was used.  Unused controllers won't make a difference, since no DPT
   124                              <1> 	; will point to them.  Performance isn't an issue, as this is a reset operation.
   125                              <1> 	;
   126 00001950 B90500              <1> 	mov		cx, NUMBER_OF_IDEVARS
   127                              <1> 
   128                              <1> .Loop:
   129 00001953 E86DED              <1> 	call	FindDPT_MasterOrSingleForIdevarsOffsetInDL
   130 00001956 721D                <1> 	jc		SHORT .ControllerNotAvailable
   131                              <1> 
   132                              <1> 	; Reset controller (both Master and Slave Drive). We ignore error codes
   133                              <1> 	; here since initialization is the one that matters.
   134 00001958 51                  <1> 	push	cx
   135 00001959 52                  <1> 	push	dx
   136 0000195A 53                  <1> 	push	bx
   137                              <1> %ifdef MODULE_IRQ
   138 0000195B E851EB              <1> 	call	Interrupts_UnmaskInterruptControllerForDriveInDSDI
   139                              <1> %endif
   140 0000195E E810F5              <1> 	call	Device_ResetMasterAndSlaveController
   141                              <1> %ifdef MODULE_ADVANCED_ATA
   142 00001961 E8BDF5              <1> 	call	AdvAtaInit_InitializeControllerForDPTinDSDI
   143                              <1> %endif
   144 00001964 5B                  <1> 	pop		bx
   145 00001965 5A                  <1> 	pop		dx
   146                              <1> 
   147                              <1> 	; Initialize Master Drive
   148 00001966 E8D700              <1> 	call	AH9h_InitializeDriveForUse					; Initialize Master drive
   149 00001969 E8D2FF              <1> 	call	BackupErrorCodeFromTheRequestedDriveToBH
   150                              <1> 
   151                              <1> 	; Initialize Slave Drive
   152 0000196C E859ED              <1> 	call	FindDPT_SlaveForIdevarsOffsetInDL
   153 0000196F 7203                <1> 	jc		SHORT .SlaveDriveNotAvailable
   154 00001971 E8CC00              <1> 	call	AH9h_InitializeDriveForUse
   155                              <1> 	; Here we have a small problem. Since DL now has offset to IDEVARS, it will be the same
   156                              <1> 	; for both Master and Slave Drive. We simply ignore error from slave drive reset since most
   157                              <1> 	; systems do not have slave drives at all and it is unlikely that AH=00h would be called for
   158                              <1> 	; specific drive anyway. AH=Dh is for that.
   159                              <1> 
   160                              <1> .SlaveDriveNotAvailable:
   161 00001974 59                  <1> 	pop		cx
   162                              <1> .ControllerNotAvailable:
   163 00001975 80C212              <1> 	add		dl, IDEVARS_size							; move Idevars pointer forward
   164 00001978 E2D9                <1> 	loop	.Loop
   165 0000197A C3                  <1> 	ret
