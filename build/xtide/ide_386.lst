    71                              <1> ; Returns offset to DRVDETECTINFO based on DPT pointer.
    72                              <1> ;
    73                              <1> ; DriveDetectInfo_ConvertDPTtoBX
    74                              <1> ;	Parameters:
    75                              <1> ;		DS:DI:	DPT Pointer
    76                              <1> ;	Returns:
    77                              <1> ;		BX:		Offset to DRVDETECTINFO struct
    78                              <1> ;	Corrupts registers:
    79                              <1> ;		AX
    80                              <1> ;--------------------------------------------------------------------
    81                              <1> DriveDetectInfo_ConvertDPTtoBX:
    82                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
    83                              <1> %if DPT_DRVDETECTINFO_SIZE_MULTIPLIER = 2
    84                              <1> %if BOOTVARS.rgDrvDetectInfo & 1					; Should never be odd but better safe than sorry
    85                              <1> 	lea		bx, [di-RAMVARS_size]
    86                              <1> 	eSHL_IM	bx, 1
    87                              <1> 	add		bx, BOOTVARS.rgDrvDetectInfo
    88                              <1> %else
    89 000007EC 8D9D773F            <1> 	lea		bx, [di-RAMVARS_size+(BOOTVARS.rgDrvDetectInfo/2)]
    90                              <1> 	eSHL_IM	bx, 1
   661                              <2> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <2> %ifdef USE_386
   663                              <2>  %if %2 = 1
   664                              <2>  FSIS ], %1
   665                              <2>  %if strpos
   666                              <2>  eSHIFT_IM %1, %2, shl
   667                              <2>  %else
   668 000007F0 01DB                <2>  add %1, %1
   669                              <2>  %endif
   670                              <2>  %else
   671                              <2>  eSHIFT_IM %1, %2, shl
   672                              <2>  %endif
   673                              <2> %else
   674                              <2>  eSHIFT_IM %1, %2, shl
   675                              <2> %endif
   676                              <2> %endif
    91                              <1> %endif
    92                              <1> %else
    93                              <1> %ifdef USE_186
    94                              <1> 	lea		bx, [di-RAMVARS_size]
    95                              <1> 	imul	bx, DPT_DRVDETECTINFO_SIZE_MULTIPLIER
    96                              <1> 	add		bx, BOOTVARS.rgDrvDetectInfo
    97                              <1> %else
    98                              <1> 	lea		ax, [di-RAMVARS_size]					; subtract off base of DPTs
    99                              <1> 	mov		bl, DPT_DRVDETECTINFO_SIZE_MULTIPLIER	; DRVDETECTINFO are a whole number multiple of DPT size
   100                              <1> 	mul		bl
   101                              <1> 	add		ax, BOOTVARS.rgDrvDetectInfo			; add base of DRVDETECTINFO
   102                              <1> 	xchg	bx, ax
   103                              <1> %endif
   104                              <1> %endif
   105                              <1> %endif
   106 000007F2 C3                  <1> 	ret
