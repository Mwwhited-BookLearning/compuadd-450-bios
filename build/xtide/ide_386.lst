    19                              <1> 
    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=4h, Verify Disk Sectors.
    25                              <1> ;
    26                              <1> ; AH4h_HandlerForVerifyDiskSectors
    27                              <1> ;	Parameters:
    28                              <1> ;		AL, CX, DH:	Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK in SS:BP:
    33                              <1> ;		AL:		Number of sectors to verify (1...128)
    34                              <1> ;		CH:		Cylinder number, bits 7...0
    35                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9 and 8
    36                              <1> ;				Bits 5...0:	Starting sector number (1...63)
    37                              <1> ;		DH:		Starting head number (0...255)
    38                              <1> ;	Returns with INTPACK in SS:BP:
    39                              <1> ;		AH:		Int 13h/40h floppy return status
    40                              <1> ;		AL:		Number of sectors actually verified (only valid if CF set for some BIOSes)
    41                              <1> ;		CF:		0 if successful, 1 if error
    42                              <1> ;--------------------------------------------------------------------
    43                              <1> ALIGN JUMP_ALIGN
    44                              <1> AH4h_HandlerForVerifyDiskSectors:
    45 000019BC B440                <1> 	mov		ah, COMMAND_VERIFY_SECTORS
    46 000019BE E88D02              <1> 	call	Prepare_ByValidatingSectorsInALforOldInt13h	; Preserves AX
    47 000019C1 BB40FF              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRQ, FLG_STATUS_DRDY)
    48 000019C4 50                  <1> 	push	ax			; Store number of sectors to verify
    49 000019C5 E85CF4              <1> 	call	Idepack_TranslateOldInt13hAddressAndIssueCommandFromAH
    50 000019C8 59                  <1> 	pop		cx			; Number of sectors verified if successful
    51 000019C9 7303                <1> 	jnc		SHORT .NoErrors
    52                              <1> 
    53                              <1> ; TODO: For now we assume serial device do not produce verify errors
    54 000019CB E80600              <1> 	call	AH4h_CalculateNumberOfSuccessfullyVerifiedSectors
    55                              <1> .NoErrors:
    56 000019CE E9ABFE              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAHandTransferredSectorsFromCL
    57                              <1> 
    58                              <1> 
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> ; Calculates number of succesfully verified sectors. This function works only
    61                              <1> ; if verify command stopped to an device error (such as bad sector) since IDE
    62                              <1> ; register contents are not valid unless error.
    63                              <1> ;
    64                              <1> ; AH4h_CalculateNumberOfSuccessfullyVerifiedSectors
    65                              <1> ;	Parameters:
    66                              <1> ;		AH:		INT 13h error code
    67                              <1> ;		CX:		Number of sectors that was meant to be verified
    68                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    69                              <1> ;		SS:BP:	Ptr to IDEPACK
    70                              <1> ;	Returns with INTPACK in SS:BP:
    71                              <1> ;		CX:		Number of sectors succesfully verified
    72                              <1> ;		CF:		1
    73                              <1> ;--------------------------------------------------------------------
    74 000019D1 90<rep 3h>          <1> ALIGN JUMP_ALIGN
    75                              <1> AH4h_CalculateNumberOfSuccessfullyVerifiedSectors:
    76 000019D4 91                  <1> 	xchg	cx, ax						; Store error code to CH
    77 000019D5 E824F8              <1> 	call	Device_ReadLBAlowRegisterToAL
    78 000019D8 2A4603              <1> 	sub		al, [bp+IDEPACK.bLbaLow]	; AL = sector address with verify failure - starting sector address
    79 000019DB 30E4                <1> 	xor		ah, ah
    80 000019DD 91                  <1> 	xchg	cx, ax						; Number of successfully verified sectors in CX, error code in AH
    81 000019DE F9                  <1> 	stc
    82 000019DF C3                  <1> 	ret
