    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> %define SERIALSERVER_AH_ALREADY_HAS_COMMAND_BYTE
    24                              <1> %define SERIALSERVER_NO_ZERO_SECTOR_COUNTS
    25                              <1> 
    26                              <1> ;--------------------------------------------------------------------
    27                              <1> ; SerialCommand_OutputWithParameters
    28                              <1> ;	Parameters:
    29                              <1> ;		BH:		Non-zero if 48-bit addressing used
    30                              <1> ;				(ignored at present as 48-bit addressing is not supported)
    31                              <1> ;		BL:		IDE Status Register bit to poll after command
    32                              <1> ;				(ignored at present, since there is no IDE status register to poll)
    33                              <1> ;		ES:SI:	Ptr to buffer (for data transfer commands)
    34                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    35                              <1> ;		SS:BP:	Ptr to IDEREGS_AND_INTPACK
    36                              <1> ;	Returns:
    37                              <1> ;		AH:		INT 13h Error Code
    38                              <1> ;		CX:		Number of successfully transferred sectors (for transfer commands)
    39                              <1> ;		CF:		Cleared if success, Set if error
    40                              <1> ;	Corrupts registers:
    41                              <1> ;		AL, BX, CX, DX, (ES:SI for data transfer commands)
    42                              <1> ;--------------------------------------------------------------------
    43                              <1> ALIGN JUMP_ALIGN
    44                              <1> SerialCommand_OutputWithParameters:
    45 000015E4 B4A2                <1> 	mov		ah, SerialServer_Command_Read
    46 000015E6 8A4606              <1> 	mov		al, [bp+IDEPACK.bCommand]
    47                              <1> 
    48 000015E9 3C20                <1> 	cmp		al, 20h							; Read Sectors IDE command
    49 000015EB 7409                <1> 	je		SHORT .readOrWrite
    50 000015ED FEC4                <1> 	inc		ah								; now SerialServer_Protocol_Write
    51 000015EF 3C30                <1> 	cmp		al, 30h							; Write Sectors IDE command
    52 000015F1 7403                <1> 	je		SHORT .readOrWrite
    53                              <1> 
    54                              <1> ;  all other commands return success
    55                              <1> ;  including function 0ech which should return drive information, this is handled with the identify functions
    56                              <1> ;
    57 000015F3 30E4                <1> 	xor		ah, ah							;  also clears carry
    58 000015F5 C3                  <1> 	ret
    59                              <1> 
    60                              <1> .readOrWrite:
    61 000015F6 886600              <1> 	mov		[bp+IDEPACK.bFeatures], ah		; store protocol command
    62                              <1> %ifdef USE_AT
    63 000015F9 8A7602              <1> 	mov		dh, [bp+IDEPACK.bSectorCount]
    64                              <1> %endif
    65 000015FC E8C4FC              <1> 	call	IdeTransfer_NormalizePointerInESSI
    66                              <1> %ifdef USE_AT
    67 000015FF 7304                <1> 	jnc		SHORT .PointerNormalizationWasSuccessful
    68 00001601 31C9                <1> 	xor		cx, cx							; Nothing transferred
    69 00001603 F9                  <1> 	stc
    70 00001604 C3                  <1> 	ret
    71                              <1> .PointerNormalizationWasSuccessful:
    72                              <1> %endif
    73                              <1> 
    74 00001605 8B5514              <1> 	mov		dx, [di+DPT_SERIAL.wSerialPortAndBaud]
    75                              <1> ; fall through to SerialCommand_FallThroughToSerialServer_SendReceive
    76                              <1> 
    77                              <1> ALIGN JUMP_ALIGN
