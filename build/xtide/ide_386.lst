    20                              <2> %ifdef INCLUDE_MENU_LIBRARY
    21                              <2> struc BYTE_MULTIPLES
    22                              <2> 	.B			resb	1
    23                              <2> 	.kiB		resb	1
    24                              <2> 	.MiB		resb	1
    25                              <2> 	.GiB		resb	1
    26                              <2> 	.TiB		resb	1
    27                              <2> endstruc
    28                              <2> 
    29                              <2> ; Section containing code
    30                              <2> SECTION .text
    31                              <2> 
    32                              <2> ;--------------------------------------------------------------------
    33                              <2> ; Size_GetSizeToAXAndCharToDLfromBXDXAXwithMagnitudeInCX
    34                              <2> ;	Parameters:
    35                              <2> ;		BX:DX:AX:	Size in magnitude
    36                              <2> ;		CX:			Magnitude in BYTE_MULTIPLES
    37                              <2> ;	Returns:
    38                              <2> ;		AX:			Size in magnitude
    39                              <2> ;		CX:			Tenths
    40                              <2> ;		DL:			Magnitude character:
    41                              <2> ;						'k' = *1024   B = kiB
    42                              <2> ;						'M' = *1024 kiB = MiB
    43                              <2> ;						'G' = *1024 MiB = GiB
    44                              <2> ;						'T' = *1024 GiB = TiB
    45                              <2> ;						'P' = *1024 TiB = PiB
    46                              <2> ;	Corrupts registers:
    47                              <2> ;		BX, DH
    48                              <2> ;--------------------------------------------------------------------
    49                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
    50                              <2> Size_GetSizeToAXAndCharToDLfromBXDXAXwithMagnitudeInCX:
    51                              <2> %ifndef USE_186		; If 8086/8088
    52                              <2> 	push	di
    53                              <2> %endif
    54                              <2> 	push	si
    55                              <2> 
    56                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
    57                              <2> .MagnitudeConversionLoop:
    58                              <2> 	ePUSH_T	di, .MagnitudeConversionLoop; DI corrupted only on 8086/8088 build
    59                              <2> %ifdef USE_186
    60                              <2> 	test	bx, bx						; Bits 32...47 in use?
    61                              <2> 	jnz		SHORT Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX
    62                              <2> 	test	dx, dx						; Bits 16...31 in use?
    63                              <2> 	jnz		SHORT Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX
    64                              <2> %else ; 808x
    65                              <2> 	mov		di, bx
    66                              <2> 	or		di, dx
    67                              <2> 	jnz		SHORT Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX
    68                              <2> %endif
    69                              <2> 	cmp		ax, 10000					; 5 digits needed?
    70                              <2> 	jae		SHORT Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX
    71                              <2> 	add		sp, BYTE 2					; Clean return address from stack
    72                              <2> 
    73                              <2> 	; Convert remainder to tenths
    74                              <2> 	mov		bx, 640
    75                              <2> 	xchg	bx, ax						; BX = Size, AX = (10 / 1024) * 65536
    76                              <2> 	mul		si							; DX = Remainder * (10 / 1024)
    77                              <2> 	xchg	dx, ax
    78                              <2> 	xchg	cx, ax						; CX = Tenths, AX = Magnitude
    79                              <2> 	xchg	bx, ax						; AX = Size, BX	= Magnitude
    80                              <2> 
    81                              <2> 	; Convert magnitude to character
    82                              <2> 	mov		dl, [cs:bx+.rgbMagnitudeToChar]
    83                              <2> 
    84                              <2> 	pop		si
    85                              <2> %ifndef USE_186
    86                              <2> 	pop		di
    87                              <2> %endif
    88                              <2> 	ret
    89                              <2> .rgbMagnitudeToChar:	db	" kMGTP"
    90                              <2> 
    91                              <2> ;--------------------------------------------------------------------
    92                              <2> ; Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX
    93                              <2> ;	Parameters:
    94                              <2> ;		BX:DX:AX:	Size
    95                              <2> ;		CX:			Magnitude in BYTE_MULTIPLES (must be 254 or less)
    96                              <2> ;	Returns:
    97                              <2> ;		BX:DX:AX:	Size in magnitude
    98                              <2> ;		SI:			Remainder (0...1023)
    99                              <2> ;		CX:			Magnitude in BYTE_MULTIPLES
   100                              <2> ;	Corrupts registers:
   101                              <2> ;		Nothing
   102                              <2> ;--------------------------------------------------------------------
   103                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
   104                              <2> Size_DivideSizeInBXDXAXby1024andIncrementMagnitudeInCX:
   105                              <2> 	inc		cx						; Increment magnitude
   106                              <2> 	mov		si, 1023
   107                              <2> 	and		si, ax					; Remainder now in SI
   108                              <2> 	; Fall to Size_DivideSizeInBXDXAXby1024
   109                              <2> %endif ; INCLUDE_MENU_LIBRARY
   110                              <2> 
   111                              <2> ;--------------------------------------------------------------------
   112                              <2> ; Size_DivideSizeInBXDXAXby1024
   113                              <2> ;	Parameters:
   114                              <2> ;		BX:DX:AX:	Size
   115                              <2> ;		CX:			Must be 255 or less
   116                              <2> ;	Returns:
   117                              <2> ;		BX:DX:AX:	Size divided by 1024
   118                              <2> ;	Corrupts registers:
   119                              <2> ;		Nothing
   120                              <2> ;--------------------------------------------------------------------
   121                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
   122                              <2> Size_DivideSizeInBXDXAXby1024:
   123                              <2> %ifdef USE_386
   124 0000038B 0FACD00A            <2> 	shrd	ax, dx, 10
   125 0000038F 0FACDA0A            <2> 	shrd	dx, bx, 10
   126 00000393 C1EB0A              <2> 	shr		bx, 10
   127                              <2> %else
   128                              <2> 	push	cx
   129                              <2> 	mov		cl, 10
   130                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
   131                              <2> .ShiftLoop:
   132                              <2> 	call	Size_DivideBXDXAXbyTwo
   133                              <2> 	loop	.ShiftLoop
   134                              <2> 	pop		cx
   135                              <2> %endif
   136 00000396 C3                  <2> 	ret
   137                              <2> 
   138                              <2> ;--------------------------------------------------------------------
   139                              <2> ; Size_ConvertSectorCountInBXDXAXtoKiB
   140                              <2> ; Size_DivideBXDXAXbyTwo
   141                              <2> ;	Parameters:
   142                              <2> ;		BX:DX:AX:	Total sector count
   143                              <2> ;	Returns:
   144                              <2> ;		BX:DX:AX:	Total size in kiB
   145                              <2> ;		CF:			Remainder from division
   146                              <2> ;	Corrupts registers:
   147                              <2> ;		Nothing
   148                              <2> ;--------------------------------------------------------------------
   149                              <2> %ifdef EXCLUDE_FROM_XUB
   150                              <2> 	%ifdef USE_386
   151                              <2> 		%define EXCLUDE
   152                              <2> 	%endif
   153                              <2> 	%ifdef MODULE_BOOT_MENU
   154                              <2> 		%undef EXCLUDE
   155                              <2> 	%endif
   156                              <2> %endif
   157                              <2> 
   158                              <2> %ifndef EXCLUDE
   159                              <2> ALIGN UTIL_SIZE_JUMP_ALIGN
   160                              <2> Size_ConvertSectorCountInBXDXAXtoKiB:	; unused entrypoint ok
   161                              <2> Size_DivideBXDXAXbyTwo:					; unused entrypoint ok
   162                              <2> 	shr		bx, 1					; Divide sector count by 2...
   163                              <2> 	rcr		dx, 1					; ...to get disk size in...
   164                              <2> 	rcr		ax, 1					; ...kiB
   165                              <2> 	ret
   166                              <2> %endif
   167                              <2> %undef EXCLUDE
