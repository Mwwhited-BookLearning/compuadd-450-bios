   233                              <1> ;--------------------------------------------------------------------
   234                              <1> ; .ReadAtaInfoFromHardDisk
   235                              <1> ;	Parameters:
   236                              <1> ;		BH:		Drive Select byte for Drive and Head Register
   237                              <1> ;		DX:		Autodetected port (for devices that support autodetection)
   238                              <1> ;		CS:BP:	Ptr to IDEVARS for the drive
   239                              <1> ;		DS:		RAMVARS segment
   240                              <1> ;		ES:		Zero (BDA segment)
   241                              <1> ;	Returns:
   242                              <1> ;		CF:		Cleared if ATA-information read successfully
   243                              <1> ;				Set if any error
   244                              <1> ;	Corrupts registers:
   245                              <1> ;		AX, BL, CX, DX, SI, DI
   246                              <1> ;--------------------------------------------------------------------
   247                              <1> .ReadAtaInfoFromHardDisk:
   248 00000967 BE007C              <1> 	mov		si, BOOTVARS.rgbAtaInfo			; ES:SI now points to ATA info location
   249 0000096A 06                  <1> 	push	es
   250 0000096B 56                  <1> 	push	si
   251 0000096C 52                  <1> 	push	dx
   252 0000096D 53                  <1> 	push	bx
   253 0000096E E80905              <1> 	call	Device_IdentifyToBufferInESSIwithDriveSelectByteInBH
   254 00000971 5B                  <1> 	pop		bx
   255 00000972 5A                  <1> 	pop		dx
   256 00000973 5E                  <1> 	pop		si
   257 00000974 07                  <1> 	pop		es
   258 00000975 7306                <1> 	jnc		SHORT CreateBiosTablesForHardDisk
   259                              <1> 	; Fall to .ReadAtapiInfoFromDrive
   260                              <1> 
