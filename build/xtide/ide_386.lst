   392                              <2> ; DisplayPrint_CharacterFromAL
   393                              <2> ;	Parameters:
   394                              <2> ;		AL:		Character to display
   395                              <2> ;				Zero value is ignored (no character is printed)
   396                              <2> ;		DS:		BDA segment (zero)
   397                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   398                              <2> ;	Returns:
   399                              <2> ;		DI:		Updated offset to video RAM
   400                              <2> ;	Corrupts registers:
   401                              <2> ;		AX, DX
   402                              <2> ;--------------------------------------------------------------------
   403                              <2> ALIGN DISPLAY_JUMP_ALIGN
   404                              <2> DisplayPrint_CharacterFromAL:
   405 0000028F 84C0                <2> 	test	al, al
   406 00000291 741C                <2> 	jz		DisplayPrint_Ret
   407                              <2> 
   408 00000293 8A265E04            <2> 	mov		ah, [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.bAttribute]
   409 00000297 FF265804            <2> 	jmp		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fnCharOut]
   410                              <2> 
