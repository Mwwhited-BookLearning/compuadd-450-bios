    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=24h, Set Multiple Blocks.
    25                              <1> ;
    26                              <1> ; AH24h_HandlerForSetMultipleBlocks
    27                              <1> ;	Parameters:
    28                              <1> ;		AL:		Same as in INTPACK
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Parameters on INTPACK:
    33                              <1> ;		AL:		Number of Sectors per Block (1, 2, 4, 8, 16, 32, 64 or 128)
    34                              <1> ;	Returns with INTPACK:
    35                              <1> ;		AH:		Int 13h return status
    36                              <1> ;		CF:		0 if successful, 1 if error
    37                              <1> ;--------------------------------------------------------------------
    38                              <1> AH24h_HandlerForSetMultipleBlocks:
    39                              <1> %ifndef USE_186
    40                              <1> 	call	AH24h_SetBlockSize
    41                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    42                              <1> %else
    43 00001B93 68[8018]            <1> 	push	Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    44                              <1> 	; Fall to AH24h_SetBlockSize
    45                              <1> %endif
    46                              <1> 
    47                              <1> 
    48                              <1> ;--------------------------------------------------------------------
    49                              <1> ; AH24h_SetBlockSize
    50                              <1> ;	Parameters:
    51                              <1> ;		AL:		Number of Sectors per Block (1, 2, 4, 8, 16, 32, 64 or 128)
    52                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    53                              <1> ;		SS:BP:	Ptr to IDEPACK
    54                              <1> ;	Returns:
    55                              <1> ;		AH:		Int 13h return status
    56                              <1> ;		CF:		0 if successful, 1 if error
    57                              <1> ;	Corrupts registers:
    58                              <1> ;		AL, CX, DX
    59                              <1> ;--------------------------------------------------------------------
    60                              <1> AH24h_SetBlockSize:
    61                              <1> %ifdef MODULE_8BIT_IDE_ADVANCED
    62                              <1> 	; XT-CF does not support largest block size in DMA mode.
    63                              <1> 	cmp		al, XTCF_DMA_MODE_MAX_BLOCK_SIZE
    64                              <1> 	jbe		SHORT .NoNeedToLimitBlockSize
    65                              <1> 
    66                              <1> 	; Return error if we tried too large block for XT-CF.
    67                              <1> 	; Do not limit it to maximum supported since software calling AH=24h
    68                              <1> 	; must know what the actual block size is.
    69                              <1> 	cmp		BYTE [di+DPT_ATA.bDevice], DEVICE_8BIT_XTCF_DMA
    70                              <1> 	je		SHORT ProcessXTCFsubcommandFromAL.AH1Eh_LoadInvalidCommandToAHandSetCF
    71                              <1> .NoNeedToLimitBlockSize:
    72                              <1> %endif ; MODULE_8BIT_IDE_ADVANCED
    73                              <1> 
    74 00001B96 53                  <1> 	push	bx
    75                              <1> 
    76 00001B97 50                  <1> 	push	ax			; Store block size for later use
    77 00001B98 92                  <1> 	xchg	dx, ax		; DL = Block size (Sector Count Register)
    78 00001B99 B0C6                <1> 	mov		al, COMMAND_SET_MULTIPLE_MODE
    79 00001B9B BB40B5              <1> 	mov		bx, TIMEOUT_AND_STATUS_TO_WAIT(TIMEOUT_DRDY, FLG_STATUS_DRDY)
    80 00001B9E E8A7F2              <1> 	call	Idepack_StoreNonExtParametersAndIssueCommandFromAL
    81                              <1> 
    82                              <1> 	; Disable block mode if failure or if called with block size of 1 sector.
    83                              <1> 	; Some drives allow block mode commands for 1 sector blocks and some do not.
    84 00001BA1 5B                  <1> 	pop		bx			; Pop block size to BL
    85 00001BA2 720A                <1> 	jc		SHORT .DisableBlockMode
    86                              <1> 
    87                              <1> 	; All valid block sizes are powers of 2 which means BL have just one bit set (parity odd).
    88                              <1> 	; Incrementing BX will cause all block sizes except 1 to have two bits set (parity even).
    89                              <1> 	; Note that PF reflects only the lowest 8 bits of any register being modified.
    90 00001BA4 43                  <1> 	inc		bx						; 1 -> 2 ?
    91 00001BA5 7B07                <1> 	jpo		SHORT .DisableBlockMode	; Jump if BL = 2
    92 00001BA7 4B                  <1> 	dec		bx						; Restore block size (was larger than 1)
    93                              <1> 
    94                              <1> 	; Enable block mode and store block size
    95 00001BA8 804D0102            <1> 	or		BYTE [di+DPT.bFlagsHigh], FLGH_DPT_USE_BLOCK_MODE_COMMANDS
    96 00001BAC EB07                <1> 	jmp		SHORT .StoreBlockSizeFromBLandReturn
    97                              <1> 
    98                              <1> .DisableBlockMode:
    99 00001BAE 806501FD            <1> 	and		BYTE [di+DPT.bFlagsHigh], ~FLGH_DPT_USE_BLOCK_MODE_COMMANDS
   100 00001BB2 B301                <1> 	mov		bl, 1
   101 00001BB4 F9                  <1> 	stc
   102                              <1> .StoreBlockSizeFromBLandReturn:
   103 00001BB5 885D15              <1> 	mov		[di+DPT_ATA.bBlockSize], bl
   104 00001BB8 5B                  <1> 	pop		bx
   105 00001BB9 C3                  <1> 	ret
