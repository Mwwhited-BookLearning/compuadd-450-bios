    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> ;--------------------------------------------------------------------
    24                              <1> ; Int 13h function AH=1h, Read Disk Status.
    25                              <1> ;
    26                              <1> ; AH1h_HandlerForReadDiskStatus
    27                              <1> ;	Parameters:
    28                              <1> ;		DL:		Translated Drive number
    29                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    30                              <1> ;		SS:BP:	Ptr to IDEREGS_AND_INTPACK
    31                              <1> ;	Returns with INTPACK:
    32                              <1> ;		AH:		Int 13h floppy return status
    33                              <1> ;		CF:		0 if AH = RET_HD_SUCCESS, 1 otherwise (error)
    34                              <1> ;--------------------------------------------------------------------
    35 0000197B 90                  <1> ALIGN JUMP_ALIGN
    36                              <1> AH1h_HandlerForReadDiskStatus:
    37                              <1> 	LOAD_BDA_SEGMENT_TO	ds, ax, !
   180                              <2> %ifndef USE_186
   181                              <2>  xor %2, %2
   182                              <2>  mov %1, %2
   183                              <2> %elifidn %3, !
   184 0000197C 31C0                <2>  xor %2, %2
   185 0000197E 8ED8                <2>  mov %1, %2
   186                              <2> %else
   187                              <2>  push BYTE 0
   188                              <2>  pop %1
   189                              <2> %endif
    38                              <1> 
    39                              <1> %ifdef MODULE_SERIAL_FLOPPY
    40 00001980 84D2                <1> 	test	dl, dl
    41 00001982 7806                <1> 	js		.HardDisk
    42 00001984 8A264104            <1> 	mov		ah, [BDA.bFDRetST]	; Unlike for hard disks below, floppy version does not clear the status
    43 00001988 EB04                <1> 	jmp		.done
    44                              <1> .HardDisk:
    45                              <1> %endif
    46                              <1> 
    47 0000198A 86267404            <1> 	xchg	ah, [BDA.bHDLastSt]	; Load and clear last error (AH is cleared with the LOAD_BDA_SEGMENT_TO above)
    48                              <1> 
    49                              <1> .done:
    50                              <1> %ifndef USE_186
    51                              <1> 	call	Int13h_SetErrorCodeToIntpackInSSBPfromAH
    52                              <1> 	jmp		Int13h_ReturnFromHandlerWithoutStoringErrorCode
    53                              <1> %else
    54 0000198E 68[8618]            <1> 	push	Int13h_ReturnFromHandlerWithoutStoringErrorCode
    55 00001991 E916FF              <1> 	jmp		Int13h_SetErrorCodeToIntpackInSSBPfromAH
    56                              <1> %endif
