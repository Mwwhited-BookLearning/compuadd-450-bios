   262                              <1> %ifdef MODULE_ATAPI
   263                              <1> 	cmp		ax, ATAPI_SIGNATURE
   264                              <1> 	je		SHORT DetectDrives_AtapiDeviceFound
   265                              <1> %endif
   266                              <1> 	;call	ReadAtapiInfoFromDrive			; Assume CD-ROM
   267                              <1> 	;jnc	SHORT _CreateBiosTablesForCDROM
   268                              <1> 	; Fall to DetectDrives_DriveNotFound
