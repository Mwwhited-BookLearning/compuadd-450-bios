   262                              <1> ;--------------------------------------------------------------------
   263                              <1> AtaID_GetActiveTimeToAXfromPioModeInBX:
   264                              <1> 	eMOVZX	ax, BYTE [cs:bx+.rgbPioModeToActiveTimeNs]
   407                              <2> %ifndef USE_386
   408                              <2>  %ifidni %1, ax
   409                              <2>  mov al, %2
   410                              <2>  xor ah, ah
   411                              <2>  %elifidni %1, bx
   412                              <2>  mov bl, %2
   413                              <2>  xor bh, bh
