   150                              <1> ; Prints BIOS name and segment address where it is found.
   151                              <1> ;
   152                              <1> ; DetectPrint_RomFoundAtSegment
   153                              <1> ;	Parameters:
   154                              <1> ;		Nothing
   155                              <1> ;	Returns:
   156                              <1> ;		Nothing
   157                              <1> ;	Corrupts registers:
   158                              <1> ;		AX, SI, DI
   159                              <1> ;--------------------------------------------------------------------
   160                              <1> DetectPrint_RomFoundAtSegment:
   161 000009D0 BE[D400]            <1> 	mov		si, g_szRomAt
   162 000009D3 8CCF                <1> 	mov		di, cs						; BIOS segment address, for later inclusion in the output, parameterized
   163                              <1> 										; so that it can be a different value when using .BootMenuEntry
   164                              <1> 
   165                              <1> .BootMenuEntry:
   166 000009D5 55                  <1> 	push	bp
   167 000009D6 89E5                <1> 	mov		bp, sp
   168                              <1> 
   169                              <1> %ifndef USE_186
   170                              <1> 	mov		ax, ROMVARS.szTitle
   171                              <1> 	push	ax
   172                              <1> 	push	di							; BIOS segment
   173                              <1> 	mov		al, ROMVARS.szVersion & 0FFh
   174                              <1> 	push	ax
   175                              <1> %else
   176                              <1> 	; szTitle and szVersion have the high order byte of their addresses zero,
   177                              <1> 	; so these push instructions are only 2 bytes
   178                              <1> 	;
   179 000009D8 6A0C                <1> 	push	ROMVARS.szTitle
   180 000009DA 57                  <1> 	push	di							; BIOS segment
   181 000009DB 6A2C                <1> 	push	ROMVARS.szVersion
   182                              <1> %endif
   183                              <1> 
   184 000009DD EB2E                <1> 	jmp		SHORT DetectPrint_FormatCSSIfromParamsInSSBP
   185                              <1> 
