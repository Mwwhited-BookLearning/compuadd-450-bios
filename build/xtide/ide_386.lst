    26                              <2> %include "SerialServer.inc"
     1                              <3> ; Project name	:	XTIDE Universal BIOS
     2                              <3> ; Description	:	Serial Server Defines
     3                              <3> 
     4                              <3> %ifndef SERIALSERVER_INC
     5                              <3> %define SERIALSERVER_INC
     6                              <3> 
     7                              <3> %include "Serial.inc"
     8                              <3> 
     9                              <3> ;
    10                              <3> ; Command codes
    11                              <3> ;
    12                              <3> SerialServer_Command_Header					EQU		0a0h
    13                              <3> SerialServer_Command_Write					EQU		(SerialServer_Command_Header | 3)
    14                              <3> SerialServer_Command_Read					EQU		(SerialServer_Command_Header | 2)
    15                              <3> SerialServer_Command_Inquire				EQU		(SerialServer_Command_Header | 0)
    16                              <3> SerialServer_Command_Custom_Read			EQU		(SerialServer_Command_Header | 4)
    17                              <3> SerialServer_Command_Custom_Write			EQU		(SerialServer_Command_Header | 5)
    18                              <3> 
    19                              <3> SerialServer_SubCommand_Image_SendInitiate		EQU		1
    20                              <3> SerialServer_SubCommand_Image_SendSectors		EQU		2
    21                              <3> SerialServer_SubCommand_Image_SendComplete		EQU		3
    22                              <3> 
    23                              <3> ;
    24                              <3> ; Locations within the ATA 512-byte Inquire structure, taken from the "Vendor specific area",
    25                              <3> ; for serial port specific information that is returned by the server for an inquire.
    26                              <3> ;
    27                              <3> ; NOTE: These are byte offsets (because of the "*2"), which is more convenient here, while
    28                              <3> ;       the ATA structure defines these in terms of word offsets.
    29                              <3> ;
    30                              <3> SerialServer_ATA_wServerVersion			EQU		(157*2)
    31                              <3> SerialServer_ATA_wDriveFlags			EQU		(158*2)
    32                              <3> SerialServer_ATA_wPortAndBaud			EQU		(159*2)
    33                              <3> 
    34                              <3> ;
    35                              <3> ; Command structure passed to SerialServer_SendReceive.  This mirrors IDEPACK in the XTIDE Universal BIOS, 
    36                              <3> ; since that structure is passed directly without copying values into this structure.
    37                              <3> ;
    38                              <3> struc SerialServer_Command
    39                              <3> 	.wCommandAndCustom:	
    40                              <3> 	.bCommand				resb	1
    41                              <3> 
    42                              <3> 	.bCustomCommand:	
    43                              <3> 	.bDrvAndHead			resb	1	; LBA28 27...24
    44                              <3> 
    45                              <3> 	.wSectorCountAndLbaLow:
    46                              <3> 	.bSectorCount			resb	1
    47                              <3> 
    48                              <3> 	.bCustomData3:		
    49                              <3> 	.bSectorNumber:
    50                              <3> 	.bLbaLow				resb	1	; LBA 7...0
    51                              <3> 
    52                              <3> 	.wCustomData1:		
    53                              <3> 	.bCustomData1:		
    54                              <3> 	.wCylinder:
    55                              <3> 	.wLbaMiddleAndHigh:
    56                              <3> 	.bLbaMiddle				resb	1	; LBA 15...8
    57                              <3> 
    58                              <3> 	.bCustomData2:		
    59                              <3> 	.bLbaHigh				resb	1	; LBA 23...16
    60                              <3> endstruc
    61                              <3> 
    62                              <3> %endif
    63                              <3> 
    27                              <2> 
    28                              <2> ; Section containing code
    29                              <2> SECTION .text
    30                              <2> 
    31                              <2> ;--------------------------------------------------------------------
    32                              <2> ; SerialServerScan_ScanForServer:
    33                              <2> ;	Parameters:
    34                              <2> ;		BH:		Drive Select byte for Drive and Head Select Register
    35                              <2> ;				0xAx: Scan for drive, low nibble indicates drive
    36                              <2> ;				0x0:  Scan for Server, independent of drives
    37                              <2> ;		DX:		Port and Baud to Scan for
    38                              <2> ;				0: Scan a known set of ports and bauds
    39                              <2> ;		ES:SI:	Ptr to buffer for return
    40                              <2> ;	Returns:
    41                              <2> ;		CF:		Cleared if success, Set if error
    42                              <2> ;	Corrupts registers:
    43                              <2> ;		AL, BX, CX, DX, DI
    44                              <2> ;--------------------------------------------------------------------
    45                              <2> SerialServerScan_ScanForServer:
    46 0000176C B90100              <2> 	mov		cx, 1			; one sector, not scanning (default)
    47                              <2> 
    48 0000176F 85D2                <2> 	test	dx, dx
    49 00001771 7543                <2> 	jnz		SHORT SerialServerScan_CheckForServer_PortAndBaudInDX
    50                              <2> 
    51 00001773 BF[AD17]            <2> 	mov		di, .scanPortAddresses-1
    52 00001776 B501                <2> 	mov		ch, 1			;  tell server that we are scanning
    53                              <2> 
    54                              <2> .nextPort:
    55 00001778 47                  <2> 	inc		di				; load next port address
    56 00001779 B640                <2> 	mov		dh, 40h			; Clear DH and make sure CF is set if error
    57 0000177B 2E8A15              <2> 	mov		dl, [cs:di]
    58                              <2> 	eSHL_IM	dx, 2			; shift from one byte to two
   661                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   662                              <3> %ifdef USE_386
   663                              <3>  %if %2 = 1
   664                              <3>  FSIS ], %1
   665                              <3>  %if strpos
   666                              <3>  eSHIFT_IM %1, %2, shl
   667                              <3>  %else
   668                              <3>  add %1, %1
   669                              <3>  %endif
   670                              <3>  %else
   671                              <3>  eSHIFT_IM %1, %2, shl
   631                              <4> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <4> %ifndef USE_186
   633                              <4>  %ifidni %1, cl
   634                              <4>  times %2 %3 %1, 1
   635                              <4>  %elifidni %1, ch
   636                              <4>  times %2 %3 %1, 1
   637                              <4>  %elifidni %1, cx
   638                              <4>  times %2 %3 %1, 1
   639                              <4>  %else
   640                              <4>  %if %2 > 3
   641                              <4>  push cx
   642                              <4>  mov cl, %2
   643                              <4>  %3 %1, cl
   644                              <4>  pop cx
   645                              <4>  %else
   646                              <4>  times %2 %3 %1, 1
   647                              <4>  %endif
   648                              <4>  %endif
   649                              <4> 
   650                              <4> %else
   651 0000177E C1E202              <4>  %3 %1, %2
   652                              <4> %endif
   653                              <4> %endif
   672                              <3>  %endif
   673                              <3> %else
   674                              <3>  eSHIFT_IM %1, %2, shl
   675                              <3> %endif
   676                              <3> %endif
    59 00001781 742A                <2> 	jz		SHORT .error
    60                              <2> 
    61                              <2> ;
    62                              <2> ; Test for COM port presence, write to and read from registers
    63                              <2> ;
    64 00001783 52                  <2> 	push	dx
    65 00001784 80C203              <2> 	add		dl, Serial_UART_lineControl
    66 00001787 B09A                <2> 	mov		al, 9Ah
    67 00001789 EE                  <2> 	out		dx, al
    68 0000178A EC                  <2> 	in		al, dx
    69 0000178B 5A                  <2> 	pop		dx
    70 0000178C 3C9A                <2> 	cmp		al, 9Ah
    71 0000178E 75E8                <2> 	jne		SHORT .nextPort
    72                              <2> 
    73 00001790 B00C                <2> 	mov		al, 0Ch
    74 00001792 EE                  <2> 	out		dx, al
    75 00001793 EC                  <2> 	in		al, dx
    76 00001794 3C0C                <2> 	cmp		al, 0Ch
    77 00001796 75E0                <2> 	jne		SHORT .nextPort
    78                              <2> 
    79                              <2> ;
    80                              <2> ; Begin baud rate scan on this port...
    81                              <2> ;
    82                              <2> ; On a scan, we support 6 baud rates, starting here and going higher by a factor of two each step, with a
    83                              <2> ; small jump between 9600 and 38800.  These 6 were selected since we wanted to support 9600 baud and 115200,
    84                              <2> ; *on the server side* if the client side had a 4x clock multiplier, a 2x clock multiplier, or no clock multiplier.
    85                              <2> ;
    86                              <2> ; Starting with 30h, that means 30h (2400 baud), 18h (4800 baud), 0Ch (9600 baud), and
    87                              <2> ;					            04h (28800 baud), 02h (57600 baud), 01h (115200 baud)
    88                              <2> ;
    89                              <2> ; Note: hardware baud multipliers (2x, 4x, 8x) will impact the final baud rate and are not known at this level
    90                              <2> ;
    91 00001798 B660                <2> 	mov		dh, 30h * 2		; multiply by 2 since we are about to divide by 2
    92 0000179A 2E8A15              <2> 	mov		dl, [cs:di]		; restore single byte port address for scan
    93                              <2> 
    94                              <2> .nextBaud:
    95 0000179D D0EE                <2> 	shr		dh, 1
    96 0000179F 74D7                <2> 	jz		SHORT .nextPort
    97 000017A1 80FE06              <2> 	cmp		dh, 6			; skip from 6 to 4, to move from the top of the 9600 baud range
    98 000017A4 7502                <2> 	jne		SHORT .testBaud	; to the bottom of the 115200 baud range
    99 000017A6 B604                <2> 	mov		dh, 4
   100                              <2> 
   101                              <2> .testBaud:
   102 000017A8 E80B00              <2> 	call	SerialServerScan_CheckForServer_PortAndBaudInDX
   103 000017AB 72F0                <2> 	jc		SHORT .nextBaud
   104                              <2> 
   105                              <2> .error:
   106 000017AD C3                  <2> 	ret
   107                              <2> 
   108                              <2> .scanPortAddresses:
   109 000017AE B8                  <2> 	db	SERIAL_COM7_IOADDRESS >> 2
   110 000017AF F8                  <2> 	db	SERIAL_COM6_IOADDRESS >> 2
   111 000017B0 BC                  <2> 	db	SERIAL_COM5_IOADDRESS >> 2
   112 000017B1 BA                  <2> 	db	SERIAL_COM4_IOADDRESS >> 2
   113 000017B2 FA                  <2> 	db	SERIAL_COM3_IOADDRESS >> 2
   114 000017B3 BE                  <2> 	db	SERIAL_COM2_IOADDRESS >> 2
   115 000017B4 FE                  <2> 	db	SERIAL_COM1_IOADDRESS >> 2
   116 000017B5 00                  <2> 	db	0
   117                              <2> 
   118                              <2> 
   119                              <2> ;--------------------------------------------------------------------
   120                              <2> ; SerialServer_CheckForServer_PortAndBaudInDX:
   121                              <2> ;	Parameters:
   122                              <2> ;		BH:		Drive Select byte for Drive and Head Select Register
   123                              <2> ;				0xAx: Scan for drive, low nibble indicates drive
   124                              <2> ;				0x0:  Scan for Server, independent of drives
   125                              <2> ;		DX:		Baud and Port
   126                              <2> ;		CH:		1: We are doing a scan for the serial server
   127                              <2> ;				0: We are working off a specific port given by the user
   128                              <2> ;		CL:		1, for one sector to read
   129                              <2> ;		ES:SI:	Ptr to buffer for return
   130                              <2> ;	Returns:
   131                              <2> ;		AH:		INT 13h Error Code
   132                              <2> ;		CF:		Cleared if success, Set if error
   133                              <2> ;	Corrupts registers:
   134                              <2> ;		AL, BX
   135                              <2> ;--------------------------------------------------------------------
   136                              <2> SerialServerScan_CheckForServer_PortAndBaudInDX:
   137 000017B6 55                  <2> 	push	bp				; setup fake SerialServer_Command
   138 000017B7 52                  <2> 	push	dx				; send port baud and rate, returned in inquire packet
   139                              <2> 							; (and possibly returned in the drive identification string)
   140 000017B8 51                  <2> 	push	cx				; send number of sectors, and if it is on a scan or not
   141 000017B9 B3A0                <2> 	mov		bl, SerialServer_Command_Inquire		; protocol command onto stack with bh
   142 000017BB 53                  <2> 	push	bx
   143                              <2> 
   144 000017BC 89E5                <2> 	mov		bp, sp
   145 000017BE E847FE              <2> 	call	SerialServer_SendReceive
   146                              <2> 
   147 000017C1 5B                  <2> 	pop		bx
   148 000017C2 59                  <2> 	pop		cx
   149 000017C3 5A                  <2> 	pop		dx
   150 000017C4 5D                  <2> 	pop		bp
   151                              <2> 
   152 000017C5 C3                  <2> 	ret
   153                              <2> 
