    22                              <1> 
    23                              <1> ; Maximum valid P-CHS parameters
    24                              <1> MAX_PCHS_CYLINDERS			EQU		16383
    25                              <1> MAX_PCHS_HEADS				EQU		16
    26                              <1> MAX_PCHS_SECTORS_PER_TRACK	EQU		63
    27                              <1> 
    28                              <1> 
    29                              <1> ; PIO Minimum Cycle Times (t0)
    30                              <1> ; Timings for Advanced Modes (3 and above) can be read from ATA info WORDs 67 and 68
    31                              <1> ; Those usually have the same Cycle Time as below
    32                              <1> PIO_0_MIN_CYCLE_TIME_NS		EQU		600
    33                              <1> PIO_1_MIN_CYCLE_TIME_NS		EQU		383
    34                              <1> PIO_2_MIN_CYCLE_TIME_NS		EQU		240
    35                              <1> PIO_3_MIN_CYCLE_TIME_NS		EQU		180
    36                              <1> PIO_4_MIN_CYCLE_TIME_NS		EQU		120
    37                              <1> PIO_5_MIN_CYCLE_TIME_NS		EQU		100		; CF specification
    38                              <1> PIO_6_MIN_CYCLE_TIME_NS		EQU		80		; CF specification
    39                              <1> 
    40                              <1> ; PIO Minimum Address Valid Times (t1)
    41                              <1> PIO_0_MIN_ADDRESS_VALID_NS	EQU		70
    42                              <1> PIO_1_MIN_ADDRESS_VALID_NS	EQU		50
    43                              <1> PIO_2_MIN_ADDRESS_VALID_NS	EQU		30
    44                              <1> PIO_3_MIN_ADDRESS_VALID_NS	EQU		30
    45                              <1> PIO_4_MIN_ADDRESS_VALID_NS	EQU		25
    46                              <1> PIO_5_MIN_ADDRESS_VALID_NS	EQU		15
    47                              <1> PIO_6_MIN_ADDRESS_VALID_NS	EQU		10
    48                              <1> 
    49                              <1> ; PIO Minimum Active Times (t2)
    50                              <1> PIO_0_MIN_ACTIVE_TIME_NS	EQU		165
    51                              <1> PIO_1_MIN_ACTIVE_TIME_NS	EQU		125
    52                              <1> PIO_2_MIN_ACTIVE_TIME_NS	EQU		100
    53                              <1> PIO_3_MIN_ACTIVE_TIME_NS	EQU		80
    54                              <1> PIO_4_MIN_ACTIVE_TIME_NS	EQU		70
    55                              <1> PIO_5_MIN_ACTIVE_TIME_NS	EQU		65
    56                              <1> PIO_6_MIN_ACTIVE_TIME_NS	EQU		55
    57                              <1> 
    58                              <1> ; PIO 0...2 Maximum Addr valid to IOCS16- released (t8)
    59                              <1> PIO_0_MAX_ADDR_VALID_TO_IOCS16_RELEASED		EQU		60
    60                              <1> PIO_1_MAX_ADDR_VALID_TO_IOCS16_RELEASED		EQU		45
    61                              <1> PIO_2_MAX_ADDR_VALID_TO_IOCS16_RELEASED		EQU		30
    62                              <1> 
    63                              <1> ; PIO DIOR-/DIOW- to address valid hold (t9)
    64                              <1> PIO_0_DIORW_TO_ADDR_VALID_HOLD				EQU		20
    65                              <1> PIO_1_DIORW_TO_ADDR_VALID_HOLD				EQU		15
    66                              <1> PIO_2_DIORW_TO_ADDR_VALID_HOLD				EQU		10
    67                              <1> 
    68                              <1> 
    69                              <1> ; ATA-1 Drive Information struct
    70                              <1> ; F = Fixed value
    71                              <1> ; V = Variable value
    72                              <1> ; R = Reserved word
    73                              <1> ; X = Vendor specific word
    74                              <1> struc ATA1
    75 00000000 ????                <1> 	.wGenCfg	resw 1	; 0F, General configuration bit-significant information
    76 00000002 ????                <1> 	.wCylCnt	resw 1	; 1F, Number of cylinders
    77 00000004 ????                <1> 				resw 1	; 2R
    78 00000006 ????                <1> 	.wHeadCnt	resw 1	; 3F, Number of heads
    79 00000008 ????                <1> 	.wBpTrck	resw 1	; 4F, Number of unformatted bytes per track
    80 0000000A ????                <1> 	.wBpSect	resw 1	; 5F, Number of unformatted bytes per sector
    81 0000000C ????                <1> 	.wSPT		resw 1	; 6F, Number of sectors per track
    82 0000000E ????????????        <1> 				resw 3	; 7...9X
    83 00000014 <res 14h>           <1> 	.strSerial	resb 20	; 10...19F, Serial number (20 ASCII characters, 0000h=not specified)
    84 00000028 ????                <1> 	.wBuffType	resw 1	; 20F, Buffer type
    85 0000002A ????                <1> 	.wBuffSize	resw 1	; 21F, Buffer size in 512 byte increments (0000h=not specified)
    86 0000002C ????                <1> 	.wEccCnt	resw 1	; 22F, # of ECC bytes avail on read/write long cmds (0000h=not spec'd)
    87 0000002E ????????????????    <1> 	.strFirmW	resb 8	; 23...26F, Firmware revision (8 ASCII characters, 0000h=not specified)
    88 00000036 <res 28h>           <1> 	.strModel	resb 40	; 27...46F, Model number (40 ASCII characters, 0000h=not specified)
    89 0000005E ??                  <1> 	.bBlckSize	resb 1	; 47[0-7]F, Maximum number of sectors that can be transferred
    90                              <1> 						;			per interrupt on read and write multiple commands
    91                              <1> 						;			(00h=Read/write multiple commands not implemented)
    92 0000005F ??                  <1> 				resb 1	; 47[8-15]X
    93 00000060 ????                <1> 	.wDWIO		resw 1	; 48F, Can perform doubleword I/O (boolean)
    94 00000062 ????                <1> 	.wCaps		resw 1	; 49FRX, Capabilities
    95 00000064 ????                <1> 				resw 1	; 50R
    96 00000066 ??                  <1> 				resb 1	; 51[0-7]X
    97 00000067 ??                  <1> 	.bPioMode	resb 1	; 51[8-15]F, PIO data transfer cycle timing mode (0, 1 or 2)
    98 00000068 ??                  <1> 				resb 1	; 52[0-7]X
    99 00000069 ??                  <1> 	.bDMATiming	resb 1	; 52[8-15]F, DMA data transfer cycle timing mode
   100 0000006A ????                <1> 	.wFields	resw 1	; 53FVR, Field (next words) validity bits
   101                              <1> 
   102                              <1> 	; Words 54-58 are valid only if bit0 is set in .wFields
   103 0000006C ????                <1> 	.wCurCyls	resw 1	; 54V, Number of current cylinders
   104 0000006E ????                <1> 	.wCurHeads	resw 1	; 55V, Number of current heads
   105 00000070 ????                <1> 	.wCurSPT	resw 1	; 56V, Number of current sectors per track
   106 00000072 ????????            <1> 	.dwCurSCnt	resd 1	; 57...58V, Current capacity in sectors
   107                              <1> 
   108                              <1> 	; Words 59-63 are always valid
   109 00000076 ??                  <1> 	.bBlockSel	resb 1	; 59[0-7]V, Current setting for number of sectors that
   110                              <1> 						;			can be transferred per interrupt on R/W multiple command
   111 00000077 ??                  <1> 	.bBlockFlgs	resb 1	; 59[8-15]VR, bit 0 set if Multiple sector setting is valid
   112 00000078 ????????            <1> 	.dwLBACnt	resd 1	; 60...61F, Total number of user addressable sectors (LBA mode only)
   113 0000007C ??                  <1> 	.bSDMASupp	resb 1	; 62[0-7]F, Single word DMA transfer modes supported
   114 0000007D ??                  <1> 	.bSDMAAct	resb 1	; 62[8-15]V, Single word DMA transfer mode active
   115 0000007E ??                  <1> 	.bMDMASupp	resb 1	; 63[0-7]F, Multiword DMA transfer modes supported
   116 0000007F ??                  <1> 	.bMDMAAct	resb 1	; 63[8-15]V, Multiword DMA transfer mode active
   117                              <1> endstruc
   118                              <1> 
   119                              <1> A1_MODEL_NUMBER_LENGTH	EQU	40		; 40 ASCII characters
   120                              <1> 
   121                              <1> ; ATA-1 Word 0, General configuration
   122                              <1> A1_wGenCfg_NONMAG		EQU	(1<<15)	; Reserved for non-magnetic drives
   123                              <1> A1_wGenCfg_FGAPREQ		EQU	(1<<14)	; Format speed tolerance gap required
   124                              <1> A1_wGenCfg_TRCKOFF		EQU	(1<<13)	; Track offset option available
   125                              <1> A1_wGenCfg_DATAOFF		EQU	(1<<12)	; Data strobe offset option available
   126                              <1> A1_wGenCfg_ROTTOL		EQU	(1<<11)	; Rotational speed tolerance is > 0,5%
   127                              <1> A1_wGenCfg_XFERFAST		EQU (1<<10)	; Disk transfer rate > 10 Mbs
   128                              <1> A1_wGenCfg_XFERMED		EQU	(1<<9)	; Disk transfer rate > 5Mbs but <= 10Mbs
   129                              <1> A1_wGenCfg_XFERSLOW		EQU (1<<8)	; Disk transfer rate <= 5Mbs
   130                              <1> A1_wGenCfg_REMOVABLE	EQU	(1<<7)	; Removable cartridge drive
   131                              <1> A1_wGenCfg_FIXED		EQU	(1<<6)	; Fixed drive
   132                              <1> A1_wGenCfg_MOTCTRL		EQU	(1<<5)	; Spindle motor control option implemented
   133                              <1> A1_wGenCfg_HEADSLOW		EQU	(1<<4)	; Head switch time > 15 usec
   134                              <1> A1_wGenCfg_NOTMFM		EQU	(1<<3)	; Not MFM encoded
   135                              <1> A1_wGenCfg_SOFTSECT		EQU	(1<<2)	; Soft sectored
   136                              <1> A1_wGenCfg_HARDSECT		EQU	(1<<1)	; Hard sectored
   137                              <1> 
   138                              <1> ; ATA-1 Word 49, Capabilities
   139                              <1> A1_wCaps_LBA			EQU	(1<<9)	; LBA supported
   140                              <1> A1_wCaps_DMA			EQU	(1<<8)	; DMA supported
   141                              <1> 
   142                              <1> ; ATA-1 Word 53, Fields
   143                              <1> A1_wFields_54to58		EQU	(1<<0)	; The fields reported in words 54-58 are valid
   144                              <1> 
   145                              <1> ; ATA-1 Word 59 high byte, Block mode flags
   146                              <1> A1_bBlockFlgs_VALID		EQU	(1<<0)	; Multiple sector setting (bBlockSel) is valid
   147                              <1> 
   148                              <1> 
   149                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   150                              <1> 
   151                              <1> ; ATA-2 Drive Information struct
   152                              <1> ; F = Fixed value
   153                              <1> ; V = Variable value
   154                              <1> ; R = Reserved word
   155                              <1> ; X = Vendor specific word
   156                              <1> struc ATA2
   157 00000000 ????                <1> 	.wGenCfg	resw 1	; 0F, General configuration bit-significant information
   158 00000002 ????                <1> 	.wCylCnt	resw 1	; 1F, Number of logical cylinders
   159 00000004 ????                <1> 				resw 1	; 2R
   160 00000006 ????                <1> 	.wHeadCnt	resw 1	; 3F, Number of logical heads
   161 00000008 ????                <1> 				resw 1	; 4X
   162 0000000A ????                <1> 				resw 1	; 5X
   163 0000000C ????                <1> 	.wSPT		resw 1	; 6F, Number of logical sectors per track
   164 0000000E ????????????        <1> 				resw 3	; 7...9X
   165 00000014 <res 14h>           <1> 	.strSerial	resb 20	; 10...19F, Serial number (20 ASCII characters, 0000h=not specified)
   166 00000028 ????                <1> 				resw 1	; 20X
   167 0000002A ????                <1> 				resw 1	; 21X
   168 0000002C ????                <1> 	.wEccCnt	resw 1	; 22F, # of ECC bytes avail on read/write long cmds (0000h=not spec'd)
   169 0000002E ????????????????    <1> 	.strFirmW	resb 8	; 23...26F, Firmware revision (8 ASCII characters, 0000h=not specified)
   170 00000036 <res 28h>           <1> 	.strModel	resb 40	; 27...46F, Model number (40 ASCII characters, 0000h=not specified)
   171 0000005E ??                  <1> 	.bBlckSize	resb 1	; 47[0-7]F, Maximum number of sectors that can be transferred
   172                              <1> 						;			per interrupt on read and write multiple commands
   173                              <1> 						;			(00h=Read/write multiple commands not implemented)
   174 0000005F ??                  <1> 				resb 1	; 47[8-15]X
   175 00000060 ????                <1> 				resw 1	; 48R
   176 00000062 ????                <1> 	.wCaps		resw 1	; 49FRX, Capabilities
   177 00000064 ????                <1> 				resw 1	; 50R
   178 00000066 ??                  <1> 				resb 1	; 51[0-7]X
   179 00000067 ??                  <1> 	.bPIOTiming	resb 1	; 51[8-15]F, PIO data transfer cycle timing mode
   180 00000068 ??                  <1> 				resb 1	; 52[0-7]X
   181 00000069 ??                  <1> 	.bDMATiming	resb 1	; 52[8-15]F, DMA data transfer cycle timing mode
   182 0000006A ????                <1> 	.wFields	resw 1	; 53FVR, Field (next words) validity bits
   183                              <1> 
   184                              <1> 	; Words 54-58 are valid only if bit0 is set in .wFields
   185 0000006C ????                <1> 	.wCurCyls	resw 1	; 54V, Number of current logical cylinders
   186 0000006E ????                <1> 	.wCurHeads	resw 1	; 55V, Number of current logical heads
   187 00000070 ????                <1> 	.wCurSPT	resw 1	; 56V, Number of current logical sectors per track
   188 00000072 ????????            <1> 	.dwCurSCnt	resd 1	; 57...58V, Current capacity in sectors
   189                              <1> 
   190                              <1> 	; Words 59-63 are always valid
   191 00000076 ??                  <1> 	.bBlockSel	resb 1	; 59[0-7]V, Current setting for number of sectors that
   192                              <1> 						;			can be transferred per interrupt on R/W multiple command
   193 00000077 ??                  <1> 	.bBlockFlgs	resb 1	; 59[8-15]VR, bit 0 set if Multiple sector setting is valid
   194 00000078 ????????            <1> 	.dwLBACnt	resd 1	; 60...61F, Total number of user addressable sectors (LBA mode only)
   195 0000007C ??                  <1> 	.bSDMASupp	resb 1	; 62[0-7]F, Single word DMA transfer modes supported
   196 0000007D ??                  <1> 	.bSDMAAct	resb 1	; 62[8-15]V, Single word DMA transfer mode active
   197 0000007E ??                  <1> 	.bMDMASupp	resb 1	; 63[0-7]F, Multiword DMA transfer modes supported
   198 0000007F ??                  <1> 	.bMDMAAct	resb 1	; 63[8-15]V, Multiword DMA transfer mode active
   199                              <1> 
   200                              <1> 	; Words 64-70 are valid only if bit1 is set in .wFields (ATA2+)
   201 00000080 ??                  <1> 	.bPIOSupp	resb 1	; 64[0-7]F, Advanced PIO Transfer Modes Supported
   202 00000081 ??                  <1> 				resb 1	; 64[8-15]R
   203 00000082 ????                <1> 	.wMDMAMinCy	resw 1	; 65F, Minimum Multiword DMA Transfer Cycle Time Per Word
   204 00000084 ????                <1> 	.wMDMARecCy	resw 1	; 66F, Manufacturer’s Recommended Multiword DMA Transfer Cycle Time
   205 00000086 ????                <1> 	.wPIOMinCy	resw 1	; 67F, Minimum PIO Transfer Cycle Time Without Flow Control
   206 00000088 ????                <1> 	.wPIOMinCyF	resw 1	; 68F, Minimum PIO Transfer Cycle Time With IORDY Flow Control
   207                              <1> endstruc
   208                              <1> 
   209                              <1> ; ATA-2 Word 0, General configuration
   210                              <1> A2_wGenCfg_NONMAG		EQU	(1<<15)	; Reserved for non-magnetic drives
   211                              <1> A2_wGenCfg_REMOVABLE	EQU	(1<<7)	; Removable media device
   212                              <1> A2_wGenCfg_FIXED		EQU	(1<<6)	; Not removable controller and/or device
   213                              <1> 
   214                              <1> ; ATA-1 Word 49, Capabilities
   215                              <1> A2_wCaps_TIMER			EQU	(1<<13)	; Standby timer values as specified in this standard are supported
   216                              <1> A2_wCaps_IORDY			EQU	(1<<11)	; IORDY supported
   217                              <1> A2_wCaps_CANDISIORDY	EQU	(1<<10)	; IORDY can be disabled
   218                              <1> A2_wCaps_LBA			EQU	(1<<9)	; LBA supported
   219                              <1> A2_wCaps_DMA			EQU	(1<<8)	; DMA supported
   220                              <1> 
   221                              <1> ; ATA-2 Word 53, Fields
   222                              <1> A2_wFields_54to58		EQU	(1<<0)	; The fields reported in words 54-58 are valid
   223                              <1> A2_wFields_64to70		EQU	(1<<1)	; The fields reported in words 64-70 are valid
   224                              <1> 
   225                              <1> ; ATA-2 Word 59 high byte, Block mode flags
   226                              <1> A2_bBlockFlgs_VALID		EQU	(1<<0)	; Multiple sector setting (bBlockSel) is valid
   227                              <1> 
   228                              <1> ; ATA-2 Word 64, Advanced PIO transfer modes supported
   229                              <1> A2_bPIOSupp_PIO3		EQU	(1<<0)
   230                              <1> A2_bPIOSupp_PIO4		EQU	(1<<1)
   231                              <1> 
   232                              <1> 
   233                              <1> ;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
   234                              <1> 
   235                              <1> ; ATA-6 Drive Information struct
   236                              <1> ; F = Fixed value
   237                              <1> ; V = Variable value
   238                              <1> ; R = Reserved word
   239                              <1> ; X = Vendor specific word
   240                              <1> struc ATA6
   241 00000000 ????                <1> 	.wGenCfg	resw 1	; 0F, General configuration bit-significant information
   242 00000002 ????                <1> 				resw 1	; 1X, Obsolete (Number of logical cylinders)
   243 00000004 ????                <1> 				resw 1	; 2V, Specific configuration
   244 00000006 ????                <1> 				resw 1	; 3X, Obsolete (Number of logical heads)
   245 00000008 ????                <1> 				resw 1	; 4X
   246 0000000A ????                <1> 				resw 1	; 5X
   247 0000000C ????                <1> 				resw 1	; 6X, Obsolete (Number of logical sectors per track)
   248 0000000E ????????            <1> 				resw 2	; 7...8V, Reserved for assignment by the CompactFlash Association
   249 00000012 ????                <1> 				resw 1	; 9X
   250 00000014 <res 14h>           <1> 	.strSerial	resb 20	; 10...19F, Serial number (20 ASCII characters, 0000h=not specified)
   251 00000028 ????                <1> 				resw 1	; 20X
   252 0000002A ????                <1> 				resw 1	; 21X
   253 0000002C ????                <1> 				resw 1	; 22X, Obsolete (# of ECC bytes avail on read/write long cmds (0000h=not spec'd))
   254 0000002E ????????????????    <1> 	.strFirmW	resb 8	; 23...26F, Firmware revision (8 ASCII characters, 0000h=not specified)
   255 00000036 <res 28h>           <1> 	.strModel	resb 40	; 27...46F, Model number (40 ASCII characters, 0000h=not specified)
   256 0000005E ??                  <1> 	.bBlckSize	resb 1	; 47[0-7]F, Maximum number of sectors that can be transferred
   257                              <1> 						;			per interrupt on read and write multiple commands
   258                              <1> 						;			(00h=Read/write multiple commands not implemented)
   259 0000005F ??                  <1> 				resb 1	; 47[8-15]F, 80h
   260 00000060 ????                <1> 				resw 1	; 48R
   261 00000062 ????                <1> 	.wCaps		resw 1	; 49FX, Capabilities
   262 00000064 ????                <1> 	.wCapsHigh	resw 1	; 50FX, Capabilities 2
   263 00000066 ????                <1> 				resw 1	; 51X, Obsolete (PIO data transfer cycle timing mode)
   264 00000068 ????                <1> 				resw 1	; 52X, Obsolete (DMA data transfer cycle timing mode)
   265 0000006A ????                <1> 	.wFields	resw 1	; 53FX, Field (next words) validity bits
   266                              <1> 
   267                              <1> 	; Words 54-58 are valid only if bit0 is set in .wFields
   268 0000006C ????                <1> 				resw 1	; 54X, Obsolete (Number of current logical cylinders)
   269 0000006E ????                <1> 				resw 1	; 55X, Obsolete (Number of current logical heads)
   270 00000070 ????                <1> 				resw 1	; 56X, Obsolete (Number of current logical sectors per track)
   271 00000072 ????????            <1> 				resd 1	; 57...58X, Obsolete (Current capacity in sectors)
   272                              <1> 
   273                              <1> 	; Words 59-63 are always valid
   274 00000076 ??                  <1> 	.bBlockSel	resb 1	; 59[0-7]V, Current setting for number of sectors that
   275                              <1> 						;			can be transferred per interrupt on R/W multiple command
   276 00000077 ??                  <1> 	.bBlockFlgs	resb 1	; 59[8-15]VR, bit 0 set if Multiple sector setting is valid
   277 00000078 ????????            <1> 	.dwLBACnt	resd 1	; 60...61F, Total number of user addressable sectors (LBA-28)
   278 0000007C ??                  <1> 				resb 1	; 62[0-7]X, Obsolete (Single word DMA transfer modes supported)
   279 0000007D ??                  <1> 				resb 1	; 62[8-15]X, Obsolete (Single word DMA transfer mode active)
   280 0000007E ????                <1> 	.wMDMA		resw 1	; 63FV, Multiword DMA transfer modes supported and active
   281                              <1> 
   282                              <1> 	; Words 64-70 are valid only if bit1 is set in .wFields (ATA2+)
   283 00000080 ??                  <1> 	.bPIOSupp	resb 1	; 64[0-7]F, Advanced PIO Transfer Modes Supported
   284 00000081 ??                  <1> 				resb 1	; 64[8-15]R
   285 00000082 ????                <1> 	.wMDMAMinCy	resw 1	; 65F, Minimum Multiword DMA Transfer Cycle Time Per Word
   286 00000084 ????                <1> 	.wMDMARecCy	resw 1	; 66F, Manufacturer’s Recommended Multiword DMA Transfer Cycle Time
   287 00000086 ????                <1> 	.wPIOMinCy	resw 1	; 67F, Minimum PIO Transfer Cycle Time Without Flow Control
   288 00000088 ????                <1> 	.wPIOMinCyF	resw 1	; 68F, Minimum PIO Transfer Cycle Time With IORDY Flow Control
   289 0000008A ????????            <1> 				resw 71-69	; 69...70R
   290                              <1> 
   291                              <1> 	; Words 71...74 are reserved for IDENTIFY PACKET DEVICE command
   292 0000008E ????????????????    <1> 				resw 75-71	; 71...74R
   293                              <1> 
   294 00000096 ????                <1> 	.wQueue		resw 1	; 75[0-4]F, Maximum queue depth - 1
   295 00000098 ????????????????    <1> 				resw 80-76	; 76...79R
   296                              <1> 
   297 000000A0 ????                <1> 	.wMajorVer	resw 1	; 80F, Major Version Number
   298 000000A2 ????                <1> 	.wMinorVer	resw 1	; 81F, Minor Version Number
   299 000000A4 ????                <1> 	.wSetSup82	resw 1	; 82F, Command set supported
   300 000000A6 ????                <1> 	.wSetSup83	resw 1	; 83F, Command sets supported
   301 000000A8 ????                <1> 	.wSetSup84	resw 1	; 84F, Command set / Feature supported extension
   302 000000AA ????                <1> 	.wEnFor82	resw 1	; 85FV, Command set / feature enabled (for word 82)
   303 000000AC ????                <1> 	.wEnFor83	resw 1	; 86FV, Command set / feature enabled (for word 83)
   304 000000AE ????                <1> 	.wEnFor84	resw 1	; 87FV, Command set / feature enabled (for word 84)
   305                              <1> 
   306                              <1> 	; Word 88 is valid only if bit2 is set in .wFields (word 53)
   307 000000B0 ????                <1> 	.wUDMA		resw 1	; 88FV, Ultra DMA Mode support
   308                              <1> 
   309 000000B2 ????                <1> 	.wEraseTime	resw 1	; 89F, Time required for security erase unit completion
   310 000000B4 ????                <1> 	.wEnhErTime	resw 1	; 90F, Time required for Enhanced security erase completion
   311 000000B6 ????                <1> 	.wCurPower	resw 1	; 91V, Current advanced power management value
   312 000000B8 ????                <1> 	.wPWRev		resw 1	; 92V, Master Password Revision Code
   313 000000BA ????                <1> 	.wReset		resw 1	; 93FV, Hardware reset result
   314 000000BC ??                  <1> 	.bCurAcous	resb 1	; 94[0-7]V, Current automatic acoustic management value
   315 000000BD ??                  <1> 	.bRecAcous	resb 1	; 94[8-15]V, Vendor’s recommended acoustic management value
   316 000000BE <res Ah>            <1> 				resw 100-95		; 95...99R
   317 000000C8 ????????????????    <1> 	.qwLBACnt	resb 8	; 100...103V, Total number of user addressable sectors (LBA48)
   318 000000D0 <res 2Eh>           <1> 				resw 127-104	; 104...126R
   319 000000FE ????                <1> 	.wRMSN		resw 1	; 127F, Removable Media Status Notification feature set support
   320 00000100 ????                <1> 	.wSecurity	resw 1	; 128FV, Security Status
   321 00000102 <res 3Eh>           <1> 				resw 160-129	; 129...157X, Vendor Specific
   322 00000140 ????                <1> 	.wCFAPower	resw 1	; 160FV, CFA Power Mode 1
   323 00000142 <res 1Eh>           <1> 				resw 176-161	; 161...175R, Reserved for assignment by the CompactFlash Association
   324 00000160 <res 3Ch>           <1> 	.strMediaSr	resw 206-176	; 176...205V, Current media serial number
   325 0000019C <res 62h>           <1> 				resw 255-206	; 206...254R
   326                              <1> 	.wIntegrityWord:
   327 000001FE ??                  <1> 	.bSignature	resb 1	; 255[0-7]X, Signature
   328 000001FF ??                  <1> 	.bChecksum	resb 1	; 255[8-15]X, Checksum
   329                              <1> endstruc
   330                              <1> 
   331                              <1> ; ATA-6 Word 0, General configuration
   332                              <1> A6_wGenCfg_REMOVABLE	EQU	(1<<7)	; Removable media device
   333                              <1> A6_wGenCfg_INCOMPLETE	EQU	(1<<2)	; Response incomplete
   334                              <1> 
   335                              <1> ; ATA-6 Word 49, Capabilities
   336                              <1> A6_wCaps_TIMER			EQU	(1<<13)	; Standby timer values as specified in this standard are supported
   337                              <1> A6_wCaps_IORDY			EQU	(1<<11)	; IORDY supported
   338                              <1> A6_wCaps_CANDISIORDY	EQU	(1<<10)	; IORDY can be disabled
   339                              <1> A6_wCaps_LBA			EQU	(1<<9)	; LBA supported
   340                              <1> A6_wCaps_DMA			EQU	(1<<8)	; DMA supported
   341                              <1> 
   342                              <1> ; ATA-6 Word 53, Fields
   343                              <1> A6_wFields_88			EQU	(1<<2)	; The fields reported in word 88 are valid
   344                              <1> A6_wFields_64to70		EQU	(1<<1)	; The fields reported in words 64-70 are valid
   345                              <1> 
   346                              <1> ; ATA-6 Word 59 high byte, Block mode flags
   347                              <1> A6_bBlockFlgs_VALID		EQU	(1<<0)	; Multiple sector setting (bBlockSel) is valid
   348                              <1> 
   349                              <1> ; ATA-6 Word 63, Multiword DMA Mode
   350                              <1> A6_wMDMA_MODE2_SELECTED	EQU	(1<<10)	; Multiword DMA mode 2 is selected
   351                              <1> A6_wMDMA_MODE1_SELECTED	EQU	(1<<9)	; Multiword DMA mode 1 is selected
   352                              <1> A6_wMDMA_MODE0_SELECTED	EQU	(1<<8)	; Multiword DMA mode 0 is selected
   353                              <1> A6_wMDMA_MODE2_SUPRTD	EQU	(1<<2)	; Multiword DMA mode 2 and below are supported
   354                              <1> A6_wMDMA_MODE1_SUPRTD	EQU	(1<<1)	; Multiword DMA mode 1 and below are supported
   355                              <1> A6_wMDMA_MODE0_SUPRTD	EQU	(1<<0)	; Multiword DMA mode 0 is supported
   356                              <1> 
   357                              <1> ; ATA-6 Word 80, Major version number
   358                              <1> A6_wMajorVer_ATA6		EQU	(1<<6)
   359                              <1> A6_wMajorVer_ATA5		EQU	(1<<5)
   360                              <1> A6_wMajorVer_ATA4		EQU	(1<<4)
   361                              <1> A6_wMajorVer_ATA3		EQU	(1<<3)
   362                              <1> 
   363                              <1> ; ATA-6 Word 82, Command set supported
   364                              <1> A6_wSetSup82_NOP		EQU	(1<<14)	; NOP command supported
   365                              <1> A6_wSetSup82_RDBUFF		EQU	(1<<13)	; READ BUFFER command supported
   366                              <1> A6_wSetSup82_WRBUFF		EQU	(1<<12)	; WRITE BUFFER command supported
   367                              <1> A6_wSetSup82_PROT_AREA	EQU	(1<<10)	; Host Protected Area feature set supported
   368                              <1> A6_wSetSup82_DEV_RESET	EQU	(1<<9)	; DEVICE RESET command supported
   369                              <1> A6_wSetSup82_SERVICE	EQU	(1<<8)	; SERVICE interrupt supported
   370                              <1> A6_wSetSup82_RELEASE	EQU	(1<<7)	; Release interrupt supported
   371                              <1> A6_wSetSup82_LOOKAHEAD	EQU	(1<<6)	; Look-ahead supported
   372                              <1> A6_wSetSup82_WRCACHE	EQU	(1<<5)	; Write cache supported
   373                              <1> A6_wSetSup82_POWERMAN	EQU	(1<<3)	; Power Management feature set supported
   374                              <1> A6_wSetSup82_REM_MEDIA	EQU	(1<<2)	; Removable Media feature set supported
   375                              <1> A6_wSetSup82_SECURITY	EQU	(1<<1)	; Security Mode feature set supported
   376                              <1> A6_wSetSup82_SMART		EQU	(1<<0)	; SMART feature set supported
   377                              <1> 
   378                              <1> ; ATA-6 Word 83, Command sets supported
   379                              <1> A6_wSetSup83_FLUSH_EXT	EQU	(1<<13)	; FLUSH CACHE EXT command supported
   380                              <1> A6_wSetSup83_FLUSH		EQU	(1<<12)	; FLUSH CACHE command supported
   381                              <1> A6_wSetSup83_CFG		EQU	(1<<11)	; Device Configuration Overlay feature set supported
   382                              <1> A6_wSetSup83_LBA48		EQU	(1<<10)	; 48-bit LBA feature set supported
   383                              <1> A6_wSetSup83_ACOUSTIC	EQU	(1<<9)	; Automatic Acoustic Management feature set supported
   384                              <1> A6_wSetSup83_SET_MAX	EQU	(1<<8)	; SET MAX security extension supported
   385                              <1> A6_wSetSup83_FEATURES	EQU	(1<<6)	; SET FEATURES subcommand required to spinup after power-up
   386                              <1> A6_wSetSup83_POWERUP	EQU	(1<<5)	; Power-Up In Standby feature set supported
   387                              <1> A6_wSetSup83_RMSN		EQU	(1<<4)	; Removable Media Status Notification feature set supported
   388                              <1> A6_wSetSup83_APM		EQU	(1<<3)	; Advanced Power Management feature set supported
   389                              <1> A6_wSetSup83_CFA		EQU	(1<<2)	; CFA feature set supported
   390                              <1> A6_wSetSup83_DMAQUEUED	EQU	(1<<1)	; READ/WRITE DMA QUEUED supported
   391                              <1> A6_wSetSup83_MICROCODE	EQU	(1<<0)	; DOWNLOAD MICROCODE command supported
   392                              <1> 
   393                              <1> ; ATA-6 Word 84, Command set/feature supported extension
   394                              <1> A6_wSetSup84_GENLOG		EQU	(1<<5)	; General Purpose Logging feature set supported
   395                              <1> A6_wSetSup84_MEDIAPASS	EQU	(1<<3)	; Media Card Pass Through Command feature set supported
   396                              <1> A6_wSetSup84_MEDIASER	EQU	(1<<2)	; Media serial number supported
   397                              <1> A6_wSetSup84_SMARTTEST	EQU	(1<<1)	; SMART self-test supported
   398                              <1> A6_wSetSup84_SMARTLOG	EQU	(1<<0)	; SMART error logging supported
   399                              <1> 
   400                              <1> ; ATA-6 Word 85, Command set/feature enabled (supported by word 82)
   401                              <1> A6_wEnFor82_NOP			EQU	(1<<14)	; NOP command enabled
   402                              <1> A6_wEnFor82_RDBUFF		EQU	(1<<13)	; READ BUFFER command enabled
   403                              <1> A6_wEnFor82_WRBUFF		EQU	(1<<12)	; WRITE BUFFER command enabled
   404                              <1> A6_wEnFor82_PROT_AREA	EQU	(1<<10)	; Host Protected Area feature set enabled
   405                              <1> A6_wEnFor82_DEV_RESET	EQU	(1<<9)	; DEVICE RESET command enabled
   406                              <1> A6_wEnFor82_SERVICE		EQU	(1<<8)	; SERVICE interrupt enabled
   407                              <1> A6_wEnFor82_RELEASE		EQU	(1<<7)	; Release interrupt enabled
   408                              <1> A6_wEnFor82_LOOKAHEAD	EQU	(1<<6)	; Look-ahead enabled
   409                              <1> A6_wEnFor82_WRCACHE		EQU	(1<<5)	; Write cache enabled
   410                              <1> A6_wEnFor82_POWERMAN	EQU	(1<<3)	; Power Management feature set enabled
   411                              <1> A6_wEnFor82_REM_MEDIA	EQU	(1<<2)	; Removable Media feature set enabled
   412                              <1> A6_wEnFor82_SECURITY	EQU	(1<<1)	; Security Mode feature set enabled
   413                              <1> A6_wEnFor82_SMART		EQU	(1<<0)	; SMART feature set enabled
   414                              <1> 
   415                              <1> ; ATA-6 Word 86, Command set/feature enabled (supported by word 83)
   416                              <1> A6_wEnFor83_FLUSH_EXT	EQU	(1<<13)	; FLUSH CACHE EXT command supported
   417                              <1> A6_wEnFor83_FLUSH		EQU	(1<<12)	; FLUSH CACHE command supported
   418                              <1> A6_wEnFor83_CFG			EQU	(1<<11)	; Device Configuration Overlay supported
   419                              <1> A6_wEnFor83_LBA48		EQU	(1<<10)	; 48-bit LBA feature set supported
   420                              <1> A6_wEnFor83_ACOUSTIC	EQU	(1<<9)	; Automatic Acoustic Management feature set enabled
   421                              <1> A6_wEnFor83_SET_MAX		EQU	(1<<8)	; SET MAX security extension enabled by SET MAX SET PASSWORD
   422                              <1> A6_wEnFor83_FEATURES	EQU	(1<<6)	; SET FEATURES subcommand required to spinup after power-up
   423                              <1> A6_wEnFor83_POWERUP		EQU	(1<<5)	; Power-Up In Standby feature set enabled
   424                              <1> A6_wEnFor83_RMSN		EQU	(1<<4)	; Removable Media Status Notification feature set enabled
   425                              <1> A6_wEnFor83_APM			EQU	(1<<3)	; Advanced Power Management feature set enabled
   426                              <1> A6_wEnFor83_CFA			EQU	(1<<2)	; CFA feature set enabled
   427                              <1> A6_wEnFor83_DMAQUEUED	EQU	(1<<1)	; READ/WRITE DMA QUEUED supported
   428                              <1> A6_wEnFor83_MICROCODE	EQU	(1<<0)	; DOWNLOAD MICROCODE command supported
   429                              <1> 
   430                              <1> ; ATA-6 Word 87, Command set/feature default
   431                              <1> A6_wEnFor84_GENLOG		EQU	(1<<5)	; General Purpose Logging feature set supported
   432                              <1> A6_wEnFor84_MEDIAPASS	EQU	(1<<3)	; Media Card Pass Through Command feature set enabled
   433                              <1> A6_wEnFor84_MEDIASER	EQU	(1<<2)	; Media serial number is valid
   434                              <1> A6_wEnFor84_SMARTTEST	EQU	(1<<1)	; SMART self-test supported
   435                              <1> A6_wEnFor84_SMARTLOG	EQU	(1<<0)	; SMART error logging supported
   436                              <1> 
   437                              <1> ; ATA-6 Word 88, Ultra DMA Mode
   438                              <1> A6_wUDMA_MODE5_SELECTED	EQU	(1<<13)	; Ultra DMA mode 5 is selected
   439                              <1> A6_wUDMA_MODE4_SELECTED	EQU	(1<<12)	; Ultra DMA mode 4 is selected
   440                              <1> A6_wUDMA_MODE3_SELECTED	EQU	(1<<11)	; Ultra DMA mode 3 is selected
   441                              <1> A6_wUDMA_MODE2_SELECTED	EQU	(1<<10)	; Ultra DMA mode 2 is selected
   442                              <1> A6_wUDMA_MODE1_SELECTED	EQU	(1<<9)	; Ultra DMA mode 1 is selected
   443                              <1> A6_wUDMA_MODE0_SELECTED	EQU	(1<<8)	; Ultra DMA mode 0 is selected
   444                              <1> A6_wUDMA_MODE5_SUPRTD	EQU	(1<<5)	; Ultra DMA mode 5 and below are supported
   445                              <1> A6_wUDMA_MODE4_SUPRTD	EQU	(1<<4)	; Ultra DMA mode 4 and below are supported
   446                              <1> A6_wUDMA_MODE3_SUPRTD	EQU	(1<<3)	; Ultra DMA mode 3 and below are supported
   447                              <1> A6_wUDMA_MODE2_SUPRTD	EQU	(1<<2)	; Ultra DMA mode 2 and below are supported
   448                              <1> A6_wUDMA_MODE1_SUPRTD	EQU	(1<<1)	; Ultra DMA mode 1 and below are supported
   449                              <1> A6_wUDMA_MODE0_SUPRTD	EQU	(1<<0)	; Ultra DMA mode 0 is supported
   450                              <1> 
   451                              <1> ; ATA-6 Word 93, Hardware reset result
   452                              <1> A6_wReset_CBLID_BELOW	EQU	(1<<13)	; Device detected CBLID- above ViH
   453                              <1> A6_wReset_DEV1_PDIAG	EQU	(1<<11)	; Device 1 asserted PDIAG-
   454                              <1> A6_wReset_DEV0_RESP_D1	EQU	(1<<6)	; Device 0 responds when Device 1 is selected
   455                              <1> A6_wReset_DEV0_DASP		EQU	(1<<5)	; Device 0 detected the assertion of DASP-
   456                              <1> A6_wReset_DEV0_PDIAG	EQU	(1<<4)	; Device 0 detected the assertion of PDIAG
   457                              <1> A6_wReset_DEV0_PASSED	EQU	(1<<3)	; Device 0 passed diagnostics
   458                              <1> A6_wReset_MASK_DEV1_DETERMINE	EQU ((1<<10)|(1<<9))	; These bits indicate how Device 1 determined the device number
   459                              <1> A6_wReset_MASK_DEV0_DETERMINE	EQU ((1<<2)|(1<<1))		; These bits indicate how Device 0 determined the device number:
   460                              <1> A6_wReset_RESERVED		EQU	00b
   461                              <1> A6_wReset_JUMPER		EQU	01b		; a jumper was used
   462                              <1> A6_wReset_CSEL			EQU	10b		; the CSEL signal was used
   463                              <1> A6_wReset_UNKNOWN		EQU	11b		; some other method was used or the method is unknown
   464                              <1> 
   465                              <1> ; ATA-6 Word 127, Removable Media Status Notification feature set support
   466                              <1> A6_wRMSN_SUPPORTED		EQU	(1<<0)	; Removable Media Status Notification feature supported
   467                              <1> 
   468                              <1> ; ATA-6 Word 128, Security status
   469                              <1> A6_wSecurity_MAX		EQU	(1<<8)	; Security level 0 = High, 1 = Maximum
   470                              <1> A6_wSecurity_ENH_ERASE	EQU	(1<<5)	; Enhanced security erase supported
   471                              <1> A6_wSecurity_EXPIRED	EQU	(1<<4)	; Security count expired
   472                              <1> A6_wSecurity_FROZEN		EQU	(1<<3)	; Security frozen
   473                              <1> A6_wSecurity_LOCKED		EQU	(1<<2)	; Security locked
   474                              <1> A6_wSecurity_ENABLED	EQU	(1<<1)	; Security enabled
   475                              <1> A6_wSecurity_SUPPORTED	EQU	(1<<0)	; Security supported
   476                              <1> 
   477                              <1> ; ATA-6 Word 160, CFA Power Mode 1
   478                              <1> A6_wCFAPower_WORDSUPP	EQU	(1<<15)	; Word 160 supported
   479                              <1> A6_wCFAPower_REQUIRED	EQU	(1<<13)	; CFA power mode 1 is required for one or more commands implemented by the device
   480                              <1> A6_wCFAPower_DISABLED	EQU	(1<<12)	; CFA power mode 1 disabled
   481                              <1> A6_wCFAPower_MASK_mA	EQU	0FFFh	; Maximum current in mA
   482                              <1> 
   483                              <1> ; ATA-6 WORD 255, Integrity Word (Signature and Checksum)
   484                              <1> A6_wIntegrity_SIGNATURE	EQU	0A5h
   485                              <1> 
