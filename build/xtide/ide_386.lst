   183                              <1> ; Device_ReadLBAlowRegisterToAL
   184                              <1> ;
   185                              <1> ; Returns LBA low register / Sector number register contents.
   186                              <1> ; Note that this returns valid value only after transfer command (read/write/verify)
   187                              <1> ; has stopped to an error. Do not call this otherwise.
   188                              <1> ;
   189                              <1> ;	Parameters:
   190                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
   191                              <1> ;	Returns:
   192                              <1> ;		AL:		Byte read from the device register
   193                              <1> ;	Corrupts registers:
   194                              <1> ;		BX, DX (only DX if MODULE_ATAPI is included)
   195                              <1> ;--------------------------------------------------------------------
   196                              <1> ;%ifdef MODULE_SERIAL	; IDE + Serial
   197                              <1> ;ALIGN JUMP_ALIGN
   198                              <1> ;Device_ReadLBAlowRegisterToAL:
   199                              <1> ;	test	BYTE [di+DPT.bFlagsHigh], FLGH_DPT_SERIAL_DEVICE
   200                              <1> ;%ifdef USE_386
   201                              <1> ;	jz		IdeCommand_ReadLBAlowRegisterToAL
   202                              <1> ;	jmp		SerialCommand_ReadLBAlowRegisterToAL
   203                              <1> ;%else ; ~USE_386
   204                              <1> ;	jnz		SHORT .ReadFromSerialPort
   205                              <1> ;	jmp		IdeCommand_ReadLBAlowRegisterToAL
   206                              <1> 
   207                              <1> ;ALIGN JUMP_ALIGN
   208                              <1> ;.ReadFromSerialPort:
   209                              <1> ;	jmp		SerialCommand_ReadLBAlowRegisterToAL
   210                              <1> ;%endif
   211                              <1> 
   212                              <1> ;%else					; IDE only
   213                              <1> 	Device_ReadLBAlowRegisterToAL		EQU		IdeCommand_ReadLBAlowRegisterToAL
   214                              <1> ;%endif
   215                              <1> ; TODO: For now we simply assume serial device do not produce verify errors
