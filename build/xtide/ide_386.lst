   336                              <2> ; DisplayPrint_NullTerminatedStringFromCSSI
   337                              <2> ;	Parameters:
   338                              <2> ;		CS:SI:	Ptr to NULL terminated string
   339                              <2> ;		DS:		BDA segment (zero)
   340                              <2> ;		ES:DI:	Ptr to cursor location in video RAM
   341                              <2> ;	Returns:
   342                              <2> ;		DI:		Updated offset to video RAM
   343                              <2> ;	Corrupts registers:
   344                              <2> ;		AX, DX
   345                              <2> ;--------------------------------------------------------------------
   346                              <2> %ifndef MODULE_STRINGS_COMPRESSED
   347                              <2> ;;;
   348                              <2> ;;; Take care when using this routine with compressed strings (which is why it is disabled).
   349                              <2> ;;; All strings in CSSI should go through the DisplayFormatCompressed code to be decoded.
   350                              <2> ;;;
   351                              <2> ALIGN DISPLAY_JUMP_ALIGN
   352                              <2> DisplayPrint_NullTerminatedStringFromCSSI:
   353                              <2> 	push	bx
   354                              <2> 	mov		bx, cs
   355                              <2> 	call	DisplayPrint_NullTerminatedStringFromBXSI
   356                              <2> 	pop		bx
   357                              <2> 	ret
   358                              <2> %endif
   359                              <2> 
   360                              <2> 
   361                              <2> ;;;
   362                              <2> ;;; Note that the following routines need to be at the bottom of this file
   363                              <2> ;;; to accomodate short jumps from the next file (DisplayFormat/DisplayFormatCompressed)
   364                              <2> ;;;
