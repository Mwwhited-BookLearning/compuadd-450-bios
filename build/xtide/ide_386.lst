     5                              <2> 
     6                              <2> ; BIOS interrupts
     7                              <2> BIOS_SYSTEM_TIMER_TICK_INTERRUPT_08h	EQU		08h
     8                              <2> BIOS_VIDEO_INTERRUPT_10h				EQU		10h
     9                              <2> BIOS_EQUIPMENT_INTERRUPT_11h			EQU		11h
    10                              <2> BIOS_DISK_INTERRUPT_13h					EQU		13h
    11                              <2> BIOS_SYSTEM_INTERRUPT_15h				EQU		15h
    12                              <2> BIOS_KEYBOARD_INTERRUPT_16h				EQU		16h
    13                              <2> BIOS_BOOT_FAILURE_INTERRUPT_18h			EQU		18h
    14                              <2> BIOS_BOOT_LOADER_INTERRUPT_19h			EQU		19h
    15                              <2> BIOS_TIME_PCI_PNP_INTERRUPT_1Ah			EQU		1Ah
    16                              <2> BIOS_USER_TIMER_TICK_INTERRUPT_1Ch		EQU		1Ch
    17                              <2> BIOS_DISKETTE_INTERRUPT_40h				EQU		40h
    18                              <2> HD0_DPT_POINTER_41h						EQU		41h
    19                              <2> HD1_DPT_POINTER_46h						EQU		46h
    20                              <2> 
