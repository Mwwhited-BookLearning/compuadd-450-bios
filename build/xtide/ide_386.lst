    11                              <1> %include "CgaSnow.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	Macros for preventing CGA snow.
     3                              <2> %ifndef CGASNOW_INC
     4                              <2> %define CGASNOW_INC
     5                              <2> 
     6                              <2> ;--------------------------------------------------------------------
     7                              <2> ; CALL_WAIT_FOR_RETRACE_IF_NECESSARY_THEN
     8                              <2> ; JMP_WAIT_FOR_RETRACE_IF_NECESSARY_THEN
     9                              <2> ;	Parameters:
    10                              <2> ;		%1:		Instruction that accesses CGA memory
    11                              <2> ;		AL:		Character to output
    12                              <2> ;		AH:		Attribute to output (stosw only)
    13                              <2> ;		DS:		BDA segment (zero)
    14                              <2> ;		ES:SI:	Ptr to video memory where to read from (if %1 reads)
    15                              <2> ;		ES:DI:	Ptr to video memory where to output (if %1 writes)
    16                              <2> ;	Returns:
    17                              <2> ;		SI, DI:	Updated according to instruction
    18                              <2> ;	Corrupts registers:
    19                              <2> ;		AX, DX
    20                              <2> ;--------------------------------------------------------------------
    21                              <2> %macro CALL_WAIT_FOR_RETRACE_IF_NECESSARY_THEN 1
    22                              <2> %ifdef ELIMINATE_CGA_SNOW
    23                              <2> 	%ifidn %1, stosb
    24                              <2> 		call	CgaSnow_Stosb
    25                              <2> 	%elifidn %1, stosw
    26                              <2> 		call	CgaSnow_Stosw
    27                              <2> 	%elifidn %1, rep movsb
    28                              <2> 		call	CgaSnow_RepMovsb
    29                              <2> 	%else
    30                              <2> 		%error	"Invalid instruction passed to CALL_WAIT_FOR_RETRACE_IF_NECESSARY_THEN"
    31                              <2> 	%endif
    32                              <2> %else	; No CGA snow prevention
    33                              <2> 	%ifidn %1, rep movsb
    34                              <2> 		eSEG_STR rep, es, movsb
    35                              <2> 	%else
    36                              <2> 		%1	; Single instruction
    37                              <2> 	%endif
    38                              <2> %endif
    39                              <2> %endmacro
    40                              <2> 
    41                              <2> %macro JMP_WAIT_FOR_RETRACE_IF_NECESSARY_THEN 1
    42                              <2> %ifdef ELIMINATE_CGA_SNOW
    43                              <2> 	%ifidn %1, stosb
    44                              <2> 		jmp		CgaSnow_Stosb
    45                              <2> 	%elifidn %1, stosw
    46                              <2> 		jmp		CgaSnow_Stosw
    47                              <2> 	%elifidn %1, rep movsb
    48                              <2> 		jmp		CgaSnow_RepMovsb
    49                              <2> 	%else
    50                              <2> 		%error	"Invalid instruction passed to JMP_WAIT_FOR_RETRACE_IF_NECESSARY_THEN"
    51                              <2> 	%endif
    52                              <2> %else	; No CGA snow prevention
    53                              <2> 	%ifidn %1, rep movsb
    54                              <2> 		eSEG_STR rep, es, movsb
    55                              <2> 		ret
    56                              <2> 	%else
    57                              <2> 		%1	; Single instruction
    58                              <2> 		ret
    59                              <2> 	%endif
    60                              <2> %endif
    61                              <2> %endmacro
    62                              <2> 
    63                              <2> 
    64                              <2> ;--------------------------------------------------------------------
    65                              <2> ; WAIT_UNTIL_SAFE_CGA_WRITE
    66                              <2> ;	Parameters:
    67                              <2> ;		DX:		CGA Status Register Address (3DAh)
    68                              <2> ;	Returns:
    69                              <2> ;		Nothing
    70                              <2> ;	Corrupts registers:
    71                              <2> ;		AL
    72                              <2> ;--------------------------------------------------------------------
    73                              <2> %macro WAIT_UNTIL_SAFE_CGA_WRITE 0
    74                              <2> %%WaitUntilNotInRetrace:
    75                              <2> 	in		al, dx
    76                              <2> 	shr		al, 1	; 1 = Bit 0: A 1 indicates that regen-buffer memory access can be
    77                              <2> 					; made without interfering with the display. (H or V retrace)
    78                              <2> 	jc		SHORT %%WaitUntilNotInRetrace
    79                              <2> %%WaitUntilNextRetraceStarts:
    80                              <2> 	in		al, dx
    81                              <2> 	shr		al, 1
    82                              <2> 	jnc		SHORT %%WaitUntilNextRetraceStarts
    83                              <2> %endmacro
    84                              <2> 
    85                              <2> 
    86                              <2> %endif ; CGASNOW_INC
    12                              <1> %include "CMOS.inc"
     1                              <2> ; Project name	:	Assembly Library
     2                              <2> ; Description	:	Defines for accessing CMOS.
     3                              <2> 
     4                              <2> ;
     5                              <2> ; XTIDE Universal BIOS and Associated Tools
     6                              <2> ; Copyright (C) 2009-2010 by Tomi Tilli, 2011-2018 by XTIDE Universal BIOS Team.
     7                              <2> ;
