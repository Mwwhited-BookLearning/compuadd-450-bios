   280                              <2> ; Keyboard_GetKeystrokeToAX
   281                              <2> ; Keyboard_GetKeystrokeToAXandLeaveItToBuffer
   282                              <2> ; Keyboard_GetKeystrokeToAXandWaitIfNecessary
   283                              <2> ;	Parameters:
   284                              <2> ;		Nothing
   285                              <2> ;	Returns:
   286                              <2> ;		AL:		ASCII character (if keystroke available)
   287                              <2> ;		AH:		BIOS scan code (if keystroke available)
   288                              <2> ;		ZF:		Set if no keystroke available
   289                              <2> ;				Cleared if keystroke available
   290                              <2> ;	Corrupts registers:
   291                              <2> ;		Nothing
   292                              <2> ;--------------------------------------------------------------------
   293                              <2> %ifdef EXCLUDE_FROM_XUB
   294                              <2> 	%define EXCLUDE
   295                              <2> 	%ifdef MODULE_HOTKEYS OR MODULE_BOOT_MENU
   296                              <2> 		%undef EXCLUDE
   297                              <2> 	%endif
   298                              <2> %endif
   299                              <2> 
   300                              <2> %ifndef EXCLUDE
   301                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   302                              <2> Keyboard_GetKeystrokeToAXandLeaveItToBuffer:
   303 00000340 B401                <2> 	mov		ah, CHECK_FOR_KEYSTROKE
   304 00000342 CD16                <2> 	int		BIOS_KEYBOARD_INTERRUPT_16h
   305 00000344 C3                  <2> 	ret
   306                              <2> 
   307                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   308                              <2> Keyboard_GetKeystrokeToAX:
   309 00000345 E8F8FF              <2> 	call	Keyboard_GetKeystrokeToAXandLeaveItToBuffer
   310 00000348 7406                <2> 	jz		SHORT Keyboard_GetKeystrokeToAXReturn
   311                              <2> 	; Fall to Keyboard_GetKeystrokeToAXandWaitIfNecessary
   312                              <2> ALIGN KEYBOARD_JUMP_ALIGN
   313                              <2> Keyboard_GetKeystrokeToAXandWaitIfNecessary:
   314 0000034A 30E4                <2> 	xor		ah, ah						; GET_KEYSTROKE
   315 0000034C CD16                <2> 	int		BIOS_KEYBOARD_INTERRUPT_16h
   316 0000034E 85C0                <2> 	test	ax, ax						; Clear ZF
   317                              <2> Keyboard_GetKeystrokeToAXReturn:
   318 00000350 C3                  <2> 	ret
   319                              <2> 
   320                              <2> %endif
   321                              <2> %undef EXCLUDE
