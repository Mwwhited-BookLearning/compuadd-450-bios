    20                              <1> ; Section containing code
    21                              <1> SECTION .text
    22                              <1> 
    23                              <1> 
    24                              <1> ;--------------------------------------------------------------------
    25                              <1> ; Int 13h function AH=8h, Read Disk Drive Parameters.
    26                              <1> ;
    27                              <1> ; AH8h_HandlerForReadDiskDriveParameters
    28                              <1> ;	Parameters:
    29                              <1> ;		DL:		Translated Drive number
    30                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    31                              <1> ;		SS:BP:	Ptr to IDEPACK
    32                              <1> ;	Returns with INTPACK:
    33                              <1> ;		BL:		Drive Type (for serial floppies only)
    34                              <1> ;		CH:		Maximum cylinder number, bits 7...0
    35                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9...8
    36                              <1> ;				Bits 5...0:	Maximum sector number (1...63)
    37                              <1> ;		DH:		Maximum head number (0...254)
    38                              <1> ;		DL:		Number of drives!!!
    39                              <1> ;		ES:DI:	Floppy DPT (for serial floppies only)
    40                              <1> ;		AH:		Int 13h/40h floppy return status
    41                              <1> ;		CF:		0 if successful, 1 if error
    42                              <1> ;--------------------------------------------------------------------
    43                              <1> AH8h_HandlerForReadDiskDriveParameters:
    44 000019E0 85FF                <1> 	test	di, di
    45 000019E2 742A                <1> 	jz		SHORT .NotOurDrive
    46                              <1> 
    47 000019E4 E82F00              <1> 	call	AH8h_GetDriveParameters
    48                              <1> 
    49                              <1> %ifdef MODULE_SERIAL_FLOPPY
    50 000019E7 0E                  <1> 	push	cs							; setup registers if we are a floppy drive, in all cases
    51 000019E8 07                  <1> 	pop		es							; if it is not a floppy drive, these values will not be put in INTPACK
    52 000019E9 BF[2F1A]            <1> 	mov		di, AH8h_FloppyDPT
    53                              <1> %endif
    54                              <1> 	;; fall-through
    55                              <1> 
    56                              <1> .MidGame:
    57 000019EC E851EB              <1> 	call	RamVars_GetCountOfKnownDrivesToAX		; assume hard disk for now, will discard if for floppies
    58                              <1> 
    59 000019EF F6461A80            <1> 	test	BYTE [bp+IDEPACK.intpack+INTPACK.dl], 80h
    60 000019F3 750C                <1> 	jnz		SHORT .CalledForHardDrive
    61                              <1> 
    62 000019F5 885E18              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.bl], bl
    63 000019F8 8C460C              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.es], es
    64 000019FB 897E10              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.di], di
    65                              <1> 
    66 000019FE E893EB              <1> 	call	FloppyDrive_GetCountToAX
    67                              <1> 
    68                              <1> .CalledForHardDrive:
    69 00001A01 88F4                <1> 	mov		ah, dh
    70                              <1> 
    71 00001A03 894E1C              <1> 	mov		[bp+IDEPACK.intpack+INTPACK.cx], cx
    72 00001A06 87461A              <1> 	xchg	[bp+IDEPACK.intpack+INTPACK.dx], ax		; recover DL for BDA last status byte determination
    73                              <1> 
    74 00001A09 30E4                <1> 	xor		ah, ah
    75                              <1> %ifdef MODULE_SERIAL_FLOPPY
    76 00001A0B E975FE              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH_ALHasDriveNumber
    77                              <1> %else
    78                              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    79                              <1> %endif
    80                              <1> 
    81                              <1> .NotOurDrive:
    82 00001A0E E883FE              <1> 	call	Int13h_CallPreviousInt13hHandler
    83 00001A11 73D9                <1> 	jnc		SHORT .MidGame
    84 00001A13 E96AFE              <1> 	jmp		Int13h_ReturnFromHandlerAfterStoringErrorCodeFromAH
    85                              <1> 
    86                              <1> 
    87                              <1> ;--------------------------------------------------------------------
    88                              <1> ; Returns L-CHS parameters for drive and total hard disk count.
    89                              <1> ;
    90                              <1> ; AH8h_GetDriveParameters
    91                              <1> ;	Parameters:
    92                              <1> ;		DS:DI:	Ptr to DPT (in RAMVARS segment)
    93                              <1> ;	Returns:
    94                              <1> ;		BL:		Drive Type (for serial floppies only)
    95                              <1> ;		CH:		Maximum cylinder number, bits 7...0
    96                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9...8
    97                              <1> ;				Bits 5...0:	Maximum sector number (1...63)
    98                              <1> ;		DH:		Maximum head number (0...254)
    99                              <1> ;	Corrupts registers:
   100                              <1> ;		AX, BH
   101                              <1> ;--------------------------------------------------------------------
   102                              <1> AH8h_GetDriveParameters:
   103 00001A16 E8E0EC              <1> 	call	AccessDPT_GetLCHStoAXBLBH
   104 00001A19 E8ADED              <1> 	call	AtaGeometry_LimitAXtoMaximumLCylinders
   105                              <1> 	; Fall to .PackReturnValues
   106                              <1> 
   107                              <1> ;--------------------------------------------------------------------
   108                              <1> ; Packs L-CHS values to INT 13h, AH=08h return values.
   109                              <1> ;
   110                              <1> ; .PackReturnValues
   111                              <1> ;	Parameters:
   112                              <1> ;		AX:		Number of L-CHS cylinders available (1...1024)
   113                              <1> ;		BL:		Number of L-CHS heads (1...255)
   114                              <1> ;		BH:		Number of L-CHS sectors per track (1...63)
   115                              <1> ;		DS:		RAMVARS segment
   116                              <1> ;	Returns:
   117                              <1> ;		BL:		Drive Type (for serial floppies only)
   118                              <1> ;		CH:		Maximum cylinder number, bits 7...0
   119                              <1> ;		CL:		Bits 7...6: Cylinder number bits 9...8
   120                              <1> ;				Bits 5...0:	Maximum sector number (1...63)
   121                              <1> ;		DH:		Maximum head number (0...254)
   122                              <1> ;	Corrupts registers:
   123                              <1> ;		AX, BH
   124                              <1> ;--------------------------------------------------------------------
   125                              <1> .PackReturnValues:
   126 00001A1C 48                  <1> 	dec		ax						; AX = Number of last cylinder
   127 00001A1D 4B                  <1> 	dec		bx						; BL = Number of last head
   128 00001A1E 91                  <1> 	xchg	cx, ax
   129 00001A1F 86E9                <1> 	xchg	cl, ch					; CH = Last cylinder bits 0...7
   130                              <1> 	eROR_IM	cl, 2					; CL bits 6...7 = Last cylinder bits 8...9
   680                              <2>  eSHIFT_IM %1, %2, ror
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 00001A21 C0C902              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   131 00001A24 08F9                <1> 	or		cl, bh					; CL bits 0...5 = Sectors per track
   132 00001A26 88DE                <1> 	mov		dh, bl					; DH = Maximum head number
   133                              <1> 
   134                              <1> %ifdef MODULE_SERIAL_FLOPPY
   135 00001A28 8A5D01              <1> 	mov		bl, [di+DPT.bFlagsHigh]
   136                              <1> 	eSHR_IM	bl, FLGH_DPT_SERIAL_FLOPPY_TYPE_FIELD_POSITION
   657                              <2>  eSHIFT_IM %1, %2, shr
   631                              <3> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   632                              <3> %ifndef USE_186
   633                              <3>  %ifidni %1, cl
   634                              <3>  times %2 %3 %1, 1
   635                              <3>  %elifidni %1, ch
   636                              <3>  times %2 %3 %1, 1
   637                              <3>  %elifidni %1, cx
   638                              <3>  times %2 %3 %1, 1
   639                              <3>  %else
   640                              <3>  %if %2 > 3
   641                              <3>  push cx
   642                              <3>  mov cl, %2
   643                              <3>  %3 %1, cl
   644                              <3>  pop cx
   645                              <3>  %else
   646                              <3>  times %2 %3 %1, 1
   647                              <3>  %endif
   648                              <3>  %endif
   649                              <3> 
   650                              <3> %else
   651 00001A2B C0EB05              <3>  %3 %1, %2
   652                              <3> %endif
   653                              <3> %endif
   137                              <1> %endif
   138 00001A2E C3                  <1> 	ret
   139                              <1> 
   140                              <1> 
   141                              <1> %ifdef MODULE_SERIAL_FLOPPY
   142                              <1> ;
   143                              <1> ; Floppy Disk Parameter Table.  There is no way to specify more than one of these
   144                              <1> ; for any given system, so no way to make this drive or media specific.
   145                              <1> ; So we return fixed values out of the ROM for callers who might be expecting this information.
   146                              <1> ;
   147                              <1> ; On AT systems, we return the information for a 1.44 MB disk,
   148                              <1> ; and on XT systems, we return the information for a 360 KB disk.
   149                              <1> ;
   150                              <1> AH8h_FloppyDPT:
   151                              <1> %ifdef USE_AT
   152 00001A2F AF                  <1> 	db		0ah << 4 | 0fh			; Offset 0: Drive timings, 1.44MB values
   153                              <1> %else
   154                              <1> 	db		0dh << 4 | 0fh			; Offset 0: Drive timings, 360KB values
   155                              <1> %endif
   156                              <1> 
   157 00001A30 02                  <1> 	db		1h << 1 | 0				; Offset 1: Typical values of 1 for head load time
   158                              <1> 									; 			DMA used (although it actually is not, but is more restrictive)
   159 00001A31 25                  <1> 	db		25h						; Offset 2: Inactivity motor turn-off delay,
   160                              <1> 									; 			Typical value of 25h for 2 second delay
   161 00001A32 02                  <1> 	db		02h						; Offset 3: Sector size, always 512
   162                              <1> 
   163                              <1> %ifdef USE_AT
   164 00001A33 12                  <1> 	db		12h						; Offset 4: Sectors per track, 1.44MB value
   165 00001A34 1B                  <1> 	db		1bh						; Offset 5: Sector gap, 1.44MB value
   166                              <1> %else
   167                              <1> 	db		09h						; Offset 4: Sectors per track, 360KB value
   168                              <1> 	db		2ah						; Offset 5: Sector gap, 360KB value
   169                              <1> %endif
   170                              <1> 
   171 00001A35 FF                  <1> 	db		0ffh					; Offset 6: Data length
   172                              <1> 
   173                              <1> %ifdef USE_AT
   174 00001A36 6C                  <1> 	db		6ch						; Offset 7: Format gap length, 1.44MB value
   175                              <1> %else
   176                              <1> 	db		50h						; Offset 7: Format gap length, 360KB value
   177                              <1> %endif
   178                              <1> 
   179 00001A37 F6                  <1> 	db		0f6h					; Offset 8: Fill byte for format
   180 00001A38 0F                  <1> 	db		0fh						; Offset 9: Head setting time
   181 00001A39 08                  <1> 	db		08h						; Offset A: Wait for motor startup time
   182                              <1> 
