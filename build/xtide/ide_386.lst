    22                              <2> HARDWARE_IRQ_0_INTERRUPT_08h			EQU		08h		; System timer
    23                              <2> HARDWARE_IRQ_1_INTERRUPT_09h			EQU		09h		; Keyboard
    24                              <2> HARDWARE_IRQ_2_INTERRUPT_0Ah			EQU		0Ah
    25                              <2> HARDWARE_IRQ_3_INTERRUPT_0Bh			EQU		0Bh
    26                              <2> HARDWARE_IRQ_4_INTERRUPT_0Ch			EQU		0Ch
    27                              <2> HARDWARE_IRQ_5_INTERRUPT_0Dh			EQU		0Dh
    28                              <2> HARDWARE_IRQ_6_INTERRUPT_0Eh			EQU		0Eh
    29                              <2> HARDWARE_IRQ_7_INTERRUPT_0Fh			EQU		0Fh
    30                              <2> HARDWARE_IRQ_8_INTERRUPT_70h			EQU		70h
    31                              <2> HARDWARE_IRQ_9_INTERRUPT_71h			EQU		71h
    32                              <2> HARDWARE_IRQ_10_INTERRUPT_72h			EQU		72h
    33                              <2> HARDWARE_IRQ_11_INTERRUPT_73h			EQU		73h
    34                              <2> HARDWARE_IRQ_12_INTERRUPT_74h			EQU		74h
    35                              <2> HARDWARE_IRQ_13_INTERRUPT_75h			EQU		75h
    36                              <2> HARDWARE_IRQ_14_INTERRUPT_76h			EQU		76h
    37                              <2> HARDWARE_IRQ_15_INTERRUPT_77h			EQU		77h
