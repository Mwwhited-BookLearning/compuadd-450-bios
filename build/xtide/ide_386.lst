    27                              <2> ; DisplayCharOut_TeletypeOutputWithAttribute
    28                              <2> ; DisplayCharOut_TeletypeOutput
    29                              <2> ;	Parameters:
    30                              <2> ;		AL:		Character to output
    31                              <2> ;		AH:		Attribute to output
    32                              <2> ;		DS:		BDA segment (zero)
    33                              <2> ;		ES:DI:	Ptr to video memory where to output
    34                              <2> ;	Returns:
    35                              <2> ;		DI:		Incremented for next character
    36                              <2> ;	Corrupts registers:
    37                              <2> ;		AX, DX
    38                              <2> ;--------------------------------------------------------------------
    39                              <2> ALIGN DISPLAY_JUMP_ALIGN
    40                              <2> DisplayCharOut_TeletypeOutputWithAttribute:
    41 00000174 3C20                <2> 	cmp		al, ' '							; Printable character?
    42 00000176 7206                <2> 	jb		SHORT DisplayCharOut_BiosTeletypeOutput
    43                              <2> 	JMP_WAIT_FOR_RETRACE_IF_NECESSARY_THEN stosw
    42                              <3> %ifdef ELIMINATE_CGA_SNOW
    43                              <3>  %ifidn %1, stosb
    44                              <3>  jmp CgaSnow_Stosb
    45                              <3>  %elifidn %1, stosw
    46                              <3>  jmp CgaSnow_Stosw
    47                              <3>  %elifidn %1, rep movsb
    48                              <3>  jmp CgaSnow_RepMovsb
    49                              <3>  %else
    50                              <3>  %error "Invalid instruction passed to JMP_WAIT_FOR_RETRACE_IF_NECESSARY_THEN"
    51                              <3>  %endif
    52                              <3> %else
    53                              <3>  %ifidn %1, rep movsb
    54                              <3>  eSEG_STR rep, es, movsb
    55                              <3>  ret
    56                              <3>  %else
    57 00000178 AB                  <3>  %1
    58 00000179 C3                  <3>  ret
    59                              <3>  %endif
    60                              <3> %endif
    44                              <2> 
    45                              <2> ALIGN DISPLAY_JUMP_ALIGN
    46                              <2> DisplayCharOut_TeletypeOutput:
    47 0000017A 3C20                <2> 	cmp		al, ' '							; Printable character?
    48 0000017C 7319                <2> 	jae		SHORT DisplayCharOut_Character
    49                              <2> 	; Fall to DisplayCharOut_BiosTeletypeOutput
    50                              <2> 
    51                              <2> ;--------------------------------------------------------------------
    52                              <2> ; DisplayCharOut_BiosTeletypeOutput
    53                              <2> ;	Parameters:
    54                              <2> ;		AL:		Control character
    55                              <2> ;		DS:		BDA segment (zero)
    56                              <2> ;		ES:DI:	Ptr to video memory where to output
    57                              <2> ;	Returns:
    58                              <2> ;		DI:		Incremented for next character
    59                              <2> ;	Corrupts registers:
    60                              <2> ;		AX, DX
    61                              <2> ;--------------------------------------------------------------------
    62                              <2> ALIGN DISPLAY_JUMP_ALIGN
    63                              <2> DisplayCharOut_BiosTeletypeOutput:
