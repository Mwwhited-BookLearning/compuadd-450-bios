   261                              <1> ; FormatDriveHotkeyString
   262                              <1> ;	Parameters:
   263                              <1> ;		CH:		Zero if letter in CL is selected for boot
   264                              <1> ;		CL:		Drive letter hotkey from BOOTVARS
   265                              <1> ;		AL:		First character for drive key string
   266                              <1> ;		AH:		Second character for drive key string (ANGLE_QUOTE_RIGHT)
   267                              <1> ;		SI:		Offset to hotkey description string
   268                              <1> ;		ES:		BDA segment (zero)
   269                              <1> ;	Returns:
   270                              <1> ;		Nothing
   271                              <1> ;	Corrupts registers:
   272                              <1> ;		AX, CX, DX, SI, DI
   273                              <1> ;--------------------------------------------------------------------
   274                              <1> FormatDriveHotkeyString:
   275                              <1> 	; Invalid scancodes are filtered on HotkeyBar_StoreHotkeyToBootvarsIfValidKeystrokeInAX
   276                              <1> 	; so here we have either drive letter or function key pressed. If latter, draw
   277                              <1> 	; drive letters as unselected
   278 00000BA0 26803E0D7F3B        <1> 	cmp		BYTE [es:BOOTVARS.hotkeyVars+HOTKEYVARS.bScancode], FIRST_FUNCTION_KEY_SCANCODE
   279 00000BA6 7314                <1> 	jae		SHORT GetNonSelectedHotkeyDescriptionAttributeToDX
   280                              <1> 
   281                              <1> 	; Drive selected to boot from?
   282 00000BA8 84ED                <1> 	test	ch, ch
   283 00000BAA 7510                <1> 	jnz		SHORT GetNonSelectedHotkeyDescriptionAttributeToDX
   284 00000BAC EB09                <1> 	jmp		SHORT GetSelectedHotkeyDescriptionAttributeToDX
   285                              <1> 
   286                              <1> 
   287                              <1> ;--------------------------------------------------------------------
   288                              <1> ; FormatFunctionHotkeyString
   289                              <1> ;	Parameters:
   290                              <1> ;		AL:		Scancode of function key, to know which if any to show as selected
   291                              <1> ;				Later replaced with an 'F' for the call to the output routine
   292                              <1> ;		AH:		Second character for drive key string
   293                              <1> ;		SI:		Offset to hotkey description string
   294                              <1> ;		ES:		BDA segment (zero)
   295                              <1> ;	Returns:
   296                              <1> ;		Nothing
   297                              <1> ;	Corrupts registers:
   298                              <1> ;		AX, CX, DX, SI, DI
   299                              <1> ;--------------------------------------------------------------------
   300                              <1> FormatFunctionHotkeyString:
   301 00000BAE 31C9                <1> 	xor		cx, cx		; Null character, eaten in output routines
   302                              <1> 
   303 00000BB0 2638060D7F          <1> 	cmp		[es:BOOTVARS.hotkeyVars+HOTKEYVARS.bScancode], al
   304 00000BB5 B046                <1> 	mov		al, 'F'		; Replace scancode with character for output
   305                              <1> 
   306                              <1> %ifdef MODULE_BOOT_MENU
   307                              <1> 
   308                              <1> GetSelectedHotkeyDescriptionAttributeToDX:
   309                              <1> 	mov		si, ATTRIBUTE_CHARS.cHighlightedItem	; Selected hotkey
   310                              <1> 	je		SHORT GetDescriptionAttributeToDX		; From compare with bScancode above and from FormatDriveHotkeyString
   311                              <1> 
   312                              <1> GetNonSelectedHotkeyDescriptionAttributeToDX:
   313                              <1> 	mov		si, ATTRIBUTE_CHARS.cItem				; Unselected hotkey
   314                              <1> 
   315                              <1> 	; Display Library should not be called like this
   316                              <1> GetDescriptionAttributeToDX:
   317                              <1> 	xchg	dx, ax
   318                              <1> 	call	MenuAttribute_GetToAXfromTypeInSI
   319                              <1> 	xchg	dx, ax					; DX = Description attribute
   320                              <1> 	;;  fall through to PushHotkeyParamsAndFormat
   321                              <1> 
   322                              <1> 
   323                              <1> %else ; if no MODULE_BOOT_MENU - No boot menu so use simpler attributes
   324                              <1> 
   325                              <1> GetSelectedHotkeyDescriptionAttributeToDX:
   326 00000BB7 BAF03E              <1> 	mov		dx, (COLOR_ATTRIBUTE(COLOR_YELLOW, COLOR_CYAN) << 8) | MONO_REVERSE_BLINK
   327 00000BBA 7403                <1> 	je		SHORT SelectAttributeFromDHorDLbasedOnVideoMode		; From compare with bScancode above and from FormatDriveHotkeyString
   328                              <1> 
   329                              <1> GetNonSelectedHotkeyDescriptionAttributeToDX:
   330 00000BBC BA7030              <1> 	mov		dx, (COLOR_ATTRIBUTE(COLOR_BLACK, COLOR_CYAN) << 8) | MONO_REVERSE
   331                              <1> 
   332                              <1> SelectAttributeFromDHorDLbasedOnVideoMode:
   333 00000BBF 268A2E4904          <1> 	mov		ch, [es:BDA.bVidMode]		; We only need to preserve CL
   334 00000BC4 D0ED                <1> 	shr		ch, 1
   335 00000BC6 7306                <1> 	jnc		SHORT .AttributeLoadedToDL	; Black & White modes
   336 00000BC8 D0ED                <1> 	shr		ch, 1
   337 00000BCA 7502                <1> 	jnz		SHORT .AttributeLoadedToDL	; MDA
   338 00000BCC 88F2                <1> 	mov		dl, dh
   339                              <1> .AttributeLoadedToDL:
   340                              <1> 	;;  fall through to PushHotkeyParamsAndFormat
   341                              <1> 
   342                              <1> %endif ; MODULE_BOOT_MENU
