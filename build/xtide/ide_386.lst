    23                              <2> ;--------------------------------------------------------------------
    24                              <2> ; DisplayPage_SetFromAL
    25                              <2> ;	Parameters:
    26                              <2> ;		AL:		New display page
    27                              <2> ;		DS:		BDA segment (zero)
    28                              <2> ;	Returns:
    29                              <2> ;		Nothing
    30                              <2> ;	Corrupts registers:
    31                              <2> ;		AX, DX
    32                              <2> ;--------------------------------------------------------------------
    33                              <2> %ifndef EXCLUDE_FROM_XUB OR EXCLUDE_FROM_XTIDECFG OR EXCLUDE_FROM_BIOSDRVS
    34                              <2> ALIGN DISPLAY_JUMP_ALIGN
    35                              <2> DisplayPage_SetFromAL:
    36                              <2> 	xor		ah, ah
    37                              <2> 	mul		WORD [VIDEO_BDA.wBytesPerPage]		; AX = Offset to page
    38                              <2> 	mov		[VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition], ax
    39                              <2> 	ret
    40                              <2> %endif
    41                              <2> 
    42                              <2> 
    43                              <2> %ifdef EXCLUDE_FROM_XUB
    44                              <2> 	%define EXCLUDE
    45                              <2> 	%ifdef MODULE_HOTKEYS OR MODULE_BOOT_MENU
    46                              <2> 		%undef EXCLUDE
    47                              <2> 	%endif
    48                              <2> %endif
    49                              <2> 
    50                              <2> %ifndef EXCLUDE OR EXCLUDE_FROM_BIOSDRVS
    51                              <2> ;--------------------------------------------------------------------
    52                              <2> ; DisplayPage_GetColumnsToALandRowsToAH
    53                              <2> ;	Parameters:
    54                              <2> ;		DS:		BDA segment (zero)
    55                              <2> ;	Returns:
    56                              <2> ;		AL:		Number of columns in selected text mode
    57                              <2> ;		AH:		Number of rows in selected text mode
    58                              <2> ;	Corrupts registers:
    59                              <2> ;		Nothing
    60                              <2> ;--------------------------------------------------------------------
    61                              <2> ALIGN DISPLAY_JUMP_ALIGN
    62                              <2> DisplayPage_GetColumnsToALandRowsToAH:
    63 0000024A A04A04              <2> 	mov		al, [VIDEO_BDA.wColumns]		; 40 or 80
    64 0000024D B419                <2> 	mov		ah, 25							; Always 25 rows on standard text modes
    65 0000024F C3                  <2> 	ret
    66                              <2> %endif
    67                              <2> %undef EXCLUDE
    68                              <2> 
    69                              <2> ;--------------------------------------------------------------------
    70                              <2> ; DisplayPage_SynchronizeToHardware
    71                              <2> ;	Parameters:
    72                              <2> ;		DS:		BDA segment (zero)
    73                              <2> ;	Returns:
    74                              <2> ;		Nothing
    75                              <2> ;	Corrupts registers:
    76                              <2> ;		AX, DX
    77                              <2> ;--------------------------------------------------------------------
    78                              <2> ALIGN DISPLAY_JUMP_ALIGN
    79                              <2> DisplayPage_SynchronizeToHardware:
    80 00000250 31D2                <2> 	xor		dx, dx
    81 00000252 A15404              <2> 	mov		ax, [VIDEO_BDA.displayContext+DISPLAY_CONTEXT.fpCursorPosition]
    82 00000255 F7364C04            <2> 	div		WORD [VIDEO_BDA.wBytesPerPage]	; AX = Page
    83                              <2> 
    84 00000259 3A066204            <2> 	cmp		al, [VIDEO_BDA.bActivePage]
    85 0000025D 7404                <2> 	je		SHORT .Return					; Same page, no need to synchronize
    86 0000025F B405                <2> 	mov		ah, SELECT_ACTIVE_DISPLAY_PAGE
    87 00000261 CD10                <2> 	int		BIOS_VIDEO_INTERRUPT_10h
    88                              <2> .Return:
    89 00000263 C3                  <2> 	ret
