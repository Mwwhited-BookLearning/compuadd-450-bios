   414                              <1> ; Boot Menu menuitem strings
   415                              <1> ;
   416                              <1> ; The following strings are used by BootMenuPrint_* routines.
   417                              <1> ; To support optimizations in that code, these strings must start on the same 256 byte page,
   418                              <1> ; which is checked at assembly time below.
   419                              <1> ;
   420                              <1> g_szDriveNumSpace:		; db	" "							; leading space, used if drive number is less than 0fh
   421                              <1>                   		; db	 20h    ; uncompressed
   422                              <1>                   		  db	 20h    ; compressed
   423                              <1> 
   424                              <1> ; must come immediately before g_szDriveNum!
   425                              <1> g_szBootMenuPrintStart:
   426                              <1> g_szDriveNum:			; db	"%x %s",NULL
   427                              <1>              			; db	 25h,  78h,  20h,  25h,  73h,  00h    ; uncompressed
   428                              <1>              			  db	 37h,  20h,  1dh                      ; compressed
   429                              <1> 
   430                              <1> g_szDriveNumBNSpace:	; db	" "							; leading space, used if drive number is less than 0fh
   431                              <1>                     	; db	 20h    ; uncompressed
   432                              <1>                     	  db	 20h    ; compressed
   433                              <1> 
   434                              <1> ; must come immediately before g_szDriveNumBOOTNFO!
   435                              <1> g_szDriveNumBOOTNFO:	; db	"%x %z",NULL
   436                              <1>                     	; db	 25h,  78h,  20h,  25h,  7ah,  00h    ; uncompressed
   437                              <1>                     	  db	 37h,  20h,  1eh                      ; compressed
   438                              <1> 
   439                              <1> g_szFloppyDrv:			; db	"Floppy Drive %c",NULL
   440                              <1>               			; db	 46h,  6ch,  6fh,  70h,  70h,  79h,  20h,  44h,  72h,  69h,  76h,  65h,  20h,  25h,  63h,  00h    ; uncompressed
   441                              <1>               			  db	 4ch,  72h,  75h,  76h,  76h, 0ffh,  4ah,  78h,  6fh,  7ch, 0ebh,  1ch                            ; compressed
   442                              <1> 
   443                              <1> g_szBootMenuPrintEnd:
   444                              <1> g_szForeignHD:			; db	"Foreign Hard Disk",NULL
   445                              <1>               			; db	 46h,  6fh,  72h,  65h,  69h,  67h,  6eh,  20h,  48h,  61h,  72h,  64h,  20h,  44h,  69h,  73h,  6bh,  00h    ; uncompressed
   446                              <1>               			  db	 4ch,  75h,  78h,  6bh,  6fh,  6dh, 0f4h,  4eh,  67h,  78h, 0eah,  4ah,  6fh,  79h, 0b1h                      ; compressed
   447                              <1> 
   448                              <1> 
   449                              <1> %ifndef CHECK_FOR_UNUSED_ENTRYPOINTS
   450                              <1> %if ((g_szBootMenuPrintStart-$$) & 0xff00) <> ((g_szBootMenuPrintEnd-$$) & 0xff00)
   451                              <1> %error "g_szBootMenuPrint* strings must start on the same 256 byte page, required by the BootMenuPrint_* routines.  Please move this block up or down within Strings.asm"
   452                              <1> %endif
   453                              <1> %if g_szDriveNumSpace+1 != g_szDriveNum || g_szDriveNumBNSpace+1 != g_szDriveNumBOOTNFO
   454                              <1> %error "g_szDriveNumSpace or g_szDriveNumBNSpace are out of position"
   455                              <1> %endif
   456                              <1> %endif
