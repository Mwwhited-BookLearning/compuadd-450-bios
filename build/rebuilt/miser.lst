     9                                  ; 55AA option ROM signature, size 30h*512 = 24 KB. Lives at E800:0000 at runtime (system BIOS far-calls E800:0010 etc).
    10                                  rom_header:
    11                                  ; [data] option ROM header
    12 00000000 55AA30                          db 0x55, 0xAA, 0x30 ; 0000 U.0
    13                                  
    14                                  ; Option ROM init entry: RETF - nothing to do at scan time
    15                                  init_stub:
    16 00000003 CB                              retf                                     ; 0003
    17                                  
    18                                  ; 'PhoenixMISER' identification string
    19                                  miser_signature:
    20                                  ; [data] signature
    21                                  ; [data] string
    22 00000004 50686F656E69784D49-             db 0x50, 0x68, 0x6F, 0x65, 0x6E, 0x69, 0x78, 0x4D, 0x49, 0x53, 0x45, 0x52 ; 0004 PhoenixMISER
    22 0000000D 534552             
    23                                  
    24                                  ; Far-callable entry table (each is call near ; retf). Called from system BIOS at F000:98F9 and jumped to from F000:5940 (POST start).
    25                                  api_entry_10:
    26 00000010 E81116                          call miser_post_hook                     ; 0010
    27 00000013 CB                              retf                                     ; 0013
    28 00000014 00<rep 8h>                      times 8 db 0x00                     ; 0014 fill
    29                                  
    30                                  ; jmp near
    31                                  api_entry_1C:
    32 0000001C E93219                          db 0xE9, 0x32, 0x19                      ; 001C  jmp get_api_far_ptr
    33 0000001F 0000000000                      db 0x00, 0x00, 0x00, 0x00, 0x00 ; 001F .....
    34                                  
    35                                  ; RETF stub; system BIOS far-jumps here from F000:5B01
    36                                  api_entry_24:
    37 00000024 CB                              retf                                     ; 0024
    38 00000025 000000                          db 0x00, 0x00, 0x00 ; 0025 ...
    39                                  
